@using IOMS.Infrastructure.Data
@using IOMS.Web.Utility
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudGrid>
            @* === Basic Info === *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Basic Information</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" Class="p-4 py-3">
                <MudTextField @bind-Value="_name" Label="Name" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6" Class="p-4 py-3">
                <MudTextField @bind-Value="_sku" Label="SKU" Required="true" />
            </MudItem>           
            <MudItem xs="12" sm="6" Class="p-4 py-3">
                <MudTextField @bind-Value="_barcode" Label="Barcode" Class="pb-5" />
                <MudAutocomplete T="CategoryDto"
                                 Label="Category"
                                 Required="true"
                                 Value="_selectedCategory"
                                 ValueChanged="OnCategoryChanged"
                                 SearchFunc="SearchCategories"
                                 ToStringFunc="@(c => c?.Path ?? c?.Name ?? "")"
                                 ResetValueOnEmptyText="false"
                                 CoerceText="true"
                                 Clearable="true" Class="pb-5" />

                <MudAutocomplete T="BrandDto"
                                 Label="Brand"
                                 Value="_selectedBrand"
                                 ValueChanged="OnBrandChanged"
                                 SearchFunc="SearchBrands"
                                 ToStringFunc="@(b => b?.Name ?? "")"
                                 ResetValueOnEmptyText="false"
                                 CoerceText="true"
                                 Clearable="true" Class="pb-5" />
                <MudTextField @bind-Value="_model" Label="Model" Class="pb-5" />
            </MudItem>          
            <MudItem xs="12" sm="6" Class="p-4 py-3">
                <MudNumericField @bind-Value="_costPrice" Label="Cost Price" Format="N2" Min="0m" Class="pb-5" />
                <MudNumericField @bind-Value="_sellingPrice" Label="Selling Price" Format="N2" Min="0m" Class="pb-5" />
                <MudNumericField @bind-Value="_wholeSellingPrice" Label="Whole Selling Price" Format="N2" Min="0m" Class="pb-5" />
                <MudNumericField @bind-Value="_reorderLevel" Label="Reorder Level" Min="0" Class="pb-5" />
                <MudNumericField @bind-Value="_moq" Label="Min Order Qty" Min="1" Class="pb-5" />
            </MudItem>
            <MudItem xs="12" Class="py-0">
                <RichTextField @bind-Value="_description" Label="Description" Lines="10" Class="mt-3" />
            </MudItem>
        
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>
@inject ApplicationDbContext DbContext
@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public object? Product { get; set; }
    [Parameter] public List<CategoryDto> Categories { get; set; } = new();
    [Parameter] public List<BrandDto> Brands { get; set; } = new();

    // Basic fields
    private string _name = "";
    private string _sku = "";
    private string? _barcode;
    private string? _description;
    private Guid _categoryId;
    private CategoryDto? _selectedCategory;
    private Guid? _brandId;
    private BrandDto? _selectedBrand;
    private decimal _costPrice;
    private decimal _sellingPrice;
    private decimal _wholeSellingPrice;
    private int _reorderLevel = 10;
    private int _moq = 1;
    private string? _model;

    protected override void OnInitialized()
    {
        if (Product is ProductDetailsDto details)
        {
            _name = details.Name;
            _sku = details.SKU;
            _barcode = details.Barcode;
            _description = details.Description;
            _categoryId = details.CategoryId;
            _selectedCategory = Categories.FirstOrDefault(c => c.Id == details.CategoryId);
            _costPrice = details.CostPrice;
            _wholeSellingPrice = details.WholeSellingPrice;
            _sellingPrice = details.SellingPrice;
            _reorderLevel = details.ReorderLevel;
            _moq = details.MinimumOrderQuantity;
            _model = details.Model;
            _brandId = details.BrandId;
            _selectedBrand = Brands.FirstOrDefault(b => b.Id == details.BrandId);
        }
        else if (Product is ProductDto p)
        {
            _name = p.Name;
            _sku = p.SKU;
            _barcode = p.Barcode;
            _description = p.Description;
            _categoryId = p.CategoryId;
            _selectedCategory = Categories.FirstOrDefault(c => c.Id == p.CategoryId);
            _costPrice = p.CostPrice;
            _wholeSellingPrice = p.WholeSellingPrice;
            _sellingPrice = p.SellingPrice;
            _reorderLevel = p.ReorderLevel;
            _moq = p.MinimumOrderQuantity;
        }
        else if (Categories.Count > 0)
        {
            _selectedCategory = Categories.First();
            _categoryId = _selectedCategory.Id;
        }
    }

    private Task<IEnumerable<CategoryDto>> SearchCategories(string text, CancellationToken _)
    {
        var results = string.IsNullOrWhiteSpace(text)
            ? Categories
            : Categories.Where(c => c.Name.Contains(text, StringComparison.OrdinalIgnoreCase) || (c.Path!=null && c.Path.Contains(text, StringComparison.OrdinalIgnoreCase)));
        return Task.FromResult(results.AsEnumerable());
    }

    private Task<IEnumerable<BrandDto>> SearchBrands(string text, CancellationToken _)
    {
        var results = string.IsNullOrWhiteSpace(text)
            ? Brands
            : Brands.Where(b => b.Name.Contains(text, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(results.AsEnumerable());
    }

    private void OnCategoryChanged(CategoryDto? cat)
    {
        _selectedCategory = cat;
        _categoryId = cat?.Id ?? Guid.Empty;
    }

    private void OnBrandChanged(BrandDto? brand)
    {
        _selectedBrand = brand;
        _brandId = brand?.Id;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        var dto = new CreateProductDetailsDto(
            _name,
            _sku,
            _barcode,
            _description,
            _costPrice,
            _sellingPrice,
            _wholeSellingPrice,
            _reorderLevel,
            _moq,
            _categoryId,
            _brandId,
            null, // BaseUoMId
            null, // ImageUrl
            _model
        );
        MudDialog.Close(DialogResult.Ok(dto));
    }
}
