@using IOMS.Infrastructure.Data
@using MudBlazor

<MudDialog Class="bg-dialog-sales">
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="2">
                <MudDatePicker @bind-Date="dataModel.SalesDate" Label="Sales Date" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="dataModel.BrandName" Label="Branch Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3" Class="mb-4">
                <MudAutocomplete T="FilterItem"
                                 @ref="CustomerDropDownControl"
                                 Label="Customer"
                                 Required="true"
                                 @key="_lastCustomerSelection"
                                 @bind-Value="dataModel.SelectedCustomer"
                                 @bind-Text="_customerText"
                                 @bind-Value:after="OnCustomerChanged"
                                 SearchFunc="SearchCustomers"
                                 ToStringFunc="@(c => c?.Name ?? "")"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="dataModel.Naration" Label="Naration" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="dataModel.Chalan" Label="Chalan" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>        
        
        <MudText Typo="Typo.h6" Class="my-0">Order Items</MudText>
        <MudTable Items="@dataModel.Items" Dense="true" Elevation="0" Class="product-item-list">
            <HeaderContent>
                <MudTh Class="col-4">Product</MudTh>
                <MudTh Class="col-1">Qty</MudTh>
                <MudTh Class="col-2">Unit Price</MudTh>
                <MudTh Class="col-2">Discount</MudTh>
                <MudTh Class="col-2">Line Total</MudTh>
                <MudTh Class="pe-2 text-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNewItem" Class="mt-2 add-item-icon"></MudButton>
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                @if (context.ProductId==Guid.Empty)
                {
                     <MudTd Class="col-4">
                        <MudSelect T=Guid Value="dataModel.SelectedItem.ProductId" ValueChanged="OnProductFilterChanged" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var p in Products)
                            {
                                <MudSelectItem Value="@p.Id">@p.Name (@p.SKU)</MudSelectItem>
                            }
                        </MudSelect>

                     </MudTd>
                    <MudTd Class="col-1 px-2"><MudNumericField @bind-Value="dataModel.SelectedItem.Quantity" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudTd>
                    <MudTd Class="col-2"> <MudNumericField @bind-Value="dataModel.SelectedItem.UnitPrice" Format="N2" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudTd>
                    <MudTd Class="col-2 w-100 d-flex justify-content-between px-0">
                        <MudNumericField @bind-Value="dataModel.SelectedItem.DiscountAmount" Format="N1" Class="_newDiscount" Variant="Variant.Outlined" Margin="Margin.Dense" />
                       @* 
                        <InputSelect id="country" @bind-Value="dataModel.SelectedItem.DiscountType" Class="_discountType">
                                 @foreach (DiscountType type in Enum.GetValues(typeof(DiscountType)))
                            {
                                <option value="@((int)type)">@CommonUtility.GetDisplayName(type)</option>
                            }    </InputSelect>

                        <select @bind="dataModel.SelectedItem.DiscountType" Class="_discountType">
                            @foreach (DiscountType type in Enum.GetValues(typeof(DiscountType)))
                            {
                                <option value="@((int)type)">@CommonUtility.GetDisplayName(type)</option>
                            }
                       </select> *@

                        <MudSelect @bind-Value="dataModel.SelectedItem.DiscountType" Class="_discountType" Variant="Variant.Outlined" Margin="Margin.Dense">
                              @foreach (DiscountType type in Enum.GetValues(typeof(DiscountType)))
                                {
                                <MudSelectItem Value="@((int)type)">@CommonUtility.GetDisplayName(type)</MudSelectItem>
                                }
                        </MudSelect>
                    </MudTd>
                    <MudTd Class="col-2">
                        @{
                            CalculateLineTotal();
                            //CalculationBalance();
                        }
                        <MudNumericField @bind-Value="dataModel.SelectedItem.TotalPrice" Format="C" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudTd>
                    <MudTd Class="col-1 pe-2 text-end">
                        <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Filled.Save" Size="Size.Small" Color="Color.Primary" OnClick="AddItem"/>
                        <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => dataModel.Items.Remove(context))" />
                    </MudTd>
                    }
                else
                {
                    <MudTd>@Products.FirstOrDefault(p => p.Id == context.ProductId).Name</MudTd>
                    <MudTd>@context.Quantity</MudTd>
                    <MudTd>@context.UnitPrice.ToString("C")</MudTd>
                    <MudTd>@context.TotalDiscountAmount.ToString("C")</MudTd>
                    <MudTd>@context.TotalPrice.ToString("C")</MudTd>
                    <MudTd Class="text-end">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"OnClick="@(() => dataModel.Items.Remove(context))" />
                    </MudTd>
                }

            </RowTemplate>
        </MudTable>        
        <MudCard Class="mt-4">
            <MudCardHeader Class="pb-0 pt-2">
                <MudText>Balance</MudText>             
                <hr  class="border-1"/>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid Class="pt-0">                    
                    <MudItem xs="3" Class="pe-2 pt-2">
                        <MudTextField @bind-Value="dataModel.DrAmount" Label="Dr" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                        <MudTextField @bind-Value="dataModel.CrAmount" Label="Cr" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                        <MudNumericField @bind-Value="dataModel.StackQty" Label="Stack Qty" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                    </MudItem>
                    <MudItem xs="3" Class="pe-2 pt-2">
                        <MudNumericField @bind-Value="dataModel.ItemAmount" Disabled="true" Label="Item Amount" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                        <MudNumericField @bind-Value="dataModel.LabourCharges" Label="Labour Charges" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                        <MudNumericField @bind-Value="dataModel.TruckCharges" Label="Truck Charges" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                    </MudItem>
                    <MudItem xs="3" Class="pe-2 pt-2">
                        <MudNumericField @bind-Value="dataModel.VATAmount" Label="VAT" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                        <div class="d-flex justify-content-between">
                            <MudNumericField @bind-Value="dataModel.DiscountAmount" Label="Discount" Variant="Variant.Outlined" Margin="Margin.Dense" Class="DiscountField pb-1 col-7" />
                            <MudSelect @bind-Value="dataModel.DiscountType" Variant="Variant.Outlined" Margin="Margin.Dense" Class="DiscountTypeField pb-1 col-3">
                                <MudSelectItem Value="0">%</MudSelectItem>
                                <MudSelectItem Value="1">Fixed</MudSelectItem>
                            </MudSelect>
                        </div>
                        <MudNumericField @bind-Value="dataModel.GrandTotalAmount" Disabled="true" Label="Grand Total" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                    </MudItem>
                    <MudItem xs="3" Class="pe-2 pt-2">
                        <MudNumericField @bind-Value="dataModel.PaidAmount" Label="Paid Amount" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                        <MudNumericField @bind-Value="dataModel.DueAmount" Label="Due Amount" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                    </MudItem>
                </MudGrid>
                @{
                    CalculationBalance();
                }
            </MudCardContent>
        </MudCard>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!dataModel.Items.Any())">
            Sale
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitToPrint" Disabled="@(!dataModel.Items.Any())">
            Sale & Print
        </MudButton>
    </DialogActions>
</MudDialog>

@inject ApplicationDbContext DbContext
@inject IDialogService DialogService

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<CustomerDto> Customers { get; set; } = new();
    [Parameter] public List<(Guid Id, string Name, string SKU, decimal Price)> Products { get; set; } = new();

    private CreateSalesOrderDtoModels dataModel = new CreateSalesOrderDtoModels();
    private MudAutocomplete<FilterItem> CustomerDropDownControl = default!;
    private string? _customerText;
    private FilterItem? _lastCustomerSelection;
    private static readonly FilterItem AddNewCustomerOption = new(Guid.Empty, "Add New", false);


    // private DateTime? SalesDate = DateTime.Today;
    // private string BrandName ="";
    // private string Naration ="";
    // private string Chalan = "";
    // private FilterItem _selectedCustomer;
    //private FilterItem? _lastCustomerSelection;
    // private int _selectedCustomerIndex=0;
    // private string? _notes;
    // private List<CreateSalesOrderItemDto> _items = new();
    // private Guid _newProductId;    
    // private int _newQty = 1;
    // private decimal _newPrice;
    // private decimal _newDiscount;
    // private decimal _totalDiscount;
    // private int _discountType=0;    
    // private decimal _newTotalPrice;
    // private string DrField = "";
    // private string CrField = "";
    // private string StackQtyField = "0";
    // private decimal? ItemAmountField;
    // private decimal? DiscountField ;
    // private int DiscountTypeField=0;
    // private decimal? TotalAmountField;
    // private decimal? LabourChargesField;
    // private decimal? TruckChargesField;
    // private decimal? GrandTotalField;
    // private decimal? VATField;
    // private decimal? PaidAmountField;
    // private decimal? DueAmountField;
    // private decimal? GrandTotalWithVATField;


    protected override void OnInitialized()
    {
        if (Customers.Count > 0) dataModel.SelectedCustomer = Customers.Select(x => new FilterItem(x.Id, x.Name, x.IsActive)).First();
        if (Products.Count > 0) { dataModel.SelectedItem.ProductId = Products.First().Id; dataModel.SelectedItem.UnitPrice = Products.First().Price; }
    }

    private void OnProductFilterChanged(Guid productId)
    {
        var p = Products.FirstOrDefault(p => p.Id == productId);
        if (p != default) dataModel.SelectedItem.UnitPrice = p.Price;
    }


    private void AddNewItem()
    {
        var item = dataModel.Items.Where(x => x.ProductId == Guid.Empty).FirstOrDefault();
        if (item != null) return;
     
        dataModel.Items.Add(new CreateSalesOrderItemDto(Guid.Empty, 0, 0, 0, DiscountType.Percentage, 0, 0, null));
        dataModel.SelectedItem.Quantity = 1;
        dataModel.SelectedItem.DiscountAmount = 0;
        //if (Products.Count > 0) { _newProductId = Products.First().Id; _newPrice = Products.First().Price; }
    }

    private void AddItem()
    {
        if (dataModel.SelectedItem.ProductId == Guid.Empty || dataModel.SelectedItem.Quantity <= 0) return;

        dataModel.Items.Add(new CreateSalesOrderItemDto(dataModel.SelectedItem.ProductId, dataModel.SelectedItem.Quantity, dataModel.SelectedItem.UnitPrice, dataModel.SelectedItem.DiscountAmount, (DiscountType)dataModel.SelectedItem.DiscountType, dataModel.SelectedItem.TotalDiscount, dataModel.SelectedItem.TotalPrice, null));
        dataModel.SelectedItem.Quantity = 1;
        dataModel.SelectedItem.DiscountAmount = 0;
        dataModel.ItemAmount = dataModel.Items.Sum(i => i.TotalPrice);

        if (Products.Count > 0) { dataModel.SelectedItem.ProductId = Products.First().Id; dataModel.SelectedItem.UnitPrice = Products.First().Price; }

        dataModel.Items = dataModel.Items.OrderByDescending(x => x.ProductId).ToList();
    }
    private void CalculateLineTotal()
    {
        dataModel.SelectedItem.TotalDiscount = 0;
        if (dataModel.SelectedItem.DiscountType == (int)DiscountType.Percentage)
        {
            dataModel.SelectedItem.TotalDiscount = (dataModel.SelectedItem.UnitPrice * dataModel.SelectedItem.Quantity) * (dataModel.SelectedItem.DiscountAmount / 100);
        }
        else
        {
            dataModel.SelectedItem.TotalDiscount = dataModel.SelectedItem.DiscountAmount;
        }

        dataModel.SelectedItem.TotalPrice = ((dataModel.SelectedItem.UnitPrice * dataModel.SelectedItem.Quantity) - dataModel.SelectedItem.TotalDiscount);
    }

    private void CalculationBalance()
    {  
        decimal totalVatAmount = 0;
        decimal vat = dataModel.VATAmount;
        if (vat > 0)
            totalVatAmount = (dataModel.ItemAmount) * ((dataModel.VATAmount) / 100); ;

        dataModel.GrandTotalAmount = (dataModel.ItemAmount) + totalVatAmount + (dataModel.LabourCharges) + (dataModel.TruckCharges);

        decimal? discountAmt = 0m;

        if (dataModel.DiscountType == (int)DiscountType.Percentage)
        {
            discountAmt = (dataModel.ItemAmount) * (dataModel.DiscountAmount / 100);
        }
        else
        {
            discountAmt = dataModel.DiscountAmount;
        }

        dataModel.GrandTotalAmount = dataModel.GrandTotalAmount - (discountAmt ?? 0);

        dataModel.DueAmount = (dataModel.GrandTotalAmount) - (dataModel.PaidAmount);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        var dto = new CreateSalesOrderDto(dataModel.SelectedCustomer.Id, null, dataModel.Notes, null, null, null, OrderStatus.Sold, dataModel.SalesDate ?? DateTime.Today, dataModel.Items);
        MudDialog.Close(DialogResult.Ok(dto));
    }
    private void SubmitToPrint()
    {
        var dto = new CreateSalesOrderDto(dataModel.SelectedCustomer.Id, null, dataModel.Notes, null, null, null, OrderStatus.Delivered, dataModel.SalesDate ?? DateTime.Today, dataModel.Items);
        MudDialog.Close(DialogResult.Ok(dto));
    }

    private async Task OnCustomerChanged()
    {
        var cust = dataModel.SelectedCustomer;

        if (cust?.Id == Guid.Empty)
        {
            var previousCustomer = _lastCustomerSelection;
            var parameters = new DialogParameters<CustomerDialog>
            {
                { x => x.Customer, new CustomerDto(Guid.Empty, string.Empty, string.Empty, string.Empty, string.Empty, string.Empty, string.Empty, string.Empty, 0, string.Empty, false, false) }
                //{ x => x.Customer, Customers.Where(c => c.Id != Guid.Empty).FirstOrDefault() }
            };

            var dialog = await DialogService.ShowAsync<CustomerDialog>("New Customer", parameters,
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
            var result = await dialog.Result;

            await CustomerDropDownControl.ResetAsync();

            if (result != null && !result.Canceled && result.Data is CreateCustomerDto dto)
            {
                var newCustomer = new IOMS.Domain.Entities.Customer
                    {
                        Name = dto.Name,
                        Email = dto.Email,
                        Phone = dto.Phone,
                        Address = dto.Address,
                        City = dto.City,
                        State = dto.State,
                        Country = dto.Country,
                        PostalCode = dto.PostalCode,
                        CreditLimit = dto.CreditLimit,
                        PaymentTerms = dto.PaymentTerms,
                        IsTaxExempt = dto.IsTaxExempt
                    };

                // await DbContext.SaveChangesAsync();
                // Snackbar.Add("Customer updated", Severity.Success);
                // await LoadData();

                DbContext.Customers.Add(newCustomer);
                await DbContext.SaveChangesAsync();     
                var latestCustomer = await DbContext.Customers.ToListAsync();
                Customers = latestCustomer.Select(c => new CustomerDto(c.Id, c.Name, c.Email, c.Phone, c.Address, c.City, c.State, c.Country, c.CreditLimit, c.PaymentTerms, c.IsActive, c.IsTaxExempt)).ToList();

                cust = new FilterItem(newCustomer.Id, newCustomer.Name, false);

                //var latestCustomers = await DbContext.Customers.ToListAsync();

                dataModel.SelectedCustomer = Customers.Where(x => x.Id == newCustomer.Id).Select(c => new FilterItem(c.Id, c.Name, false)).FirstOrDefault();
                //_selectedCustomer = Customers.FirstOrDefault();
                _lastCustomerSelection = dataModel.SelectedCustomer;
                //_customerId = _selectedCustomer?.Id ?? Guid.Empty;
                _customerText = dataModel.SelectedCustomer?.Name;

                StateHasChanged();
            }
            else
            {
                dataModel.SelectedCustomer = previousCustomer;
                _lastCustomerSelection = dataModel.SelectedCustomer;
                //_customer = previousCustomer;
                _customerText = dataModel.SelectedCustomer?.Name;

                StateHasChanged();
            }
        }
        else
        {
            dataModel.SelectedCustomer = cust;
            _lastCustomerSelection = dataModel.SelectedCustomer;
            _customerText = dataModel.SelectedCustomer?.Name;
        }
    }

    private Task<IEnumerable<FilterItem>> SearchCustomers(string text, CancellationToken _)
    {
        IEnumerable<FilterItem> baseResults;

        if (string.IsNullOrWhiteSpace(text))
        {
            baseResults = Customers.Where(c => c.Id != Guid.Empty).Select(c => new FilterItem(c.Id, c.Name, false));
        }
        else
        {
            baseResults = Customers.Where(c =>
                c.Id != Guid.Empty &&
                (c.Name.Contains(text, StringComparison.OrdinalIgnoreCase)))
                .Select(c => new FilterItem(c.Id, c.Name, false));
        }

        //var results = new[] { AddNewCustomerOption }.Concat(baseResults).DistinctBy(c => c.Id);
        var results = baseResults.Append(AddNewCustomerOption).DistinctBy(c => c.Id);

        return Task.FromResult(results);
    }

}
