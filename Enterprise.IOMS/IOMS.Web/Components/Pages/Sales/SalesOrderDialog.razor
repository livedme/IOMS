            //     StateHasChanged();
            // }
        }
        else
        {
            var p = Products.FirstOrDefault(p => p.Id == prod?.Id);
            if (p != default)
            {
                dataModel.SelectedItem.ProductId = p.Id;
                    dataModel.SelectedItem.Quantity = 1;
                    dataModel.SelectedItem.UnitPrice = p.Price;
                    dataModel.SelectedItem.DiscountType = (int)DiscountType.Percentage;
                    dataModel.SelectedItem.DiscountAmount = 0m;
                    dataModel.SelectedItem.TotalDiscount = 0m;

                // Load available serials for this product
                _selectedSerialSet = new();
                _availableSerials = await DbContext.ProductSerials
                    .Where(ps => ps.ProductId == p.Id && ps.Status == ProductSerialStatus.Available)
                    .ToListAsync();
                }
            _lastProductSelection = prod;
            _productText = prod?.Name;
        }
    }

    private Task<IEnumerable<FilterItem>> SearchProducts(string text, CancellationToken _)
    {
        IEnumerable<FilterItem> baseResults;

        if (string.IsNullOrWhiteSpace(text))
        {
            baseResults = Products.Where(c => c.Id != Guid.Empty).Select(c => new FilterItem(c.Id, c.Name, false));
        }
        else
        {
            baseResults = Products.Where(c =>
                c.Id != Guid.Empty &&
                (c.Name.Contains(text, StringComparison.OrdinalIgnoreCase)))
                .Select(c => new FilterItem(c.Id, c.Name, false));
        }

        //var results = new[] { AddNewCustomerOption }.Concat(baseResults).DistinctBy(c => c.Id);
        var results = baseResults.Append(AddNewCustomerOption).DistinctBy(c => c.Id);

        return Task.FromResult(results);
    }

    
    private void ToggleSerial(Guid id, bool selected)
    {
        if (selected) _selectedSerialSet.Add(id);
        else _selectedSerialSet.Remove(id);
    }

    private void CalculateLineTotal()
    {
        dataModel.SelectedItem.TotalDiscount = 0;
        if (dataModel.SelectedItem.DiscountType == (int)DiscountType.Percentage)
        {
            dataModel.SelectedItem.TotalDiscount = (dataModel.SelectedItem.UnitPrice * dataModel.SelectedItem.Quantity) * (dataModel.SelectedItem.DiscountAmount / 100);
        }
        else
        {
            dataModel.SelectedItem.TotalDiscount = dataModel.SelectedItem.DiscountAmount;
        }

        dataModel.SelectedItem.TotalPrice = ((dataModel.SelectedItem.UnitPrice * dataModel.SelectedItem.Quantity) - dataModel.SelectedItem.TotalDiscount);
    }

    private void CalculationBalance()
    {
        decimal totalVatAmount = 0;
        decimal vat = dataModel.VATAmount;
        if (vat > 0)
            totalVatAmount = (dataModel.ItemAmount) * ((dataModel.VATAmount) / 100); ;

        dataModel.GrandTotalAmount = (dataModel.ItemAmount) + totalVatAmount + (dataModel.LabourCharges) + (dataModel.TruckCharges);

        decimal? discountAmt = 0m;

        if (dataModel.DiscountType == (int)DiscountType.Percentage)
        {
            discountAmt = (dataModel.ItemAmount) * (dataModel.DiscountAmount / 100);
        }
        else
        {
            discountAmt = dataModel.DiscountAmount;
        }

        dataModel.GrandTotalAmount = dataModel.GrandTotalAmount - (discountAmt ?? 0);

        dataModel.DueAmount = (dataModel.GrandTotalAmount) - (dataModel.PaidAmount);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        var dto = new CreateSalesOrderDto(dataModel.SelectedCustomer.Id, null, dataModel.BranchId, dataModel.Notes, null, null, null, OrderStatus.Sold, dataModel.SalesDate ?? DateTime.Today, dataModel.Items);
        MudDialog.Close(DialogResult.Ok(dto));
    }
    
    private void SubmitToPrint()
    {
        var dto = new CreateSalesOrderDto(dataModel.SelectedCustomer.Id, null, dataModel.BranchId, dataModel.Notes, null, null, null, OrderStatus.Delivered, dataModel.SalesDate ?? DateTime.Today, dataModel.Items);
        MudDialog.Close(DialogResult.Ok(dto));
    }

    

