@page "/orders/sales"
@rendermode InteractiveServer
@inject IOrderService OrderService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@using IOMS.Infrastructure.Data
@inject ApplicationDbContext DbContext

<PageTitle>Sales Orders - IOMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Sales Orders</MudText>

<MudPaper Elevation="2" Class="pa-4">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_search" Placeholder="Search orders..." Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                          DebounceInterval="300" OnDebounceIntervalElapsed="LoadOrders" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect @bind-Value="_statusFilter" Label="Status" Clearable="true">
                @foreach (var status in Enum.GetValues<OrderStatus>())
                {
                    <MudSelectItem Value="@((OrderStatus?)status)">@status</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreate">New Sales Order</MudButton>
        </MudItem>
    </MudGrid>

    <MudTable Items="@_orders.Items" Dense="true" Hover="true" Striped="true" Loading="@_loading" Class="mt-4" Elevation="0">
        <HeaderContent>
            <MudTh>Order #</MudTh>
            <MudTh>Customer</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align:right">Total</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.OrderNumber</MudTd>
            <MudTd>@context.CustomerName</MudTd>
            <MudTd>@context.OrderDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd>
                <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
            </MudTd>
            <MudTd Style="text-align:right">@context.TotalAmount.ToString("C")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Info"
                               OnClick="@(() => ViewOrder(context.Id))" />
                @if (context.Status == OrderStatus.Pending)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                                   OnClick="@(() => Approve(context.Id))" />
                }
                @if (context.Status != OrderStatus.Cancelled && context.Status != OrderStatus.Delivered)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => Cancel(context.Id))" />
                }
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private PagedResult<SalesOrderDto> _orders = new(new(), 0, 1, 25);
    private string _search = "";
    private OrderStatus? _statusFilter;
    private bool _loading = true;
    private int _page = 1;

    protected override async Task OnInitializedAsync() => await LoadOrders();

    private async Task LoadOrders()
    {
        _loading = true;
        try { _orders = await OrderService.GetSalesOrders(_search, _statusFilter, _page, 25); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _loading = false;
    }

    private async Task Approve(Guid id)
    {
        try
        {
            await OrderService.ApproveOrder(id);
            Snackbar.Add("Order approved successfully", Severity.Success);
            await LoadOrders();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Cancel(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Cancel Order", "Are you sure?", "Yes, Cancel", "No");
        if (confirm == true)
        {
            try
            {
                await OrderService.CancelOrder(id, "Cancelled by user");
                Snackbar.Add("Order cancelled", Severity.Warning);
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task ViewOrder(Guid id) => Nav.NavigateTo($"/orders/sales/{id}");

    private async Task OpenCreate()
    {
        var customers = await DbContext.Customers.Where(c => c.IsActive).OrderBy(c => c.Name).ToListAsync();
        var products = await DbContext.Products.OrderBy(p => p.Name).ToListAsync();

        var parameters = new DialogParameters<SalesOrderDialog>
        {
            { x => x.Customers, customers.Select(c => (c.Id, c.Name)).ToList() },
            { x => x.Products, products.Select(p => (p.Id, p.Name, p.SKU, p.SellingPrice)).ToList() }
        };

        var dialog = await DialogService.ShowAsync<SalesOrderDialog>("New Sales Order", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateSalesOrderDto dto)
        {
            try
            {
                var orderId = await OrderService.CreateSalesOrder(dto);
                Snackbar.Add("Sales order created successfully", Severity.Success);
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private Color GetStatusColor(OrderStatus status) => status switch
    {
        OrderStatus.Pending => Color.Default,
        OrderStatus.Approved => Color.Info,
        OrderStatus.Packed => Color.Warning,
        OrderStatus.Shipped => Color.Primary,
        OrderStatus.Delivered => Color.Success,
        OrderStatus.Cancelled => Color.Error,
        _ => Color.Default
    };
}
