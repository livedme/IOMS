@page "/quotes"
@rendermode InteractiveServer
@inject IQuotationService QuotationService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@using IOMS.Infrastructure.Data
@inject ApplicationDbContext DbContext

<PageTitle>Quotations - IOMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Sales Quotations</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           OnClick="OpenCreateDialog" Class="mb-4">New Quotation</MudButton>

<MudPaper Elevation="2" Class="pa-4">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_search" Placeholder="Search quotations..." Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                          DebounceInterval="300" OnDebounceIntervalElapsed="Load" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect Value="_statusFilter" Label="Status" Clearable="true"
                       ValueChanged="@((QuoteStatus? v) => { _statusFilter = v; _ = Load(); })" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (QuoteStatus s in Enum.GetValues<QuoteStatus>())
                {
                    <MudSelectItem Value="@((QuoteStatus?)s)">@s</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudTable Items="@_quotes" Dense="true" Hover="true" Striped="true" Loading="@_loading" Class="mt-4" Elevation="0">
        <HeaderContent>
            <MudTh>Quote #</MudTh>
            <MudTh>Customer</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Valid Until</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align:right">Total</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><strong>@context.QuoteNumber</strong></MudTd>
            <MudTd>@context.CustomerName</MudTd>
            <MudTd>@context.QuoteDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd>
                <MudText Color="@(context.ValidUntil < DateTime.Today && context.Status == QuoteStatus.Draft ? Color.Warning : Color.Default)">
                    @context.ValidUntil.ToString("yyyy-MM-dd")
                </MudText>
            </MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">@context.Status</MudChip></MudTd>
            <MudTd Style="text-align:right">@context.TotalAmount.ToString("C")</MudTd>
            <MudTd>
                @if (context.Status == QuoteStatus.Draft || context.Status == QuoteStatus.Sent)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small"
                                   Title="Accept" OnClick="() => AcceptQuote(context.Id)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small"
                                   Title="Reject" OnClick="() => RejectQuote(context.Id)" />
                }
                @if (context.Status == QuoteStatus.Accepted)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Primary" Size="Size.Small"
                                   Title="Convert to Order" OnClick="() => ConvertToOrder(context.Id)" />
                }
            </MudTd>
        </RowTemplate>
        <PagerContent><MudTablePager /></PagerContent>
    </MudTable>
</MudPaper>

@code {
    private List<QuoteDisplayDto> _quotes = new();
    private string _search = "";
    private QuoteStatus? _statusFilter;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        try
        {
            var query = DbContext.SalesQuotes
                .Include(q => q.Customer)
                .Include(q => q.Items)
                .AsQueryable();

            if (_statusFilter.HasValue) query = query.Where(q => q.Status == _statusFilter.Value);
            if (!string.IsNullOrWhiteSpace(_search))
                query = query.Where(q => q.QuoteNumber.Contains(_search) || q.Customer.Name.Contains(_search));

            var data = await query.OrderByDescending(q => q.QuoteDate).Take(100).ToListAsync();
            _quotes = data.Select(q => new QuoteDisplayDto
            {
                Id = q.Id,
                QuoteNumber = q.QuoteNumber,
                CustomerName = q.Customer?.Name ?? "",
                QuoteDate = q.QuoteDate,
                ValidUntil = q.ValidUntil,
                Status = q.Status,
                TotalAmount = q.TotalAmount
            }).ToList();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _loading = false;
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<QuotationDialog>("New Quotation", new DialogParameters(),
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
            await Load();
    }

    private async Task AcceptQuote(Guid id)
    {
        try
        {
            await QuotationService.AcceptQuote(id);
            Snackbar.Add("Quote accepted", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task RejectQuote(Guid id)
    {
        try
        {
            await QuotationService.RejectQuote(id, "Rejected by user");
            Snackbar.Add("Quote rejected", Severity.Info);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ConvertToOrder(Guid id)
    {
        try
        {
            await QuotationService.ConvertQuoteToOrder(id);
            Snackbar.Add("Quotation converted to Sales Order", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private Color GetStatusColor(QuoteStatus status) => status switch
    {
        QuoteStatus.Draft => Color.Default,
        QuoteStatus.Sent => Color.Info,
        QuoteStatus.Accepted => Color.Success,
        QuoteStatus.Rejected => Color.Error,
        QuoteStatus.Expired => Color.Warning,
        QuoteStatus.Converted => Color.Tertiary,
        _ => Color.Default
    };

    private class QuoteDisplayDto
    {
        public Guid Id { get; set; }
        public string QuoteNumber { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public DateTime QuoteDate { get; set; }
        public DateTime ValidUntil { get; set; }
        public QuoteStatus Status { get; set; }
        public decimal TotalAmount { get; set; }
    }
}
