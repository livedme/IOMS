@page "/customers"
@rendermode InteractiveServer
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using IOMS.Infrastructure.Data
@inject ApplicationDbContext DbContext

<PageTitle>Customers - IOMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Customers</MudText>

<MudPaper Elevation="2" Class="pa-4">
    <MudGrid>
        <MudItem xs="12" sm="8">
            <MudTextField @bind-Value="_searchString" Placeholder="Search customers..." Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                          DebounceInterval="300" OnDebounceIntervalElapsed="LoadData" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreate">New Customer</MudButton>
        </MudItem>
    </MudGrid>

    <MudTable Items="@_items" Dense="true" Hover="true" Striped="true" Loading="@_loading" Class="mt-4" Elevation="0">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Phone</MudTh>
            <MudTh>City</MudTh>
            <MudTh Style="text-align:right">Credit Limit</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.Email</MudTd>
            <MudTd>@context.Phone</MudTd>
            <MudTd>@context.City</MudTd>
            <MudTd Style="text-align:right">@context.CreditLimit.ToString("C")</MudTd>
            <MudTd>
                <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Default)" Size="Size.Small">
                    @(context.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => OpenEdit(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => Delete(context.Id))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private record CustomerListItem(Guid Id, string Name, string? Email, string? Phone,
        string? City, decimal CreditLimit, bool IsActive);

    private List<CustomerListItem> _items = new();
    private string _searchString = "";
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        _loading = true;
        var query = DbContext.Customers.AsQueryable();
        if (!string.IsNullOrWhiteSpace(_searchString))
            query = query.Where(c => c.Name.Contains(_searchString) || c.Email!.Contains(_searchString));

        var data = await query.OrderBy(c => c.Name).Take(100).ToListAsync();
        _items = data.Select(c => new CustomerListItem(c.Id, c.Name, c.Email, c.Phone, c.City, c.CreditLimit, c.IsActive)).ToList();
        _loading = false;
    }

    private async Task OpenCreate()
    {
        var dialog = await DialogService.ShowAsync<CustomerDialog>("New Customer",
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is CreateCustomerDto dto)
        {
            DbContext.Customers.Add(new IOMS.Domain.Entities.Customer
            {
                Name = dto.Name,
                Email = dto.Email,
                Phone = dto.Phone,
                Address = dto.Address,
                City = dto.City,
                State = dto.State,
                Country = dto.Country,
                PostalCode = dto.PostalCode,
                CreditLimit = dto.CreditLimit,
                PaymentTerms = dto.PaymentTerms,
                IsTaxExempt = dto.IsTaxExempt
            });
            await DbContext.SaveChangesAsync();
            Snackbar.Add("Customer created", Severity.Success);
            await LoadData();
        }
    }

    private async Task OpenEdit(CustomerListItem item)
    {
        var entity = await DbContext.Customers.FindAsync(item.Id);
        if (entity == null) return;

        var dto = new CustomerDto(entity.Id, entity.Name, entity.Email, entity.Phone, entity.Address,
            entity.City, entity.State, entity.Country, entity.CreditLimit, entity.PaymentTerms, entity.IsActive, entity.IsTaxExempt);

        var parameters = new DialogParameters<CustomerDialog> { { x => x.Customer, dto } };
        var dialog = await DialogService.ShowAsync<CustomerDialog>("Edit Customer", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is CreateCustomerDto updated)
        {
            entity.Name = updated.Name;
            entity.Email = updated.Email;
            entity.Phone = updated.Phone;
            entity.Address = updated.Address;
            entity.City = updated.City;
            entity.State = updated.State;
            entity.Country = updated.Country;
            entity.PostalCode = updated.PostalCode;
            entity.CreditLimit = updated.CreditLimit;
            entity.PaymentTerms = updated.PaymentTerms;
            entity.IsTaxExempt = updated.IsTaxExempt;
            await DbContext.SaveChangesAsync();
            Snackbar.Add("Customer updated", Severity.Success);
            await LoadData();
        }
    }

    private async Task Delete(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Confirm", "Delete this customer?", "Delete", "Cancel");
        if (confirm == true)
        {
            var entity = await DbContext.Customers.FindAsync(id);
            if (entity != null) { entity.IsDeleted = true; await DbContext.SaveChangesAsync(); await LoadData(); }
        }
    }
}
