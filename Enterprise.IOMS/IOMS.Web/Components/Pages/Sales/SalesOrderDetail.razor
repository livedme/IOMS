@page "/orders/sales/{Id:guid}"
@rendermode InteractiveServer
@inject IOrderService OrderService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Sales Order Detail - IOMS</PageTitle>

@if (_order == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudGrid>
        <MudItem xs="12">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Nav.NavigateTo("/orders/sales"))">Back to Orders</MudButton>
        </MudItem>
        <MudItem xs="12">
            <MudText Typo="Typo.h4">@_order.OrderNumber</MudText>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudField Label="Customer">@_order.CustomerName</MudField>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudField Label="Date">@_order.OrderDate.ToString("yyyy-MM-dd")</MudField>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudField Label="Status">
                <MudChip T="string" Color="Color.Info" Size="Size.Small">@_order.Status</MudChip>
            </MudField>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudField Label="Total">@_order.TotalAmount.ToString("C")</MudField>
        </MudItem>

        <MudItem xs="12">
            <MudTable Items="@_order.Items" Dense="true" Hover="true" Elevation="2">
                <HeaderContent>
                    <MudTh>Product</MudTh>
                    <MudTh>SKU</MudTh>
                    <MudTh Style="text-align:right">Qty</MudTh>
                    <MudTh Style="text-align:right">Shipped</MudTh>
                    <MudTh Style="text-align:right">Unit Price</MudTh>
                    <MudTh Style="text-align:right">Discount</MudTh>
                    <MudTh Style="text-align:right">Tax</MudTh>
                    <MudTh Style="text-align:right">Line Total</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ProductName</MudTd>
                    <MudTd>@context.ProductSKU</MudTd>
                    <MudTd Style="text-align:right">@context.Quantity</MudTd>
                    <MudTd Style="text-align:right">@context.ShippedQuantity</MudTd>
                    <MudTd Style="text-align:right">@context.UnitPrice.ToString("C")</MudTd>
                    <MudTd Style="text-align:right">@context.DiscountPercent%</MudTd>
                    <MudTd Style="text-align:right">@context.TaxAmount.ToString("C")</MudTd>
                    <MudTd Style="text-align:right">@context.LineTotal.ToString("C")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudItem>

        <MudItem xs="12">
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudField Label="Subtotal">@_order.SubTotal.ToString("C")</MudField>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudField Label="Tax">@_order.TaxAmount.ToString("C")</MudField>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudField Label="Discount">@_order.DiscountAmount.ToString("C")</MudField>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudField Label="Freight">@_order.FreightAmount.ToString("C")</MudField>
                </MudItem>
            </MudGrid>
        </MudItem>

        @if (!string.IsNullOrWhiteSpace(_order.Notes))
        {
            <MudItem xs="12">
                <MudField Label="Notes">@_order.Notes</MudField>
            </MudItem>
        }
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private SalesOrderDto? _order;

    protected override async Task OnInitializedAsync()
    {
        try { _order = await OrderService.GetSalesOrderById(Id); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
