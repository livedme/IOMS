    private async Task OpenCreate()
    {      
        var parameters = new DialogParameters<BrancheDialog>
        {
            { x => x.Branch, _branche }
        };

        var dialog = await DialogService.ShowAsync<BrancheDialog>("New Branch", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = false });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateBranchDto dto)
        {
            try
            {
                var branchId = await BranchService.CreateBranch(dto);
                Snackbar.Add("Branch created successfully", Severity.Success);
                await LoadBranches ();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

