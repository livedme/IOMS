@page "/orders/sales"
@rendermode InteractiveServer
@inject IOrderService OrderService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@using IOMS.Infrastructure.Data
@inject ApplicationDbContext DbContext

<PageTitle>Sales - IOMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Sales</MudText>

<MudPaper Elevation="2" Class="pa-4">
    <MudGrid Class="mb-3">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_search" Placeholder="Search sales..." Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="300"
                          OnDebounceIntervalElapsed="LoadOrders" ShrinkLabel="true" Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T=OrderStatus? Value="@_statusFilter" Placeholder="Select status" Clearable="true"
                       ValueChanged="OnStatusFilterChanged" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var status in Enum.GetValues<OrderStatus>())
                {
                    if (OrderStatus.Pending == status || OrderStatus.Approved == status) continue;

                    <MudSelectItem Value="@((OrderStatus?)status)">@status</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreate">New Sale</MudButton>
        </MudItem>
    </MudGrid>

    <MudTable Items="@_orders.Items" Dense="true" Hover="true" Striped="true" Loading="@_loading" Class="mt-4"
              Elevation="0">
        <HeaderContent>
            <MudTh>Order #</MudTh>
            <MudTh>Customer</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align:right">Total</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.OrderNumber</MudTd>
            <MudTd>@context.Customer.Name</MudTd>
            <MudTd>@context.OrderDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd>
                <MudChip T="string" Color="@CommonUtility.GetStatusColor(context.Status)" Size="Size.Small">
                    @context.Status</MudChip>
                </MudTd>
                <MudTd Style="text-align:right">@context.TotalAmount.ToString("C")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Info"
                                   OnClick="@(() => ViewOrder(context.Id))" />
                    @if (context.Status == OrderStatus.Pending)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                                       OnClick="@(() => Approve(context.Id))" />
                    }
                    @if (context.Status != OrderStatus.Cancelled && context.Status != OrderStatus.Delivered)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => OpenEdit(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => Cancel(context.Id))" />
                    }
                    @if (context.Status == OrderStatus.Cancelled)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Title="Delete"
                                       OnClick="@(() => DeleteOrder(context.Id))" />
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>

@code {
    private PagedResult<SalesOrderDto> _orders = new(new(), 0, 1, 25);
    private string _search = "";
    private List<OrderStatus?> _statusFilters = new() {
        OrderStatus.Sold,
                OrderStatus.Packed,
                OrderStatus.Shipped,
                OrderStatus.PartiallyShipped,
                OrderStatus.Delivered,
                OrderStatus.Cancelled };
    private OrderStatus? _statusFilter;
    private bool _loading = true;
    private int _page = 1;

    protected override async Task OnInitializedAsync() => await LoadOrders();

    private async Task LoadOrders()
    {
        _loading = true;
        try { _orders = await OrderService.GetSalesOrders(_search, _statusFilters, _page, 25); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _loading = false;
    }

    private async Task OnStatusFilterChanged(OrderStatus? status)
    {
        if (status.HasValue)
        {
            _statusFilters.Clear();
            _statusFilters.Add(status.Value);
        }
        else
        {
            _statusFilters = new() {
                OrderStatus.Sold,
                OrderStatus.Packed,
                OrderStatus.Shipped,
                OrderStatus.PartiallyShipped,
                OrderStatus.Delivered,
                OrderStatus.Cancelled
            };
        }
        await LoadOrders();
    }

    private async Task Approve(Guid id)
    {
        try
        {
            await OrderService.ApproveOrder(id);
            Snackbar.Add("Order approved successfully", Severity.Success);
            await LoadOrders();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Cancel(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Cancel Sales", "Are you sure?", "Yes, Cancel", "No");
        if (confirm == true)
        {
            try
            {
                await OrderService.CancelOrder(id, "Cancelled by user");
                Snackbar.Add("Sales cancelled", Severity.Warning);
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task ViewOrder(Guid id) => Nav.NavigateTo($"/orders/sales/{id}");

    private async Task OpenEdit(SalesOrderDto order)
    {
        var customers = await DbContext.Customers.Where(c => c.IsActive).OrderBy(c => c.Name).ToListAsync();
        var products = await DbContext.Products.OrderBy(p => p.Name).ToListAsync();

        var editModel = new CreateSalesOrderDtoModels
        {
            BranchId = order.BranchId ?? Guid.Empty,
            SalesDate = order.OrderDate,
            Naration = order.Naration,
            Chalan = order.Chalan,
            Notes = order.Notes,
            SubTotal = order.SubTotal,
            LabourCharge = order.LabourCharge,
            TruckCharge = order.TruckCharge,
            TaxAmount = order.TaxAmount,
            DiscountAmount = order.DiscountAmount,
            DiscountType = order.DiscountType,
            TotalAmount = order.TotalAmount,
            PaidAmount = order.PaidAmount,
            DueAmount = order.DueAmount,
            SelectedCustomer = new FilterItem(order.CustomerId, order.Customer.Name, false),
            Items = order.Items.Select(i => new CreateSalesOrderItemDto(
                i.ProductId, i.Quantity, i.UnitPrice, i.DiscountAmount, i.DiscountType, i.TotalDiscount, i.LineTotalPrice, null, null
            )).ToList()
        };

        var parameters = new DialogParameters<SalesOrderDialog>
        {
            { x => x.Customers, customers.Select(c => new CustomerDto(c.Id, c.Name, c.Email, c.Phone, c.Address, c.City, c.Zila,
c.State, c.Country, c.PostalCode, c.CreditLimit, c.PaymentTerms, c.IsActive, c.IsTaxExempt)).ToList() },
            { x => x.Products, products.Select(p => (p.Id, p.Name, p.SKU, p.SellingPrice)).ToList() },
            { x => x.dataModel, editModel }
        };

        var dialog = await DialogService.ShowAsync<SalesOrderDialog>($"Edit Sale #{order.OrderNumber}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateSalesOrderDto dto)
        {
            try
            {
                await OrderService.UpdateSalesOrder(order.Id, dto);
                Snackbar.Add("Sales order updated", Severity.Success);
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task OpenCreate()
    {
        var customers = await DbContext.Customers.Where(c => c.IsActive).OrderBy(c => c.Name).ToListAsync();
        var products = await DbContext.Products.OrderBy(p => p.Name).ToListAsync();

        var parameters = new DialogParameters<SalesOrderDialog>
        {
            { x => x.Customers, customers.Select(c => new CustomerDto(c.Id, c.Name,c.Email,c.Phone,c.Address,c.City,c.Zila,
c.State,c.Country,c.PostalCode,c.CreditLimit,c.PaymentTerms, c.IsActive, c.IsTaxExempt)).ToList() },
            { x => x.Products, products.Select(p => (p.Id, p.Name, p.SKU, p.SellingPrice)).ToList() }
        };

        var dialog = await DialogService.ShowAsync<SalesOrderDialog>("New Sales", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateSalesOrderDto dto)
        {
            try
            {
                var orderId = await OrderService.CreateSalesOrder(dto);
                Snackbar.Add("Sales created successfully", Severity.Success);
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task DeleteOrder(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Delete Sales Order",
            "This will permanently delete the sales order. Continue?", "Yes, Delete", "No");
        if (confirm == true)
        {
            try
            {
                await OrderService.DeleteSalesOrder(id);
                Snackbar.Add("Sales order deleted", Severity.Success);
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

}
