@page "/orders/sales"
@rendermode InteractiveServer
@inject IOrderService OrderService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@using IOMS.Infrastructure.Data
@inject ApplicationDbContext DbContext

<PageTitle>Sales - IOMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Sales</MudText>

<MudPaper Elevation="2" Class="pa-4">
    <MudGrid Class="mb-3">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_search" Placeholder="Search sales..." Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="300"
                          OnDebounceIntervalElapsed="LoadOrders" ShrinkLabel="true" Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T=OrderStatus? Value="@_statusFilter" Placeholder="Select status" Clearable="true"
                       ValueChanged="OnStatusFilterChanged" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var status in Enum.GetValues<OrderStatus>())
                {
                    if (OrderStatus.Pending == status || OrderStatus.Approved == status) continue;

                    <MudSelectItem Value="@((OrderStatus?)status)">@status</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreate">New Sale</MudButton>
        </MudItem>
    </MudGrid>

    <MudTable Items="@_orders.Items" Dense="true" Hover="true" Striped="true" Loading="@_loading" Class="mt-4"
              Elevation="0">
        <HeaderContent>
            <MudTh>Order #</MudTh>
            <MudTh>Customer</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align:right">Total</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.OrderNumber</MudTd>
            <MudTd>@context.Customer.CustomerName</MudTd>
            <MudTd>@context.OrderDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd>
                <MudChip T="string" Color="@CommonUtility.GetStatusColor(context.Status)" Size="Size.Small">
                    @context.Status</MudChip>
                </MudTd>
                <MudTd Style="text-align:right">@context.TotalAmount.ToString("C")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Info"
                                   OnClick="@(() => ViewOrder(context.Id))" />
                    @if (context.Status == OrderStatus.Pending)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success"
                                       OnClick="@(() => Approve(context.Id))" />
                    }
                    @if (context.Status != OrderStatus.Cancelled && context.Status != OrderStatus.Delivered)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => OpenEdit(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => Cancel(context.Id))" />
                    }
                    @if (context.Status == OrderStatus.Cancelled)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Title="Delete"
                                       OnClick="@(() => DeleteOrder(context.Id))" />
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>

    @* ─── Right-side Slider Drawer ─── *@
<MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.End" Elevation="16" Variant="DrawerVariant.Temporary" Width="1150px" CloseOnOverlayClick="true" Class="bg-light-subtle text-black">

        <div class="d-flex align-center justify-space-between px-4"
             style="min-height:56px;border-bottom:1px solid #e0e0e0;">
            <MudText Typo="Typo.h6">@_drawerTitle</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseDrawer" />
        </div>

        <div style="overflow-y:auto;height:calc(100vh - 56px);padding:16px;">

            @* ── VIEW mode ── *@
            @if (_drawerMode == SliderMode.View)
            {
                @if (_viewOrder == null)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else
                {
                    <div class="info-card mb-4">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="text-muted small">Customer</div>
                                <strong>@_viewOrder.Customer?.CustomerName</strong><br />
                                <span class="small">@_viewOrder.Customer?.CustomerPhone</span><br />
                                <span class="small">@_viewOrder.Customer?.CustomerEmail</span>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted small">Order Date</div>
                                <strong>@_viewOrder.OrderDate.ToString("dd-MMM-yyyy")</strong>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted small">Status</div>
                                <MudChip T="string" Color="@CommonUtility.GetStatusColor(_viewOrder.Status)" Size="Size.Small">
                                    @_viewOrder.Status
                                </MudChip>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted small">Branch</div>
                                <strong>@_viewOrder.Branch?.Name</strong><br />
                                <span class="small">@_viewOrder.Branch?.Location</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-lg-8">
                            <MudTable Items="@_viewOrder.Items" Dense="true" Hover="true" Elevation="2">
                                <HeaderContent>
                                    <MudTh>#</MudTh>
                                    <MudTh>Product</MudTh>
                                    <MudTh>SKU</MudTh>
                                    <MudTh Style="text-align:right">Qty</MudTh>
                                    <MudTh Style="text-align:right">Unit Price</MudTh>
                                    <MudTh Style="text-align:right">Discount</MudTh>
                                    <MudTh Style="text-align:right">Total</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@(_viewOrder.Items.IndexOf(context) + 1)</MudTd>
                                    <MudTd>@context.ProductName</MudTd>
                                    <MudTd>@context.ProductSKU</MudTd>
                                    <MudTd Style="text-align:right">@context.Quantity</MudTd>
                                    <MudTd Style="text-align:right">@context.UnitPrice.ToString("C")</MudTd>
                                    <MudTd Style="text-align:right">@context.TotalDiscount.ToString("C")</MudTd>
                                    <MudTd Style="text-align:right">@context.LineTotalPrice.ToString("C")</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                        <div class="col-lg-4">
                            <div class="summary-card">
                                <h6 class="text-primary mb-3">ORDER SUMMARY</h6>
                                <div class="summary-item"><span>Subtotal</span><strong>@_viewOrder.SubTotal.ToString("C")</strong>
                                </div>
                                <div class="summary-item">
                                    <span>Discount</span><strong>@_viewOrder.DiscountAmount.ToString("C")</strong></div>
                                    <div class="summary-item"><span>Tax</span><strong>@_viewOrder.TaxAmount.ToString("C")</strong></div>
                                    <div class="summary-item"><span>Labour</span><strong>@_viewOrder.LabourCharge.ToString("C")</strong>
                                    </div>
                                    <div class="summary-item"><span>Truck</span><strong>@_viewOrder.TruckCharge.ToString("C")</strong>
                                    </div>
                                    <div class="pt-3 border-top mt-2">
                                        <div class="d-flex justify-content-between">
                                            <strong>TOTAL</strong>
                                            <span class="text-primary fw-bold fs-5">@_viewOrder.TotalAmount.ToString("C")</span>
                                        </div>
                                        <div class="d-flex justify-content-between mt-1">
                                            <span class="text-muted">Paid</span>
                                            <span class="text-success fw-semibold">@_viewOrder.PaidAmount.ToString("C")</span>
                                        </div>
                                        <div class="d-flex justify-content-between mt-1">
                                            <span class="text-muted">Due</span>
                                            <span class="text-danger fw-semibold">@_viewOrder.DueAmount.ToString("C")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_viewOrder.Notes))
                        {
                            <MudField Label="Notes" Class="mt-3">@_viewOrder.Notes</MudField>
                        }

                        <div class="d-flex gap-2 mt-4">
                            @if (_viewOrder.Status == OrderStatus.Pending)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle"
                                           OnClick="@(() => ApproveAndRefresh(_viewOrder.Id))">Approve</MudButton>
                            }
                            @if (_viewOrder.Status != OrderStatus.Cancelled && _viewOrder.Status != OrderStatus.Delivered)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                                           OnClick="@(() => SwitchToEdit(_viewOrder))">Edit</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel"
                                           OnClick="@(() => CancelFromDrawer(_viewOrder.Id))">Cancel Order</MudButton>
                            }
                        </div>
                    }
                }

            </div>
        </MudDrawer>

        <style>
            .info-card {
                border: 1px solid #dee2e6;
                border-radius: 12px;
                padding: 20px;
                background: #fff;
            }

            .summary-card {
                border: 1px solid #dee2e6;
                border-radius: 12px;
                padding: 20px;
                background: #fff;
            }

            .summary-item {
                display: flex;
                justify-content: space-between;
                padding: 8px 0;
                border-bottom: 1px solid #e9ecef;
                font-size: .9rem;
            }
        </style>

@code {
    // ─── List state ───
    private PagedResult<SalesOrderDto> _orders = new(new(), 0, 1, 25);
    private string _search = "";
    private List<OrderStatus?> _statusFilters = new() {
        OrderStatus.Sold, OrderStatus.Packed, OrderStatus.Shipped,
        OrderStatus.PartiallyShipped, OrderStatus.Delivered, OrderStatus.Cancelled };
    private OrderStatus? _statusFilter;
    private bool _loading = true;
    private int _page = 1;

    // ─── Drawer state ───
    private enum SliderMode { View, Edit, Create }
    private bool _drawerOpen;
    private SliderMode _drawerMode = SliderMode.View;
    private string _drawerTitle = "";
    private SalesOrderDto? _viewOrder;
    private SalesOrderDto? _editingOrder;
    private CreateSalesOrderDtoModels _editModel = new();
    private List<CustomerDto> _drawerCustomers = new();
    private List<(Guid Id, string Name, string SKU, decimal Price)> _drawerProducts = new();
    private int _drawerKey;

    protected override async Task OnInitializedAsync() => await LoadOrders();

    private async Task LoadOrders()
    {
        _loading = true;
        try { _orders = await OrderService.GetSalesOrders(_search, _statusFilters, _page, 25); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _loading = false;
    }

    private async Task OnStatusFilterChanged(OrderStatus? status)
    {
        if (status.HasValue)
        {
            _statusFilters.Clear();
            _statusFilters.Add(status.Value);
        }
        else
        {
            _statusFilters = new() {
                OrderStatus.Sold, OrderStatus.Packed, OrderStatus.Shipped,
                OrderStatus.PartiallyShipped, OrderStatus.Delivered, OrderStatus.Cancelled
            };
        }
        await LoadOrders();
    }

    private async Task Approve(Guid id)
    {
        try
        {
            await OrderService.ApproveOrder(id);
            Snackbar.Add("Order approved successfully", Severity.Success);
            await LoadOrders();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ApproveAndRefresh(Guid id)
    {
        await Approve(id);
        CloseDrawer();
    }

    private async Task Cancel(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Cancel Sales", "Are you sure?", "Yes, Cancel", "No");
        if (confirm == true)
        {
            try
            {
                await OrderService.CancelOrder(id, "Cancelled by user");
                Snackbar.Add("Sales cancelled", Severity.Warning);
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task CancelFromDrawer(Guid id)
    {
        await Cancel(id);
        if (_drawerOpen && _viewOrder?.Id == id)
            _viewOrder = await OrderService.GetSalesOrderById(id);
    }

    // ─── Drawer helpers ───
    private void CloseDrawer() => _drawerOpen = false;

    private async Task ViewOrder(Guid id)
    {
        _viewOrder = null;
        _drawerTitle = "Loading\u2026";
        _drawerMode = SliderMode.View;
        _drawerOpen = true;
        try
        {
            _viewOrder = await OrderService.GetSalesOrderById(id);
            _drawerTitle = $"Sale #{_viewOrder?.OrderNumber}";
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task SwitchToEdit(SalesOrderDto order)
    {
        CloseDrawer();
        await OpenEdit(order);
    }

    private async Task OpenEdit(SalesOrderDto order)
    {
        await LoadDrawerFormData(order);
        await ShowSalesOrderDialog($"Edit Sale #{order.OrderNumber}");
    }

    private async Task LoadDrawerFormData(SalesOrderDto order)
    {
        var customers = await DbContext.Customers.Where(c => c.IsActive).OrderBy(c => c.CustomerName).ToListAsync();
        var products = await DbContext.Products.OrderBy(p => p.Name).ToListAsync();

        _drawerCustomers = customers.Select(c => new CustomerDto(c.Id, c.CustomerName, c.CustomerEmail, c.CustomerPhone,"","","", c.Address,
            c.City, c.Zila, c.State, c.Country, c.PostalCode, c.CreditLimit, c.PaymentTerms, c.IsActive, c.IsTaxExempt)).ToList();
        _drawerProducts = products.Select(p => (p.Id, p.Name, p.SKU, p.SellingPrice)).ToList();

        _editModel = new CreateSalesOrderDtoModels
        {
            BranchId = order.BranchId ?? Guid.Empty,
            SalesDate = order.OrderDate,
            Naration = order.Naration,
            Chalan = order.Chalan,
            Notes = order.Notes,
            SubTotal = order.SubTotal,
            LabourCharge = order.LabourCharge,
            TruckCharge = order.TruckCharge,
            TaxAmount = order.TaxAmount,
            DiscountAmount = order.DiscountAmount,
            DiscountType = order.DiscountType,
            TotalAmount = order.TotalAmount,
            PaidAmount = order.PaidAmount,
            DueAmount = order.DueAmount,
            SelectedCustomer = new FilterItem(order.CustomerId, order.Customer.CustomerName, false),
            Items = order.Items.Select(i => new CreateSalesOrderItemDto(
                i.ProductId, i.Quantity, i.UnitPrice, i.DiscountAmount, i.DiscountType,
                i.TotalDiscount, i.LineTotalPrice, null, null)).ToList()
        };

        _editingOrder = order;
        _drawerMode = SliderMode.Edit;
        _drawerKey++;
    }

    private async Task OpenCreate()
    {
        var customers = await DbContext.Customers.Where(c => c.IsActive).OrderBy(c => c.CustomerName).AsNoTracking().ToListAsync();
        var products = await DbContext.Products.OrderBy(p => p.Name).ToListAsync();

        _drawerCustomers = customers.Select(c => new CustomerDto(c.Id, c.CustomerName, c.CustomerEmail, c.CustomerPhone,"","","", c.Address,
            c.City, c.Zila, c.State, c.Country, c.PostalCode, c.CreditLimit, c.PaymentTerms, c.IsActive, c.IsTaxExempt)).ToList();
        _drawerProducts = products.Select(p => (p.Id, p.Name, p.SKU, p.SellingPrice)).ToList();

        _editModel = new CreateSalesOrderDtoModels();
        _editingOrder = null;
        _drawerMode = SliderMode.Create;
        _drawerKey++;
        await ShowSalesOrderDialog("New Sale");
    }

    private async Task ShowSalesOrderDialog(string title)
    {
        var parameters = new DialogParameters<SalesOrderDialog>
        {
            { x => x.Customers, _drawerCustomers },
            { x => x.Products, _drawerProducts },
            { x => x.dataModel, _editModel },
            { x => x.OnSubmit, EventCallback.Factory.Create<CreateSalesOrderDto>(this, HandleFormSubmit) },
            { x => x.OnSubmitAndPrint, EventCallback.Factory.Create<CreateSalesOrderDto>(this, HandleFormSubmitAndPrint) },
            { x => x.OnCancel, EventCallback.Factory.Create(this, CloseDialog) }
        };

        var dialog = await DialogService.ShowAsync<SalesOrderDialog>(title, parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Large,                
                FullWidth = true,
                CloseOnEscapeKey = true
            });

        await dialog.Result;
    }

    private Task CloseDialog() => Task.CompletedTask;

    private async Task HandleFormSubmit(CreateSalesOrderDto dto)
    {
        try
        {
            if (_drawerMode == SliderMode.Edit && _editingOrder != null)
            {
                await OrderService.UpdateSalesOrder(_editingOrder.Id, dto);
                Snackbar.Add("Sales order updated", Severity.Success);
            }
            else
            {
                await OrderService.CreateSalesOrder(dto);
                Snackbar.Add("Sales created successfully", Severity.Success);
            }
            await LoadOrders();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task HandleFormSubmitAndPrint(CreateSalesOrderDto dto)
    {
        await HandleFormSubmit(dto);
        // Print support can be added here
    }

    private async Task DeleteOrder(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Delete Sales Order",
            "This will permanently delete the sales order. Continue?", "Yes, Delete", "No");
        if (confirm == true)
        {
            try
            {
                await OrderService.DeleteSalesOrder(id);
                Snackbar.Add("Sales order deleted", Severity.Success);
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }
}

