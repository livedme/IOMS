@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_supplierId" Label="Supplier" Required="true">
                    @foreach (var s in Suppliers)
                    {
                        <MudSelectItem Value="@s.Id">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_notes" Label="Notes" />
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.h6" Class="mt-4 mb-2">Order Items</MudText>

        <MudTable Items="@_items" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>Product</MudTh>
                <MudTh>Qty</MudTh>
                <MudTh>Unit Price</MudTh>
                <MudTh>Line Total</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@Products.FirstOrDefault(p => p.Id == context.ProductId).Name</MudTd>
                <MudTd>@context.Quantity</MudTd>
                <MudTd>@context.UnitPrice.ToString("C")</MudTd>
                <MudTd>@((context.UnitPrice * context.Quantity).ToString("C"))</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => _items.Remove(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>

        <MudGrid Class="mt-3">
            <MudItem xs="12" sm="4">
                <MudSelect @bind-Value="_newProductId" Label="Product">
                    @foreach (var p in Products)
                    {
                        <MudSelectItem Value="@p.Id">@p.Name (@p.SKU)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField @bind-Value="_newQty" Label="Qty" Min="1" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField @bind-Value="_newPrice" Label="Price" Format="N2" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddItem" Class="mt-2">Add</MudButton>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.h6" Class="mt-4" Align="Align.Right">
            Total: @_items.Sum(i => i.UnitPrice * i.Quantity).ToString("C")
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!_items.Any())">
            Create PO
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<(Guid Id, string Name)> Suppliers { get; set; } = new();
    [Parameter] public List<(Guid Id, string Name, string SKU, decimal Price)> Products { get; set; } = new();

    private Guid _supplierId;
    private string? _notes;
    private List<CreatePurchaseOrderItemDto> _items = new();

    private Guid _newProductId;
    private int _newQty = 1;
    private decimal _newPrice;

    protected override void OnInitialized()
    {
        if (Suppliers.Count > 0) _supplierId = Suppliers.First().Id;
        if (Products.Count > 0) { _newProductId = Products.First().Id; _newPrice = Products.First().Price; }
    }

    private void AddItem()
    {
        if (_newProductId == Guid.Empty || _newQty <= 0) return;
        _items.Add(new CreatePurchaseOrderItemDto(_newProductId, _newQty, _newPrice, null));
        _newQty = 1;
        if (Products.Count > 0) { _newProductId = Products.First().Id; _newPrice = Products.First().Price; }
    }

    private void Cancel() => MudDialog.Cancel();
    private void Submit() => MudDialog.Close(DialogResult.Ok(
        new CreatePurchaseOrderDto(_supplierId, null, _notes, null, null, _items)));
}
