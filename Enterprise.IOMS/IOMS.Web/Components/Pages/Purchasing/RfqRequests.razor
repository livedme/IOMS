@page "/quotes/rfq"
@rendermode InteractiveServer
@inject IRfqService RfqService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>RFQ Requests</PageTitle>
<MudText Typo="Typo.h4" Class="mb-4">Request for Quotation (RFQ)</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="_search" Label="Search" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                          OnKeyUp="@(async _ => await LoadData())" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect @bind-Value="_statusFilter" Label="Status" Clearable="true">
                @foreach (RfqStatus s in Enum.GetValues<RfqStatus>())
                {
                    <MudSelectItem Value="@((RfqStatus?)s)">@s</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="OpenCreate" StartIcon="@Icons.Material.Filled.Add">New RFQ</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="_rfqs" Hover="true" Striped="true" Loading="_loading">
    <HeaderContent>
        <MudTh>RFQ #</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Required Date</MudTh>
        <MudTh>Items</MudTh>
        <MudTh>Responses</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="RFQ #">@context.RfqNumber</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Color="@CommonUtility.GetStatusColor(context.Status)">@context.Status</MudChip>
        </MudTd>
        <MudTd DataLabel="Required Date">@(context.RequiredDate?.ToString("yyyy-MM-dd") ?? "-")</MudTd>
        <MudTd DataLabel="Items">@context.Items.Count</MudTd>
        <MudTd DataLabel="Responses">@context.SupplierResponses.Count</MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                           OnClick="@(() => Navigation.NavigateTo($"/quotes/rfq/{context.Id}"))" />
        </MudTd>
    </RowTemplate>
</MudTable>

<MudPagination Class="mt-4" Count="_totalPages" SelectedChanged="OnPageChanged" Selected="_page" />

@code {
    private List<RfqRequestDto> _rfqs = new();
    private string? _search;
    private RfqStatus? _statusFilter;
    private int _page = 1;
    private int _totalPages = 1;
    private bool _loading;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var result = await RfqService.GetRfqRequests(_search, _statusFilter, _page, 20);
            _rfqs = result.Items;
            _totalPages = result.TotalPages;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task OpenCreate()
    {
        var dialog = await DialogService.ShowAsync<RfqCreateDialog>("New RFQ",
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await LoadData();
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadData();
    }

}
