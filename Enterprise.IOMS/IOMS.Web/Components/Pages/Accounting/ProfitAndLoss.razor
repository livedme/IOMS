@page "/reports/profit-loss"
@rendermode InteractiveServer
@inject IAccountingService AccountingService
@inject ISnackbar Snackbar

<PageTitle>Profit & Loss - IOMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Profit & Loss Statement</MudText>

<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudDatePicker @bind-Date="_fromDate" Label="From" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker @bind-Date="_toDate" Label="To" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Generate" Class="mt-2">Generate</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_report != null)
{
    @* ── KPI Cards ── *@
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex align-center" Elevation="3" Style="border-left:4px solid var(--mud-palette-success);">
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Large" Class="mr-3" />
                <div><MudText Typo="Typo.body2" Color="Color.Secondary">Total Revenue</MudText>
                <MudText Typo="Typo.h5"><strong>@_report.TotalRevenue.ToString("C0")</strong></MudText></div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex align-center" Elevation="3" Style="border-left:4px solid var(--mud-palette-error);">
                <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Color="Color.Error" Size="Size.Large" Class="mr-3" />
                <div><MudText Typo="Typo.body2" Color="Color.Secondary">Total Expenses</MudText>
                <MudText Typo="Typo.h5"><strong>@_report.TotalExpenses.ToString("C0")</strong></MudText></div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex align-center" Elevation="3" Style="@($"border-left:4px solid {(_report.NetProfit >= 0 ? "var(--mud-palette-success)" : "var(--mud-palette-error)")};")">
                <MudIcon Icon="@(_report.NetProfit >= 0 ? Icons.Material.Filled.ThumbUp : Icons.Material.Filled.ThumbDown)"
                         Color="@(_report.NetProfit >= 0 ? Color.Success : Color.Error)" Size="Size.Large" Class="mr-3" />
                <div><MudText Typo="Typo.body2" Color="Color.Secondary">Net Profit</MudText>
                <MudText Typo="Typo.h5"><strong>@_report.NetProfit.ToString("C0")</strong></MudText></div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ── Charts ── *@
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="3">
                <MudText Typo="Typo.h6" Class="mb-2">Revenue vs Expenses</MudText>
                <MudChart T=double ChartType="ChartType.Bar" ChartSeries="@_pnlBarSeries"
                          XAxisLabels="@_pnlBarLabels" Width="100%" Height="300px" />
            </MudPaper>
        </MudItem>
        @if (_report.ExpenseLines.Any())
        {
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="3">
                    <MudText Typo="Typo.h6" Class="mb-2">Expense Breakdown</MudText>
                    <MudChart T=double T="double" ChartType="ChartType.Donut" InputData="@_expenseDonutData"
                              InputLabels="@_expenseDonutLabels" Width="100%" Height="300px" />
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    @if (_report.RevenueLines.Any())
    {
        <MudPaper Class="pa-4 mb-4" Elevation="3">
            <MudText Typo="Typo.h6" Class="mb-2">Revenue by Account</MudText>
            <MudChart T=double T="double" ChartType="ChartType.Bar" ChartSeries="@_revenueBarSeries"
                      XAxisLabels="@_revenueBarLabels" Width="100%" Height="250px" />
        </MudPaper>
    }

    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.h5" Class="mt-2" Color="Color.Success">Revenue</MudText>
        <MudTable Items="@_report.RevenueLines" Dense="true" Elevation="0" Class="mb-4">
            <HeaderContent>
                <MudTh>Code</MudTh>
                <MudTh>Account</MudTh>
                <MudTh Style="text-align:right">Amount</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.AccountCode</MudTd>
                <MudTd>@context.AccountName</MudTd>
                <MudTd Style="text-align:right">@context.Amount.ToString("C")</MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd ColSpan="2"><strong>Total Revenue</strong></MudTd>
                <MudTd Style="text-align:right"><strong>@_report.TotalRevenue.ToString("C")</strong></MudTd>
            </FooterContent>
        </MudTable>

        <MudText Typo="Typo.h5" Color="Color.Error">Expenses</MudText>
        <MudTable Items="@_report.ExpenseLines" Dense="true" Elevation="0" Class="mb-4">
            <HeaderContent>
                <MudTh>Code</MudTh>
                <MudTh>Account</MudTh>
                <MudTh Style="text-align:right">Amount</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.AccountCode</MudTd>
                <MudTd>@context.AccountName</MudTd>
                <MudTd Style="text-align:right">@context.Amount.ToString("C")</MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd ColSpan="2"><strong>Total Expenses</strong></MudTd>
                <MudTd Style="text-align:right"><strong>@_report.TotalExpenses.ToString("C")</strong></MudTd>
            </FooterContent>
        </MudTable>
    </MudPaper>
}

@code {
    private DateTime? _fromDate = new DateTime(DateTime.Today.Year, 1, 1);
    private DateTime? _toDate = DateTime.Today;
    private ProfitAndLossDto? _report;

    // Chart data
    private string[] _pnlBarLabels = { "Revenue", "Expenses", "Net Profit" };
    private List<ChartSeries<double>> _pnlBarSeries = new();
    private double[] _expenseDonutData = [];
    private string[] _expenseDonutLabels = [];
    private string[] _revenueBarLabels = [];
    private List<ChartSeries<double>> _revenueBarSeries = new();
    private async Task Generate()
    {
        try
        {
            _report = await AccountingService.GetProfitAndLoss(_fromDate ?? DateTime.Today.AddYears(-1), _toDate ?? DateTime.Today);

            // Revenue vs Expenses bar
            _pnlBarSeries = new List<ChartSeries<double>>
            {
                new() { Name = "Amount", Data = new double[] { (double)_report.TotalRevenue, (double)_report.TotalExpenses, (double)Math.Abs(_report.NetProfit) } }
            };

            // Expense breakdown donut
            var topExpenses = _report.ExpenseLines.OrderByDescending(e => e.Amount).Take(8).ToList();
            _expenseDonutLabels = topExpenses.Select(e => e.AccountName.Length > 18 ? e.AccountName[..18] + ".." : e.AccountName).ToArray();
            _expenseDonutData = topExpenses.Select(e => (double)e.Amount).ToArray();

            // Revenue bar
            _revenueBarLabels = _report.RevenueLines.Select(r => r.AccountName.Length > 15 ? r.AccountName[..15] + ".." : r.AccountName).ToArray();
            _revenueBarSeries = new List<ChartSeries<double>>
            {
                new() { Name = "Revenue", Data = _report.RevenueLines.Select(r => (double)r.Amount).ToArray() }
            };
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
