@page "/accounting/debit-notes"
@rendermode InteractiveServer
@inject ICreditDebitNoteService NoteService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Debit Notes</PageTitle>
<MudText Typo="Typo.h4" Class="mb-4">Debit Notes</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="8">
            <MudTextField @bind-Value="_search" Label="Search" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                          OnKeyUp="@(async _ => await LoadData())" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="CreateNote" StartIcon="@Icons.Material.Filled.Add">New Debit Note</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="_notes" Hover="true" Striped="true" Loading="_loading">
    <HeaderContent>
        <MudTh>Debit Note #</MudTh>
        <MudTh>Invoice #</MudTh>
        <MudTh>Date</MudTh>
        <MudTh>Amount</MudTh>
        <MudTh>Reason</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Debit Note #">@context.DebitNoteNumber</MudTd>
        <MudTd DataLabel="Invoice #">@context.InvoiceNumber</MudTd>
        <MudTd DataLabel="Date">@context.Date.ToShortDateString()</MudTd>
        <MudTd DataLabel="Amount">@context.Amount.ToString("C")</MudTd>
        <MudTd DataLabel="Reason">@context.Reason</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Color="@(context.Status == DebitNoteStatus.Approved ? Color.Success : context.Status == DebitNoteStatus.Draft ? Color.Default : Color.Info)" Size="Size.Small">
                @context.Status
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Actions">
            @if (context.Status == DebitNoteStatus.Draft)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small"
                               OnClick="@(() => ApproveNote(context.Id))" Title="Approve" />
            }
        </MudTd>
    </RowTemplate>
</MudTable>

<MudPagination Class="mt-4" Count="_totalPages" SelectedChanged="OnPageChanged" Selected="_page" />

@code {
    private List<DebitNoteDto> _notes = new();
    private string? _search;
    private int _page = 1;
    private int _totalPages = 1;
    private bool _loading;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var result = await NoteService.GetDebitNotes(_search, _page, 20);
            _notes = result.Items;
            _totalPages = result.TotalPages;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task CreateNote()
    {
        var dialog = await DialogService.ShowAsync<DebitNoteDialog>("New Debit Note",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await LoadData();
    }

    private async Task ApproveNote(Guid id)
    {
        try
        {
            await NoteService.ApproveDebitNote(id);
            Snackbar.Add("Debit note approved.", Severity.Success);
            await LoadData();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadData();
    }
}
