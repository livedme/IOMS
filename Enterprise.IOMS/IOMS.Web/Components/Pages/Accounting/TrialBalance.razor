@page "/reports/trial-balance"
@rendermode InteractiveServer
@inject IAccountingService AccountingService
@inject ISnackbar Snackbar

<PageTitle>Trial Balance - IOMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Trial Balance</MudText>

<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudDatePicker @bind-Date="_asOfDate" Label="As Of Date" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Generate" Class="mt-2">
                Generate
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_report != null)
{
    @* ── KPI Cards ── *@
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex align-center" Elevation="3" Style="border-left:4px solid var(--mud-palette-primary);">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Primary" Size="Size.Large" Class="mr-3" />
                <div><MudText Typo="Typo.body2" Color="Color.Secondary">Total Debits</MudText>
                <MudText Typo="Typo.h5"><strong>@_report.TotalDebits.ToString("C0")</strong></MudText></div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex align-center" Elevation="3" Style="border-left:4px solid var(--mud-palette-success);">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Success" Size="Size.Large" Class="mr-3" />
                <div><MudText Typo="Typo.body2" Color="Color.Secondary">Total Credits</MudText>
                <MudText Typo="Typo.h5"><strong>@_report.TotalCredits.ToString("C0")</strong></MudText></div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex align-center" Elevation="3" Style="@($"border-left:4px solid {(_report.TotalDebits == _report.TotalCredits ? "var(--mud-palette-success)" : "var(--mud-palette-error)")};")">
                <MudIcon Icon="@(_report.TotalDebits == _report.TotalCredits ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
                         Color="@(_report.TotalDebits == _report.TotalCredits ? Color.Success : Color.Error)" Size="Size.Large" Class="mr-3" />
                <div><MudText Typo="Typo.body2" Color="Color.Secondary">Balance</MudText>
                <MudText Typo="Typo.h5"><strong>@((_report.TotalDebits - _report.TotalCredits).ToString("C0"))</strong></MudText></div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* ── Charts ── *@
    <MudGrid Class="mb-4">
        @if (_acctTypeLabels.Length > 0)
        {
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="3">
                    <MudText Typo="Typo.h6" Class="mb-2">Debits vs Credits by Account Type</MudText>
                    <MudChart T=double ChartType="ChartType.Bar" ChartSeries="@_acctTypeSeries"
                              XAxisLabels="@_acctTypeLabels" Width="100%" Height="300px" />
                </MudPaper>
            </MudItem>
        }
        @if (_typeDistLabels.Length > 0)
        {
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="3">
                    <MudText Typo="Typo.h6" Class="mb-2">Balance Distribution by Type</MudText>
                    <MudChart T=double ChartType="ChartType.Donut" InputData="@_typeDistData"
                              InputLabels="@_typeDistLabels" Width="100%" Height="300px" />
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudPaper Elevation="2" Class="pa-4">
        <MudTable Items="@_report.Lines" Dense="true" Hover="true" Striped="true" Elevation="0">
            <HeaderContent>
                <MudTh>Code</MudTh>
                <MudTh>Account</MudTh>
                <MudTh>Type</MudTh>
                <MudTh Style="text-align:right">Debit</MudTh>
                <MudTh Style="text-align:right">Credit</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><strong>@context.AccountCode</strong></MudTd>
                <MudTd>@context.AccountName</MudTd>
                <MudTd>@context.AccountType</MudTd>
                <MudTd Style="text-align:right">@(context.Debit > 0 ? context.Debit.ToString("C") : "")</MudTd>
                <MudTd Style="text-align:right">@(context.Credit > 0 ? context.Credit.ToString("C") : "")</MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd ColSpan="3"><strong>Totals</strong></MudTd>
                <MudTd Style="text-align:right"><strong>@_report.TotalDebits.ToString("C")</strong></MudTd>
                <MudTd Style="text-align:right"><strong>@_report.TotalCredits.ToString("C")</strong></MudTd>
            </FooterContent>
        </MudTable>
    </MudPaper>
}

@code {
    private DateTime? _asOfDate = DateTime.Today;
    private TrialBalanceDto? _report;

    // Chart data
    private string[] _acctTypeLabels = [];
    private List<ChartSeries<double>> _acctTypeSeries = new();
    private string[] _typeDistLabels = [];
    private double[] _typeDistData = [];

    private async Task Generate()
    {
        try
        {
            _report = await AccountingService.GetTrialBalance(_asOfDate ?? DateTime.Today);

            // Group by account type
            var typeGroups = _report.Lines.GroupBy(l => l.AccountType.ToString()).ToList();
            _acctTypeLabels = typeGroups.Select(g => g.Key).ToArray();
            _acctTypeSeries = new List<ChartSeries<double>>
            {
                new() { Name = "Debits", Data = typeGroups.Select(g => (double)g.Sum(l => l.Debit)).ToArray() },
                new() { Name = "Credits", Data = typeGroups.Select(g => (double)g.Sum(l => l.Credit)).ToArray() }
            };

            // Balance by type donut
            var typeDist = typeGroups.Select(g => new {
                Type = g.Key,
                Balance = Math.Abs((double)g.Sum(l => l.Debit) - (double)g.Sum(l => l.Credit))
            }).Where(x => x.Balance > 0).ToList();
            _typeDistLabels = typeDist.Select(t => t.Type).ToArray();
            _typeDistData = typeDist.Select(t => t.Balance).ToArray();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
