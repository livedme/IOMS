@inject ITaxService TaxService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@(ExistingRate != null ? "Edit" : "Add") Tax Rate</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_name" Label="Tax Name" Required="true" />
            <MudTextField @bind-Value="_code" Label="Code" Required="true" Class="mt-3" />
            <MudNumericField @bind-Value="_rate" Label="Rate (%)" Min="0" Max="100" Format="N2" Required="true" Class="mt-3" />
            <MudSelect @bind-Value="_taxType" Label="Tax Type" Required="true" Class="mt-3">
                @foreach (TaxType t in Enum.GetValues<TaxType>())
                {
                    <MudSelectItem Value="@t">@t</MudSelectItem>
                }
            </MudSelect>
            <MudCheckBox @bind-Value="_isCompound" Label="Compound Tax" Class="mt-3" />
            <MudCheckBox @bind-Value="_isActive" Label="Active" Class="mt-1" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public TaxRateDto? ExistingRate { get; set; }
    private MudForm _form = null!;

    private string _name = "", _code = "";
    private decimal _rate = 0;
    private TaxType _taxType = TaxType.VAT;
    private bool _isCompound = false, _isActive = true;

    protected override void OnParametersSet()
    {
        if (ExistingRate != null)
        {
            _name = ExistingRate.Name;
            _rate = ExistingRate.Rate;
            _taxType = ExistingRate.TaxType;
            _isActive = ExistingRate.IsActive;
        }
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (!_form.IsValid) return;
        try
        {
            var dto = new CreateTaxRateDto(_name, _code, _rate, _taxType, _isCompound, _isActive);
            if (ExistingRate != null)
                await TaxService.UpdateTaxRate(ExistingRate.Id, dto);
            else
                await TaxService.CreateTaxRate(dto);
            Snackbar.Add("Tax rate saved", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void Cancel() => MudDialog.Cancel();
}
