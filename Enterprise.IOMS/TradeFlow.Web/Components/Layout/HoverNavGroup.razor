@* Nav parent that opens its sub menu on hover. In the open menu it expands inline;
   in the collapsed icon rail it opens a floating flyout (inline expansion would be
   squeezed into 56px and clipped by the rail's scroll container). Click still toggles. *@
@implements IDisposable
@if (Rail)
{
    <div @onmouseenter="EnterFlyout" @onmouseleave="ScheduleCloseFlyout">
        <MudIconButton Icon="@Icon" Title="@Title" Size="Size.Medium" Style="color:#A3A3A3;" OnClick="ToggleFlyout" />
        <MudPopover Open="@_flyout" AnchorOrigin="Origin.CenterRight" TransformOrigin="Origin.CenterLeft" Elevation="8" Paper="true">
            <div class="pa-2" @onclick="CloseFlyout" @onmouseenter="CancelCloseFlyout" @onmouseleave="CloseFlyoutNow" style="min-width:230px;">
                <MudText Typo="Typo.subtitle2" Class="px-4 pt-2 pb-1" Style="font-weight:700;">@Title</MudText>
                @ChildContent
            </div>
        </MudPopover>
    </div>
}
else
{
    <div  class="left-nav-menu-item" @onmouseenter="Enter" @onmouseleave="Leave">
        <MudNavGroup Title="@Title" Icon="@Icon" @bind-Expanded="_open" Class="@Class">
            @ChildContent
        </MudNavGroup>
    </div>
}

@code {
    /// <summary>True while the left menu is collapsed to its icon rail (cascaded from the layout).</summary>
    [CascadingParameter(Name = "LeftMenuRail")] public bool Rail { get; set; }

    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _open;
    private bool _flyout;
    private CancellationTokenSource? _closeCts;

    private void Enter() => _open = true;

    private void Leave() => _open = false;

    private void EnterFlyout()
    {
        CancelCloseFlyout();
        _flyout = true;
    }

    private void ToggleFlyout()
    {
        CancelCloseFlyout();
        _flyout = !_flyout;
    }

    private void CloseFlyout()
    {
        CancelCloseFlyout();
        _flyout = false;
    }

    /// <summary>
    /// The flyout lives outside this hover zone (popover renders at body level), so moving
    /// from the icon to the flyout briefly leaves it. Delay the close; entering the flyout
    /// cancels it, which keeps the sub menu open while crossing the gap.
    /// </summary>
    private void ScheduleCloseFlyout()
    {
        CancelCloseFlyout();
        _closeCts = new CancellationTokenSource();
        var token = _closeCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(300, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(() =>
                {
                    _flyout = false;
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException) { }
        });
    }

    private void CancelCloseFlyout()
    {
        _closeCts?.Cancel();
        _closeCts?.Dispose();
        _closeCts = null;
    }

    private void CloseFlyoutNow()
    {
        CancelCloseFlyout();
        _flyout = false;
    }

    public void Dispose()
    {
        _closeCts?.Cancel();
        _closeCts?.Dispose();
    }
}
