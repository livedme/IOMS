@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject TradeFlow.Infrastructure.Services.TenantContext TenantContext

@* Wraps the routed page rather than sitting beside it. Blazor only guarantees that it awaits a
   *parent's* OnInitializedAsync before initialising that parent's children; two components rendered
   next to each other are initialised in render order with no ordering guarantee between them, and a
   sibling that yields (which GetAuthenticationStateAsync does whenever revalidation is in flight)
   lets the page's first query run first. TenantProvider fails closed on an unresolved tenant, so
   that race surfaces as a failed circuit rather than as wrong data. *@
@ChildContent

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Populates the circuit-scoped <see cref="TradeFlow.Infrastructure.Services.TenantContext"/>
    /// from the Blazor authentication state.
    /// </summary>
    /// <remarks>
    /// <c>IHttpContextAccessor.HttpContext</c> is <c>null</c> once a Blazor Server circuit is
    /// established, so the tenant has to be captured from the <c>AuthenticationStateProvider</c>
    /// once and held for the life of the circuit.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authenticationState.User;

        if (principal.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var tenantClaim = principal.FindFirst("TenantId")?.Value;
        if (!Guid.TryParse(tenantClaim, out var tenantId) || tenantId == Guid.Empty)
        {
            // Left unresolved on purpose. TenantProvider fails closed, so an authenticated user
            // without a valid tenant gets an error rather than another tenant's data.
            return;
        }

        TenantContext.Set(tenantId, principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value);
    }
}
