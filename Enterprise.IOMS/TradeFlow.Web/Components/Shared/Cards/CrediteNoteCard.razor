<!-- Credit & Debit Notes -->
@if (creditNotes.Count > 0)
{
    <div class="so-section-lbl mb-2" style="color:#2e7d32;font-weight:600;">Credit Notes (@creditNotes.Count)</div>
    @if (creditNotes.Count > 0)
    {
        <div class="so-items-wrapper mb-3">
            <MudTable Items="@creditNotes" Dense="true" Hover="true" Elevation="0" Class="so-items-table">
                <HeaderContent>
                    <MudTh>Note #</MudTh>
                    @if (IsParty)
                    {
                        <MudTh>Invoice #</MudTh>
                    }
                    <MudTh>Date</MudTh>
                    <MudTh>Reason</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align:right">Amount(@Taka.HIcon())</MudTh>                    
                </HeaderContent>
                <RowTemplate>
                    <MudTd><strong>@context.CreditNoteNumber</strong></MudTd>
                    @if(IsParty)
                    {
                        <MudTd>@context.InvoiceNumber</MudTd>
                    }
                    <MudTd>@context.Date.ToString("dd MMM yyyy")</MudTd>
                    <MudTd>@context.Reason</MudTd>                    
                    <MudTd><MudChip T="string" Size="Size.Small" Color="@CommonUtility.GetNoteStatusColor(context.Status.ToString())">@context.Status</MudChip></MudTd>
                    <MudTd Style="text-align:right;font-weight:600;">@context.Amount</MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    }
}

@code {
    [Parameter] public List<CreditNoteDto> creditNotes { get; set; } = new();
    [Parameter] public bool IsParty { get; set; }=false;
}