<div class="kpi-card" style="background:@(Gradient);">
    <div class="d-flex align-center justify-space-between">
        <div class="kpi-icon" style="background:@(IconColor);">
            <MudIcon Icon="@Icon" Size="Size.Small" Style="color:white;" />
        </div>
        <div class="kpi-label" style="color:@(LabelColor);">@Label</div>
    </div>
    <div>
        <div class="kpi-value" style="color:@(ValueColor);">@Value</div>
        <div class="kpi-trend" style="color:@(IsPositive ? "#0f5b2e" : "#991b1b");">
            <MudIcon Icon="@(IsPositive ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)" Size="Size.Small" Style="font-size:13px;" />
            @Math.Abs(Growth).ToString("0.0")% @TrendLabel
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter] public string IconColor { get; set; } = "#2563eb";
    [Parameter] public string Gradient { get; set; } = "linear-gradient(135deg,#a8c9ff 0%,#8fb8ff 100%);";
    [Parameter] public string ValueColor { get; set; } = "#0f2040";
    [Parameter] public string LabelColor { get; set; } = "#1e3a5f";
    [Parameter] public double Growth { get; set; }
    [Parameter] public bool IsPositive { get; set; } = true;
    [Parameter] public string TrendLabel { get; set; } = "vs last week";
}
