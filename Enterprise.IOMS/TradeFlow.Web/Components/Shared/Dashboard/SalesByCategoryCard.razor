<DashboardCardShell Title="Sales by Category" ViewAllHref="/products" ViewAllText="All Products" FillHeight="true">
    <div class="tm-list">
        @if (!Items.Any())
        {
            <div class="tm-panel-body">
                <MudAlert Severity="Severity.Info" Dense="true">No category data.</MudAlert>
            </div>
        }
        else
        {
            int rank = 1;
            decimal maxCat = Items.Max(c => c.Amount);
            foreach (var c in Items)
            {
                var color = GetCategoryColor(c.Category);
                var w = maxCat <= 0 ? 0 : (double)c.Amount / (double)maxCat * 100;
                <div class="tm-list-row">
                    <div class="tm-rank">@rank</div>
                    <div class="tm-list-ico" style="background:@color;">
                        <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Small" Style="font-size:15px; color:#fff;" />
                    </div>
                    <div class="tm-list-main">
                        <div class="tm-list-title" title="@c.Category">@c.Category</div>
                        <div class="tm-bar" style="margin-top:5px;">
                            <div class="tm-bar-fill" style="width:@w.ToString("0")%; background:@color;"></div>
                        </div>
                    </div>
                    <div class="tm-list-end">
                        <div class="tm-list-amt">@c.Amount.ToString("C0")</div>
                        <div class="tm-list-meta">@c.Percentage.ToString("0.0")% of sales</div>
                    </div>
                </div>
                rank++;
            }
        }
    </div>
</DashboardCardShell>

@code {
    [Parameter] public IReadOnlyList<SalesByCategoryDto> Items { get; set; } = Array.Empty<SalesByCategoryDto>();

    private static string GetCategoryColor(string cat) => cat switch
    {
        "Electronics" => "#3b82f6",
        "Fashion" => "#f59e0b",
        "Home & Living" => "#22c55e",
        "Home &amp; Living" => "#22c55e",
        "Health & Beauty" => "#a855f7",
        "Sports" => "#06b6d4",
        _ => "#94a3b8"
    };
}
