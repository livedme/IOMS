<div class="tm-stats">
    <TmStatTile Icon="💰" Number="@Kpis.TotalSales.ToString("C0")" Label="Total Sales" Tone="blue" Trend="@Kpis.TotalSalesGrowth" />
    <TmStatTile Icon="🛒" Number="@Kpis.TodaysSales.ToString("C0")" Label="Today's Sales" Tone="green" Trend="@Kpis.TodaysSalesGrowth" TrendSuffix=" vs yest." />
    <TmStatTile Icon="🧾" Number="@Kpis.TotalOrders.ToString("N0")" Label="Total Orders" Tone="purple" Trend="@Kpis.TotalOrdersGrowth" />
    <TmStatTile Icon="📈" Number="@Kpis.TotalProfit.ToString("C0")" Label="Total Profit" Tone="yellow" Trend="@Kpis.TotalProfitGrowth" />
    <TmStatTile Icon="📦" Number="@Kpis.InventoryValue.ToString("C0")" Label="Inventory Value" Tone="teal" Trend="@Kpis.InventoryValueGrowth" />
    <TmStatTile Icon="⚠" Number="@Kpis.LowStockItems.ToString()" Label="Low Stock Items" Tone="red" Trend="@Kpis.LowStockGrowth" />
</div>

@code {
    [Parameter, EditorRequired] public DashboardExtendedKpiDto Kpis { get; set; } = default!;
}
