@* Dashboard filter strip — date range, store and refresh. Quick actions live in the page header. *@
<div class="tm-card tm-filters">
    <div class="tm-select">
        <select value="@DateRange" @onchange="OnDateRangeChanged" title="Date range">
            <option value="Apr 29, 2025 - May 5, 2025">Apr 29, 2025 - May 5, 2025</option>
            <option value="Last 7 Days">Last 7 Days</option>
            <option value="Last 30 Days">Last 30 Days</option>
            <option value="This Month">This Month</option>
        </select>
    </div>

    <div class="tm-select">
        <select value="@StoreFilter" @onchange="OnStoreFilterChanged" title="Store">
            <option value="All Stores">All Stores</option>
            <option value="Dhaka">Dhaka</option>
            <option value="Chattogram">Chattogram</option>
            <option value="Sylhet">Sylhet</option>
            <option value="Khulna">Khulna</option>
        </select>
    </div>

    <button class="tm-reset" @onclick="OnRefresh" title="Reload dashboard data">⟳ Refresh</button>
</div>

@code {
    [Parameter] public string DateRange { get; set; } = "";
    [Parameter] public string StoreFilter { get; set; } = "";
    [Parameter] public EventCallback<string> DateRangeChanged { get; set; }
    [Parameter] public EventCallback<string> StoreFilterChanged { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private Task OnDateRangeChanged(ChangeEventArgs e) => DateRangeChanged.InvokeAsync(e.Value?.ToString() ?? "");
    private Task OnStoreFilterChanged(ChangeEventArgs e) => StoreFilterChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
