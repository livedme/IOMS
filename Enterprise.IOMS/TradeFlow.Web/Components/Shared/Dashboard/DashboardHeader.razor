@* Dashboard filter strip — date range, store and refresh. Quick actions live in the page header. *@
<div class="tm-card tm-filters">
    <div class="tm-select">
        <select value="@DateRange" @onchange="OnDateRangeChanged" title="Date range">
            @foreach (var option in DashboardRanges.Labels)
            {
                <option value="@option">@option</option>
            }
        </select>
    </div>

    <div class="tm-select">
        @* Options come from the tenant's real branches. This list used to be hard-coded to
           Dhaka / Chattogram / Sylhet / Khulna, which matched no actual data and silently
           filtered nothing. The comparison is explicit because a bare int would render
           disabled="0", which HTML still treats as disabled. *@
        <select value="@StoreFilter" @onchange="OnStoreFilterChanged" title="Store" disabled="@(Stores.Count == 0)">
            <option value="All Stores">All Stores</option>
            @foreach (var b in Stores)
            {
                <option value="@b">@b</option>
            }
        </select>
    </div>

    <button class="tm-reset" @onclick="OnRefresh" title="Reload dashboard data">⟳ Refresh</button>
</div>

@code {
    [Parameter] public string DateRange { get; set; } = DashboardRanges.DefaultLabel;
    [Parameter] public string StoreFilter { get; set; } = "All Stores";

    /// <summary>Branch names for the store selector, supplied by the page.</summary>
    [Parameter] public IReadOnlyList<string> Stores { get; set; } = Array.Empty<string>();

    [Parameter] public EventCallback<string> DateRangeChanged { get; set; }
    [Parameter] public EventCallback<string> StoreFilterChanged { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private Task OnDateRangeChanged(ChangeEventArgs e) => DateRangeChanged.InvokeAsync(e.Value?.ToString() ?? DashboardRanges.DefaultLabel);
    private Task OnStoreFilterChanged(ChangeEventArgs e) => StoreFilterChanged.InvokeAsync(e.Value?.ToString() ?? "All Stores");
}
