@inject NavigationManager Nav

<div class="dashboard-topbar">
    <div class="dashboard-title-wrap">
        <MudText Typo="Typo.h5" Style="font-weight:800; letter-spacing:-0.5px;">@Title</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-size:0.84rem;">@Subtitle</MudText>
    </div>

    <div class="dashboard-actions-panel">
        <div class="quick-actions-grid">
            @foreach (var a in Actions)
            {
                <div class="quick-btn" @onclick='() => Nav.NavigateTo(a.Href)'>
                    <div class="quick-icon" style="background:@a.Color;"><MudIcon Icon="@a.Icon" Size="Size.Small" /></div>
                    <span style="font-size:0.76rem; font-weight:700; color:#1e293b; line-height:1.1;">@a.Label</span>
                </div>
            }
        </div>

        <div class="filter-row my-5">
            <MudPaper Elevation="0" Class="d-flex align-center px-3 py-1" Style="border:1px solid #e2e8f0; border-radius:10px; background:#fff; height:36px;">
                <MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Size="Size.Small" Style="font-size:16px;" Class="mr-2" Color="Color.Secondary" />
                <MudSelect T="string" Value="@DateRange" ValueChanged="@OnDateRangeChangedAsync" Dense="true" Variant="Variant.Text" DisableUnderLine="true" Style="min-width:175px; font-size:0.84rem;">
                    <MudSelectItem Value="@("Apr 29, 2025 - May 5, 2025")">Apr 29, 2025 - May 5, 2025</MudSelectItem>
                    <MudSelectItem Value="@("Last 7 Days")">Last 7 Days</MudSelectItem>
                    <MudSelectItem Value="@("Last 30 Days")">Last 30 Days</MudSelectItem>
                    <MudSelectItem Value="@("This Month")">This Month</MudSelectItem>
                </MudSelect>
            </MudPaper>
            <MudPaper Elevation="0" Class="d-flex align-center px-3 py-1" Style="border:1px solid #e2e8f0; border-radius:10px; background:#fff; height:36px;">
                <MudIcon Icon="@Icons.Material.Outlined.Storefront" Size="Size.Small" Class="mr-2" Color="Color.Secondary" />
                <MudSelect T="string" Value="@StoreFilter" ValueChanged="@OnStoreFilterChangedAsync" Dense="true" Variant="Variant.Text" DisableUnderLine="true" Style="min-width:110px; font-size:0.84rem;">
                    <MudSelectItem Value="@("All Stores")">All Stores</MudSelectItem>
                    <MudSelectItem Value="@("Dhaka")">Dhaka</MudSelectItem>
                    <MudSelectItem Value="@("Chattogram")">Chattogram</MudSelectItem>
                    <MudSelectItem Value="@("Sylhet")">Sylhet</MudSelectItem>
                    <MudSelectItem Value="@("Khulna")">Khulna</MudSelectItem>
                </MudSelect>
            </MudPaper>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Dashboard";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string DateRange { get; set; } = "";
    [Parameter] public string StoreFilter { get; set; } = "";
    [Parameter] public EventCallback<string> DateRangeChanged { get; set; }
    [Parameter] public EventCallback<string> StoreFilterChanged { get; set; }

    private static readonly (string Label, string Icon, string Color, string Href)[] Actions =
    {
        ("New Sale",       Icons.Material.Outlined.PointOfSale,  "#10b981", "/orders/sales"),
        ("Add Product",    Icons.Material.Outlined.Add,          "#0ea5e9", "/products"),
        ("New Purchase",   Icons.Material.Outlined.ShoppingCart, "#8b5cf6", "/orders/purchase"),
        ("Add Customer",   Icons.Material.Outlined.GroupAdd,     "#f59e0b", "/customers"),
        ("Stock Transfer", Icons.Material.Outlined.SyncAlt,      "#14b8a6", "/inventory/transfers"),
        ("Generate Report",Icons.Material.Outlined.Description,  "#6366f1", "/reports/trial-balance")
    };

    private Task OnDateRangeChangedAsync(string v) => DateRangeChanged.InvokeAsync(v);
    private Task OnStoreFilterChangedAsync(string v) => StoreFilterChanged.InvokeAsync(v);
}
