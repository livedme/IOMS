@* Sales Overview card. Header, area plot and footer layout is shared with Purchase Overview so
   the two read identically; only the series, accent colour and footer labels differ. *@

<div class="tm-card tm-panel">
    <div class="tm-panel-head" style="align-items:flex-start;">
        <div>
            <span class="tm-panel-title" style="font-size:15px;">Sales Overview</span>
            <div class="tm-ov-sub">@Subtitle</div>
        </div>
        <div style="text-align:right;">
            @* The period is a label, not a control: the range selector in the filter strip above is
               the single control for both overview cards. *@
            <span class="tm-ov-period">@Range.Label.ToUpperInvariant()</span>
            <div class="tm-ov-total">@Total.ToString("C0")</div>
        </div>
    </div>

    <div class="tm-panel-body">
        @if (Points.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">No sales data yet.</MudAlert>
        }
        else
        {
            <TmAreaChart Points="@ChartPoints" Accent="#3b82f6"
                         AccessibleLabel="@($"Sales over the {Subtitle}")" />

            <div class="tm-ov-foot">
                <div>
                    <span class="tm-dim">Peak day</span>
                    <span class="tm-ov-peak">@Peak.ToString("C0")</span>
                </div>
                <div>
                    <span class="tm-dim">Gross profit</span>
                    <span class="@(GrossProfit < 0 ? "tm-red" : "tm-green")">@GrossProfit.ToString("C0")</span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<SalesOverviewPointDto> Points { get; set; } = Array.Empty<SalesOverviewPointDto>();

    /// <summary>Period currently applied by the dashboard filter strip. Only used for the header
    /// label and the span caption; the series itself is read by the page.</summary>
    [Parameter] public DashboardRange Range { get; set; } = DashboardRanges.Resolve(DashboardRanges.DefaultLabel, DateTime.UtcNow);

    private decimal Total => Points.Sum(p => p.TotalSales);
    private decimal GrossProfit => Points.Sum(p => p.Profit);
    private decimal Peak => Points.Count == 0 ? 0m : Points.Max(p => p.TotalSales);

    private List<(string Label, decimal Value)> ChartPoints =>
        Points.Select(p => (p.Label, p.TotalSales)).ToList();

    private string Subtitle => Points.Count == 0 ? string.Empty : Range.Caption;
}
