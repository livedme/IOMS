<DashboardCardShell Title="Sales Overview" FillHeight="true">
    <HeaderExtra>
        <div class="tm-select" style="min-width:130px; max-width:150px;">
            <select class="tm-panel-select" value="@Range" @onchange="OnRangeChanged">
                <option value="Last 7 Days">Last 7 Days</option>
                <option value="Last 30 Days">Last 30 Days</option>
                <option value="Last 12 Months">Last 12 Months</option>
            </select>
        </div>
    </HeaderExtra>
    <ChildContent>
        <div class="tm-panel-body">
            @if (Points.Any())
            {
                decimal maxDay = Points.Max(x => x.TotalSales);
                <div class="tm-day-grid">
                    @foreach (var d in Points)
                    {
                        var w = maxDay <= 0 ? 0 : (double)d.TotalSales / (double)maxDay * 100;
                        var profitClass = d.Profit >= 0 ? "tm-green" : "tm-red";
                        <div class="tm-day">
                            <div class="tm-day-label" title="@d.Label">@d.Label</div>
                            <div class="tm-day-val">@d.TotalSales.ToString("C0")</div>
                            <div class="tm-day-sub @profitClass">@d.Profit.ToString("C0")</div>
                            <div class="tm-bar" style="margin-top:6px;">
                                <div class="tm-bar-fill" style="width:@w.ToString("0")%; background:linear-gradient(90deg,#3b82f6,#60a5fa);"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Dense="true">No sales data yet.</MudAlert>
            }
        </div>
    </ChildContent>
</DashboardCardShell>

@code {
    [Parameter] public IReadOnlyList<SalesOverviewPointDto> Points { get; set; } = Array.Empty<SalesOverviewPointDto>();
    [Parameter] public string Range { get; set; } = "Last 7 Days";
    [Parameter] public EventCallback<string> RangeChanged { get; set; }

    private Task OnRangeChanged(ChangeEventArgs e) => RangeChanged.InvokeAsync(e.Value?.ToString() ?? "Last 7 Days");
}
