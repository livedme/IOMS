<DashboardCardShell Title="Recent Transactions" ViewAllHref="/accounting/payments" ViewAllText="Payments">
    <div class="tm-list">
        @if (!Items.Any())
        {
            <div class="tm-panel-body">
                <MudAlert Severity="Severity.Info" Dense="true">No recent transactions.</MudAlert>
            </div>
        }
        else
        {
            @foreach (var tx in Items)
            {
                var (icon, bg) = GetTxIcon(tx.Type);
                var (pillBg, pillFg) = GetTxStatusStyle(tx.Status);
                <div class="tm-list-row">
                    <div class="tm-list-ico" style="background:@bg;">
                        <MudIcon Icon="@icon" Size="Size.Small" Style="color:#fff; font-size:15px;" />
                    </div>
                    <div class="tm-list-main">
                        <div class="tm-list-title">@tx.Number</div>
                        <div class="tm-list-sub">@tx.Type · @tx.TimeAgo</div>
                    </div>
                    <div class="tm-list-end">
                        <div class="tm-list-amt">@tx.Amount.ToString("C")</div>
                        <span class="tm-pill" style="background:@pillBg; color:@pillFg; border-color:@pillBg; margin-top:3px;">@tx.Status</span>
                    </div>
                </div>
            }
        }
    </div>
</DashboardCardShell>

@code {
    [Parameter] public IReadOnlyList<RecentTransactionDto> Items { get; set; } = Array.Empty<RecentTransactionDto>();

    private static (string icon, string bg) GetTxIcon(string type) => type switch
    {
        "Sale" => (Icons.Material.Filled.PointOfSale, "#10b981"),
        "Purchase" => (Icons.Material.Filled.ShoppingBag, "#0ea5e9"),
        "Return" => (Icons.Material.Filled.AssignmentReturn, "#ef4444"),
        "Payment" => (Icons.Material.Filled.Payments, "#8b5cf6"),
        _ => (Icons.Material.Filled.Receipt, "#64748b")
    };

    private static (string bg, string fg) GetTxStatusStyle(string s) => s switch
    {
        "Completed" => ("#dcfce7", "#166534"),
        "Received" => ("#dbeafe", "#1e40af"),
        "Refunded" => ("#fee2e2", "#991b1b"),
        "Cash" => ("#f1f5f9", "#334155"),
        _ => ("#f1f5f9", "#475569")
    };
}
