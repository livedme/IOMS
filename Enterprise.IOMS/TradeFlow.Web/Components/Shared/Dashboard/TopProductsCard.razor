@inherits DashboardTileBase<List<TopProductDto>>

<DashboardCardShell Title="Top Selling Products by Revenue" ViewAllHref="/products/list" ViewAllText="All Products" FillHeight="true" Loading="@Loading">
    <div class="tm-panel-body" style="padding:4px 6px 8px;">
        @if (Data.Any())
        {
            int rank = 1;

            // Items arrive ordered by revenue (GetTopProducts groups by product and sorts on
            // SUM(Quantity * UnitPrice) descending), and the bar is scaled against the top seller
            // so the leader always fills the track.
            double maxRev = Data.Max(x => (double)x.Revenue);
            foreach (var p in Data.Take(5))
            {
                var widthPct = maxRev == 0 ? 0 : (double)p.Revenue / maxRev * 100;
                <div class="tm-list-row">
                    <div class="tm-rank">@rank</div>
                    <div class="tm-list-main">
                        <div class="tm-list-title" title="@p.ProductName">@p.ProductName</div>
                        <div class="tm-list-sub">@p.UnitsSold.ToString("N0") sold · @(Taka.Ho((p.UnitsSold == 0 ? 0m : p.Revenue / p.UnitsSold))) avg</div>
                        <div class="d-flex align-center" style="gap:8px; margin-top:4px;">
                            <div class="tm-bar" style="flex:1;"><div class="tm-bar-fill" style="width:@widthPct.ToString("0")%; background:#3b82f6;"></div></div>
                            <span class="tm-list-amt">@Taka.Ho(p.Revenue)</span>
                        </div>
                    </div>
                </div>
                rank++;
            }
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true">No product sales data yet.</MudAlert>
        }
    </div>
</DashboardCardShell>

@code {
    protected override List<TopProductDto> EmptyData { get; } = new();

    protected override Task<List<TopProductDto>> LoadAsync() =>
        DashboardService.GetTopProducts(5, Range.Days);
}
