<DashboardCardShell Title="Daily Sales by Store" ViewAllHref="/shop/branches" ViewAllText="Branches" FillHeight="true">
    <div class="tm-list">
        @if (!Items.Any())
        {
            <div class="tm-panel-body">
                <MudAlert Severity="Severity.Info" Dense="true">No store data.</MudAlert>
            </div>
        }
        else
        {
            int rank = 1;
            decimal maxStore = Items.Max(s => s.Sales);
            foreach (var s in Items)
            {
                var w = maxStore <= 0 ? 0 : (double)s.Sales / (double)maxStore * 100;
                <div class="tm-list-row">
                    <div class="tm-rank">@rank</div>
                    <div class="tm-list-ico" style="background:#6366f1;">
                        <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Small" Style="font-size:15px; color:#fff;" />
                    </div>
                    <div class="tm-list-main">
                        <div class="tm-list-title" title="@s.StoreName">@s.StoreName</div>
                        <div class="tm-bar" style="margin-top:5px;">
                            <div class="tm-bar-fill" style="width:@w.ToString("0")%; background:linear-gradient(90deg,#6366f1,#a5b4fc);"></div>
                        </div>
                    </div>
                    <div class="tm-list-end">
                        <div class="tm-list-amt">@s.Sales.ToString("C0")</div>
                        <div class="tm-list-meta">Sales</div>
                    </div>
                </div>
                rank++;
            }
        }
    </div>
</DashboardCardShell>

@code {
    [Parameter] public IReadOnlyList<DailySalesByStoreDto> Items { get; set; } = Array.Empty<DailySalesByStoreDto>();
}
