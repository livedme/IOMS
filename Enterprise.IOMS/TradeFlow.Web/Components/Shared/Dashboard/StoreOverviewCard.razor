@inherits DashboardTileBase<List<StoreOverviewDto>>

<DashboardCardShell Title="Store Overview" ViewAllHref="/shop/branches" ViewAllText="All Stores" FillHeight="true" Loading="@Loading">
    <div class="tm-table-wrap">
        <table class="tm-table" style="min-width:560px;">
            <thead>
                <tr>
                    <th>Store</th>
                    <th style="text-align:right">Orders</th>
                    <th style="text-align:right">Revenue</th>
                    <th style="text-align:right">Cost</th>
                    <th style="text-align:right">Profit</th>
                    <th style="text-align:right">Share</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredData.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align:center; padding:32px; color:#94a3b8;">No store sales yet. Assign a branch to a sales order to see per-store performance.</td>
                    </tr>
                }
                else
                {
                    var maxRevenue = FilteredData.Max(x => x.Revenue);
                    @foreach (var s in FilteredData)
                    {
                        var widthPct = maxRevenue <= 0 ? 0 : (double)s.Revenue / (double)maxRevenue * 100;
                        var marginPct = s.Revenue == 0 ? 0 : Math.Round((double)(s.Profit / s.Revenue * 100), 1);
                        <tr>
                            <td>
                                <div class="d-flex align-center" style="gap:8px;">
                                    <div class="tm-bar" style="width:64px; flex:none;">
                                        <div class="tm-bar-fill" style="width:@widthPct.ToString("0")%; background:#3b82f6;"></div>
                                    </div>
                                    <span style="font-weight:600;">@s.StoreName</span>
                                </div>
                            </td>
                            <td class="tm-num" style="text-align:right;">@s.Orders.ToString("N0")</td>
                            <td class="tm-money" style="text-align:right; font-weight:600;">@Taka.Ho(s.Revenue)</td>
                            <td class="tm-dim" style="text-align:right;">@Taka.Ho(s.Cost)</td>
                            <td class="tm-money" style="text-align:right; font-weight:600; color:@(s.Profit < 0 ? "#dc2626" : "#16a34a");">
                                @Taka.Ho(s.Profit)
                                <span style="font-size:10.5px; font-weight:500;">(@marginPct.ToString("0.#")%)</span>
                            </td>
                            <td style="text-align:right;">
                                <span class="tm-pill tm-pill-blue">@s.SharePct.ToString("0.#")%</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</DashboardCardShell>

@code {
    private const string AllStores = "All Stores";

    /// <summary>
    /// Store picked in the filter strip. Applied in memory over the already-loaded breakdown rather
    /// than triggering a re-query, so switching stores is instant and the read stays per-range.
    /// </summary>
    [Parameter] public string StoreFilter { get; set; } = AllStores;

    protected override List<StoreOverviewDto> EmptyData { get; } = new();

    protected override Task<List<StoreOverviewDto>> LoadAsync() =>
        DashboardService.GetStoreOverview(Range.Days);

    private List<StoreOverviewDto> FilteredData
    {
        get
        {
            if (StoreFilter == AllStores) return Data;

            // "Unassigned" is the bucket for orders with no branch, so it is included when the user
            // explicitly picks it rather than being dropped by the name comparison.
            return Data
                .Where(s => string.Equals(s.StoreName, StoreFilter, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }
}
