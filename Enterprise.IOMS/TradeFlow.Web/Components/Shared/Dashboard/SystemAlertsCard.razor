<DashboardCardShell Title="System Alerts" ViewAllHref="/admin/audit-logs" ViewAllText="Audit Logs">
    <div class="tm-list">
        @if (!Items.Any())
        {
            <div class="tm-panel-body">
                <MudAlert Severity="Severity.Success" Dense="true">No active alerts.</MudAlert>
            </div>
        }
        else
        {
            @foreach (var al in Items)
            {
                var (bg, icon) = GetAlertStyle(al.AlertType);
                <div class="tm-list-row">
                    <div class="tm-list-ico" style="background:@bg;">
                        <MudIcon Icon="@icon" Size="Size.Small" Style="color:#fff; font-size:15px;" />
                    </div>
                    <div class="tm-list-main">
                        <div class="tm-list-title" title="@al.Detail">@al.Title</div>
                        <div class="tm-list-sub">@al.TimeAgo</div>
                    </div>
                </div>
            }
        }
    </div>
</DashboardCardShell>

@code {
    [Parameter] public IReadOnlyList<SystemAlertDto> Items { get; set; } = Array.Empty<SystemAlertDto>();

    private static (string bg, string icon) GetAlertStyle(string t) => t switch
    {
        "error" => ("#ef4444", Icons.Material.Filled.Warning),
        "warning" => ("#f59e0b", Icons.Material.Filled.Schedule),
        "info" => ("#3b82f6", Icons.Material.Filled.PersonAdd),
        "success" => ("#10b981", Icons.Material.Filled.CheckCircle),
        _ => ("#64748b", Icons.Material.Filled.Notifications)
    };
}
