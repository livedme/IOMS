<DashboardCardShell Title="Best Performing Stores" ViewAllHref="/shop/branches" ViewAllText="Branches" FillHeight="true">
    <div class="tm-list">
        @if (!Items.Any())
        {
            <div class="tm-panel-body">
                <MudAlert Severity="Severity.Info" Dense="true">No store performance data.</MudAlert>
            </div>
        }
        else
        {
            @foreach (var s in Items)
            {
                <div class="tm-list-row">
                    <div class="tm-list-ico" style="background:#e0e9ff; color:#2f5bff;">
                        <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Small" Style="font-size:15px;" />
                    </div>
                    <div class="tm-list-main">
                        <div class="tm-list-title">@s.StoreName</div>
                    </div>
                    <div class="tm-list-end">
                        <div class="tm-list-amt">@s.Sales.ToString("C0")</div>
                        <div class="tm-stat-trend @(s.GrowthPct >= 0 ? "up" : "down")" style="justify-content:flex-end; margin-top:2px;">
                            <MudIcon Icon="@(s.GrowthPct >= 0 ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)" Size="Size.Small" Style="font-size:12px;" />
                            @s.GrowthPct.ToString("0.0")%
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</DashboardCardShell>

@code {
    [Parameter] public IReadOnlyList<BestStoreDto> Items { get; set; } = Array.Empty<BestStoreDto>();
}
