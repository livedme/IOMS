<DashboardCardShell Title="Recent Orders" ViewAllHref="/sales/orders" ViewAllText="All Orders">
    <div class="tm-table-wrap">
        <table class="tm-table" style="min-width:620px;">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Store</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th style="text-align:right">Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (!Items.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align:center; padding:32px; color:#94a3b8;">No recent orders.</td>
                    </tr>
                }
                else
                {
                    @foreach (var o in Items)
                    {
                        <tr>
                            <td><span class="tm-veh">@o.OrderNumber</span></td>
                            <td class="tm-dim">@o.Customer</td>
                            <td class="tm-dim">@o.Store</td>
                            <td class="tm-dim">@o.Date.ToString("dd MMM yyyy hh:mm tt")</td>
                            <td><span class="@GetStatusPill(o.Status)"><span class="tm-dot"></span>@o.Status</span></td>
                            <td class="tm-money" style="text-align:right; font-weight:700;">@o.Amount.ToString("C")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</DashboardCardShell>

@code {
    [Parameter] public IReadOnlyList<RecentOrderExtendedDto> Items { get; set; } = Array.Empty<RecentOrderExtendedDto>();

    private static string GetStatusPill(string s) => s switch
    {
        "Completed" => "tm-pill tm-pill-green",
        "Delivered" => "tm-pill tm-pill-green",
        "Processing" => "tm-pill tm-pill-blue",
        "Shipped" => "tm-pill tm-pill-purple",
        "Pending" => "tm-pill tm-pill-amber",
        "Cancelled" => "tm-pill tm-pill-red",
        _ => "tm-pill tm-pill-gray"
    };
}
