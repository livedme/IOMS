<DashboardCardShell Title="Payment Methods" ViewAllHref="/accounting/payments" ViewAllText="Payments" FillHeight="true">
    <div class="tm-list">
        @if (!Items.Any())
        {
            <div class="tm-panel-body">
                <MudAlert Severity="Severity.Info" Dense="true">No payment data.</MudAlert>
            </div>
        }
        else
        {
            int rank = 1;
            decimal maxPay = Items.Max(p => p.Amount);
            foreach (var pm in Items)
            {
                var col = GetPaymentColor(pm.Method);
                var w = maxPay <= 0 ? 0 : (double)pm.Amount / (double)maxPay * 100;
                <div class="tm-list-row">
                    <div class="tm-rank">@rank</div>
                    <div class="tm-list-ico" style="background:@col;">
                        <MudIcon Icon="@GetPaymentIcon(pm.Method)" Size="Size.Small" Style="font-size:15px; color:#fff;" />
                    </div>
                    <div class="tm-list-main">
                        <div class="tm-list-title" title="@pm.Method">@pm.Method</div>
                        <div class="tm-bar" style="margin-top:5px;">
                            <div class="tm-bar-fill" style="width:@w.ToString("0")%; background:@col;"></div>
                        </div>
                    </div>
                    <div class="tm-list-end">
                        <div class="tm-list-amt">@pm.Amount.ToString("C0")</div>
                        <div class="tm-list-meta">@pm.Percentage.ToString("0.0")% of sales</div>
                    </div>
                </div>
                rank++;
            }
        }
    </div>
</DashboardCardShell>

@code {
    [Parameter] public IReadOnlyList<PaymentMethodBreakdownDto> Items { get; set; } = Array.Empty<PaymentMethodBreakdownDto>();

    private static string GetPaymentColor(string m) => m switch
    {
        "Cash" => "#3b82f6",
        "Card" => "#22c55e",
        "Mobile Payment" => "#f59e0b",
        "Bank Transfer" => "#a855f7",
        _ => "#94a3b8"
    };

    private static string GetPaymentIcon(string m) => m switch
    {
        "Cash" => Icons.Material.Filled.Payments,
        "Card" => Icons.Material.Filled.CreditCard,
        "Mobile Payment" => Icons.Material.Filled.Smartphone,
        "Bank Transfer" => Icons.Material.Filled.AccountBalance,
        _ => Icons.Material.Filled.Receipt
    };
}
