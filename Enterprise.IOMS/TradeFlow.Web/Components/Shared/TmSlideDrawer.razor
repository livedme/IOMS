<MudDrawer @bind-Open="Open" Anchor="Anchor.End" Elevation="16" Variant="DrawerVariant.Temporary"
           Width="@Width" CloseOnOverlayClick="true" Class="bg-light-subtle text-black">

    <div class="tm-slide-head">
        <MudText Typo="Typo.h6">@Title</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Close" />
    </div>

    <div class="tm-slide-body">
        @ChildContent
    </div>
</MudDrawer>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Width { get; set; } = "1150px";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private void Close() => OpenChanged.InvokeAsync(false);
}
