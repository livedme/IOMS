<div class="tm-card tm-header @(WrapActions ? "tm-header-wrap" : "")">
    <div class="tm-header-left">
        <div class="tm-header-icon">@Icon</div>
        <div>
            <h2 class="tm-title">@Title</h2>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="tm-subtitle">@Subtitle</p>
            }
        </div>
    </div>
    <div class="d-flex align-center @(WrapActions ? "tm-header-actions-wrap" : "")" style="gap:8px">
        @Actions
    </div>
</div>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    /// <summary>Let the action area wrap onto a second line instead of overflowing.</summary>
    [Parameter] public bool WrapActions { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
