@page "/sales/list"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject IOrderService OrderService
@inject ICustomerService CustomerService
@inject IProductService ProductService
@inject IBranchService BranchService
@inject ISnackbar Snackbar
@inject IDialogService DialogService


<PageTitle>Sales - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="🛒" Title="Sales" Subtitle="Completed sales awaiting packing, dispatch and delivery">
        <Actions>
            <button class="tm-reset" @onclick="Refresh">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="() => OpenCreateEdit(null)">+ New Sale</button>
        </Actions>
    </TmPageHeader>

    @* ─── Stats ─── *@
    <div class="tm-stats">
        <TmStatTile Icon="🛒" Number="@TotalCountText" Label="Sales" Tone="blue" OnClick="@(() => FilterByStatus(null))" />
        <TmStatTile Icon="💵" Number="@SoldCountText" Label="Sold" Tone="purple" OnClick="@(() => FilterByStatus(OrderStatus.Sold))" />
        <TmStatTile Icon="📦" Number="@PackedCountText" Label="Packed" Tone="yellow" OnClick="@(() => FilterByStatus(OrderStatus.Packed))" />
        <TmStatTile Icon="🚚" Number="@ShippedCountText" Label="Shipped" Tone="teal" OnClick="@(() => FilterByStatus(OrderStatus.Shipped))" />
        <TmStatTile Icon="✅" Number="@DeliveredCountText" Label="Delivered" Tone="green" OnClick="@(() => FilterByStatus(OrderStatus.Delivered))" />
        <TmStatTile Icon="💰" Number="@PageValueText" Label="Page Value" Tone="red" />
    </div>

    @* ─── Filters ─── *@
    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by order number, customer, chalan..." value="@pagedRequest.SearchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.CustomerId?.ToString() ?? "")" @onchange="OnCustomerChanged">
                <option value="">All Customers</option>
                @foreach (var c in _customers)
                {
                    <option value="@c.Id">@c.CustomerName</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.BranchId?.ToString() ?? "")" @onchange="OnBranchChanged">
                <option value="">All Branches</option>
                @foreach (var b in _branches)
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.Status?.ToString() ?? "")" @onchange="OnStatusChanged">
                <option value="">All Status</option>
                @foreach (var s in SalesStatuses)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <input type="date" value="@FormatDate(pagedRequest.From)" @onchange="OnFromChanged" title="From date" />
        </div>
        <div class="tm-select">
            <input type="date" value="@FormatDate(pagedRequest.To)" @onchange="OnToChanged" title="To date" />
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    @* ─── Table ─── *@
    <div class="tm-card tm-table-card">
        @if (_loading)
        {
            <div style="position:absolute; inset:0; background:rgba(255,255,255,0.62); backdrop-filter:blur(1px); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2; border-radius:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Style="margin-top:8px; color:#334155; font-weight:600;">Loading sales...</MudText>
            </div>
        }
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:1250px">
                <thead>
                    <tr>
                        <th @onclick="@(() => SortBy(Col.OrderNumber))">🧾 Order # @SortIcon(Col.OrderNumber)</th>
                        <th @onclick="@(() => SortBy(Col.OrderDate))">📅 Date @SortIcon(Col.OrderDate)</th>
                        <th @onclick="@(() => SortBy(Col.Customer))">👤 Customer @SortIcon(Col.Customer)</th>
                        <th @onclick="@(() => SortBy(Col.Branch))">🏬 Branch @SortIcon(Col.Branch)</th>
                        <th style="text-align:right">Items</th>
                        <th style="text-align:right" @onclick="@(() => SortBy(Col.SubTotal))">Subtotal @SortIcon(Col.SubTotal)</th>
                        <th style="text-align:right">Tax</th>
                        <th style="text-align:right" @onclick="@(() => SortBy(Col.TotalAmount))">Total @SortIcon(Col.TotalAmount)</th>
                        <th style="text-align:right" @onclick="@(() => SortBy(Col.PaidAmount))">Paid @SortIcon(Col.PaidAmount)</th>
                        <th style="text-align:right" @onclick="@(() => SortBy(Col.DueAmount))">Due @SortIcon(Col.DueAmount)</th>
                        <th @onclick="@(() => SortBy(Col.Status))">Status @SortIcon(Col.Status)</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_hasLoadedOnce && _loading)
                    {
                        <tr><td colspan="12" style="text-align:center; padding:40px; color:#94a3b8;">Loading sales...</td></tr>
                    }
                    else if (pagedResultNew.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="12" style="text-align:center; padding:40px;">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#94a3b8;" Class="mb-2" />
                                <div style="color:#64748b;">No sales found — try a different search or filter</div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="ResetFilters">Clear filters</MudButton>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var o in pagedResultNew.Items)
                        {
                            <tr>
                                <td>
                                    <span class="tm-veh">
                                        <span class="tm-veh-ico" style="background:#dcfce7">🛒</span>@o.OrderNumber
                                    </span>
                                </td>
                                <td class="tm-dim">@o.OrderDate.ToString("dd MMM yyyy")</td>
                                <td class="tm-branch">@(o.Customer?.CustomerName ?? "-")</td>
                                <td class="tm-dim">@(o.Branch?.Name ?? "-")</td>
                                <td class="tm-num" style="text-align:right">@o.ItemCount</td>
                                <td class="tm-money" style="text-align:right">@o.SubTotal.ToString("N0")</td>
                                <td class="tm-money" style="text-align:right">@o.TaxAmount.ToString("N0")</td>
                                <td class="tm-money" style="text-align:right"><strong>@o.TotalAmount.ToString("N0")</strong></td>
                                <td class="tm-money" style="text-align:right;color:#15803d">@o.PaidAmount.ToString("N0")</td>
                                <td style="text-align:right">
                                    <span style="font-weight:700; color:@(o.DueAmount > 0 ? "#dc2626" : "#94a3b8")">
                                        @(o.DueAmount > 0 ? o.DueAmount.ToString("N0") : "-")
                                    </span>
                                </td>
                                <td><span class="@GetStatusPill(o.Status)"><span class="tm-dot"></span>@o.Status</span></td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-view" title="View" @onclick="() => ViewOrder(o.Id)">👁</button>
                                        @if (o.Status == OrderStatus.Pending)
                                        {
                                            <button class="tm-act" style="color:#16a34a" title="Approve" @onclick="() => Approve(o.Id)">✔</button>
                                        }
                                        @if (o.Status != OrderStatus.Cancelled && o.Status != OrderStatus.Delivered)
                                        {
                                            <button class="tm-act tm-act-edit" title="Edit" @onclick="() => OpenCreateEdit(o.Id)">✎</button>
                                            <button class="tm-act tm-act-del" title="Cancel" @onclick="() => Cancel(o.Id)">✕</button>
                                        }
                                        @if (o.Status == OrderStatus.Cancelled)
                                        {
                                            <button class="tm-act tm-act-del" title="Delete" @onclick="() => DeleteOrder(o.Id)">🗑</button>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div style="opacity:@(_loading ? "0.55" : "1"); pointer-events:@(_loading ? "none" : "auto");">
            <TmPager CurrentPage="pagedResultNew.CurrentPage"
                     PageSize="pagedResultNew.PageSize"
                     TotalCount="pagedResultNew.TotalCount"
                     TotalPages="pagedResultNew.TotalPages"
                     ItemLabel="Sales Orders"
                     OnGoToPage="GoToPage"
                     OnPrev="GoPrevPage"
                     OnNext="GoNextPage"
                     OnPageSizeChanged="OnPageSizeChanged" />
        </div>
    </div>
</div>

@* ─── Right-side Slider Panel (consistent with Global Search) ─── *@
<SalesOrderViewPanel @ref="_salesOrderViewPanel" />

@code {
    // ─── Sortable column keys (constants avoid nested quotes in markup lambdas) ───
    private static class Col
    {
        public const string OrderNumber = "OrderNumber";
        public const string OrderDate = "OrderDate";
        public const string Customer = "Customer";
        public const string Branch = "Branch";
        public const string SubTotal = "SubTotal";
        public const string TotalAmount = "TotalAmount";
        public const string PaidAmount = "PaidAmount";
        public const string DueAmount = "DueAmount";
        public const string Status = "Status";
    }

    // ─── Lifecycle statuses owned by this page (Pending/Approved live on /sales/orders) ───
    private readonly List<OrderStatus> SalesStatuses =Enum.GetValues<OrderStatus>().ToList();

    // ─── List state ───
    private PagedResultNew<SalesOrderDto> pagedResultNew = new();
    private SalesPagedRequest pagedRequest = new()
    {
        SortColumn = Col.OrderDate,
        SortAscending = false
    };

    private List<CustomerDto> _customers = new();
    private List<BranchDto> _branches = new();
    private bool _loading = true;
    private bool _hasLoadedOnce;
    private bool _loadRunning;
    private bool _loadQueued;
    private decimal _pageValue;
    private CancellationTokenSource? _debounceCts;

    // ─── Drawer state ───
    private enum SliderMode { View, Edit, Create }
    private SliderMode _drawerMode = SliderMode.View;
    private SalesOrderDto? _editingOrder;
    private SalesOrderViewPanel? _salesOrderViewPanel;
    private CreateSalesOrderDtoModels _editModel = new();    
    private List<(Guid Id, string Name, string SKU, decimal Price)> _drawerProducts = new();

    protected override async Task OnInitializedAsync()
    {
        try { _branches = await BranchService.GetBranches(); } catch { }
        try
        {
            var customers = await CustomerService.GetCustomersAsync(null, 1, 500);
            _customers = customers.Items;

            var products = await ProductService.GetProductsAsync(new ProductPagedRequest());
            _drawerProducts = products.Items.OrderBy(p => p.Name).ToList().Select(p => (p.Id, p.Name, p.SKU, p.SellingPrice)).ToList();

        }
        catch { }

        await LoadOrders();
    }

    private async Task Refresh() => await LoadOrders();

    /// <summary>
    /// Single-flight loader. The page and the services share one scoped DbContext, so two
    /// overlapping queries would throw "A second operation was started on this context
    /// instance". Callers that arrive mid-flight set a flag instead of starting a parallel
    /// query, and the running load then re-runs once with the newest filter state.
    /// </summary>
    private async Task LoadOrders()
    {
        if (_loadRunning)
        {
            _loadQueued = true;
            return;
        }

        _loadRunning = true;
        try
        {
            do
            {
                _loadQueued = false;
                await LoadOrdersCore();
            }
            while (_loadQueued);
        }
        finally { _loadRunning = false; }
    }

    private async Task LoadOrdersCore()
    {
        _loading = true;
        try
        {
            pagedResultNew = await OrderService.GetSalesOrdersAsync(pagedRequest);
            _pageValue = pagedResultNew.Items.Sum(o => o.TotalAmount);
            _hasLoadedOnce = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading sales: {ex.Message}", Severity.Error);
        }
        finally { _loading = false; }
    }

    // ─── Stats / sorting helpers ───
    private string TotalCountText => Stat("TotalCount");
    private string SoldCountText => Stat("SoldCount");
    private string PackedCountText => Stat("PackedCount");
    private string ShippedCountText => Stat("ShippedCount");
    private string DeliveredCountText => Stat("DeliveredCount");
    private string PageValueText => _pageValue.ToString("N0");

    private string Stat(string key) =>
        pagedResultNew.Stats != null && pagedResultNew.Stats.TryGetValue(key, out var v) ? v.ToString() : "0";

    private void SortBy(string column)
    {
        if (pagedRequest.SortColumn == column)
            pagedRequest.SortAscending = !pagedRequest.SortAscending;
        else
        {
            pagedRequest.SortColumn = column;
            pagedRequest.SortAscending = true;
        }
        pagedRequest.CurrentPage = 0;
    }

    private string SortIcon(string column)
    {
        if (pagedRequest.SortColumn != column) return "";
        return pagedRequest.SortAscending ? "▲" : "▼";
    }

    // ─── Filters ───
    private void OnSearchInput(ChangeEventArgs e)
    {
        pagedRequest.SearchTerm = e.Value?.ToString() ?? "";
        pagedRequest.CurrentPage = 0;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(async () =>
                {
                    await LoadOrders();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task OnCustomerChanged(ChangeEventArgs e)
    {
        pagedRequest.CustomerId = ParseGuid(e.Value);
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task OnBranchChanged(ChangeEventArgs e)
    {
        pagedRequest.BranchId = ParseGuid(e.Value);
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        pagedRequest.Status = Enum.TryParse<OrderStatus>(e.Value?.ToString(), out var s) ? s : null;
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task OnFromChanged(ChangeEventArgs e)
    {
        pagedRequest.From = ParseDate(e.Value);
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task OnToChanged(ChangeEventArgs e)
    {
        pagedRequest.To = ParseDate(e.Value);
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task FilterByStatus(OrderStatus? status)
    {
        pagedRequest.Status = status;
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task ResetFilters()
    {
        pagedRequest.SearchTerm = "";
        pagedRequest.Status = null;
        pagedRequest.CustomerId = null;
        pagedRequest.BranchId = null;
        pagedRequest.From = null;
        pagedRequest.To = null;
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private static Guid? ParseGuid(object? value) =>
        Guid.TryParse(value?.ToString(), out var g) && g != Guid.Empty ? g : null;

    private static DateTime? ParseDate(object? value) =>
        DateTime.TryParse(value?.ToString(), out var d) ? d : null;

    private static string FormatDate(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";

    // ─── Paging (zero-based, matches TmPager) ───
    private async Task GoToPage(int page)
    {
        pagedRequest.CurrentPage = Math.Clamp(page, 0, Math.Max(0, pagedResultNew.TotalPages - 1));
        await LoadOrders();
    }

    private async Task GoPrevPage()
    {
        if (pagedRequest.CurrentPage > 0)
        {
            pagedRequest.CurrentPage--;
            await LoadOrders();
        }
    }

    private async Task GoNextPage()
    {
        if (pagedRequest.CurrentPage < pagedResultNew.TotalPages - 1)
        {
            pagedRequest.CurrentPage++;
            await LoadOrders();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sz))
        {
            pagedRequest.PageSize = Math.Clamp(sz, 1, 100);
            pagedRequest.CurrentPage = 0;
            await LoadOrders();
        }
    }

    private static string GetStatusPill(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "tm-pill tm-pill-amber",
        OrderStatus.Approved => "tm-pill tm-pill-blue",
        OrderStatus.Sold => "tm-pill tm-pill-purple",
        OrderStatus.Packed => "tm-pill tm-pill-amber",
        OrderStatus.Shipped => "tm-pill tm-pill-blue",
        OrderStatus.PartiallyShipped => "tm-pill tm-pill-teal",
        OrderStatus.Delivered => "tm-pill tm-pill-green",
        OrderStatus.Cancelled => "tm-pill tm-pill-red",
        _ => "tm-pill tm-pill-blue"
    };

    // ─── Row actions ───
    private async Task Approve(Guid id)
    {
        try
        {
            await OrderService.ApproveOrder(id);
            Snackbar.Add("Order approved successfully", Severity.Success);
            await LoadOrders();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Cancel(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Cancel Sales", "Are you sure?", "Yes, Cancel", "No");
        if (confirm == true)
        {
            try
            {
                await OrderService.CancelOrder(id, "Cancelled by user");
                Snackbar.Add("Sales cancelled", Severity.Warning);
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task ViewOrder(Guid id)
    {
        if (_salesOrderViewPanel != null)
            await _salesOrderViewPanel.OpenAsync(id);
    }

    private async Task<SalesOrderDto> GetOrderDetails(Guid Id)
    {
        return await OrderService.GetSalesOrderById(Id);
    }
    

    // ─── Create/Update/Delete ───
    private async Task OpenCreateEdit(Guid? orderId)
    {
        var dataModel = new CreateSalesOrderDtoModels();
        string dialogTitle = "New Purchase Order";
        _drawerMode = SliderMode.View;
        _editingOrder = null;

        if (orderId.HasValue)
        {
            var order = await GetOrderDetails(orderId.Value);
            if (order == null) { Snackbar.Add("Sales order not found", Severity.Error); return; }
            dialogTitle = $"Edit Sale #{order.OrderNumber}";
            _editingOrder = order;
            _drawerMode = SliderMode.Edit;

            dataModel = new CreateSalesOrderDtoModels
            {
                BranchId = order.BranchId ?? Guid.Empty,
                SalesDate = order.OrderDate,
                Naration = order.Naration,
                Chalan = order.Chalan,
                Notes = order.Notes,
                SubTotal = order.SubTotal,
                LabourCharge = order.LabourCharge,
                TruckCharge = order.TruckCharge,
                TaxAmount = order.TaxAmount,
                DiscountAmount = order.DiscountAmount,
                DiscountType = (int)order.DiscountType,
                TotalAmount = order.TotalAmount,
                PaidAmount = order.PaidAmount,
                DueAmount = order.DueAmount,
                CustomerDdlControl = new ControlDto
                {
                    SelectedItem = new ControlItemsDto
                    {
                        Id = order.CustomerId,
                        Name = order.Customer?.CustomerName ?? "",
                        IsSelected = false
                    }
                },
                ItemsLine = order.Items.Select(i => new CreateSalesOrderItemDto(
                    i.ProductId, i.Quantity, i.UnitPrice, i.DiscountAmount, (int)i.DiscountType,
                    i.TotalDiscount, i.LineTotalPrice, null, null)).ToList()
            };

        }

        var parameters = new DialogParameters<SalesOrderDialog>
        {
            { x => x.Customers, _customers },
            { x => x.Products, _drawerProducts },
            { x => x.dataModel, dataModel },
            { x => x.OnSubmit, EventCallback.Factory.Create<CreateSalesOrderDto>(this, HandleFormSubmit) },
            { x => x.OnSubmitAndPrint, EventCallback.Factory.Create<CreateSalesOrderDto>(this, HandleFormSubmitAndPrint) },
            { x => x.OnCancel, EventCallback.Factory.Create(this, CloseDialog) }
        };

        var dialog = await DialogService.ShowAsync<SalesOrderDialog>(dialogTitle, parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseOnEscapeKey = true,
                CloseButton = true
            });

        await dialog.Result;

    }

    private async Task HandleFormSubmit(CreateSalesOrderDto dto)
    {
        try
        {
            if (_drawerMode == SliderMode.Edit && _editingOrder != null)
            {
                await OrderService.UpdateSalesOrder(_editingOrder.Id, dto);
                Snackbar.Add("Sales order updated", Severity.Success);
            }
            else
            {
                await OrderService.CreateSalesOrder(dto);
                Snackbar.Add("Sales created successfully", Severity.Success);
            }
            await LoadOrders();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task HandleFormSubmitAndPrint(CreateSalesOrderDto dto)
    {
        await HandleFormSubmit(dto);
    }
    
    private Task CloseDialog() => Task.CompletedTask;

    private async Task DeleteOrder(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Delete Sales Order",
            "This will permanently delete the sales order. Continue?", "Yes, Delete", "No");
        if (confirm == true)
        {
            try
            {
                await OrderService.DeleteSalesOrder(id);
                Snackbar.Add("Sales order deleted", Severity.Success);
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
