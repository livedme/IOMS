@using IOMS.Infrastructure.Data
@using TradeFlow.Web.Components.Pages.Inventory
<style>
    .mud-table-container {
        max-height: 350px;
        min-height: 250px;
    }

    .mud-table-dense * .mud-table-row .mud-table-cell {
        padding: 6px 1px 6px 4px;
        padding-inline-start: 15px;
        padding-inline-end: 15px;
    }
</style>
<MudDialog Class="bg-dialog-sales">
    <DialogContent>
        <div class="sales-order-form">
            <MudGrid>
                <MudItem xs="12" sm="2">
                    <MudDatePicker @bind-Date="dataModel.SalesDate" Label="Sales Date" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="Guid"
                               Label="Brannche"
                               Required="true"
                               @bind-Value="dataModel.BranchId"
                               @bind-Text="_branchtext"
                               Clearable="true"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">

                        @foreach (var b in _Branches)
                        {
                            <MudSelectItem Value="@b.Id">@b.Name (@b.Code)</MudSelectItem>
                        }
                    </MudSelect>

                </MudItem> 
                <MudItem xs="12" sm="3" Class="mb-4">
                    <MudAutocomplete T="ControlItemsDto" 
                                     @ref="dataModel.CustomerDdlControl.ControlRef"
                                     Label="Customer"
                                     Required="true"
                                     @key="dataModel.CustomerDdlControl.LastSelectedItem"
                                     @bind-Value="dataModel.CustomerDdlControl.SelectedItem"
                                     @bind-Text="dataModel.CustomerDdlControl.SelectedText"
                                     @bind-Value:after="OnCustomerChanged"
                                     SearchFunc="SearchCustomers"
                                     ToStringFunc="@(c => c?.Name ?? "")"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     Clearable="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudTextField @ref="RefNaration" @bind-Value="dataModel.Naration" Label="Naration" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudTextField @bind-Value="dataModel.Chalan" Label="Chalan" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.h6" Class="my-0">Item Line</MudText>

            <MudTable Items="@dataModel.ItemsLine" Dense="true" Elevation="0" Class="product-item-list" FixedHeader="true" ContainerClass="border-bottom-0 mud-table-container">
                <HeaderContent>
                    <MudTh Style="width:auto;">Product</MudTh>
                    <MudTh Style="width:80px;">Qty</MudTh>
                    <MudTh Style="width:130px;">Unit Price</MudTh>
                    <MudTh Style="width:165px;">Discount</MudTh>
                    <MudTh Class="pe-0" Style="width:150px;">Line Total</MudTh>
                    <MudTh Style="width:70px;" class="text-end">
                        <MudIconButton Icon="@Icons.Material.Outlined.Add" Size="Size.Small" Color="Color.Primary" OnClick="AddNewItem" />
                    </MudTh>
                </HeaderContent>
                <RowTemplate>
                    @if (context.ProductId == Guid.Empty)
                    {
                        <MudTd Class="d-flex justify-content-between" Style="width:auto;">
                            <MudAutocomplete T="ControlItemsDto"
                                             @ref="dataModel.ProductObj.ProductDdlControl.ControlRef"
                                             Label=""
                                             Required="true"
                                             @key="dataModel.ProductObj.ProductDdlControl.LastSelectedItem"
                                             @bind-Value="dataModel.ProductObj.ProductDdlControl.SelectedItem"
                                             @bind-Text="dataModel.ProductObj.ProductDdlControl.SelectedText"
                                             @bind-Value:after="OnProductChanged"
                                             SearchFunc="SearchProducts"
                                             ToStringFunc="@(c => c?.Name ?? "")"
                                             ResetValueOnEmptyText="true"
                                             CoerceText="true"
                                             Clearable="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />

                            @if (_availableSerials.Any())
                            {
                                <div style="max-height:80px;overflow-y:auto ;width:50%;padding-left: 15px;">
                                    <MudSelect T="Guid" @bind-Value="dataModel.ProductObj.Serial" MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectionText))" Class="form-control" MultiSelection="true" @bind-SelectedValues="_selectedSerialSet" Variant="Variant.Outlined" Margin="Margin.Dense">
                                        @foreach (var serial in _availableSerials)
                                        {
                                            <MudSelectItem Value="@serial.Id">@serial.SerialNumber</MudSelectItem>
                                        }
                                    </MudSelect>
                                </div>
                            }
                        </MudTd>
                        <MudTd Class="px-0" Style="width:auto;"><MudNumericField @ref="RefQuantity" @bind-Value="dataModel.ProductObj.Quantity" Min="1" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudTd>
                        <MudTd Style="width:auto;"> <MudNumericField @bind-Value="dataModel.ProductObj.UnitPrice" Format="N2" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudTd>
                        <MudTd Style="width:auto;" class="d-flex justify-content-between px-0">
                            <MudNumericField @bind-Value="dataModel.ProductObj.DiscountAmount" Format="N1" Class="_newDiscount" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudSelect @bind-Value="dataModel.ProductObj.DiscountType" Class="_discountType" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (DiscountType type in Enum.GetValues(typeof(DiscountType)))
                                {
                                    <MudSelectItem Value="@((int)type)">@CommonUtility.GetDisplayName(type)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd Class="pe-0" Style="width:auto;">
                            @{
                                CalculateLineTotal();
                            }
                            <MudNumericField @bind-Value="dataModel.ProductObj.TotalPrice" Format="C" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudTd>
                        <MudTd Style="width:auto;" class="pe-2 text-end mb-5 px-0">
                            <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Outlined.Check" Size="Size.Small" Color="Color.Primary" OnClick="AddItem" />
                            <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Outlined.Close" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => dataModel.ItemsLine.Remove(context))" />
                        </MudTd>
                    }
                    else
                    {
                        var itemIndex = dataModel.ItemsLine.IndexOf(context);
                        @if (_editingItemIndex == itemIndex)
                        {
                            <MudTd Class="d-flex justify-content-between" Style="width:auto;">
                                <MudAutocomplete T="ControlItemsDto"
                                                 @ref="dataModel.ProductObj.ProductDdlControl.ControlRef"
                                                 Label=""
                                                 Required="true"
                                                 @key="dataModel.ProductObj.ProductDdlControl.LastSelectedItem"
                                                 @bind-Value="dataModel.ProductObj.ProductDdlControl.SelectedItem"
                                                 @bind-Text="dataModel.ProductObj.ProductDdlControl.SelectedText"
                                                 @bind-Value:after="OnEditProductChanged"
                                                 SearchFunc="SearchProducts"
                                                 ToStringFunc="@(c => c?.Name ?? "")"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceText="true"
                                                 Clearable="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd Class="px-0" Style="width:auto;"><MudNumericField @ref="RefQuantity" @bind-Value="dataModel.ProductObj.Quantity" Min="1" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudTd>
                            <MudTd Style="width:auto;"><MudNumericField @bind-Value="dataModel.ProductObj.UnitPrice" Format="N2" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudTd>
                            <MudTd Style="width:auto;" class="d-flex justify-content-between px-0">
                                <MudNumericField @bind-Value="dataModel.ProductObj.DiscountAmount" Format="N1" Class="_newDiscount" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                <MudSelect @bind-Value="dataModel.ProductObj.DiscountType" Class="_discountType" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (DiscountType type in Enum.GetValues(typeof(DiscountType)))
                                    {
                                        <MudSelectItem Value="@((int)type)">@CommonUtility.GetDisplayName(type)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd Class="pe-0" Style="width:auto;">
                                @{
                                    CalculateLineTotal();
                                }
                                <MudNumericField @bind-Value="dataModel.ProductObj.TotalPrice" Format="C" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd Style="width:auto;" class="pe-2 text-end mb-5 px-0">
                                <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Outlined.Check" Size="Size.Small" Color="Color.Primary" OnClick="@(() => SaveEditItem(itemIndex))" />
                                <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Outlined.Close" Size="Size.Small" Color="Color.Secondary" OnClick="CancelEditItem" />
                            </MudTd>
                        }
                        else
                        {
                            <MudTd>
                                @Products.FirstOrDefault(p => p.Id == context.ProductId).Name
                                @if (context.SerialIds?.Count > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default">@(context.SerialIds?.Count > 0 ? $"{context.SerialIds.Count} serial(s)" : "-")</MudChip>
                                }
                            </MudTd>
                            <MudTd Style="width:auto;">@context.Quantity</MudTd>
                            <MudTd Style="width:auto;">@context.UnitPrice.ToString("C")</MudTd>
                            <MudTd Style="width:auto;">@context.TotalDiscountAmount.ToString("C")</MudTd>
                            <MudTd Style="width:auto;">@context.TotalPrice.ToString("C")</MudTd>
                            <MudTd Style="width:auto;" class="text-end d-inline-flex justify-content-between">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info" OnClick="@(() => StartEditItem(itemIndex, context))" />
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => dataModel.ItemsLine.Remove(context))" />
                            </MudTd>
                        }
                    }
                </RowTemplate>
            </MudTable>

            <MudCard Class="mt-4">
                <MudCardHeader Class="pb-0 pt-2">
                    <MudText>Balance</MudText>
                    <hr class="border-1" />
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Class="pt-0">
                        <MudItem xs="3" Class="pe-2 pt-2">
                            <MudTextField @bind-Value="dataModel.DrAmount" Label="Dr" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                            <MudTextField @bind-Value="dataModel.CrAmount" Label="Cr" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                            <MudNumericField @bind-Value="dataModel.StackQty" Label="Stack Qty" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                        </MudItem>
                        <MudItem xs="3" Class="pe-2 pt-2">
                            <MudNumericField @bind-Value="dataModel.SubTotal" Disabled="true" Label="Item Amount" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                            <MudNumericField @bind-Value="dataModel.LabourCharge" Label="Labour Charges" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                            <MudNumericField @bind-Value="dataModel.TruckCharge" Label="Truck Charges" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                        </MudItem>
                        <MudItem xs="3" Class="pe-2 pt-2">
                            <MudNumericField @bind-Value="dataModel.TaxAmount" Label="Tax" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                            <div class="d-flex justify-content-between">
                                <MudNumericField @bind-Value="dataModel.DiscountAmount" Label="Discount" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="DiscountField pb-1 col-7" />
                                <MudSelect @bind-Value="dataModel.DiscountType" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="DiscountTypeField pb-1 col-3">
                                    <MudSelectItem Value="0">%</MudSelectItem>
                                    <MudSelectItem Value="1">Fixed</MudSelectItem>
                                </MudSelect>
                            </div>
                            <MudNumericField @bind-Value="dataModel.TotalAmount" Disabled="true" Label="Grand Total" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                        </MudItem>
                        <MudItem xs="3" Class="pe-2 pt-2">
                            <MudNumericField @bind-Value="dataModel.PaidAmount" Label="Paid Amount" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                            <MudNumericField @bind-Value="dataModel.DueAmount" Label="Due Amount" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="pb-1" />
                        </MudItem>
                    </MudGrid>
                    @{
                        CalculationBalance();
                    }
                </MudCardContent>
            </MudCard>
            <div class="d-flex gap-2 justify-end mt-4 pb-2">
                <MudButton OnClick="Cancel">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!dataModel.ItemsLine.Any())">
                    Sale
                </MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitToPrint" Disabled="@(!dataModel.ItemsLine.Any())">
                    Sale & Print
                </MudButton>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@inject ApplicationDbContext DbContext
@inject IDialogService DialogService
@inject IBranchService BranchService
@inject ISnackbar Snackbar

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<CustomerDto> Customers { get; set; } = new();
    [Parameter] public List<(Guid Id, string Name, string SKU, decimal Price)> Products { get; set; } = new();
    [Parameter] public CreateSalesOrderDtoModels dataModel { get; set; } = new CreateSalesOrderDtoModels();
    [Parameter] public EventCallback<CreateSalesOrderDto> OnSubmit { get; set; }
    [Parameter] public EventCallback<CreateSalesOrderDto> OnSubmitAndPrint { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    
    private MudTextField<string>? RefNaration;
    private MudNumericField<int> RefQuantity;

    


    private List<BranchDto> _Branches = new();
    private static readonly ControlItemsDto AddNewCustomerOption = new ControlItemsDto(){ Id = Guid.Empty, Name = "Add New" };

    // private MudAutocomplete<FilterItem> CustomerDropDownControl = default!;
    // private string? _customerText;
    // private FilterItem? _lastCustomerSelection;    
    
    private string _branchtext = "";
    private int _editingItemIndex = -1;

    private static readonly ControlItemsDto AddNewProductOption = new(){ Id = Guid.Empty, Name = "Add New", IsSelected = false };


    private List<ProductSerial> _availableSerials = new();
    private IReadOnlyCollection<Guid> _selectedSerialSet = Array.Empty<Guid>();

    protected override async Task OnInitializedAsync()
    {
        _Branches = await BranchService.GetBranches();

        if (dataModel.BranchId == Guid.Empty)
            dataModel.BranchId = _Branches.FirstOrDefault()?.Id ?? Guid.Empty;

        //if (dataModel.CustomerDdlControl.SelectedItem != null && dataModel.CustomerDdlControl.SelectedItem?.Id == Guid.Empty && Customers.Count > 0)
          //  dataModel.CustomerDdlControl.SelectedItem = Customers.Select(x => new ControlItemsDto() { Id = x.Id, Name = x.CustomerName, IsSelected = x.IsActive }).First();

        if (dataModel.CustomerDdlControl.SelectedItem!=null && dataModel.CustomerDdlControl.SelectedItem?.Id != Guid.Empty)
        {
            dataModel.CustomerDdlControl.SelectedText = dataModel.CustomerDdlControl.SelectedItem.Name;
            dataModel.CustomerDdlControl.LastSelectedItem = dataModel.CustomerDdlControl.SelectedItem;
        }

        if (dataModel.ProductObj.ProductId == Guid.Empty && Products.Count > 0)
        {
            dataModel.ProductObj.ProductId = Products.First().Id;
            dataModel.ProductObj.UnitPrice = Products.First().Price;
        }
    }

    protected async Task OnBrancheValueChanged(Guid brancheId)
    {
        var branche = _Branches.FirstOrDefault(b => b.Id == brancheId);
        dataModel.BranchName = branche?.Name;
        _branchtext = branche?.Name;
        dataModel.BranchId = brancheId;
    }

    private async Task OnCustomerChanged()
    {
        var cust = dataModel.CustomerDdlControl.SelectedItem;

        if (cust?.Id == Guid.Empty)
        {
            var previousCustomer = dataModel.CustomerDdlControl.SelectedItem;
            var parameters = new DialogParameters<CustomerDialog>
            {
                { x => x.Customer, new CustomerDto(){ Id = Guid.Empty, CustomerName = string.Empty, CustomerEmail = string.Empty, CustomerPhone = string.Empty, Address = string.Empty, City = string.Empty, Zila = string.Empty, State = string.Empty, Country = string.Empty, PostalCode = string.Empty, CreditLimit = 0, PaymentTerms = string.Empty, IsActive = false, IsTaxExempt = false } }
                //{ x => x.Customer, Customers.Where(c => c.Id != Guid.Empty).FirstOrDefault() }
            };

            var dialog = await DialogService.ShowAsync<CustomerDialog>("New Customer", parameters,
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
            var result = await dialog.Result;

            await dataModel.CustomerDdlControl.ControlRef.ResetAsync();

            if (result != null && !result.Canceled && result.Data is CustomerDto dto)
            {
                var newCustomer = new IOMS.Domain.Entities.Customer
                {
                    CustomerName = dto.CustomerName,
                    CustomerEmail = dto.CustomerEmail,
                    CustomerPhone = dto.CustomerPhone,
                    ContactPersonName = dto.ContactPersonName,
                    ContactPersonPhone = dto.ContactPersonPhone,
                    ContactPersonEmail = dto.ContactPersonEmail,
                    Address = dto.Address,
                    City = dto.City,
                    State = dto.State,
                    Country = dto.Country,
                    PostalCode = dto.PostalCode,
                    CreditLimit = dto.CreditLimit,
                    PaymentTerms = dto.PaymentTerms,
                    IsTaxExempt = dto.IsTaxExempt
                };

                // await DbContext.SaveChangesAsync();
                // Snackbar.Add("Customer updated", Severity.Success);
                // await LoadData();

                DbContext.Customers.Add(newCustomer);
                await DbContext.SaveChangesAsync();
                var latestCustomer = await DbContext.Customers.ToListAsync();
                Customers = latestCustomer.Select(c => new CustomerDto()
                {
                    Id = c.Id,
                    CustomerName = c.CustomerName,
                    CustomerEmail = c.CustomerEmail,
                    CustomerPhone = c.CustomerPhone,
                    ContactPersonName = c.ContactPersonName,
                    ContactPersonPhone = c.ContactPersonPhone,
                    ContactPersonEmail = c.ContactPersonEmail,
                    Address = c.Address,
                    City = c.City,
                    Zila = c.Zila,
                    State = c.State,
                    Country = c.Country,
                    PostalCode = c.PostalCode,
                    CreditLimit = c.CreditLimit,
                    PaymentTerms = c.PaymentTerms,
                    IsActive = c.IsActive,
                    IsTaxExempt = c.IsTaxExempt
                }).ToList();

                cust = new ControlItemsDto(){ Id = newCustomer.Id, Name = newCustomer.CustomerName };

                //var latestCustomers = await DbContext.Customers.ToListAsync();

                await UpdateControlSelection(dataModel.CustomerDdlControl,cust);

                //dataModel.CustomerDdlControl.SelectedItem = cust;// Customers.Where(x => x.Id == newCustomer.Id).Select(c => new ControlItemsDto() { Id = c.Id, Name = c.CustomerName }).FirstOrDefault();
                //dataModel.CustomerDdlControl.SelectedItem
                //_selectedCustomer = Customers.FirstOrDefault();
                //_lastCustomerSelection = dataModel.SelectedCustomer;
                //_customerId = _selectedCustomer?.Id ?? Guid.Empty;
                //_customerText = dataModel.SelectedCustomer?.Name;

                StateHasChanged();
            }
            else
            {
                 await UpdateControlSelection(dataModel.CustomerDdlControl,cust);

                //dataModel.SelectedCustomer = previousCustomer;
                //_lastCustomerSelection = dataModel.SelectedCustomer;
                //_customer = previousCustomer;
                //_customerText = dataModel.SelectedCustomer?.Name;

                StateHasChanged();
            }
        }
        else
        {
            await UpdateControlSelection(dataModel.CustomerDdlControl, cust);
            //dataModel.SelectedCustomer = cust;
            //_lastCustomerSelection = dataModel.SelectedCustomer;
            //_customerText = dataModel.SelectedCustomer?.Name;
        }

        if (RefNaration is not null)
        {
            await RefNaration.FocusAsync();
        }
    }
   
    private async Task UpdateControlSelection(ControlDto control, ControlItemsDto? selectedItem)
    {
        if (selectedItem != null)
        {
            control.SelectedItem = selectedItem;
            control.LastSelectedItem = selectedItem;
            control.SelectedText = selectedItem.Name ?? selectedItem.Text1;
            control.SelectedIndex++;
        }
    }
  
    private Task<IEnumerable<ControlItemsDto>> SearchCustomers(string text, CancellationToken _)
    {
        IEnumerable<ControlItemsDto> baseResults;

        if (string.IsNullOrWhiteSpace(text))
        {
            baseResults = Customers.Where(c => c.Id != Guid.Empty).Select(c => new ControlItemsDto(){ Id = c.Id, Name = c.CustomerName });
        }
        else
        {
            baseResults = Customers.Where(c =>
                c.Id != Guid.Empty &&
                (c.CustomerName.Contains(text, StringComparison.OrdinalIgnoreCase)))
                .Select(c => new ControlItemsDto(){ Id = c.Id, Name = c.CustomerName });
        }

        var results = new[] { AddNewCustomerOption }.Concat(baseResults).DistinctBy(c => c.Id);
        //var results = baseResults.Append(AddNewCustomerOption).DistinctBy(c => c.Id).ToList();

        return Task.FromResult(results);
    }

    private async Task OnProductFilterChanged(Guid productId)
    {
        var p = Products.FirstOrDefault(p => p.Id == productId);
        if (p != default)
        {
            dataModel.ProductObj.ProductId = p.Id;
            dataModel.ProductObj.Quantity = 1;
            dataModel.ProductObj.UnitPrice = p.Price;
            dataModel.ProductObj.DiscountType = (int)DiscountType.Percentage;
            dataModel.ProductObj.DiscountAmount = 0m;
            dataModel.ProductObj.TotalDiscount = 0m;
        }
    }

    private async Task StartEditItem(int index, CreateSalesOrderItemDto item)
    {
        if (dataModel.ItemsLine.Any(x => x.ProductId == Guid.Empty)) return;

        _editingItemIndex = index;
        var product = Products.FirstOrDefault(p => p.Id == item.ProductId);
        dataModel.ProductObj.ProductId = item.ProductId;
        dataModel.ProductObj.ProductDdlControl.SelectedItem = product != default
            ? new ControlItemsDto(){Id = product.Id, Name = product.Name, IsSelected = false}
            : new ControlItemsDto(){Id = Guid.Empty, Name = "", IsSelected = false};
        dataModel.ProductObj.Quantity = item.Quantity;
        dataModel.ProductObj.UnitPrice = item.UnitPrice;
        dataModel.ProductObj.DiscountAmount = item.DiscountAmount;
        dataModel.ProductObj.DiscountType = (int)item.DiscountType;
        dataModel.ProductObj.TotalDiscount = item.TotalDiscountAmount;
        dataModel.ProductObj.TotalPrice = item.TotalPrice;

        await UpdateControlSelection(dataModel.ProductObj.ProductDdlControl, dataModel.ProductObj.ProductDdlControl.SelectedItem);

        //_editProductText = product != default ? product.Name : "";
        //_editLastProductSelection = dataModel.ProductObj.ProductDdlControl;
    }

    private async Task SaveEditItem(int index)
    {
        if (dataModel.ProductObj.ProductId == Guid.Empty || dataModel.ProductObj.Quantity <= 0) return;

        CalculateLineTotal();
        var updated = new CreateSalesOrderItemDto(
            dataModel.ProductObj.ProductId,
            dataModel.ProductObj.Quantity,
            dataModel.ProductObj.UnitPrice,
            dataModel.ProductObj.DiscountAmount,
            (DiscountType)dataModel.ProductObj.DiscountType,
            dataModel.ProductObj.TotalDiscount,
            dataModel.ProductObj.TotalPrice,
            null,
            dataModel.ItemsLine[index].SerialIds);

        dataModel.ItemsLine[index] = updated;
        dataModel.SubTotal = dataModel.ItemsLine.Sum(i => i.TotalPrice);
        _editingItemIndex = -1;
    }

    private async Task CancelEditItem()
    {
        _editingItemIndex = -1;
    }

    private async Task OnEditProductChanged()
    {
        var prod = dataModel.ProductObj.ProductDdlControl?.SelectedItem;
        if (prod == null) return;

        var p = Products.FirstOrDefault(p => p.Id == prod.Id);
        if (p != default)
        {
            dataModel.ProductObj.ProductId = p.Id;
            dataModel.ProductObj.UnitPrice = p.Price;
            dataModel.ProductObj.DiscountType = (int)DiscountType.Percentage;
            dataModel.ProductObj.DiscountAmount = 0m;
            dataModel.ProductObj.TotalDiscount = 0m;
        }
        dataModel.ProductObj.ProductDdlControl.LastSelectedItem = prod;
        dataModel.ProductObj.ProductDdlControl.SelectedText = prod?.Name;

        if (RefQuantity is not null)
        {
            await RefQuantity.FocusAsync();
        }
    }

    private async Task AddNewItem()
    {
        var item = dataModel.ItemsLine.Where(x => x.ProductId == Guid.Empty).FirstOrDefault();
        if (item != null) return;
        if (_editingItemIndex >= 0) return;

        dataModel.ProductObj.ProductDdlControl.LastSelectedItem = null;
        dataModel.ProductObj.ProductDdlControl.SelectedText = "";
        _availableSerials = new();
        _selectedSerialSet = Array.Empty<Guid>();
        dataModel.ProductObj.ProductDdlControl.SelectedItem = new ControlItemsDto(){ Id = Guid.Empty, Name = "", IsSelected = false };
        dataModel.ProductObj.SelectedSerialIds = new();

        dataModel.ItemsLine.Insert(0, new CreateSalesOrderItemDto(Guid.Empty, 0, 0, 0, DiscountType.Percentage, 0, 0, null));
        dataModel.ProductObj.Quantity = 1;
        dataModel.ProductObj.DiscountAmount = 0;
    }

    private async Task AddItem()
    {

        if (dataModel.ProductObj.ProductDdlControl.SelectedItem.Id == Guid.Empty || dataModel.ProductObj.Quantity <= 0) return;

        dataModel.ItemsLine.Insert(dataModel.ItemsLine.Count, new CreateSalesOrderItemDto(dataModel.ProductObj.ProductDdlControl.SelectedItem.Id, dataModel.ProductObj.Quantity, dataModel.ProductObj.UnitPrice, dataModel.ProductObj.DiscountAmount, (DiscountType)dataModel.ProductObj.DiscountType, dataModel.ProductObj.TotalDiscount, dataModel.ProductObj.TotalPrice, null, _selectedSerialSet.Count > 0 ? _selectedSerialSet.ToList() : null));
        dataModel.ProductObj.Quantity = 1;
        dataModel.ProductObj.DiscountAmount = 0;
        dataModel.ProductObj.SelectedSerialIds = new();
        dataModel.SubTotal = dataModel.ItemsLine.Sum(i => i.TotalPrice);
        _availableSerials = new();
        _selectedSerialSet = Array.Empty<Guid>();

        if (Products.Count > 0) { dataModel.ProductObj.ProductDdlControl.SelectedItem.Id = Products.First().Id; dataModel.ProductObj.ProductDdlControl.SelectedItem.Name = Products.First().Name; }

        //dataModel.ItemsLine = dataModel.ItemsLine.OrderByDescending(x => x.ProductId).ToList();
    }

    private async Task OnProductChanged()
    {
        var prod = dataModel.ProductObj.ProductDdlControl.SelectedItem;

        if (prod?.Id == Guid.Empty)
        {
            var categories = await DbContext.Categories.ToListAsync(); // TradeFlow.Web.Utility.Common.GetCategoryList(DbContext);
            var brands = await DbContext.Brands.OrderBy(b => b.Name).ToListAsync();
            var parameters = new DialogParameters<ProductAddEditDialog>
            {   { x => x.DataModel, new ProductDetailsDto() },
                { x => x.Categories, categories.Select(c => new CategoryDto(c.Id, c.Name, c.Description, c.ParentCategoryId,"",0,c.Path)).ToList() },
                { x => x.Brands, brands.Select(b => new BrandDto(b.Id, b.Name, b.BrandCode, b.Description,0)).ToList() }
            };

            var dialog = await DialogService.ShowAsync<ProductAddEditDialog>("New Product", parameters,
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
            var result = await dialog.Result;

            await dataModel.ProductObj.ProductDdlControl.ControlRef.ResetAsync();

            if (result != null && !result.Canceled && result.Data is ProductDetailsDto dto)
            {
                var product = new IOMS.Domain.Entities.Product
                {
                    Name = dto.Name,
                    SKU = dto.SKU,
                    Barcode = dto.Barcode,
                    Description = dto.Description,
                    CostPrice = dto.CostPrice,
                    SellingPrice = dto.SellingPrice,
                    MinOrderQuantity = dto.MinOrderQuantity,
                    ReorderStockLevel = dto.ReorderStockLevel,
                    CategoryId = dto.CategoryId,
                    BrandId = dto.BrandId,
                    ImageUrl = dto.ImageUrl,
                    Model = dto.Model
                };
                DbContext.Products.Add(product);
                await DbContext.SaveChangesAsync();
                Snackbar.Add("Product created successfully", Severity.Success);

                var latestProduct = await DbContext.Products.ToListAsync();
                Products = latestProduct.Select(p => (p.Id, p.Name, p.SKU, p.SellingPrice)).ToList();

                prod = new ControlItemsDto(){ Id = product.Id, Name = product.Name, IsSelected = false };
               

                var p = Products.FirstOrDefault(p => p.Id == prod.Id);
                if (p != default)
                {
                    dataModel.ProductObj.ProductId = p.Id;
                    dataModel.ProductObj.Quantity = 1;
                    dataModel.ProductObj.UnitPrice = p.Price;
                    dataModel.ProductObj.DiscountType = (int)DiscountType.Percentage;
                    dataModel.ProductObj.DiscountAmount = 0m;
                    dataModel.ProductObj.TotalDiscount = 0m;
                }
                // dataModel.ProductObj.ProductDdlControl.SelectedItem = prod;
                // dataModel.ProductObj.ProductDdlControl.LastSelectedItem = prod;
                // dataModel.ProductObj.ProductDdlControl.SelectedText = prod?.Name;

                await UpdateControlSelection(dataModel.ProductObj.ProductDdlControl, prod);

                StateHasChanged();
            }
            else
            {
                var previousProduct = dataModel.ProductObj.ProductDdlControl.LastSelectedItem;
                var p = Products.FirstOrDefault(p => p.Id == previousProduct?.Id);
                if (p != default)
                {
                    dataModel.ProductObj.ProductId = p.Id;
                    dataModel.ProductObj.Quantity = 1;
                    dataModel.ProductObj.UnitPrice = p.Price;
                    dataModel.ProductObj.DiscountType = (int)DiscountType.Percentage;
                    dataModel.ProductObj.DiscountAmount = 0m;
                    dataModel.ProductObj.TotalDiscount = 0m;
                }
                
                await UpdateControlSelection(dataModel.ProductObj.ProductDdlControl, previousProduct);

                StateHasChanged();
            }
        }
        else
        {
            var p = Products.FirstOrDefault(p => p.Id == prod?.Id);
            if (p != default)
            {
                dataModel.ProductObj.ProductId = p.Id;
                dataModel.ProductObj.Quantity = 1;
                dataModel.ProductObj.UnitPrice = p.Price;
                dataModel.ProductObj.DiscountType = (int)DiscountType.Percentage;
                dataModel.ProductObj.DiscountAmount = 0m;
                dataModel.ProductObj.TotalDiscount = 0m;

                // Load available serials for this product
                _selectedSerialSet = Array.Empty<Guid>();
                _availableSerials = await DbContext.ProductSerials
                    .Where(ps => ps.ProductId == p.Id && ps.Status == ProductSerialStatus.Available)
                    .ToListAsync();
            }
            await UpdateControlSelection(dataModel.ProductObj.ProductDdlControl, prod);
        }

        if (RefQuantity is not null)
        {
            await RefQuantity.FocusAsync();
        }
    }

    private Task<IEnumerable<ControlItemsDto>> SearchProducts(string text, CancellationToken _)
    {
        IEnumerable<ControlItemsDto> baseResults;

        if (string.IsNullOrWhiteSpace(text))
        {
            baseResults = Products.Where(c => c.Id != Guid.Empty).Select(c => new ControlItemsDto(){ Id = c.Id, Name = c.Name, IsSelected = false });
        }
        else
        {
            baseResults = Products.Where(c =>
                c.Id != Guid.Empty &&
                (c.Name.Contains(text, StringComparison.OrdinalIgnoreCase)))
                .Select(c => new ControlItemsDto(){ Id = c.Id, Name = c.Name, IsSelected = false });
        }

        //var results = new[] { AddNewCustomerOption }.Concat(baseResults).DistinctBy(c => c.Id);
        var results = baseResults.Append(AddNewCustomerOption).DistinctBy(c => c.Id);

        return Task.FromResult(results);
    }
    
    private async Task ToggleSerial(Guid id, bool selected)
    {
        if (selected) _selectedSerialSet = _selectedSerialSet.Append(id).ToArray();
        else _selectedSerialSet = _selectedSerialSet.Where(x => x != id).ToArray();
    }

    private async Task CalculateLineTotal()
    {
        dataModel.ProductObj.TotalDiscount = 0;
        if (dataModel.ProductObj.DiscountType == (int)DiscountType.Percentage)
        {
            dataModel.ProductObj.TotalDiscount = (dataModel.ProductObj.UnitPrice * dataModel.ProductObj.Quantity) * (dataModel.ProductObj.DiscountAmount / 100);
        }
        else
        {
            dataModel.ProductObj.TotalDiscount = dataModel.ProductObj.DiscountAmount;
        }

        dataModel.ProductObj.TotalPrice = ((dataModel.ProductObj.UnitPrice * dataModel.ProductObj.Quantity) - dataModel.ProductObj.TotalDiscount);
    }

    private async Task CalculationBalance()
    {
        decimal totalVatAmount = 0;
        decimal vat = dataModel.TaxAmount;
        if (vat > 0)
            totalVatAmount = (dataModel.SubTotal) * ((dataModel.TaxAmount) / 100); ;

        dataModel.TotalAmount = (dataModel.SubTotal) + totalVatAmount + (dataModel.LabourCharge) + (dataModel.TruckCharge);

        decimal? discountAmt = 0m;

        if (dataModel.DiscountType == (int)DiscountType.Percentage)
        {
            discountAmt = (dataModel.SubTotal) * (dataModel.DiscountAmount / 100);
        }
        else
        {
            discountAmt = dataModel.DiscountAmount;
        }

        dataModel.TotalAmount = dataModel.TotalAmount - (discountAmt ?? 0);

        dataModel.DueAmount = (dataModel.TotalAmount) - (dataModel.PaidAmount);
    }

