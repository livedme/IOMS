@page "/shop/branches"
@rendermode InteractiveServer
@inject IBranchService BranchService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

<PageTitle>Branches - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="🏢" Title="Branches" Subtitle="Manage your outlet locations, codes and branch details">
        <Actions>
            <button class="tm-reset" @onclick="LoadBranches">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="OpenCreate">+ New Branch</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="🏢" Number="@_branches.Count" Label="Branches" Tone="blue" />
        <TmStatTile Icon="✔" Number="@CountOf(true)" Label="Active" Tone="green" OnClick="@(() => PickActive(true))" />
        <TmStatTile Icon="⏸" Number="@CountOf(false)" Label="Inactive" Tone="red" OnClick="@(() => PickActive(false))" />
        <TmStatTile Icon="📍" Number="@CountWithLocation" Label="With Location" Tone="purple" />
        <TmStatTile Icon="🏷" Number="@_branches.Select(b => b.Code).Distinct().Count()" Label="Unique Codes" Tone="teal" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by name, code or location..." value="@_search" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select @onchange="OnStatusChanged">
                <option value="" selected="@(_activeFilter == null)">All Status</option>
                <option value="active" selected="@(_activeFilter == true)">Active</option>
                <option value="inactive" selected="@(_activeFilter == false)">Inactive</option>
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:900px">
                <thead>
                    <tr>
                        <th>🏢 Branch</th>
                        <th>🏷 Code</th>
                        <th>📍 Location</th>
                        <th>🏠 Address</th>
                        <th>Status</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="6"><TmLoading Message="Loading branches..." /></td></tr>
                    }
                    else if (Paged.Count == 0)
                    {
                        <tr><td colspan="6"><div class="tm-loading">No branches found</div></td></tr>
                    }
                    else
                    {
                        @foreach (var b in Paged)
                        {
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#ede9fe">🏢</span>@b.Name</span></td>
                                <td><span class="tm-pill tm-pill-purple"><span class="tm-dot"></span>@(string.IsNullOrWhiteSpace(b.Code) ? "-" : b.Code)</span></td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(b.Location) ? "-" : b.Location)</td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(b.Address) ? "-" : b.Address)</td>
                                <td>
                                    <span class="@(b.IsActive ? "tm-pill tm-pill-green" : "tm-pill tm-pill-red")">
                                        <span class="tm-dot"></span>@(b.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-edit" title="Edit" @onclick="() => OpenEdit(b)">✎</button>
                                        <button class="tm-act tm-act-del" title="Delete" @onclick="() => Delete(b.Id)">🗑</button>
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <TmPager Total="@Filtered.Count" Page="@_page" PageSize="@_pageSize" ItemNoun="branches"
                  PageChanged="@(p => _page = p)" PageSizeChanged="@OnPageSizeChanged" />
    </div>
</div>

@code {
    private List<BranchDto> _branches = new();
    private BranchDto _branche = new BranchDto(Guid.Empty, "", "", null, null, true);
    private string _search = "";
    private bool? _activeFilter;
    private bool _loading = true;
    private int _page = 1;
    private int _pageSize = 10;

    private int CountWithLocation => _branches.Count(b => !string.IsNullOrWhiteSpace(b.Location));

    private List<BranchDto> Filtered => _branches.Where(b =>
        (_activeFilter == null || b.IsActive == _activeFilter.Value)
        && (string.IsNullOrWhiteSpace(_search)
            || (b.Name?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (b.Code?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (b.Location?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (b.Address?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))).ToList();

    private List<BranchDto> Paged => Filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    private int CountOf(bool active) => _branches.Count(b => b.IsActive == active);

    protected override async Task OnInitializedAsync() => await LoadBranches();

    private async Task LoadBranches()
    {
        _loading = true;
        try { _branches = await BranchService.GetBranches(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _loading = false;
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<BrancheDialog>
        {
            { x => x.Branch, _branche }
        };

        var dialog = await DialogService.ShowAsync<BrancheDialog>("New Branch", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = false, CloseButton = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateBranchDto dto)
        {
            try
            {
                await BranchService.CreateBranch(dto);
                Snackbar.Add("Branch created successfully", Severity.Success);
                await LoadBranches();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task OpenEdit(BranchDto item)
    {
        var entity = await BranchService.GetBranchById(item.Id);
        if (entity == null) return;

        var dto = new BranchDto(entity.Id, entity.Name, entity.Code, entity.Location, entity.Address, entity.IsActive);

        var parameters = new DialogParameters<BrancheDialog> { { x => x.Branch, dto } };
        var dialog = await DialogService.ShowAsync<BrancheDialog>("Edit Branch", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is CreateBranchDto updated)
        {
            await BranchService.UpdateBranch(entity.Id, updated);
            Snackbar.Add("Branch updated", Severity.Success);
            await LoadBranches();
        }
    }

    private async Task Delete(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Confirm", "Delete this branch?", "Delete", "Cancel");
        if (confirm == true)
        {
            var entity = await BranchService.GetBranchById(id);
            if (entity != null) { await BranchService.DeleteBranch(id); await LoadBranches(); }
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 1;
    }

    private void OnStatusChanged(ChangeEventArgs e)
    {
        _activeFilter = e.Value?.ToString() switch
        {
            "active" => true,
            "inactive" => false,
            _ => null
        };
        _page = 1;
    }

    private void PickActive(bool active)
    {
        _activeFilter = _activeFilter == active ? null : active;
        _page = 1;
    }

    private void ResetFilters()
    {
        _search = "";
        _activeFilter = null;
        _page = 1;
    }

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
    }
}
