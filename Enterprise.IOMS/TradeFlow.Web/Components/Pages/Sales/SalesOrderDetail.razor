@page "/orders/sales/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IOrderService OrderService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Sales Order Detail - IOMS</PageTitle>

@if (_order == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <div class="p-4">
        <MudItem xs="12">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/orders/sales"))">Back to Orders</MudButton>
        </MudItem>
        <MudItem xs="12" Class="my-3">
            <div class="d-flex">
            <MudText Typo="Typo.h5">Reference# @_order.OrderNumber</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Class="py-0" OnClick="@(() => Nav.NavigateTo("/orders/sales"))"></MudIconButton>
            </div>
        </MudItem>
        <div class="info-card mb-4">
            <div class="row g-4">
                <div class="col-lg-3 col-md-4">
                    <div class="d-flex gap-3">
                        <div class="icon-circle"><i class="fa fa-building"></i></div>
                        <div>
                            <div class="text-muted">Customer</div>
                            <h5>@_order.Customer?.CustomerName</h5>
                            @_order.Customer?.Address<br>
                            @_order.Customer?.City, @_order.Customer?.State @_order.Customer?.PostalCode<br>
                            @_order.Customer?.CustomerEmail<br>
                            Phone: @_order.Customer?.CustomerPhone
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-4">
                    <div class="d-flex gap-3">
                        <div class="icon-circle"><i class="fa fa-calendar"></i></div>
                        <div>
                            <div class="text-muted">Order Date</div>
                            <h5>@_order.OrderDate.ToString("dd-MMM-yyyy")</h5>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-4">
                    <div class="d-flex gap-3">
                        <div class="icon-circle"><i class="fa fa-tag"></i></div>
                        <div>
                            <div class="text-muted">Status</div>
                            <br>
                            <span class="badge @CommonUtility.GetStatusColor(_order.Status) px-3 py-2">
                                @_order.Status
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-4">
                    <div class="d-flex gap-3">
                        <div class="icon-circle"><i class="fa fa-tag"></i></div>
                        <div>
                            <div class="text-muted">Branch</div>
                            <h5>@_order.Branch?.Name</h5>
                            @_order.Branch?.Location<br>
                            @_order.Branch?.Address<br>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- PRODUCTS -->

        <div class="row g-4">
            <div class="col-lg-8">
                <MudItem xs="12">
                    <MudTable Items="@_order.Items" Dense="true" Hover="true" Elevation="2" ContainerClass="table-responsive" TableClass="table table-bordered m-0" HeaderClass="table-dark-custom">
                        <HeaderContent>
                            <MudTh>#</MudTh>
                            <MudTh>Product</MudTh>
                            <MudTh>SKU</MudTh>
                            <MudTh Style="text-align:right">Qty</MudTh>
                            <MudTh Style="text-align:right">Unit Price</MudTh>
                            <MudTh Style="text-align:right">Discount</MudTh>
                            <MudTh Style="text-align:right">Total</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="#">
                                @(_order.Items.IndexOf(context) + 1)
                            </MudTd>
                            <MudTd>@context.ProductName</MudTd>
                            <MudTd>@context.ProductSKU</MudTd>
                            <MudTd Style="text-align:right">@context.Quantity</MudTd>
                            <MudTd Style="text-align:right">@context.UnitPrice.ToString("C")</MudTd>
                            <MudTd Style="text-align:right">@context.TotalDiscount.ToString("C")</MudTd>
                            <MudTd Style="text-align:right">@context.LineTotalPrice.ToString("C")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudItem>
            </div>
            <div class="col-lg-4">
                <div class="summary-card">
                    <h5 class="text-primary mb-4">
                        ORDER SUMMARY
                    </h5>

                    <div class="summary-item">
                        <span>Subtotal</span>
                        <strong>@_order.SubTotal.ToString("C")</strong>
                    </div>

                    <div class="summary-item">
                        <span>Discount</span>
                        <strong>@_order.DiscountAmount.ToString("C")</strong>
                    </div>
                    <div class="summary-item">
                        <span>Tax</span>
                        <strong>@_order.TaxAmount.ToString("C")</strong>
                    </div>
                    <div class="summary-item">
                        <span>Labour</span>
                        <strong>@_order.LabourCharge.ToString("C")</strong>
                    </div>

                    <div class="summary-item">
                        <span>Truck</span>
                        <strong>@_order.TruckCharge.ToString("C")</strong>
                    </div>

                    <div class="pt-4">
                        <h5>TOTAL</h5>
                        <div class="total-price">
                            @_order.TotalAmount.ToString("C")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    
        @if (!string.IsNullOrWhiteSpace(_order.Notes))
        {
            <MudItem xs="12">
                <MudField Label="Notes">@_order.Notes</MudField>
            </MudItem>
        }
    </div>

}


@code {
    [Parameter] public Guid Id { get; set; }
    private SalesOrderDto? _order;
    private CustomerDto? _customer;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _order = await OrderService.GetSalesOrderById(Id);
            _customer = _order.Customer;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
