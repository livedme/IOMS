@page "/quotes"
@rendermode InteractiveServer
@inject IQuotationService QuotationService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Quotations - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="📝" Title="Sales Quotations" Subtitle="Create, track and convert customer quotations into orders">
        <Actions>
            <button class="tm-reset" @onclick="Load">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="OpenCreateDialog">+ New Quotation</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="📝" Number="@_quotes.Count" Label="Quotations" Tone="blue" />
        <TmStatTile Icon="📄" Number="@CountOf(QuoteStatus.Draft)" Label="Draft" Tone="purple" OnClick="@(() => PickStatus(QuoteStatus.Draft))" />
        <TmStatTile Icon="📤" Number="@CountOf(QuoteStatus.Sent)" Label="Sent" Tone="yellow" OnClick="@(() => PickStatus(QuoteStatus.Sent))" />
        <TmStatTile Icon="✔" Number="@CountOf(QuoteStatus.Accepted)" Label="Accepted" Tone="green" OnClick="@(() => PickStatus(QuoteStatus.Accepted))" />
        <TmStatTile Icon="✕" Number="@CountOf(QuoteStatus.Rejected)" Label="Rejected" Tone="red" OnClick="@(() => PickStatus(QuoteStatus.Rejected))" />
        <TmStatTile Icon="💰" Number="@TotalValue" Label="Total Quoted" Tone="teal" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by quote number or customer..." value="@_search" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select @onchange="OnStatusChanged">
                <option value="" selected="@(_statusFilter == null)">All Status</option>
                @foreach (QuoteStatus s in Enum.GetValues<QuoteStatus>())
                {
                    <option value="@s" selected="@(_statusFilter == s)">@s</option>
                }
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:1000px">
                <thead>
                    <tr>
                        <th>📄 Quote #</th>
                        <th>👤 Customer</th>
                        <th>📅 Date</th>
                        <th>⏳ Valid Until</th>
                        <th>Status</th>
                        <th style="text-align:right">Total</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="7"><TmLoading Message="Loading quotations..." /></td></tr>
                    }
                    else if (Paged.Count == 0)
                    {
                        <tr><td colspan="7"><div class="tm-loading">No quotations found</div></td></tr>
                    }
                    else
                    {
                        @foreach (var q in Paged)
                        {
                            var isExpired = q.ValidUntil < DateTime.Today;
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#e0e9ff">📄</span>@q.QuoteNumber</span></td>
                                <td class="tm-branch">@(string.IsNullOrWhiteSpace(q.CustomerName) ? "-" : q.CustomerName)</td>
                                <td class="tm-dim">@q.QuoteDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="@(isExpired ? "tm-date-red" : "tm-dim")">
                                        @q.ValidUntil.ToString("dd MMM yyyy")@(isExpired ? " (expired)" : "")
                                    </span>
                                </td>
                                <td><span class="@GetStatusPill(q.Status)"><span class="tm-dot"></span>@q.Status</span></td>
                                <td style="text-align:right" class="tm-money">@q.TotalAmount.ToString("N0")</td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-view" title="View" @onclick="() => ViewQuote(q.Id)">👁</button>
                                        @if (q.Status == QuoteStatus.Draft || q.Status == QuoteStatus.Sent)
                                        {
                                            <button class="tm-act" style="color:#16a34a" title="Accept" @onclick="() => AcceptQuote(q.Id)">✔</button>
                                            <button class="tm-act tm-act-del" title="Reject" @onclick="() => RejectQuote(q.Id)">✕</button>
                                        }
                                        @if (q.Status == QuoteStatus.Accepted)
                                        {
                                            <button class="tm-act tm-act-view" title="Convert to Order" @onclick="() => ConvertToOrder(q.Id)">🛒</button>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <TmPager Total="@Filtered.Count" Page="@_page" PageSize="@_pageSize" ItemNoun="quotations"
                  PageChanged="@(p => _page = p)" PageSizeChanged="@OnPageSizeChanged" />
    </div>
</div>

<TmSlideDrawer @bind-Open="_drawerOpen" Title="@_drawerTitle" Width="1000px">
    @if (_viewQuote == null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        var isExpired = _viewQuote.ValidUntil < DateTime.Today;
        <div class="tm-info-card mb-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="text-muted small">Customer</div>
                    <strong>@(string.IsNullOrWhiteSpace(_viewQuote.CustomerName) ? "-" : _viewQuote.CustomerName)</strong>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Quote Date</div>
                    <strong>@_viewQuote.QuoteDate.ToString("dd-MMM-yyyy")</strong>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Valid Until</div>
                    <strong class="@(isExpired ? "text-danger" : "")">@_viewQuote.ValidUntil.ToString("dd-MMM-yyyy")@(isExpired ? " (expired)" : "")</strong>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Status</div>
                    <MudChip T="string" Color="@CommonUtility.GetStatusColor(_viewQuote.Status)" Size="Size.Small">
                        @_viewQuote.Status
                    </MudChip>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <table class="tm-slide-items">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>SKU</th>
                            <th style="text-align:right">Qty</th>
                            <th style="text-align:right">Unit Price</th>
                            <th style="text-align:right">Disc %</th>
                            <th style="text-align:right">Tax</th>
                            <th style="text-align:right">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_viewQuote.Items == null || _viewQuote.Items.Count == 0)
                        {
                            <tr><td colspan="8"><div class="tm-loading">No items on this quotation</div></td></tr>
                        }
                        else
                        {
                            @for (var i = 0; i < _viewQuote.Items.Count; i++)
                            {
                                var it = _viewQuote.Items[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@it.ProductName</td>
                                    <td>@it.ProductSKU</td>
                                    <td style="text-align:right">@it.Quantity</td>
                                    <td style="text-align:right">@it.UnitPrice.ToString("C")</td>
                                    <td style="text-align:right">@it.DiscountPercent.ToString("N0")%</td>
                                    <td style="text-align:right">@it.TaxAmount.ToString("C")</td>
                                    <td style="text-align:right">@it.LineTotal.ToString("C")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="col-lg-4">
                <div class="tm-summary-card">
                    <h6 class="text-primary mb-3">QUOTE SUMMARY</h6>
                    <div class="tm-summary-item"><span>Subtotal</span><strong>@_viewQuote.SubTotal.ToString("C")</strong></div>
                    <div class="tm-summary-item"><span>Discount</span><strong>@_viewQuote.DiscountAmount.ToString("C")</strong></div>
                    <div class="tm-summary-item"><span>Tax</span><strong>@_viewQuote.TaxAmount.ToString("C")</strong></div>
                    <div class="pt-3 border-top mt-2">
                        <div class="d-flex justify-content-between">
                            <strong>TOTAL</strong>
                            <span class="text-primary fw-bold fs-5">@_viewQuote.TotalAmount.ToString("C")</span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_viewQuote.Notes))
                {
                    <MudField Label="Notes" Class="mt-3">@_viewQuote.Notes</MudField>
                }
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            @if (_viewQuote.Status == QuoteStatus.Draft || _viewQuote.Status == QuoteStatus.Sent)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle"
                           OnClick="@(() => AcceptAndRefresh(_viewQuote.Id))">Accept</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel"
                           OnClick="@(() => RejectAndRefresh(_viewQuote.Id))">Reject</MudButton>
            }
            @if (_viewQuote.Status == QuoteStatus.Accepted)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ShoppingCart"
                           OnClick="@(() => ConvertAndRefresh(_viewQuote.Id))">Convert to Order</MudButton>
            }
        </div>
    }
</TmSlideDrawer>

@code {
    private List<SalesQuoteDto> _quotes = new();
    private string _search = "";
    private QuoteStatus? _statusFilter;
    private bool _loading = true;
    private int _page = 1;
    private int _pageSize = 10;
    private decimal TotalValue => _quotes.Sum(q => q.TotalAmount);
    private System.Timers.Timer? _debounce;

    // ─── Drawer state ───
    private bool _drawerOpen;
    private string _drawerTitle = "";
    private SalesQuoteDto? _viewQuote;

    protected override async Task OnInitializedAsync() => await Load();

    private List<SalesQuoteDto> Filtered => _quotes.Where(q =>
        (_statusFilter == null || q.Status == _statusFilter.Value)
        && (string.IsNullOrWhiteSpace(_search)
            || q.QuoteNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || q.CustomerName.Contains(_search, StringComparison.OrdinalIgnoreCase))).ToList();

    private List<SalesQuoteDto> Paged => Filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    private int CountOf(QuoteStatus s) => _quotes.Count(q => q.Status == s);

    private async Task Load()
    {
        _loading = true;
        try
        {
            var result = await QuotationService.GetSalesQuotes(_search, _statusFilter, _page, _pageSize);
            _quotes = result.Items;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task ViewQuote(Guid id)
    {
        _viewQuote = null;
        _drawerTitle = "Loading…";
        _drawerOpen = true;
        try
        {
            _viewQuote = await QuotationService.GetSalesQuoteById(id);
            _drawerTitle = $"Quote #{_viewQuote?.QuoteNumber}";
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void CloseDrawer() => _drawerOpen = false;

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<QuotationDialog>("New Quotation", new DialogParameters(),
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
            await Load();
    }

    private async Task AcceptQuote(Guid id)
    {
        try
        {
            await QuotationService.AcceptQuote(id);
            Snackbar.Add("Quote accepted", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task RejectQuote(Guid id)
    {
        try
        {
            await QuotationService.RejectQuote(id, "Rejected by user");
            Snackbar.Add("Quote rejected", Severity.Info);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ConvertToOrder(Guid id)
    {
        try
        {
            await QuotationService.ConvertQuoteToOrder(id);
            Snackbar.Add("Quotation converted to Sales Order", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task AcceptAndRefresh(Guid id)
    {
        await AcceptQuote(id);
        await ReloadView(id);
    }

    private async Task RejectAndRefresh(Guid id)
    {
        await RejectQuote(id);
        await ReloadView(id);
    }

    private async Task ConvertAndRefresh(Guid id)
    {
        await ConvertToOrder(id);
        await ReloadView(id);
    }

    private async Task ReloadView(Guid id)
    {
        if (!_drawerOpen) return;
        var refreshed = await QuotationService.GetSalesQuoteById(id);
        if (refreshed != null) _viewQuote = refreshed;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 1;
        _debounce?.Stop();
        _debounce?.Dispose();
        _debounce = new System.Timers.Timer(350) { AutoReset = false };
        _debounce.Elapsed += async (_, __) =>
        {
            await Load();
            await InvokeAsync(StateHasChanged);
        };
        _debounce.Start();
    }

    private void OnStatusChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _statusFilter = string.IsNullOrEmpty(v) ? null : Enum.Parse<QuoteStatus>(v);
        _page = 1;
    }

    private void PickStatus(QuoteStatus s)
    {
        _statusFilter = _statusFilter == s ? null : s;
        _page = 1;
    }

    private void ResetFilters()
    {
        _search = "";
        _statusFilter = null;
        _page = 1;
    }

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
    }

    private static string GetStatusPill(QuoteStatus status) => status switch
    {
        QuoteStatus.Draft => "tm-pill tm-pill-purple",
        QuoteStatus.Sent => "tm-pill tm-pill-blue",
        QuoteStatus.Accepted => "tm-pill tm-pill-green",
        QuoteStatus.Rejected => "tm-pill tm-pill-red",
        QuoteStatus.Expired => "tm-pill tm-pill-amber",
        QuoteStatus.Converted => "tm-pill tm-pill-green",
        _ => "tm-pill tm-pill-blue"
    };
}
