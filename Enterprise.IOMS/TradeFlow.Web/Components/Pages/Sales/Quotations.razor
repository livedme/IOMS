@page "/quotes"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject IQuotationService QuotationService
@inject ICustomerService CustomerService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Quotations - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="📝" Title="Sales Quotations" Subtitle="Create, track and convert customer quotations into orders">
        <Actions>
            <button class="tm-reset" @onclick="Refresh">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="OpenCreateDialog">+ New Quotation</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="📝" Number="@TotalCountText" Label="Quotations" Tone="blue" OnClick="@(() => FilterByStatus(null))" />
        <TmStatTile Icon="📄" Number="@DraftCountText" Label="Draft" Tone="purple" OnClick="@(() => FilterByStatus(QuoteStatus.Draft))" />
        <TmStatTile Icon="📤" Number="@SentCountText" Label="Sent" Tone="yellow" OnClick="@(() => FilterByStatus(QuoteStatus.Sent))" />
        <TmStatTile Icon="✔" Number="@AcceptedCountText" Label="Accepted" Tone="green" OnClick="@(() => FilterByStatus(QuoteStatus.Accepted))" />
        <TmStatTile Icon="✕" Number="@RejectedCountText" Label="Rejected" Tone="red" OnClick="@(() => FilterByStatus(QuoteStatus.Rejected))" />
        <TmStatTile Icon="💰" Number="@TotalValueText" Label="Total Quoted" Tone="teal" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by quote number or customer..." value="@pagedRequest.SearchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.CustomerId?.ToString() ?? "")" @onchange="OnCustomerChanged">
                <option value="">All Customers</option>
                @foreach (var c in _customers)
                {
                    <option value="@c.Id">@c.CustomerName</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.Status?.ToString() ?? "")" @onchange="OnStatusChanged">
                <option value="">All Status</option>
                @foreach (var s in QuoteStatuses)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <input type="date" value="@FormatDate(pagedRequest.From)" @onchange="OnFromChanged" title="From date" />
        </div>
        <div class="tm-select">
            <input type="date" value="@FormatDate(pagedRequest.To)" @onchange="OnToChanged" title="To date" />
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        @if (_loading)
        {
            <div style="position:absolute; inset:0; background:rgba(255,255,255,0.62); backdrop-filter:blur(1px); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2; border-radius:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Style="margin-top:8px; color:#334155; font-weight:600;">Loading quotations...</MudText>
            </div>
        }
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:1000px">
                <thead>
                    <tr>
                        <th @onclick="@(() => SortBy(Col.QuoteNumber))">📄 Quote # @SortIcon(Col.QuoteNumber)</th>
                        <th @onclick="@(() => SortBy(Col.Customer))">👤 Customer @SortIcon(Col.Customer)</th>
                        <th @onclick="@(() => SortBy(Col.QuoteDate))">📅 Date @SortIcon(Col.QuoteDate)</th>
                        <th @onclick="@(() => SortBy(Col.ValidUntil))">⏳ Valid Until @SortIcon(Col.ValidUntil)</th>
                        <th @onclick="@(() => SortBy(Col.Status))">Status @SortIcon(Col.Status)</th>
                        <th style="text-align:right" @onclick="@(() => SortBy(Col.TotalAmount))">Total @SortIcon(Col.TotalAmount)</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_hasLoadedOnce && _loading)
                    {
                        <tr><td colspan="7" style="text-align:center; padding:40px; color:#94a3b8;">Loading quotations...</td></tr>
                    }
                    else if (pagedResultNew.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" style="text-align:center; padding:40px;">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#94a3b8;" Class="mb-2" />
                                <div style="color:#64748b;">No quotations found — try a different search or filter</div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="ResetFilters">Clear filters</MudButton>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var q in pagedResultNew.Items)
                        {
                            var isExpired = q.ValidUntil < DateTime.Today;
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#e0e9ff">📄</span>@q.QuoteNumber</span></td>
                                <td class="tm-branch">@(string.IsNullOrWhiteSpace(q.CustomerName) ? "-" : q.CustomerName)</td>
                                <td class="tm-dim">@q.QuoteDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="@(isExpired ? "tm-date-red" : "tm-dim")">
                                        @q.ValidUntil.ToString("dd MMM yyyy")@(isExpired ? " (expired)" : "")
                                    </span>
                                </td>
                                <td><span class="@GetStatusPill(q.Status)"><span class="tm-dot"></span>@q.Status</span></td>
                                <td style="text-align:right" class="tm-money">@q.TotalAmount.ToString("N0")</td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-view" title="View" @onclick="() => ViewQuote(q.Id)">👁</button>
                                        @if (q.Status == QuoteStatus.Draft || q.Status == QuoteStatus.Sent)
                                        {
                                            <button class="tm-act" style="color:#16a34a" title="Accept" @onclick="() => AcceptQuote(q.Id)">✔</button>
                                            <button class="tm-act tm-act-del" title="Reject" @onclick="() => RejectQuote(q.Id)">✕</button>
                                        }
                                        @if (q.Status == QuoteStatus.Accepted)
                                        {
                                            <button class="tm-act tm-act-view" title="Convert to Order" @onclick="() => ConvertToOrder(q.Id)">🛒</button>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div style="opacity:@(_loading ? "0.55" : "1"); pointer-events:@(_loading ? "none" : "auto");">
            <TmPager CurrentPage="pagedResultNew.CurrentPage"
                     PageSize="pagedResultNew.PageSize"
                     TotalCount="pagedResultNew.TotalCount"
                     TotalPages="pagedResultNew.TotalPages"
                     ItemLabel="Quotations"
                     OnGoToPage="GoToPage"
                     OnPrev="GoPrevPage"
                     OnNext="GoNextPage"
                     OnPageSizeChanged="OnPageSizeChanged" />
        </div>
    </div>
</div>

<TmSlideDrawer @bind-Open="_drawerOpen" Title="@_drawerTitle" Width="1000px">
    @if (_viewQuote == null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        var isExpired = _viewQuote.ValidUntil < DateTime.Today;
        <div class="tm-info-card mb-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="text-muted small">Customer</div>
                    <strong>@(string.IsNullOrWhiteSpace(_viewQuote.CustomerName) ? "-" : _viewQuote.CustomerName)</strong>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Quote Date</div>
                    <strong>@_viewQuote.QuoteDate.ToString("dd-MMM-yyyy")</strong>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Valid Until</div>
                    <strong class="@(isExpired ? "text-danger" : "")">@_viewQuote.ValidUntil.ToString("dd-MMM-yyyy")@(isExpired ? " (expired)" : "")</strong>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Status</div>
                    <MudChip T="string" Color="@CommonUtility.GetStatusColor(_viewQuote.Status)" Size="Size.Small">
                        @_viewQuote.Status
                    </MudChip>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <table class="tm-slide-items">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>SKU</th>
                            <th style="text-align:right">Qty</th>
                            <th style="text-align:right">Unit Price</th>
                            <th style="text-align:right">Disc %</th>
                            <th style="text-align:right">Tax</th>
                            <th style="text-align:right">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_viewQuote.Items == null || _viewQuote.Items.Count == 0)
                        {
                            <tr><td colspan="8"><div class="tm-loading">No items on this quotation</div></td></tr>
                        }
                        else
                        {
                            @for (var i = 0; i < _viewQuote.Items.Count; i++)
                            {
                                var it = _viewQuote.Items[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@it.ProductName</td>
                                    <td>@it.ProductSKU</td>
                                    <td style="text-align:right">@it.Quantity</td>
                                    <td style="text-align:right">@it.UnitPrice.ToString("C")</td>
                                    <td style="text-align:right">@it.DiscountPercent.ToString("N0")%</td>
                                    <td style="text-align:right">@it.TaxAmount.ToString("C")</td>
                                    <td style="text-align:right">@it.LineTotal.ToString("C")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="col-lg-4">
                <div class="tm-summary-card">
                    <h6 class="text-primary mb-3">QUOTE SUMMARY</h6>
                    <div class="tm-summary-item"><span>Subtotal</span><strong>@_viewQuote.SubTotal.ToString("C")</strong></div>
                    <div class="tm-summary-item"><span>Discount</span><strong>@_viewQuote.DiscountAmount.ToString("C")</strong></div>
                    <div class="tm-summary-item"><span>Tax</span><strong>@_viewQuote.TaxAmount.ToString("C")</strong></div>
                    <div class="pt-3 border-top mt-2">
                        <div class="d-flex justify-content-between">
                            <strong>TOTAL</strong>
                            <span class="text-primary fw-bold fs-5">@_viewQuote.TotalAmount.ToString("C")</span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_viewQuote.Notes))
                {
                    <MudField Label="Notes" Class="mt-3">@_viewQuote.Notes</MudField>
                }
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            @if (_viewQuote.Status == QuoteStatus.Draft || _viewQuote.Status == QuoteStatus.Sent)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle"
                           OnClick="@(() => AcceptAndRefresh(_viewQuote.Id))">Accept</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel"
                           OnClick="@(() => RejectAndRefresh(_viewQuote.Id))">Reject</MudButton>
            }
            @if (_viewQuote.Status == QuoteStatus.Accepted)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ShoppingCart"
                           OnClick="@(() => ConvertAndRefresh(_viewQuote.Id))">Convert to Order</MudButton>
            }
        </div>
    }
</TmSlideDrawer>

@code {
    private static class Col
    {
        public const string QuoteNumber = "QuoteNumber";
        public const string QuoteDate = "QuoteDate";
        public const string Customer = "Customer";
        public const string ValidUntil = "ValidUntil";
        public const string TotalAmount = "TotalAmount";
        public const string Status = "Status";
    }

    private readonly List<QuoteStatus> QuoteStatuses = Enum.GetValues<QuoteStatus>().ToList();

    // ─── List state ───
    private PagedResultNew<SalesQuoteDto> pagedResultNew = new();
    private QuotationPagedRequest pagedRequest = new()
    {
        SortColumn = Col.QuoteDate,
        SortAscending = false
    };

    private List<CustomerDto> _customers = new();
    private bool _loading = true;
    private bool _hasLoadedOnce;
    private bool _loadRunning;
    private bool _loadQueued;
    private CancellationTokenSource? _debounceCts;

    // ─── Drawer state ───
    private bool _drawerOpen;
    private string _drawerTitle = "";
    private SalesQuoteDto? _viewQuote;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var customers = await CustomerService.GetCustomersAsync(null, 1, 500);
            _customers = customers.Items;
        }
        catch { }

        await Load();
    }

    private async Task Refresh() => await Load();

    /// <summary>
    /// Single-flight loader. The page and the services share one scoped DbContext, so two
    /// overlapping queries would throw "A second operation was started on this context
    /// instance". Callers that arrive mid-flight set a flag instead of starting a parallel
    /// query, and the running load then re-runs once with the newest filter state.
    /// </summary>
    private async Task Load()
    {
        if (_loadRunning)
        {
            _loadQueued = true;
            return;
        }

        _loadRunning = true;
        try
        {
            do
            {
                _loadQueued = false;
                await LoadCore();
            }
            while (_loadQueued);
        }
        finally { _loadRunning = false; }
    }

    private async Task LoadCore()
    {
        _loading = true;
        try
        {
            pagedResultNew = await QuotationService.GetSalesQuotesAsync(pagedRequest);
            _hasLoadedOnce = true;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    // ─── Stats / sorting helpers ───
    private string TotalCountText => Stat("TotalCount");
    private string DraftCountText => Stat("DraftCount");
    private string SentCountText => Stat("SentCount");
    private string AcceptedCountText => Stat("AcceptedCount");
    private string RejectedCountText => Stat("RejectedCount");
    private string TotalValueText =>
        int.TryParse(Stat("TotalValue"), out var v) ? v.ToString("N0") : "0";

    private string Stat(string key) =>
        pagedResultNew.Stats != null && pagedResultNew.Stats.TryGetValue(key, out var v) ? v.ToString() : "0";

    private void SortBy(string column)
    {
        if (pagedRequest.SortColumn == column)
            pagedRequest.SortAscending = !pagedRequest.SortAscending;
        else
        {
            pagedRequest.SortColumn = column;
            pagedRequest.SortAscending = true;
        }
        pagedRequest.CurrentPage = 0;
    }

    private string SortIcon(string column)
    {
        if (pagedRequest.SortColumn != column) return "";
        return pagedRequest.SortAscending ? "▲" : "▼";
    }

    // ─── Filters ───
    private void OnSearchInput(ChangeEventArgs e)
    {
        pagedRequest.SearchTerm = e.Value?.ToString() ?? "";
        pagedRequest.CurrentPage = 0;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(async () =>
                {
                    await Load();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task OnCustomerChanged(ChangeEventArgs e)
    {
        pagedRequest.CustomerId = ParseGuid(e.Value);
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        pagedRequest.Status = Enum.TryParse<QuoteStatus>(e.Value?.ToString(), out var s) ? s : null;
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task OnFromChanged(ChangeEventArgs e)
    {
        pagedRequest.From = ParseDate(e.Value);
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task OnToChanged(ChangeEventArgs e)
    {
        pagedRequest.To = ParseDate(e.Value);
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task FilterByStatus(QuoteStatus? status)
    {
        pagedRequest.Status = pagedRequest.Status == status ? null : status;
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task ResetFilters()
    {
        pagedRequest.SearchTerm = "";
        pagedRequest.Status = null;
        pagedRequest.CustomerId = null;
        pagedRequest.From = null;
        pagedRequest.To = null;
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private static Guid? ParseGuid(object? value) =>
        Guid.TryParse(value?.ToString(), out var g) && g != Guid.Empty ? g : null;

    private static DateTime? ParseDate(object? value) =>
        DateTime.TryParse(value?.ToString(), out var d) ? d : null;

    private static string FormatDate(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";

    // ─── Paging (zero-based, matches TmPager) ───
    private async Task GoToPage(int page)
    {
        pagedRequest.CurrentPage = Math.Clamp(page, 0, Math.Max(0, pagedResultNew.TotalPages - 1));
        await Load();
    }

    private async Task GoPrevPage()
    {
        if (pagedRequest.CurrentPage > 0)
        {
            pagedRequest.CurrentPage--;
            await Load();
        }
    }

    private async Task GoNextPage()
    {
        if (pagedRequest.CurrentPage < pagedResultNew.TotalPages - 1)
        {
            pagedRequest.CurrentPage++;
            await Load();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sz))
        {
            pagedRequest.PageSize = Math.Clamp(sz, 1, 100);
            pagedRequest.CurrentPage = 0;
            await Load();
        }
    }

    private async Task ViewQuote(Guid id)
    {
        _viewQuote = null;
        _drawerTitle = "Loading…";
        _drawerOpen = true;
        try
        {
            _viewQuote = await QuotationService.GetSalesQuoteById(id);
            _drawerTitle = $"Quote #{_viewQuote?.QuoteNumber}";
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void CloseDrawer() => _drawerOpen = false;

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<QuotationDialog>("New Quotation", new DialogParameters(),
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
            await Load();
    }

    private async Task AcceptQuote(Guid id)
    {
        try
        {
            await QuotationService.AcceptQuote(id);
            Snackbar.Add("Quote accepted", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task RejectQuote(Guid id)
    {
        try
        {
            await QuotationService.RejectQuote(id, "Rejected by user");
            Snackbar.Add("Quote rejected", Severity.Info);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ConvertToOrder(Guid id)
    {
        try
        {
            await QuotationService.ConvertQuoteToOrder(id);
            Snackbar.Add("Quotation converted to Sales Order", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task AcceptAndRefresh(Guid id)
    {
        await AcceptQuote(id);
        await ReloadView(id);
    }

    private async Task RejectAndRefresh(Guid id)
    {
        await RejectQuote(id);
        await ReloadView(id);
    }

    private async Task ConvertAndRefresh(Guid id)
    {
        await ConvertToOrder(id);
        await ReloadView(id);
    }

    private async Task ReloadView(Guid id)
    {
        if (!_drawerOpen) return;
        var refreshed = await QuotationService.GetSalesQuoteById(id);
        if (refreshed != null) _viewQuote = refreshed;
    }

    private static string GetStatusPill(QuoteStatus status) => status switch
    {
        QuoteStatus.Draft => "tm-pill tm-pill-purple",
        QuoteStatus.Sent => "tm-pill tm-pill-blue",
        QuoteStatus.Accepted => "tm-pill tm-pill-green",
        QuoteStatus.Rejected => "tm-pill tm-pill-red",
        QuoteStatus.Expired => "tm-pill tm-pill-amber",
        QuoteStatus.Converted => "tm-pill tm-pill-green",
        _ => "tm-pill tm-pill-blue"
    };

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
