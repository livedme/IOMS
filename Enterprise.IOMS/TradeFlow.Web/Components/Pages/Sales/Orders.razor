@page "/sales/orders"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject IOrderService OrderService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using TradeFlow.Infrastructure.Data
@inject ApplicationDbContext DbContext

<PageTitle>Sales Orders - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="🧾" Title="Sales Orders" Subtitle="Track customer orders from approval through delivery">
        <Actions>
            <button class="tm-reset" @onclick="Refresh">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="OpenCreate">+ New Sales Order</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="🧾" Number="@TotalCountText" Label="Orders" Tone="blue" OnClick="@(() => FilterByStatus(null))" />
        <TmStatTile Icon="⏳" Number="@PendingCountText" Label="Pending" Tone="yellow" OnClick="@(() => FilterByStatus(OrderStatus.Pending))" />
        <TmStatTile Icon="⚙️" Number="@ApprovedCountText" Label="Approved" Tone="purple" OnClick="@(() => FilterByStatus(OrderStatus.Approved))" />
        <TmStatTile Icon="🚚" Number="@ShippedCountText" Label="Shipped" Tone="teal" OnClick="@(() => FilterByStatus(OrderStatus.Shipped))" />
        <TmStatTile Icon="✅" Number="@DeliveredCountText" Label="Delivered" Tone="green" OnClick="@(() => FilterByStatus(OrderStatus.Delivered))" />
        <TmStatTile Icon="💰" Number="@PageValueText" Label="Page Value" Tone="red" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by order number or customer..." value="@pagedRequest.SearchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.CustomerId?.ToString() ?? "")" @onchange="OnCustomerChanged">
                <option value="">All Customers</option>
                @foreach (var c in _customers)
                {
                    <option value="@c.Id">@c.CustomerName</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.BranchId?.ToString() ?? "")" @onchange="OnBranchChanged">
                <option value="">All Branches</option>
                @foreach (var b in _branches)
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.Status?.ToString() ?? "")" @onchange="OnStatusChanged">
                <option value="">All Status</option>
                @foreach (var s in OrderStatuses)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <input type="date" value="@FormatDate(pagedRequest.From)" @onchange="OnFromChanged" title="From date" />
        </div>
        <div class="tm-select">
            <input type="date" value="@FormatDate(pagedRequest.To)" @onchange="OnToChanged" title="To date" />
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        @if (_loading)
        {
            <div style="position:absolute; inset:0; background:rgba(255,255,255,0.62); backdrop-filter:blur(1px); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2; border-radius:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Style="margin-top:8px; color:#334155; font-weight:600;">Loading orders...</MudText>
            </div>
        }
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:950px">
                <thead>
                    <tr>
                        <th @onclick="@(() => SortBy(Col.OrderNumber))">🧾 Order # @SortIcon(Col.OrderNumber)</th>
                        <th @onclick="@(() => SortBy(Col.Customer))">👤 Customer @SortIcon(Col.Customer)</th>
                        <th @onclick="@(() => SortBy(Col.Branch))">🏬 Branch @SortIcon(Col.Branch)</th>
                        <th @onclick="@(() => SortBy(Col.OrderDate))">📅 Date @SortIcon(Col.OrderDate)</th>
                        <th @onclick="@(() => SortBy(Col.Status))">Status @SortIcon(Col.Status)</th>
                        <th style="text-align:right" @onclick="@(() => SortBy(Col.TotalAmount))">Total @SortIcon(Col.TotalAmount)</th>
                        <th style="text-align:right" @onclick="@(() => SortBy(Col.DueAmount))">Due @SortIcon(Col.DueAmount)</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_hasLoadedOnce && _loading)
                    {
                        <tr><td colspan="8" style="text-align:center; padding:40px; color:#94a3b8;">Loading orders...</td></tr>
                    }
                    else if (pagedResultNew.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="8" style="text-align:center; padding:40px;">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#94a3b8;" Class="mb-2" />
                                <div style="color:#64748b;">No sales orders found — try a different search or filter</div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="ResetFilters">Clear filters</MudButton>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var o in pagedResultNew.Items)
                        {
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#e0e9ff">🧾</span>@o.OrderNumber</span></td>
                                <td class="tm-branch">@(o.Customer?.CustomerName ?? "-")</td>
                                <td class="tm-dim">@(o.Branch?.Name ?? "-")</td>
                                <td class="tm-dim">@o.OrderDate.ToString("dd MMM yyyy")</td>
                                <td><span class="@GetStatusPill(o.Status)"><span class="tm-dot"></span>@o.Status</span></td>
                                <td style="text-align:right" class="tm-money">@o.TotalAmount.ToString("N0")</td>
                                <td style="text-align:right">
                                    <span style="font-weight:700; color:@(o.DueAmount > 0 ? "#dc2626" : "#15803d")">
                                        @(o.DueAmount > 0 ? o.DueAmount.ToString("N0") : "-")
                                    </span>
                                </td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-view" title="View" @onclick="() => ViewOrder(o.Id)">👁</button>                                        @if (o.Status == OrderStatus.Pending)
                                        {
                                            <button class="tm-act" style="color:#16a34a" title="Approve" @onclick="() => Approve(o.Id)">✔</button>
                                        }
                                        @if (o.Status != OrderStatus.Cancelled && o.Status != OrderStatus.Delivered)
                                        {
                                            <button class="tm-act tm-act-del" title="Cancel" @onclick="() => Cancel(o.Id)">✕</button>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div style="opacity:@(_loading ? "0.55" : "1"); pointer-events:@(_loading ? "none" : "auto");">
            <TmPager CurrentPage="pagedResultNew.CurrentPage"
                     PageSize="pagedResultNew.PageSize"
                     TotalCount="pagedResultNew.TotalCount"
                     TotalPages="pagedResultNew.TotalPages"
                     ItemLabel="Sales Orders"
                     OnGoToPage="GoToPage"
                     OnPrev="GoPrevPage"
                     OnNext="GoNextPage"
                     OnPageSizeChanged="OnPageSizeChanged" />
        </div>
    </div>
</div>

<TmSlideDrawer @bind-Open="_drawerOpen" Title="@_drawerTitle">
    @if (_viewOrder == null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <div class="tm-info-card mb-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="text-muted small">Customer</div>
                    <strong>@_viewOrder.Customer?.CustomerName</strong><br />
                    <span class="small">@_viewOrder.Customer?.CustomerPhone</span><br />
                    <span class="small">@_viewOrder.Customer?.CustomerEmail</span>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Order Date</div>
                    <strong>@_viewOrder.OrderDate.ToString("dd-MMM-yyyy")</strong>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Status</div>
                    <MudChip T="string" Color="@CommonUtility.GetStatusColor(_viewOrder.Status)" Size="Size.Small">
                        @_viewOrder.Status
                    </MudChip>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Branch</div>
                    <strong>@_viewOrder.Branch?.Name</strong><br />
                    <span class="small">@_viewOrder.Branch?.Location</span>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <MudTable Items="@_viewOrder.Items" Dense="true" Hover="true" Elevation="2">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>Product</MudTh>
                        <MudTh>SKU</MudTh>
                        <MudTh Style="text-align:right">Qty</MudTh>
                        <MudTh Style="text-align:right">Unit Price</MudTh>
                        <MudTh Style="text-align:right">Discount</MudTh>
                        <MudTh Style="text-align:right">Total</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@(_viewOrder.Items.IndexOf(context) + 1)</MudTd>
                        <MudTd>@context.ProductName</MudTd>
                        <MudTd>@context.ProductSKU</MudTd>
                        <MudTd Style="text-align:right">@context.Quantity</MudTd>
                        <MudTd Style="text-align:right">@context.UnitPrice.ToString("C")</MudTd>
                        <MudTd Style="text-align:right">@context.TotalDiscount.ToString("C")</MudTd>
                        <MudTd Style="text-align:right">@context.LineTotalPrice.ToString("C")</MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
            <div class="col-lg-4">
                <div class="tm-summary-card">
                    <h6 class="text-primary mb-3">ORDER SUMMARY</h6>
                    <div class="tm-summary-item"><span>Subtotal</span><strong>@_viewOrder.SubTotal.ToString("C")</strong></div>
                    <div class="tm-summary-item"><span>Discount</span><strong>@_viewOrder.DiscountAmount.ToString("C")</strong></div>
                    <div class="tm-summary-item"><span>Tax</span><strong>@_viewOrder.TaxAmount.ToString("C")</strong></div>
                    <div class="tm-summary-item"><span>Labour</span><strong>@_viewOrder.LabourCharge.ToString("C")</strong></div>
                    <div class="tm-summary-item"><span>Truck</span><strong>@_viewOrder.TruckCharge.ToString("C")</strong></div>
                    <div class="pt-3 border-top mt-2">
                        <div class="d-flex justify-content-between">
                            <strong>TOTAL</strong>
                            <span class="text-primary fw-bold fs-5">@_viewOrder.TotalAmount.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span class="text-muted">Paid</span>
                            <span class="text-success fw-semibold">@_viewOrder.PaidAmount.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span class="text-muted">Due</span>
                            <span class="text-danger fw-semibold">@_viewOrder.DueAmount.ToString("C")</span>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_viewOrder.Notes))
            {
                <MudField Label="Notes" Class="mt-3">@_viewOrder.Notes</MudField>
            }

            <div class="d-flex gap-2 mt-4">
                @if (_viewOrder.Status == OrderStatus.Pending)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle"
                               OnClick="@(() => ApproveAndRefresh(_viewOrder.Id))">Approve</MudButton>
                }
                @if (_viewOrder.Status != OrderStatus.Cancelled && _viewOrder.Status != OrderStatus.Delivered)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel"
                               OnClick="@(() => CancelFromDrawer(_viewOrder.Id))">Cancel Order</MudButton>
                }
            </div>
        </div>
    }
</TmSlideDrawer>

@code {
    private static class Col
    {
        public const string OrderNumber = "OrderNumber";
        public const string OrderDate = "OrderDate";
        public const string Customer = "Customer";
        public const string Branch = "Branch";
        public const string TotalAmount = "TotalAmount";
        public const string DueAmount = "DueAmount";
        public const string Status = "Status";
    }

    private readonly List<OrderStatus> OrderStatuses = Enum.GetValues<OrderStatus>().ToList();

    // ─── List state ───
    private PagedResultNew<SalesOrderDto> pagedResultNew = new();
    private SalesPagedRequest pagedRequest = new()
    {
        SortColumn = Col.OrderDate,
        SortAscending = false
    };

    private List<CustomerDto> _customers = new();
    private List<BranchDto> _branches = new();
    private bool _loading = true;
    private bool _hasLoadedOnce;
    private bool _loadRunning;
    private bool _loadQueued;
    private decimal _pageValue;
    private CancellationTokenSource? _debounceCts;

    // ─── Drawer state ───
    private bool _drawerOpen;
    private string _drawerTitle = "";
    private SalesOrderDto? _viewOrder;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _customers = await DbContext.Customers
                .Where(c => c.IsActive)
                .OrderBy(c => c.CustomerName)
                .Select(c => new CustomerDto { Id = c.Id, CustomerName = c.CustomerName })
                .ToListAsync();
        }
        catch { }

        try
        {
            _branches = await DbContext.Branches
                .Where(b => b.IsActive)
                .OrderBy(b => b.Name)
                .Select(b => new BranchDto(b.Id, b.Name, b.Code, b.Location, b.Address, b.IsActive))
                .ToListAsync();
        }
        catch { }

        await LoadOrders();
    }

    private async Task Refresh() => await LoadOrders();

    /// <summary>
    /// Single-flight loader. The page and the services share one scoped DbContext, so two
    /// overlapping queries would throw "A second operation was started on this context
    /// instance". Callers that arrive mid-flight set a flag instead of starting a parallel
    /// query, and the running load then re-runs once with the newest filter state.
    /// </summary>
    private async Task LoadOrders()
    {
        if (_loadRunning)
        {
            _loadQueued = true;
            return;
        }

        _loadRunning = true;
        try
        {
            do
            {
                _loadQueued = false;
                await LoadOrdersCore();
            }
            while (_loadQueued);
        }
        finally { _loadRunning = false; }
    }

    private async Task LoadOrdersCore()
    {
        _loading = true;
        try
        {
            pagedResultNew = await OrderService.GetSalesOrdersAsync(pagedRequest);
            _pageValue = pagedResultNew.Items.Sum(o => o.TotalAmount);
            _hasLoadedOnce = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading orders: {ex.Message}", Severity.Error);
        }
        finally { _loading = false; }
    }

    // ─── Stats / sorting helpers ───
    private string TotalCountText => Stat("TotalCount");
    private string PendingCountText => Stat("PendingCount");
    private string ApprovedCountText => Stat("ApprovedCount");
    private string ShippedCountText => Stat("ShippedCount");
    private string DeliveredCountText => Stat("DeliveredCount");
    private string PageValueText => _pageValue.ToString("N0");

    private string Stat(string key) =>
        pagedResultNew.Stats != null && pagedResultNew.Stats.TryGetValue(key, out var v) ? v.ToString() : "0";

    private void SortBy(string column)
    {
        if (pagedRequest.SortColumn == column)
            pagedRequest.SortAscending = !pagedRequest.SortAscending;
        else
        {
            pagedRequest.SortColumn = column;
            pagedRequest.SortAscending = true;
        }
        pagedRequest.CurrentPage = 0;
    }

    private string SortIcon(string column)
    {
        if (pagedRequest.SortColumn != column) return "";
        return pagedRequest.SortAscending ? "▲" : "▼";
    }

    // ─── Filters ───
    private void OnSearchInput(ChangeEventArgs e)
    {
        pagedRequest.SearchTerm = e.Value?.ToString() ?? "";
        pagedRequest.CurrentPage = 0;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(async () =>
                {
                    await LoadOrders();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task OnCustomerChanged(ChangeEventArgs e)
    {
        pagedRequest.CustomerId = ParseGuid(e.Value);
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task OnBranchChanged(ChangeEventArgs e)
    {
        pagedRequest.BranchId = ParseGuid(e.Value);
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        pagedRequest.Status = Enum.TryParse<OrderStatus>(e.Value?.ToString(), out var s) ? s : null;
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task OnFromChanged(ChangeEventArgs e)
    {
        pagedRequest.From = ParseDate(e.Value);
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task OnToChanged(ChangeEventArgs e)
    {
        pagedRequest.To = ParseDate(e.Value);
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task FilterByStatus(OrderStatus? status)
    {
        pagedRequest.Status = pagedRequest.Status == status ? null : status;
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task ResetFilters()
    {
        pagedRequest.SearchTerm = "";
        pagedRequest.Status = null;
        pagedRequest.CustomerId = null;
        pagedRequest.BranchId = null;
        pagedRequest.From = null;
        pagedRequest.To = null;
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private static Guid? ParseGuid(object? value) =>
        Guid.TryParse(value?.ToString(), out var g) && g != Guid.Empty ? g : null;

    private static DateTime? ParseDate(object? value) =>
        DateTime.TryParse(value?.ToString(), out var d) ? d : null;

    private static string FormatDate(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";

    // ─── Paging (zero-based, matches TmPager) ───
    private async Task GoToPage(int page)
    {
        pagedRequest.CurrentPage = Math.Clamp(page, 0, Math.Max(0, pagedResultNew.TotalPages - 1));
        await LoadOrders();
    }

    private async Task GoPrevPage()
    {
        if (pagedRequest.CurrentPage > 0)
        {
            pagedRequest.CurrentPage--;
            await LoadOrders();
        }
    }

    private async Task GoNextPage()
    {
        if (pagedRequest.CurrentPage < pagedResultNew.TotalPages - 1)
        {
            pagedRequest.CurrentPage++;
            await LoadOrders();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sz))
        {
            pagedRequest.PageSize = Math.Clamp(sz, 1, 100);
            pagedRequest.CurrentPage = 0;
            await LoadOrders();
        }
    }

    private async Task Approve(Guid id)
    {
        try
        {
            await OrderService.ApproveOrder(id);
            Snackbar.Add("Order approved successfully", Severity.Success);
            await LoadOrders();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Cancel(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Cancel Order", "Are you sure?", "Yes, Cancel", "No");
        if (confirm == true)
        {
            try
            {
                await OrderService.CancelOrder(id, "Cancelled by user");
                Snackbar.Add("Order cancelled", Severity.Warning);
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task ViewOrder(Guid id)
    {
        _viewOrder = null;
        _drawerTitle = "Loading…";
        _drawerOpen = true;
        try
        {
            _viewOrder = await OrderService.GetSalesOrderById(id);
            _drawerTitle = $"Order #{_viewOrder?.OrderNumber}";
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void CloseDrawer() => _drawerOpen = false;

    private async Task ApproveAndRefresh(Guid id)
    {
        await Approve(id);
        CloseDrawer();
    }

    private async Task CancelFromDrawer(Guid id)
    {
        await Cancel(id);
        if (_drawerOpen && _viewOrder?.Id == id)
            _viewOrder = await OrderService.GetSalesOrderById(id);
    }

    private async Task OpenCreate()
    {
        var customers = await DbContext.Customers.Where(c => c.IsActive).OrderBy(c => c.CustomerName).ToListAsync();
        var products = await DbContext.Products.OrderBy(p => p.Name).ToListAsync();

        var parameters = new DialogParameters<SalesOrderDialog>
        {
            { x => x.Customers, customers.Select(c => new CustomerDto(){ Id = c.Id, CustomerName = c.CustomerName, CustomerEmail = c.CustomerEmail, CustomerPhone = c.CustomerPhone, Address = c.Address, City = c.City, Zila = c.Zila, State = c.State, Country = c.Country, PostalCode = c.PostalCode, CreditLimit = c.CreditLimit, PaymentTerms = c.PaymentTerms, IsActive = c.IsActive, IsTaxExempt = c.IsTaxExempt }).ToList() },
            { x => x.Products, products.Select(p => (p.Id, p.Name, p.SKU, p.SellingPrice)).ToList() }
        };

        var dialog = await DialogService.ShowAsync<SalesOrderDialog>("New Sales Order", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateSalesOrderDto dto)
        {
            try
            {
                await OrderService.CreateSalesOrder(dto);
                Snackbar.Add("Sales order created successfully", Severity.Success);
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private static string GetStatusPill(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "tm-pill tm-pill-amber",
        OrderStatus.Approved => "tm-pill tm-pill-blue",
        OrderStatus.Shipped => "tm-pill tm-pill-purple",
        OrderStatus.Delivered => "tm-pill tm-pill-green",
        OrderStatus.Cancelled => "tm-pill tm-pill-red",
        _ => "tm-pill tm-pill-blue"
    };

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
