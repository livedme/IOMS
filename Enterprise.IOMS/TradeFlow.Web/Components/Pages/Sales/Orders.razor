@page "/sales/orders"
@rendermode InteractiveServer
@inject IOrderService OrderService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using TradeFlow.Infrastructure.Data
@inject ApplicationDbContext DbContext

<PageTitle>Sales Orders - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="🧾" Title="Sales Orders" Subtitle="Track customer orders from approval through delivery">
        <Actions>
            <button class="tm-reset" @onclick="LoadOrders">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="OpenCreate">+ New Sales Order</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="🧾" Number="@_totalCount" Label="Orders" Tone="blue" />
        <TmStatTile Icon="⏳" Number="@_pendingCount" Label="Pending" Tone="yellow" OnClick="@(() => PickStatus(OrderStatus.Pending))" />
        <TmStatTile Icon="⚙️" Number="@_approvedCount" Label="Approved" Tone="purple" OnClick="@(() => PickStatus(OrderStatus.Approved))" />
        <TmStatTile Icon="🚚" Number="@_shippedCount" Label="Shipped" Tone="teal" OnClick="@(() => PickStatus(OrderStatus.Shipped))" />
        <TmStatTile Icon="✅" Number="@_deliveredCount" Label="Delivered" Tone="green" OnClick="@(() => PickStatus(OrderStatus.Delivered))" />
        <TmStatTile Icon="💰" Number="@_pageValue" Label="Page Value" Tone="red" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by order number or customer..." value="@_search" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select @onchange="OnStatusChanged">
                <option value="" selected="@(_statusFilter == null)">All Status</option>
                @foreach (OrderStatus s in Enum.GetValues<OrderStatus>())
                {
                    <option value="@s" selected="@(_statusFilter == s)">@s</option>
                }
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:950px">
                <thead>
                    <tr>
                        <th>🧾 Order #</th>
                        <th>👤 Customer</th>
                        <th>🏬 Branch</th>
                        <th>📅 Date</th>
                        <th>Status</th>
                        <th style="text-align:right">Total</th>
                        <th style="text-align:right">Due</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="8"><TmLoading Message="Loading orders..." /></td></tr>
                    }
                    else if (_orders.Items.Count == 0)
                    {
                        <tr><td colspan="8"><div class="tm-loading">No sales orders found</div></td></tr>
                    }
                    else
                    {
                        @foreach (var o in _orders.Items)
                        {
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#e0e9ff">🧾</span>@o.OrderNumber</span></td>
                                <td class="tm-branch">@(o.Customer?.CustomerName ?? "-")</td>
                                <td class="tm-dim">@(o.Branch?.Name ?? "-")</td>
                                <td class="tm-dim">@o.OrderDate.ToString("dd MMM yyyy")</td>
                                <td><span class="@GetStatusPill(o.Status)"><span class="tm-dot"></span>@o.Status</span></td>
                                <td style="text-align:right" class="tm-money">@o.TotalAmount.ToString("N0")</td>
                                <td style="text-align:right">
                                    <span style="font-weight:700; color:@(o.DueAmount > 0 ? "#dc2626" : "#15803d")">
                                        @(o.DueAmount > 0 ? o.DueAmount.ToString("N0") : "-")
                                    </span>
                                </td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-view" title="View" @onclick="() => ViewOrder(o.Id)">👁</button>                                        @if (o.Status == OrderStatus.Pending)
                                        {
                                            <button class="tm-act" style="color:#16a34a" title="Approve" @onclick="() => Approve(o.Id)">✔</button>
                                        }
                                        @if (o.Status != OrderStatus.Cancelled && o.Status != OrderStatus.Delivered)
                                        {
                                            <button class="tm-act tm-act-del" title="Cancel" @onclick="() => Cancel(o.Id)">✕</button>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <TmPager Total="@_totalCount" Page="@_page" PageSize="@_pageSize" ItemNoun="orders"
                  PageChanged="@OnPageChanged" PageSizeChanged="@OnPageSizeChanged" />
    </div>
</div>

<TmSlideDrawer @bind-Open="_drawerOpen" Title="@_drawerTitle">
    @if (_viewOrder == null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <div class="tm-info-card mb-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="text-muted small">Customer</div>
                    <strong>@_viewOrder.Customer?.CustomerName</strong><br />
                    <span class="small">@_viewOrder.Customer?.CustomerPhone</span><br />
                    <span class="small">@_viewOrder.Customer?.CustomerEmail</span>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Order Date</div>
                    <strong>@_viewOrder.OrderDate.ToString("dd-MMM-yyyy")</strong>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Status</div>
                    <MudChip T="string" Color="@CommonUtility.GetStatusColor(_viewOrder.Status)" Size="Size.Small">
                        @_viewOrder.Status
                    </MudChip>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Branch</div>
                    <strong>@_viewOrder.Branch?.Name</strong><br />
                    <span class="small">@_viewOrder.Branch?.Location</span>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <MudTable Items="@_viewOrder.Items" Dense="true" Hover="true" Elevation="2">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>Product</MudTh>
                        <MudTh>SKU</MudTh>
                        <MudTh Style="text-align:right">Qty</MudTh>
                        <MudTh Style="text-align:right">Unit Price</MudTh>
                        <MudTh Style="text-align:right">Discount</MudTh>
                        <MudTh Style="text-align:right">Total</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@(_viewOrder.Items.IndexOf(context) + 1)</MudTd>
                        <MudTd>@context.ProductName</MudTd>
                        <MudTd>@context.ProductSKU</MudTd>
                        <MudTd Style="text-align:right">@context.Quantity</MudTd>
                        <MudTd Style="text-align:right">@context.UnitPrice.ToString("C")</MudTd>
                        <MudTd Style="text-align:right">@context.TotalDiscount.ToString("C")</MudTd>
                        <MudTd Style="text-align:right">@context.LineTotalPrice.ToString("C")</MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
            <div class="col-lg-4">
                <div class="tm-summary-card">
                    <h6 class="text-primary mb-3">ORDER SUMMARY</h6>
                    <div class="tm-summary-item"><span>Subtotal</span><strong>@_viewOrder.SubTotal.ToString("C")</strong></div>
                    <div class="tm-summary-item"><span>Discount</span><strong>@_viewOrder.DiscountAmount.ToString("C")</strong></div>
                    <div class="tm-summary-item"><span>Tax</span><strong>@_viewOrder.TaxAmount.ToString("C")</strong></div>
                    <div class="tm-summary-item"><span>Labour</span><strong>@_viewOrder.LabourCharge.ToString("C")</strong></div>
                    <div class="tm-summary-item"><span>Truck</span><strong>@_viewOrder.TruckCharge.ToString("C")</strong></div>
                    <div class="pt-3 border-top mt-2">
                        <div class="d-flex justify-content-between">
                            <strong>TOTAL</strong>
                            <span class="text-primary fw-bold fs-5">@_viewOrder.TotalAmount.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span class="text-muted">Paid</span>
                            <span class="text-success fw-semibold">@_viewOrder.PaidAmount.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span class="text-muted">Due</span>
                            <span class="text-danger fw-semibold">@_viewOrder.DueAmount.ToString("C")</span>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_viewOrder.Notes))
            {
                <MudField Label="Notes" Class="mt-3">@_viewOrder.Notes</MudField>
            }

            <div class="d-flex gap-2 mt-4">
                @if (_viewOrder.Status == OrderStatus.Pending)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle"
                               OnClick="@(() => ApproveAndRefresh(_viewOrder.Id))">Approve</MudButton>
                }
                @if (_viewOrder.Status != OrderStatus.Cancelled && _viewOrder.Status != OrderStatus.Delivered)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel"
                               OnClick="@(() => CancelFromDrawer(_viewOrder.Id))">Cancel Order</MudButton>
                }
            </div>
        </div>
    }
</TmSlideDrawer>

@code {
    private PagedResult<SalesOrderDto> _orders = new(new(), 0, 1, 10);
    private string _search = "";
    private List<OrderStatus?> _statusFilters = new();
    private OrderStatus? _statusFilter;
    private bool _loading = true;
    private int _page = 1;
    private int _pageSize = 10;
    private int _totalCount;
    private int _pendingCount, _approvedCount, _shippedCount, _deliveredCount;
    private decimal _pageValue;
    private System.Timers.Timer? _debounce;

    // ─── Drawer state ───
    private bool _drawerOpen;
    private string _drawerTitle = "";
    private SalesOrderDto? _viewOrder;


    protected override async Task OnInitializedAsync() => await LoadOrders();

    private async Task LoadOrders()
    {
        _loading = true;
        try
        {
            _statusFilters = _statusFilter.HasValue ? new List<OrderStatus?> { _statusFilter.Value } : new List<OrderStatus?>();
            _orders = await OrderService.GetSalesOrders(_search, _statusFilters, _page, _pageSize);
            _totalCount = _orders.TotalCount;
            _pageValue = _orders.Items.Sum(o => o.TotalAmount);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task LoadCountsAsync()
    {
        try
        {
            var all = await OrderService.GetSalesOrders("", new List<OrderStatus?>(), 1, 500);
            var items = all.Items;
            _pendingCount = items.Count(o => o.Status == OrderStatus.Pending);
            _approvedCount = items.Count(o => o.Status == OrderStatus.Approved);
            _shippedCount = items.Count(o => o.Status == OrderStatus.Shipped);
            _deliveredCount = items.Count(o => o.Status == OrderStatus.Delivered);
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadCountsAsync();
    }

    private async Task Approve(Guid id)
    {
        try
        {
            await OrderService.ApproveOrder(id);
            Snackbar.Add("Order approved successfully", Severity.Success);
            await LoadOrders();
            await LoadCountsAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Cancel(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Cancel Order", "Are you sure?", "Yes, Cancel", "No");
        if (confirm == true)
        {
            try
            {
                await OrderService.CancelOrder(id, "Cancelled by user");
                Snackbar.Add("Order cancelled", Severity.Warning);
                await LoadOrders();
                await LoadCountsAsync();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task ViewOrder(Guid id)
    {
        _viewOrder = null;
        _drawerTitle = "Loading…";
        _drawerOpen = true;
        try
        {
            _viewOrder = await OrderService.GetSalesOrderById(id);
            _drawerTitle = $"Order #{_viewOrder?.OrderNumber}";
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void CloseDrawer() => _drawerOpen = false;

    private async Task ApproveAndRefresh(Guid id)
    {
        await Approve(id);
        CloseDrawer();
    }

    private async Task CancelFromDrawer(Guid id)
    {
        await Cancel(id);
        if (_drawerOpen && _viewOrder?.Id == id)
            _viewOrder = await OrderService.GetSalesOrderById(id);
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 1;
        _debounce?.Stop();
        _debounce?.Dispose();
        _debounce = new System.Timers.Timer(350) { AutoReset = false };
        _debounce.Elapsed += async (_, __) =>
        {
            await LoadOrders();
            await InvokeAsync(StateHasChanged);
        };
        _debounce.Start();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _statusFilter = string.IsNullOrEmpty(v) ? null : Enum.Parse<OrderStatus>(v);
        _page = 1;
        await LoadOrders();
    }

    private async Task PickStatus(OrderStatus s)
    {
        _statusFilter = _statusFilter == s ? null : s;
        _page = 1;
        await LoadOrders();
    }

    private async Task ResetFilters()
    {
        _search = "";
        _statusFilter = null;
        _page = 1;
        await LoadOrders();
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadOrders();
    }

    private async Task OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
        await LoadOrders();
    }

    private async Task OpenCreate()
    {
        var customers = await DbContext.Customers.Where(c => c.IsActive).OrderBy(c => c.CustomerName).ToListAsync();
        var products = await DbContext.Products.OrderBy(p => p.Name).ToListAsync();

        var parameters = new DialogParameters<SalesOrderDialog>
        {
            { x => x.Customers, customers.Select(c => new CustomerDto(){ Id = c.Id, CustomerName = c.CustomerName, CustomerEmail = c.CustomerEmail, CustomerPhone = c.CustomerPhone, Address = c.Address, City = c.City, Zila = c.Zila, State = c.State, Country = c.Country, PostalCode = c.PostalCode, CreditLimit = c.CreditLimit, PaymentTerms = c.PaymentTerms, IsActive = c.IsActive, IsTaxExempt = c.IsTaxExempt }).ToList() },
            { x => x.Products, products.Select(p => (p.Id, p.Name, p.SKU, p.SellingPrice)).ToList() }
        };

        var dialog = await DialogService.ShowAsync<SalesOrderDialog>("New Sales Order", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateSalesOrderDto dto)
        {
            try
            {
                await OrderService.CreateSalesOrder(dto);
                Snackbar.Add("Sales order created successfully", Severity.Success);
                await LoadOrders();
                await LoadCountsAsync();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private static string GetStatusPill(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "tm-pill tm-pill-amber",
        OrderStatus.Approved => "tm-pill tm-pill-blue",
        OrderStatus.Shipped => "tm-pill tm-pill-purple",
        OrderStatus.Delivered => "tm-pill tm-pill-green",
        OrderStatus.Cancelled => "tm-pill tm-pill-red",
        _ => "tm-pill tm-pill-blue"
    };
}
