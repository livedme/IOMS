@page "/orders/sales-returns"
@rendermode InteractiveServer
@using IOMS.Application.DTOs
@using IOMS.Application.Interfaces
@using IOMS.Domain.Enums
@inject ISalesReturnService SalesReturnService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Sales Returns - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="↩️" Title="Sales Returns" Subtitle="Process customer returns, approvals and refunds">
        <Actions>
            <button class="tm-reset" @onclick="Load">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="OpenCreate">+ New Return</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="↩️" Number="@_returns.Count" Label="Returns" Tone="blue" />
        <TmStatTile Icon="📝" Number="@CountOf(SalesReturnStatus.Draft)" Label="Draft" Tone="purple" OnClick="@(() => PickStatus(SalesReturnStatus.Draft))" />
        <TmStatTile Icon="✔" Number="@CountOf(SalesReturnStatus.Approved)" Label="Approved" Tone="yellow" OnClick="@(() => PickStatus(SalesReturnStatus.Approved))" />
        <TmStatTile Icon="✅" Number="@CountOf(SalesReturnStatus.Completed)" Label="Completed" Tone="green" OnClick="@(() => PickStatus(SalesReturnStatus.Completed))" />
        <TmStatTile Icon="💰" Number="@TotalReturned" Label="Total Returned" Tone="teal" />
        <TmStatTile Icon="📥" Number="@CountOf(SalesReturnStatus.Received)" Label="Received" Tone="red" OnClick="@(() => PickStatus(SalesReturnStatus.Received))" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by return number, SO number or reason..." value="@_search" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select @onchange="OnStatusChanged">
                <option value="" selected="@(_statusFilter == null)">All Status</option>
                @foreach (SalesReturnStatus s in Enum.GetValues<SalesReturnStatus>())
                {
                    <option value="@s" selected="@(_statusFilter == s)">@s</option>
                }
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:900px">
                <thead>
                    <tr>
                        <th>↩️ Return #</th>
                        <th>🧾 SO #</th>
                        <th>Status</th>
                        <th style="text-align:right">Total</th>
                        <th>Reason</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="6"><div class="tm-loading">Loading returns...</div></td></tr>
                    }
                    else if (Paged.Count == 0)
                    {
                        <tr><td colspan="6"><div class="tm-loading">No sales returns found</div></td></tr>
                    }
                    else
                    {
                        @foreach (var r in Paged)
                        {
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#fee2e2">↩️</span>@r.ReturnNumber</span></td>
                                <td class="tm-num">@(string.IsNullOrWhiteSpace(r.SalesOrderNumber) ? "-" : r.SalesOrderNumber)</td>
                                <td><span class="@GetStatusPill(r.Status)"><span class="tm-dot"></span>@r.Status</span></td>
                                <td style="text-align:right" class="tm-money">@r.TotalAmount.ToString("N0")</td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(r.Reason) ? "-" : r.Reason)</td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-view" title="View" @onclick="() => ViewReturn(r.Id)">👁</button>
                                        @if (r.Status == SalesReturnStatus.Draft)
                                        {
                                            <button class="tm-act" style="color:#16a34a" title="Approve" @onclick="() => Approve(r.Id)">✔</button>
                                        }
                                        @if (r.Status == SalesReturnStatus.Approved)
                                        {
                                            <button class="tm-act tm-act-view" title="Complete" @onclick="() => Complete(r.Id)">✅</button>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <TmPager Total="@Filtered.Count" Page="@_page" PageSize="@_pageSize" ItemNoun="returns"
                  PageChanged="@(p => _page = p)" PageSizeChanged="@OnPageSizeChanged" />
    </div>
</div>

<TmSlideDrawer @bind-Open="_drawerOpen" Title="@_drawerTitle" Width="1000px">
    @if (_viewReturn == null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <div class="tm-info-card mb-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="text-muted small">Sales Order</div>
                    <strong>@(string.IsNullOrWhiteSpace(_viewReturn.SalesOrderNumber) ? "-" : _viewReturn.SalesOrderNumber)</strong>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Status</div>
                    <MudChip T="string" Color="@CommonUtility.GetStatusColor(_viewReturn.Status)" Size="Size.Small">
                        @_viewReturn.Status
                    </MudChip>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Reason</div>
                    <strong>@(string.IsNullOrWhiteSpace(_viewReturn.Reason) ? "-" : _viewReturn.Reason)</strong>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <table class="tm-slide-items">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th style="text-align:right">Qty</th>
                            <th style="text-align:right">Unit Price</th>
                            <th style="text-align:right">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_viewReturn.ItemsLine == null || _viewReturn.ItemsLine.Count == 0)
                        {
                            <tr><td colspan="5"><div class="tm-loading">No items on this return</div></td></tr>
                        }
                        else
                        {
                            @for (var i = 0; i < _viewReturn.ItemsLine.Count; i++)
                            {
                                var it = _viewReturn.ItemsLine[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@it.ProductName</td>
                                    <td style="text-align:right">@it.Quantity</td>
                                    <td style="text-align:right">@it.UnitPrice.ToString("C")</td>
                                    <td style="text-align:right">@it.LineTotal.ToString("C")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="col-lg-4">
                <div class="tm-summary-card">
                    <h6 class="text-primary mb-3">RETURN SUMMARY</h6>
                    <div class="tm-summary-item"><span>Items</span><strong>@(_viewReturn.ItemsLine?.Count ?? 0)</strong></div>
                    <div class="tm-summary-item"><span>Total Units</span><strong>@((_viewReturn.ItemsLine?.Sum(x => x.Quantity)) ?? 0)</strong></div>
                    <div class="pt-3 border-top mt-2">
                        <div class="d-flex justify-content-between">
                            <strong>TOTAL</strong>
                            <span class="text-primary fw-bold fs-5">@_viewReturn.TotalAmount.ToString("C")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            @if (_viewReturn.Status == SalesReturnStatus.Draft)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle"
                           OnClick="@(() => ApproveAndRefresh(_viewReturn.Id))">Approve</MudButton>
            }
            @if (_viewReturn.Status == SalesReturnStatus.Approved)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Done"
                           OnClick="@(() => CompleteAndRefresh(_viewReturn.Id))">Complete</MudButton>
            }
        </div>
    }
</TmSlideDrawer>

@code {
    private List<SalesReturnDto> _returns = new();
    private bool _loading = true;
    private string _search = "";
    private SalesReturnStatus? _statusFilter;
    private int _page = 1;
    private int _pageSize = 10;

    // ─── Drawer state ───
    private bool _drawerOpen;
    private string _drawerTitle = "";
    private SalesReturnDto? _viewReturn;

    private decimal TotalReturned => _returns.Sum(r => r.TotalAmount);

    protected override async Task OnInitializedAsync() => await Load();

    private List<SalesReturnDto> Filtered => _returns.Where(r =>
        (_statusFilter == null || r.Status == _statusFilter.Value)
        && (string.IsNullOrWhiteSpace(_search)
            || (r.ReturnNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (r.SalesOrderNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (r.Reason?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))).ToList();

    private List<SalesReturnDto> Paged => Filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    private int CountOf(SalesReturnStatus s) => _returns.Count(r => r.Status == s);

    private async Task Load()
    {
        _loading = true;
        try
        {
            var result = await SalesReturnService.GetSalesReturns(null, null, _page, _pageSize);
            _returns = result.Items;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task OpenCreate()
    {
        var dialog = await DialogService.ShowAsync<SalesReturnDialog>("New Sales Return",
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is SalesReturnDto dto)
        {
            await SalesReturnService.CreateSalesReturn(dto);
            Snackbar.Add("Sales return created successfully.", Severity.Success);
            await Load();
        }
    }

    private async Task Approve(Guid id)
    {
        try
        {
            await SalesReturnService.ApproveSalesReturn(id);
            Snackbar.Add("Return approved.", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Complete(Guid id)
    {
        try
        {
            await SalesReturnService.CompleteSalesReturn(id);
            Snackbar.Add("Return completed.", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ViewReturn(Guid id)
    {
        _viewReturn = null;
        _drawerTitle = "Loading…";
        _drawerOpen = true;
        try
        {
            _viewReturn = await SalesReturnService.GetSalesReturnById(id);
            _drawerTitle = $"Return #{_viewReturn?.ReturnNumber}";
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void CloseDrawer() => _drawerOpen = false;

    private async Task ApproveAndRefresh(Guid id)
    {
        await Approve(id);
        await ReloadView(id);
    }

    private async Task CompleteAndRefresh(Guid id)
    {
        await Complete(id);
        await ReloadView(id);
    }

    private async Task ReloadView(Guid id)
    {
        if (!_drawerOpen) return;
        var refreshed = await SalesReturnService.GetSalesReturnById(id);
        if (refreshed != null) _viewReturn = refreshed;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 1;
    }

    private void OnStatusChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _statusFilter = string.IsNullOrEmpty(v) ? null : Enum.Parse<SalesReturnStatus>(v);
        _page = 1;
    }

    private void PickStatus(SalesReturnStatus s)
    {
        _statusFilter = _statusFilter == s ? null : s;
        _page = 1;
    }

    private void ResetFilters()
    {
        _search = "";
        _statusFilter = null;
        _page = 1;
    }

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
    }

    private static string GetStatusPill(SalesReturnStatus s) => s switch
    {
        SalesReturnStatus.Draft => "tm-pill tm-pill-purple",
        SalesReturnStatus.Approved => "tm-pill tm-pill-amber",
        SalesReturnStatus.Received => "tm-pill tm-pill-blue",
        SalesReturnStatus.Completed => "tm-pill tm-pill-green",
        SalesReturnStatus.Cancelled => "tm-pill tm-pill-red",
        _ => "tm-pill tm-pill-blue"
    };
}
