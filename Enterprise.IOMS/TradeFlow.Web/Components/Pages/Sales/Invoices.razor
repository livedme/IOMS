@page "/accounting/invoices"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ISnackbar Snackbar
@inject IInvoiceService InvoiceService



<PageTitle>Invoices - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="🧾" Title="Invoices" Subtitle="Track sales and purchase invoices, payments and outstanding balances">
        <Actions>
            <button class="tm-reset" @onclick="Load">⟳ Refresh</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="🧾" Number="@_items.Count" Label="Invoices" Tone="blue" />
        <TmStatTile Icon="📄" Number="@CountOf(InvoiceStatus.Draft)" Label="Draft" Tone="purple" OnClick="@(() => PickStatus(InvoiceStatus.Draft))" />
        <TmStatTile Icon="📤" Number="@CountOf(InvoiceStatus.Sent)" Label="Sent" Tone="yellow" OnClick="@(() => PickStatus(InvoiceStatus.Sent))" />
        <TmStatTile Icon="💰" Number="@CountOf(InvoiceStatus.Paid)" Label="Paid" Tone="green" OnClick="@(() => PickStatus(InvoiceStatus.Paid))" />
        <TmStatTile Icon="⚠" Number="@OverdueCount" Label="Overdue" Tone="red" OnClick="@(() => PickStatus(InvoiceStatus.Overdue))" />
        <TmStatTile Icon="💵" Number="@OutstandingTotal" Label="Outstanding" Tone="teal" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by invoice number or party..." value="@_search" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select @onchange="OnTypeChanged">
                <option value="" selected="@(_typeFilter == null)">All Types</option>
                <option value="sales" selected="@(_typeFilter == InvoiceType.Sales)">Sales</option>
                <option value="purchase" selected="@(_typeFilter == InvoiceType.Purchase)">Purchase</option>
            </select>
        </div>
        <div class="tm-select">
            <select @onchange="OnStatusChanged">
                <option value="" selected="@(_statusFilter == null)">All Status</option>
                @foreach (InvoiceStatus s in Enum.GetValues<InvoiceStatus>())
                {
                    <option value="@s" selected="@(_statusFilter == s)">@s</option>
                }
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:1150px">
                <thead>
                    <tr>
                        <th>🧾 Invoice #</th>
                        <th>Type</th>
                        <th>👤 Customer / Supplier</th>
                        <th>📅 Date</th>
                        <th>⏳ Due Date</th>
                        <th>Status</th>
                        <th style="text-align:right">Total</th>
                        <th style="text-align:right">Paid</th>
                        <th style="text-align:right">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="9"><TmLoading Message="Loading invoices..." /></td></tr>
                    }
                    else if (Paged.Count == 0)
                    {
                        <tr><td colspan="9"><div class="tm-loading">No invoices found</div></td></tr>
                    }
                    else
                    {
                        @foreach (var i in Paged)
                        {
                            var isOverdue = i.DueDate < DateTime.Today && i.Status != InvoiceStatus.Paid && i.Status != InvoiceStatus.Cancelled;
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#e0e9ff">🧾</span>@i.InvoiceNumber</span></td>
                                <td>
                                    <span class="@(i.InvoiceType == InvoiceType.Sales ? "tm-pill tm-pill-green" : "tm-pill tm-pill-blue")">
                                        <span class="tm-dot"></span>@i.InvoiceType
                                    </span>
                                </td>
                                <td class="tm-branch">@(i.CustomerName ?? i.SupplierName ?? "-")</td>
                                <td class="tm-dim">@i.InvoiceDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="@(isOverdue ? "tm-date-red" : "tm-dim")">
                                        @i.DueDate.ToString("dd MMM yyyy")@(isOverdue ? " (overdue)" : "")
                                    </span>
                                </td>
                                <td><span class="@GetStatusPill(i.Status)"><span class="tm-dot"></span>@i.Status</span></td>
                                <td style="text-align:right" class="tm-money">@i.TotalAmount.ToString("N0")</td>
                                <td style="text-align:right" class="tm-money">@i.PaidAmount.ToString("N0")</td>
                                <td style="text-align:right">
                                    <span style="font-weight:700; color:@(i.BalanceDue > 0 ? "#dc2626" : "#15803d")">
                                        @(i.BalanceDue > 0 ? i.BalanceDue.ToString("N0") : "-")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <TmPager CurrentPage="@(_page - 1)"
                  PageSize="_pageSize"
                  TotalCount="@Filtered.Count"
                  TotalPages="@PageTotal"
                  ItemLabel="Invoices"
                  OnGoToPage="GoToPage"
                  OnPrev="GoPrevPage"
                  OnNext="GoNextPage"
                  OnPageSizeChanged="OnPageSizeChanged" />
    </div>
</div>

@code {
    // The old query pulled at most 500 rows (Take(500)) and then filtered/paged/stat-counted them in
    // memory. GetInvoicesAsync pages server-side, so ask for one big page to keep that exact window:
    // _items stays "the 500 newest matching invoices" and every stat tile / Paged below still works.
    private const int MaxRows = 500;

    private List<InvoiceDto> _items = new();
    private string _search = "";
    private InvoiceType? _typeFilter;
    private InvoiceStatus? _statusFilter;
    private bool _loading = true;
    private int _page = 1;
    private int _pageSize = 10;

    private int OverdueCount => _items.Count(i => i.DueDate < DateTime.Today
        && i.Status != InvoiceStatus.Paid && i.Status != InvoiceStatus.Cancelled);

    private string OutstandingTotal => _items.Sum(i => i.BalanceDue).ToString("N0");

    private List<InvoiceDto> Filtered => _items.Where(i =>
        (_typeFilter == null || i.InvoiceType == _typeFilter.Value)
        && (_statusFilter == null || i.Status == _statusFilter.Value)
        && (string.IsNullOrWhiteSpace(_search)
            || i.InvoiceNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (i.CustomerName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (i.SupplierName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))).ToList();

    private List<InvoiceDto> Paged => Filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    private int CountOf(InvoiceStatus s) => _items.Count(i => i.Status == s);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        try
        {
            // The Include(i => i.Customer)/Include(i => i.Supplier) this page used to declare were
            // only ever read to fill InvoiceDto.CustomerName / SupplierName — GetInvoicesAsync does
            // that join internally and returns the DTOs directly, so they are no longer needed here.
            var result = await InvoiceService.GetInvoicesAsync(
                search: _search, status: _statusFilter, type: _typeFilter, page: 1, pageSize: MaxRows);
            _items = result.Items;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 1;
    }

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _typeFilter = string.IsNullOrEmpty(v) ? null
            : v == "sales" ? InvoiceType.Sales
            : v == "purchase" ? InvoiceType.Purchase
            : null;
        _page = 1;
        await Load();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _statusFilter = string.IsNullOrEmpty(v) ? null : Enum.Parse<InvoiceStatus>(v);
        _page = 1;
        await Load();
    }

    private async Task PickStatus(InvoiceStatus s)
    {
        _statusFilter = _statusFilter == s ? null : s;
        _page = 1;
        await Load();
    }

    private async Task ResetFilters()
    {
        _search = "";
        _typeFilter = null;
        _statusFilter = null;
        _page = 1;
        await Load();
    }

    private int PageTotal => Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)_pageSize));

    private Task GoToPage(int pageIndex)
    {
        _page = Math.Clamp(pageIndex + 1, 1, PageTotal);
        return Task.CompletedTask;
    }

    private Task GoPrevPage() => GoToPage(_page - 2);

    private Task GoNextPage() => GoToPage(_page);

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            _pageSize = size;
            _page = 1;
        }
    }

    private static string GetStatusPill(InvoiceStatus s) => s switch
    {
        InvoiceStatus.Draft => "tm-pill tm-pill-purple",
        InvoiceStatus.Sent => "tm-pill tm-pill-blue",
        InvoiceStatus.Paid => "tm-pill tm-pill-green",
        InvoiceStatus.PartiallyPaid => "tm-pill tm-pill-amber",
        InvoiceStatus.Overdue => "tm-pill tm-pill-red",
        InvoiceStatus.Cancelled => "tm-pill tm-pill-red",
        _ => "tm-pill tm-pill-blue"
    };
}
