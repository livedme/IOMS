@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid>
                <MudItem xs="12" sm="6" class="d-flex flex-column">
                    <MudTextField @bind-Value="Customer.CustomerName" Label="Customer Name" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" class="mb-5" />
                    <MudTextField @bind-Value="Customer.CustomerEmail" Label="Customer Email" InputType="InputType.Email" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" class="mb-5" />
                    <MudTextField @bind-Value="Customer.CustomerPhone" Label="Customer Phone" AdornmentAriaLabel="Phone" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" class="d-flex column-gap-3 flex-column">
                    <MudTextField @bind-Value="Customer.ContactPersonName" Label="Contact Person Name" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" class="mb-5" />
                    <MudTextField @bind-Value="Customer.ContactPersonEmail" Label="Contact Person Email" InputType="InputType.Email" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" class="mb-5" />
                    <MudTextField @bind-Value="Customer.ContactPersonPhone" Label="Contact Person Phone" AdornmentAriaLabel="Phone" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Customer.Address" Label="Address" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="Customer.City" Label="Upozila" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="Customer.Zila" Label="Zila" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="Customer.State" Label="Division" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                @* <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_country" Label="Country" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_postalCode" Label="Postal Code" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </MudItem> *@
                @* <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Customer.PaymentTerms" Label="Payment Terms" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </MudItem>
            <MudItem xs="12">
                <MudCheckBox @bind-Value="Customer.IsTaxExempt" Label="Tax Exempt" CheckedIcon="@Icons.Material.Filled.CheckBox" UncheckedIcon="@Icons.Material.Outlined.CheckBoxOutlineBlank" />
            </MudItem> *@
                <MudItem xs="12">
                    <MudCheckBox @bind-Value="Customer.IsActive" Label="Is Active" CheckedIcon="@Icons.Material.Filled.CheckBox" UncheckedIcon="@Icons.Material.Outlined.CheckBoxOutlineBlank" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public CustomerDto Customer { get; set; }
    private MudForm _form = default;

    protected override void OnInitialized()
    {
        // if (Customer != null)
        // {
        //     _customerName = Customer.CustomerName;
        //     _customerEmail = Customer.CustomerEmail;
        //     _customerPhone = Customer.CustomerPhone;
        //     _contactPersonName = Customer.ContactPersonName;
        //     _contactPersonEmail = Customer.ContactPersonEmail;
        //     _contactPersonPhone = Customer.ContactPersonPhone;
        //     _address = Customer.Address;
        //     _city = Customer.City;
        //     _zila = Customer.Zila;
        //     _state = Customer.State;
        //     _country = Customer.Country;
        //     _creditLimit = Customer.CreditLimit;
        //     _paymentTerms = Customer.PaymentTerms;
        //     _isTaxExempt = Customer.IsTaxExempt;
        // }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;
        MudDialog.Close(DialogResult.Ok(Customer));
    }
}