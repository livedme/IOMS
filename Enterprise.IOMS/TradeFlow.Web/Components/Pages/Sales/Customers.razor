@page "/customers"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICustomerService CustomerService

<PageTitle>Customers - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="👥" Title="Customer Management" Subtitle="Manage customer contacts, credit limits and account status">
        <Actions>
            <button class="tm-reset" @onclick="Refresh">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="OpenCreate">+ New Customer</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="👥" Number="@TotalCountText" Label="Customers" Tone="blue" OnClick="@(() => FilterByStatus(null))" />
        <TmStatTile Icon="✔" Number="@ActiveCountText" Label="Active" Tone="green" OnClick="@(() => FilterByStatus(true))" />
        <TmStatTile Icon="✕" Number="@InactiveCountText" Label="Inactive" Tone="red" OnClick="@(() => FilterByStatus(false))" />
        <TmStatTile Icon="💰" Number="@TotalCreditLimitText" Label="Total Credit Limit" Tone="purple" />
        <TmStatTile Icon="🏙️" Number="@CityCountText" Label="Cities" Tone="teal" />
        <TmStatTile Icon="⭐" Number="@TaxExemptCountText" Label="Tax Exempt" Tone="yellow" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by name, email or phone..." value="@pagedRequest.SearchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select value="@StatusValue" @onchange="OnStatusChanged">
                <option value="">All Status</option>
                <option value="active">Active Only</option>
                <option value="inactive">Inactive Only</option>
            </select>
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.City ?? "")" @onchange="OnCityChanged">
                <option value="">All Cities</option>
                @foreach (var c in Cities)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        @if (_loading)
        {
            <div style="position:absolute; inset:0; background:rgba(255,255,255,0.62); backdrop-filter:blur(1px); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2; border-radius:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Style="margin-top:8px; color:#334155; font-weight:600;">Loading customers...</MudText>
            </div>
        }
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:1050px">
                <thead>
                    <tr>
                        <th @onclick="@(() => SortBy(Col.CustomerName))">👤 Customer @SortIcon(Col.CustomerName)</th>
                        <th @onclick="@(() => SortBy(Col.Email))">Email @SortIcon(Col.Email)</th>
                        <th @onclick="@(() => SortBy(Col.Phone))">Phone @SortIcon(Col.Phone)</th>
                        <th @onclick="@(() => SortBy(Col.ContactPerson))">Contact Person @SortIcon(Col.ContactPerson)</th>
                        <th @onclick="@(() => SortBy(Col.City))">City @SortIcon(Col.City)</th>
                        <th style="text-align:right" @onclick="@(() => SortBy(Col.CreditLimit))">Credit Limit @SortIcon(Col.CreditLimit)</th>
                        <th @onclick="@(() => SortBy(Col.PaymentTerms))">Terms @SortIcon(Col.PaymentTerms)</th>
                        <th @onclick="@(() => SortBy(Col.IsActive))">Status @SortIcon(Col.IsActive)</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_hasLoadedOnce && _loading)
                    {
                        <tr><td colspan="9" style="text-align:center; padding:40px; color:#94a3b8;">Loading customers...</td></tr>
                    }
                    else if (pagedResultNew.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="9" style="text-align:center; padding:40px;">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#94a3b8;" Class="mb-2" />
                                <div style="color:#64748b;">No customers found — try a different search or filter</div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="ResetFilters">Clear filters</MudButton>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in pagedResultNew.Items)
                        {
                            <tr>
                                <td>
                                    <span class="tm-veh">
                                        <span class="tm-veh-ico" style="background:@GetAvatarBg(c.CustomerName)">@GetInitials(c.CustomerName)</span>
                                        @c.CustomerName
                                    </span>
                                </td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(c.CustomerEmail) ? "-" : c.CustomerEmail)</td>
                                <td class="tm-num">@(string.IsNullOrWhiteSpace(c.CustomerPhone) ? "-" : c.CustomerPhone)</td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(c.ContactPersonName) ? "-" : c.ContactPersonName)</td>
                                <td class="tm-branch">@(string.IsNullOrWhiteSpace(c.City) ? "-" : c.City)</td>
                                <td style="text-align:right" class="tm-money">@c.CreditLimit.ToString("N0")</td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(c.PaymentTerms) ? "-" : c.PaymentTerms)</td>
                                <td>
                                    <span class="tm-pill @(c.IsActive ? "tm-pill-green" : "tm-pill-red")">
                                        <span class="tm-dot"></span>@(c.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-edit" title="Edit" @onclick="() => OpenEdit(c)">✎</button>
                                        <button class="tm-act tm-act-del" title="Delete" @onclick="() => Delete(c)">🗑</button>
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div style="opacity:@(_loading ? "0.55" : "1"); pointer-events:@(_loading ? "none" : "auto");">
            <TmPager CurrentPage="pagedResultNew.CurrentPage"
                     PageSize="pagedResultNew.PageSize"
                     TotalCount="pagedResultNew.TotalCount"
                     TotalPages="pagedResultNew.TotalPages"
                     ItemLabel="Customers"
                     OnGoToPage="GoToPage"
                     OnPrev="GoPrevPage"
                     OnNext="GoNextPage"
                     OnPageSizeChanged="OnPageSizeChanged" />
        </div>
    </div>
</div>

@code {
    private static class Col
    {
        public const string CustomerName = "CustomerName";
        public const string Email = "Email";
        public const string Phone = "Phone";
        public const string ContactPerson = "ContactPerson";
        public const string City = "City";
        public const string CreditLimit = "CreditLimit";
        public const string PaymentTerms = "PaymentTerms";
        public const string IsActive = "IsActive";
    }

    // ─── List state ───
    private PagedResultNew<CustomerDto> pagedResultNew = new();
    private CustomerPagedRequest pagedRequest = new()
    {
        SortColumn = Col.CustomerName,
        SortAscending = true
    };

    private List<string> _cities = new();
    private bool _loading = true;
    private bool _hasLoadedOnce;
    private bool _loadRunning;
    private bool _loadQueued;
    private CancellationTokenSource? _debounceCts;

    private List<string> Cities => _cities;
    private string StatusValue => pagedRequest.IsActive switch
    {
        true => "active",
        false => "inactive",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        try { _cities = await CustomerService.GetCustomerCitiesAsync(); } catch { }
        await LoadData();
    }

    private async Task Refresh() => await LoadData();

    /// <summary>
    /// Single-flight loader. The page and the services share one scoped DbContext, so two
    /// overlapping queries would throw "A second operation was started on this context
    /// instance". Callers that arrive mid-flight set a flag instead of starting a parallel
    /// query, and the running load then re-runs once with the newest filter state.
    /// </summary>
    private async Task LoadData()
    {
        if (_loadRunning)
        {
            _loadQueued = true;
            return;
        }

        _loadRunning = true;
        try
        {
            do
            {
                _loadQueued = false;
                await LoadDataCore();
            }
            while (_loadQueued);
        }
        finally { _loadRunning = false; }
    }

    private async Task LoadDataCore()
    {
        _loading = true;
        try
        {
            pagedResultNew = await CustomerService.GetCustomersAsync(pagedRequest);
            _hasLoadedOnce = true;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    // ─── Stats / sorting helpers ───
    private string TotalCountText => Stat("TotalCount");
    private string ActiveCountText => Stat("ActiveCount");
    private string InactiveCountText => Stat("InactiveCount");
    private string TaxExemptCountText => Stat("TaxExemptCount");
    private string CityCountText => Stat("CityCount");
    private string TotalCreditLimitText =>
        int.TryParse(Stat("TotalCreditLimit"), out var v) ? v.ToString("N0") : "0";

    private string Stat(string key) =>
        pagedResultNew.Stats != null && pagedResultNew.Stats.TryGetValue(key, out var v) ? v.ToString() : "0";

    private void SortBy(string column)
    {
        if (pagedRequest.SortColumn == column)
            pagedRequest.SortAscending = !pagedRequest.SortAscending;
        else
        {
            pagedRequest.SortColumn = column;
            pagedRequest.SortAscending = true;
        }
        pagedRequest.CurrentPage = 0;
    }

    private string SortIcon(string column)
    {
        if (pagedRequest.SortColumn != column) return "";
        return pagedRequest.SortAscending ? "▲" : "▼";
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private static string GetAvatarBg(string? name)
    {
        var palettes = new[] { "#e0e9ff", "#fee2e2", "#dcfce7", "#ede9fe", "#ffedd5", "#e0f2fe", "#fef9c3" };
        if (string.IsNullOrEmpty(name)) return palettes[0];
        return palettes[Math.Abs(name.GetHashCode()) % palettes.Length];
    }

    // ─── Filters ───
    private void OnSearchInput(ChangeEventArgs e)
    {
        pagedRequest.SearchTerm = e.Value?.ToString() ?? "";
        pagedRequest.CurrentPage = 0;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(async () =>
                {
                    await LoadData();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        pagedRequest.IsActive = e.Value?.ToString() switch
        {
            "active" => true,
            "inactive" => false,
            _ => null
        };
        pagedRequest.CurrentPage = 0;
        await LoadData();
    }

    private async Task OnCityChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        pagedRequest.City = string.IsNullOrEmpty(v) ? null : v;
        pagedRequest.CurrentPage = 0;
        await LoadData();
    }

    private async Task FilterByStatus(bool? isActive)
    {
        pagedRequest.IsActive = pagedRequest.IsActive == isActive ? null : isActive;
        pagedRequest.CurrentPage = 0;
        await LoadData();
    }

    private async Task ResetFilters()
    {
        pagedRequest.SearchTerm = "";
        pagedRequest.IsActive = null;
        pagedRequest.City = null;
        pagedRequest.CurrentPage = 0;
        await LoadData();
    }

    // ─── Paging (zero-based, matches TmPager) ───
    private async Task GoToPage(int page)
    {
        pagedRequest.CurrentPage = Math.Clamp(page, 0, Math.Max(0, pagedResultNew.TotalPages - 1));
        await LoadData();
    }

    private async Task GoPrevPage()
    {
        if (pagedRequest.CurrentPage > 0)
        {
            pagedRequest.CurrentPage--;
            await LoadData();
        }
    }

    private async Task GoNextPage()
    {
        if (pagedRequest.CurrentPage < pagedResultNew.TotalPages - 1)
        {
            pagedRequest.CurrentPage++;
            await LoadData();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sz))
        {
            pagedRequest.PageSize = Math.Clamp(sz, 1, 100);
            pagedRequest.CurrentPage = 0;
            await LoadData();
        }
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<CustomerDialog> { { x => x.Customer, new CustomerDto() } };
        var dialog = await DialogService.ShowAsync<CustomerDialog>("New Customer", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is CustomerDto dto)
        {
            await CustomerService.CreateCustomerAsync(dto);
            Snackbar.Add("Customer created", Severity.Success);
            await LoadData();
        }
    }

    private async Task OpenEdit(CustomerDto entity)
    {
        if (entity == null) return;

        var parameters = new DialogParameters<CustomerDialog> { { x => x.Customer, entity } };
        var dialog = await DialogService.ShowAsync<CustomerDialog>("Edit Customer", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is CustomerDto updated)
        {
            await CustomerService.UpdateCustomerAsync(updated.Id, updated);
            Snackbar.Add("Customer updated", Severity.Success);
            await LoadData();
        }
    }

    private async Task Delete(CustomerDto entity)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Confirm", "Delete this customer?", "Delete", "Cancel");
        if (confirm == true)
        {
            await CustomerService.DeleteCustomerAsync(entity.Id);
            Snackbar.Add($"Customer {entity.CustomerName} deleted", Severity.Warning);
            await LoadData();
        }
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
