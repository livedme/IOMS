@page "/customers"
@rendermode InteractiveServer
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICustomerService CustomerService

<PageTitle>Customers - IOMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Customers</MudText>

<MudPaper Elevation="2" Class="pa-4">
    <MudGrid>
        <MudItem xs="12" sm="8">
            <MudTextField @bind-Value="_searchString" Placeholder="Search customers..." Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                          DebounceInterval="300" OnDebounceIntervalElapsed="LoadData" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreate">New Customer</MudButton>
        </MudItem>
    </MudGrid>

    <MudTable Items="@_items" Dense="true" Hover="true" Striped="true" Loading="@_loading" Class="mt-4" Elevation="0">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Phone</MudTh>
            <MudTh>City</MudTh>
            <MudTh Style="text-align:right">Credit Limit</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.CustomerName</MudTd>
            <MudTd>@context.CustomerEmail</MudTd>
            <MudTd>@context.CustomerPhone</MudTd>
            <MudTd>@context.City</MudTd>
            <MudTd Style="text-align:right">@context.CreditLimit.ToString("C")</MudTd>
            <MudTd>
                <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Default)" Size="Size.Small">
                    @(context.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => OpenEdit(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => Delete(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {

    private List<CustomerDto> _items = new();
    private string _searchString = "";
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        _loading = true;
        var query =await CustomerService.GetCustomersAsync(_searchString);


        var data = query.Items.OrderBy(c => c.CustomerName).Take(100).ToList();
        _items = data.Select(dto => new CustomerDto
        {
            Id = dto.Id,
            CustomerName = dto.CustomerName,
            CustomerEmail = dto.CustomerEmail,
            CustomerPhone = dto.CustomerPhone,
            ContactPersonName = dto.ContactPersonName,
            ContactPersonPhone = dto.ContactPersonPhone,
            ContactPersonEmail = dto.ContactPersonEmail,
            Address = dto.Address,
            City = dto.City,
            State = dto.State,
            Country = dto.Country,
            PostalCode = dto.PostalCode,
            CreditLimit = dto.CreditLimit,
            PaymentTerms = dto.PaymentTerms,
            IsTaxExempt = dto.IsTaxExempt,
            IsActive = dto.IsActive
        }).ToList();
        _loading = false;
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<CustomerDialog> { { x => x.Customer, new CustomerDto() } };
        var dialog = await DialogService.ShowAsync<CustomerDialog>("New Customer", parameters,      
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is CustomerDto dto)
        {
            await CustomerService.CreateCustomerAsync(dto);
            Snackbar.Add("Customer created", Severity.Success);
            await LoadData();
        }
    }

    private async Task OpenEdit(CustomerDto entity)
    {
        if (entity == null) return;

        var parameters = new DialogParameters<CustomerDialog> { { x => x.Customer, entity } };
        var dialog = await DialogService.ShowAsync<CustomerDialog>("Edit Customer", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is CustomerDto updated)
        {
            await CustomerService.UpdateCustomerAsync(updated.Id, updated);
            Snackbar.Add("Customer updated", Severity.Success);
            await LoadData();
        }
    }

    private async Task Delete(CustomerDto entity)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Confirm", "Delete this customer?", "Delete", "Cancel");
        if (confirm == true)
        {   
            await CustomerService.DeleteCustomerAsync(entity.Id);
            Snackbar.Add($"Customer {entity.CustomerName} deleted", Severity.Warning);
            await LoadData(); 
        }
    }
}
