@page "/admin/archival"
@rendermode InteractiveServer
@inject IArchivalService ArchivalService
@inject ISnackbar Snackbar

<PageTitle>Data Archival - IOMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Data Archival Policies</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           OnClick="() => _showCreate = true" Class="mb-4">New Policy</MudButton>

@if (_showCreate)
{
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">Create Archival Policy</MudText>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudSelect @bind-Value="_entityType" Label="Entity Type" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("SalesOrder")">Sales Order</MudSelectItem>
                    <MudSelectItem Value="@("PurchaseOrder")">Purchase Order</MudSelectItem>
                    <MudSelectItem Value="@("Invoice")">Invoice</MudSelectItem>
                    <MudSelectItem Value="@("JournalEntry")">Journal Entry</MudSelectItem>
                    <MudSelectItem Value="@("AuditLog")">Audit Log</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField @bind-Value="_retentionDays" Label="Retention Days" Min="30" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </MudItem>
        </MudGrid>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Create" Class="mt-3">Save</MudButton>
        <MudButton Variant="Variant.Text" OnClick="() => _showCreate = false" Class="mt-3 ml-2">Cancel</MudButton>
    </MudPaper>
}

<MudPaper Elevation="2" Class="pa-4">
    <MudTable Items="@_policies" Dense="true" Hover="true" Loading="@_loading" Elevation="0">
        <HeaderContent>
            <MudTh>Entity Type</MudTh>
            <MudTh>Retention Days</MudTh>
            <MudTh>Active</MudTh>
            <MudTh>Last Run</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><strong>@context.EntityType</strong></MudTd>
            <MudTd>@context.RetentionDays days</MudTd>
            <MudTd><MudIcon Icon="@(context.IsActive ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)" Color="@(context.IsActive ? Color.Success : Color.Error)" /></MudTd>
            <MudTd>@(context.LastRunAt?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="() => Delete(context.Id)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private List<ArchivalPolicyDto> _policies = new();
    private string _entityType = "SalesOrder";
    private int _retentionDays = 365;
    private bool _showCreate;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _policies = await ArchivalService.GetPolicies();
        _loading = false;
    }

    private async Task Create()
    {
        try
        {
            var dto = new CreateArchivalPolicyDto(_entityType, _retentionDays);
            await ArchivalService.CreatePolicy(dto);
            Snackbar.Add("Archival policy created.", Severity.Success);
            _showCreate = false;
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Delete(Guid id)
    {
        try
        {
            await ArchivalService.DeletePolicy(id);
            Snackbar.Add("Policy deleted.", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
