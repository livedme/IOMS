@page "/admin/company"
@rendermode InteractiveServer
@attribute [Authorize(Policy = AuthorizationPolicies.Administrator)]

@inject ITenantService TenantService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Company Profile - IOMS</PageTitle>

<MudStack Row="true" Class="align-center mb-4">
    <MudText Typo="Typo.h4">Company Profile</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Refresh"
               OnClick="LoadAsync" Disabled="_loading">
        Refresh
    </MudButton>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}

@if (!_loading && _tenant is null)
{
    <MudAlert Severity="Severity.Warning">
        Your company profile could not be found.
    </MudAlert>
}
else if (_tenant is not null)
{
    <MudPaper Class="pa-5 mb-4">
        <MudStack Row="true" Class="align-center" Spacing="3">
            @if (!string.IsNullOrWhiteSpace(_tenant.LogoUrl))
            {
                <MudAvatar Image="@_tenant.LogoUrl" Size="Size.Large" Square="true" />
            }
            else
            {
                <MudAvatar Color="Color.Primary" Size="Size.Large" Style="font-size:1.4rem;font-weight:700;">
                    @CompanyInitial
                </MudAvatar>
            }
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5">@_tenant.CompanyName</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Company code: <strong>@_tenant.CompanyCode</strong>
                    @if (!string.IsNullOrWhiteSpace(_tenant.LegalName))
                    {
                        <span> &middot; @_tenant.LegalName</span>
                    }
                </MudText>
            </MudStack>
            <MudSpacer />
            <MudStack Row="true" Spacing="2">
                <MudChip T="string" Color="@CommonUtility.StatusColor(_tenant.TenantStatus)" Size="Size.Small">
                    @CommonUtility.FormatStatus(_tenant.TenantStatus)
                </MudChip>
                <MudChip T="string" Color="Color.Default" Size="Size.Small">
                    Onboarding: @CommonUtility.FormatStatus(_tenant.OnboardingStatus)
                </MudChip>
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 mb-4">
                <MudStack Row="true" Class="align-center mb-3">
                    <MudText Typo="Typo.h6">Company details</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.Edit" OnClick="@(() => OpenEditAsync(0))">
                        Edit
                    </MudButton>
                </MudStack>
                <MudSimpleTable Dense="true" Elevation="0" Class="company-profile-table">
                    <tbody>
                        <tr><td>Legal name</td><td>@ValueOrDash(_tenant.LegalName)</td></tr>
                        <tr><td>Industry</td><td>@ValueOrDash(_tenant.Industry)</td></tr>
                        <tr>
                            <td>Website</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(_tenant.Website))
                                {
                                    <a href="@WebsiteHref" target="_blank" rel="noopener">@_tenant.Website</a>
                                }
                                else
                                {
                                    <span>&mdash;</span>
                                }
                            </td>
                        </tr>
                        <tr><td>Address</td><td>@ValueOrDash(_tenant.Address)</td></tr>
                        <tr><td>City</td><td>@ValueOrDash(_tenant.City)</td></tr>
                        <tr><td>State</td><td>@ValueOrDash(_tenant.State)</td></tr>
                        <tr><td>Country</td><td>@ValueOrDash(_tenant.Country)</td></tr>
                        <tr><td>Country code</td><td>@ValueOrDash(_tenant.CountryCode)</td></tr>
                        <tr><td>Tenant ID</td><td><code>@_tenant.Id</code></td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 mb-4">
                <MudStack Row="true" Class="align-center mb-3">
                    <MudText Typo="Typo.h6">Contact</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.Edit" OnClick="@(() => OpenEditAsync(1))">
                        Edit
                    </MudButton>
                </MudStack>
                <MudSimpleTable Dense="true" Elevation="0" Class="company-profile-table">
                    <tbody>
                        <tr>
                            <td>Primary email</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(_tenant.PrimaryContactEmail))
                                {
                                    <a href="mailto:@_tenant.PrimaryContactEmail">@_tenant.PrimaryContactEmail</a>
                                }
                                else
                                {
                                    <span>&mdash;</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td>Primary phone</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(_tenant.PrimaryContactPhone))
                                {
                                    <a href="tel:@_tenant.PrimaryContactPhone">@_tenant.PrimaryContactPhone</a>
                                }
                                else
                                {
                                    <span>&mdash;</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td>Billing email</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(_tenant.BillingEmail))
                                {
                                    <a href="mailto:@_tenant.BillingEmail">@_tenant.BillingEmail</a>
                                }
                                else
                                {
                                    <span>&mdash;</span>
                                }
                            </td>
                        </tr>
                        <tr><td>Country</td><td>@ValueOrDash(_tenant.CountryCode)</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 mb-4">
                <MudStack Row="true" Class="align-center mb-3">
                    <MudText Typo="Typo.h6">Regional settings</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.Edit" OnClick="@(() => OpenEditAsync(2))">
                        Edit
                    </MudButton>
                </MudStack>
                <MudSimpleTable Dense="true" Elevation="0" Class="company-profile-table">
                    <tbody>
                        <tr><td>Currency</td><td>@_tenant.DefaultCurrencyCode</td></tr>
                        <tr><td>Time zone</td><td>@_tenant.DefaultTimeZone</td></tr>
                        <tr><td>Culture</td><td>@_tenant.DefaultCulture</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Lifecycle</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
                        <MudText>@CommonUtility.FormatStatus(_tenant.TenantStatus)</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Onboarding</MudText>
                        <MudText>@CommonUtility.FormatStatus(_tenant.OnboardingStatus)</MudText> 
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Created</MudText>
                        <MudText>@FormatDate(_tenant.CreatedAt)</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Activated</MudText>
                        <MudText>@FormatDate(_tenant.ActivatedAt)</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Onboarding completed</MudText>
                        <MudText>@FormatDate(_tenant.OnboardingCompletedAt)</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Trial ends</MudText>
                        <MudText>@FormatDate(_tenant.TrialEndsAt)</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Suspended</MudText>
                        <MudText>@FormatDate(_tenant.SuspendedAt)</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Cancelled</MudText>
                        <MudText>@FormatDate(_tenant.CancelledAt)</MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 mb-4">
                <MudStack Row="true" Class="align-center mb-3">
                    <MudText Typo="Typo.h6">Workspace access</MudText>
                    <MudSpacer />
                    @if (!string.IsNullOrWhiteSpace(_tenant.LicenseStatus))
                    {
                        <MudChip T="string" Color="@CommonUtility.StatusColor(_tenant.LicenseStatus)" Size="Size.Small">
                            @CommonUtility.FormatStatus(_tenant.LicenseStatus)
                        </MudChip>
                    }
                </MudStack>
                <MudGrid>
                    <MudItem xs="12">                        
                        <MudSimpleTable Dense="true" Elevation="0" Class="company-profile-table">
                            <tbody>
                                <tr><td>Application domain</td><td>@ValueOrDash(_tenant.ApplicationDomain)</td></tr>
                                @* <tr><td>Tenant ID</td><td><code>@_tenant.Id</code></td></tr> *@
                                <tr>
                                    <td>License key</td>
                                    <td>
                                        <MudStack Row="true" Spacing="2" Class="align-center">
                                            <code>@DisplayLicenseKey</code>
                                            @if (!string.IsNullOrWhiteSpace(_tenant.LicenseKey))
                                            {
                                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                                           OnClick="() => _showLicenseKey = !_showLicenseKey">
                                                    @(_showLicenseKey ? "Hide" : "Show")
                                                </MudButton>
                                            }
                                        </MudStack>
                                    </td>
                                </tr>                                
                                <tr><td>Project</td><td>@ValueOrDash(_tenant.LicenseProjectName)</td></tr>
                                <tr><td>Subscription ID</td><td>@ValueOrDash(_tenant.SubscriptionId)</td></tr>
                                <tr><td>Subscription</td><td>@ValueOrDash(_tenant.SubscriptionName)</td></tr>
                                <tr><td>Subscription no.</td><td>@ValueOrDash(_tenant.SubscriptionNumber)</td></tr>
                                <tr><td>License ID</td><td>@ValueOrDash(_tenant.LicenseId)</td></tr>
                                <tr><td>Plan</td><td>@ValueOrDash(_tenant.LicensePlan)</td></tr>
                                <tr><td>Billing cycle</td><td>@ValueOrDash(_tenant.LicenseBillingCycle)</td></tr>                                
                                <tr><td>Amount</td><td>@FormatAmount(_tenant.LicenseAmount) / Month</td></tr>
                                <tr><td>Activated</td><td>@FormatDate(_tenant.LicenseActivatedAt)</td></tr>
                                <tr><td>Valid from</td><td>@FormatDate(_tenant.LicenseValidFrom)</td></tr>
                                <tr><td>Valid until</td><td>@FormatDate(_tenant.LicenseValidUntil)</td></tr>
                                <tr><td>Last checked</td><td>@FormatDate(_tenant.LicenseCheckedAtUtc)</td></tr>
                                <tr><td>Grace period</td><td>@_tenant.LicenseGracePeriod day(s)</td></tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudItem>
                    @if (!string.IsNullOrWhiteSpace(_tenant.StatusReason))
                    {
                        <MudDivider Class="my-4" />
                        @* <MudText Typo="Typo.caption" Color="Color.Secondary">Status reason</MudText> *@
                        <MudText Class="text-danger">@_tenant.StatusReason</MudText>
                    }
                </MudGrid>

            </MudPaper>
        </MudItem>

       
    </MudGrid>
}

@code {
    private TenantProfileDto? _tenant;
    private bool _loading = true;
    private bool _showLicenseKey;

    private string CompanyInitial =>
        string.IsNullOrWhiteSpace(_tenant?.CompanyName) ? "?" : _tenant.CompanyName[0].ToString().ToUpperInvariant();

    private string DisplayLicenseKey
    {
        get
        {
            var key = _tenant?.LicenseKey;
            if (string.IsNullOrWhiteSpace(key))
                return "—";

            if (_showLicenseKey)
                return key;

            var maskedLength = Math.Min(12, Math.Max(0, key.Length - 4));
            return new string('•', maskedLength) + (key.Length > 4 ? key[^4..] : string.Empty);
        }
    }

    private string WebsiteHref =>
        _tenant?.Website?.StartsWith("http", StringComparison.OrdinalIgnoreCase) == true
            ? _tenant.Website
            : $"https://{_tenant?.Website}";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _tenant = await TenantService.GetCurrentTenantAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenEditAsync(int initialTab)
    {
        if (_tenant is null)
            return;

        var parameters = new DialogParameters<CompanyProfileEditDialog>
        {
            { x => x.Tenant, _tenant },
            { x => x.InitialTab, initialTab }
        };

        var dialog = await DialogService.ShowAsync<CompanyProfileEditDialog>(
            "Edit company profile",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not UpdateTenantProfileDto dto)
            return;

        try
        {
            _tenant = await TenantService.UpdateCurrentTenantAsync(dto);
            Snackbar.Add("Company profile updated", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static string ValueOrDash(object? value)
    {
        if (value is Guid guid && guid == Guid.Empty)
            return "—";

        var text = value?.ToString();
        return string.IsNullOrWhiteSpace(text) ? "—" : text;
    }

    private static string FormatAmount(decimal amount) => amount == 0 ? "—" : $"৳{amount:N2}";

   

    private static string FormatDate(DateTime? value) =>
        value is null
            ? "—"
            : DateTime.SpecifyKind(value.Value, DateTimeKind.Utc).ToLocalTime().ToString("dd MMM yyyy, HH:mm");
}
