@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Diagnostics
@inject IBranchService BranchService
@inject ILogger<Home> Logger

<PageTitle>Dashboard - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="📊" Title="Dashboard" Subtitle="Welcome back! Here's what's happening with your business today." WrapActions="true">
        <Actions>
            <DashboardQuickActions />
        </Actions>
    </TmPageHeader>

    @* The filter strip is the dashboard's single control surface: it owns the range selector, the
       store selector and refresh. Every tile below is a self-loading card that reacts to the range
       and reload token pushed down here, so this page only composes the grid. *@
    <DashboardHeader DateRange="@_dateRange"
                     StoreFilter="@_storeFilter"
                     Stores="@_stores"
                     DateRangeChanged="@OnDateRangeChanged"
                     StoreFilterChanged="@OnStoreFilterChanged"
                     OnRefresh="@Reload" />

    <div class="tm-dash">
        <DashboardKpiRow Range="@_range" ReloadToken="@_reloadToken" />

        @* ── Sales and purchasing over time ────────────────────────────── *@
        @* Paired in an equal two-column row: the two overview cards share a layout, and
           tm-dash-cols (3fr/1fr) would squeeze the purchase chart to a third of the
           width and leave its axis unreadable. *@
        <div class="tm-dash-row">
            <SalesOverviewCard Range="@_range" ReloadToken="@_reloadToken" />
            <PurchaseOverviewCard Range="@_range" ReloadToken="@_reloadToken" />
        </div>

        @* ── Product leaders and the stock behind them ──────────────────── *@
        <div class="tm-dash-row">
            <TopProductsCard Range="@_range" ReloadToken="@_reloadToken" />
            <StockLevelsCard Range="@_range" ReloadToken="@_reloadToken" />
        </div>

        @* ── Inventory and store position ───────────────────────────────── *@
        <div class="tm-dash-row">
            <InventoryOverviewCard Range="@_range" ReloadToken="@_reloadToken" />
            <StoreOverviewCard Range="@_range" ReloadToken="@_reloadToken" StoreFilter="@_storeFilter" />
        </div>

        @* ── Live operational feeds ─────────────────────────────────────── *@
        <div class="tm-dash-row">
            <RecentOrdersCard Range="@_range" ReloadToken="@_reloadToken" />
            <RecentTransactionsCard Range="@_range" ReloadToken="@_reloadToken" />
        </div>

        <div class="tm-dash-row">
            <RecentActivitiesCard Range="@_range" ReloadToken="@_reloadToken" />
            <SystemAlertsCard Range="@_range" ReloadToken="@_reloadToken" />
        </div>

        <AnalyticsPromoCard />
    </div>
</div>

@code {
    private const string AllStores = "All Stores";

    private string _dateRange = DashboardRanges.DefaultLabel;
    private string _storeFilter = AllStores;

    /// <summary>
    /// Resolved window behind the filter strip's range selector. It drives every range-scoped tile,
    /// and is re-resolved on every change so each card's period label and span caption describe the
    /// exact period in force.
    /// </summary>
    private DashboardRange _range = DashboardRanges.Resolve(DashboardRanges.DefaultLabel, DateTime.UtcNow);

    /// <summary>
    /// Bumped whenever the tile data must be re-read from the source (range change, toolbar refresh).
    /// Each card reloads only when this changes, so unrelated re-renders — such as the store filter —
    /// do not re-query.
    /// </summary>
    private int _reloadToken;

    private List<string> _stores = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadStores();
    }

    /// <summary>
    /// Refreshes the branch list the store selector is built from. Reloaded on every refresh so a
    /// store added or renamed while the dashboard is open appears without a full page reload. If this
    /// fails the selector simply stays on "All Stores" and every store-scoped card shows the full
    /// set, which is the safe default.
    /// </summary>
    private async Task LoadStores()
    {
        var branches = await SafeAsync(() => BranchService.GetBranches(), new List<BranchDto>(), "GetBranches");
        _stores = branches
            .Where(b => !string.IsNullOrWhiteSpace(b.Name))
            .Select(b => b.Name!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n)
            .ToList();

        // A store that no longer exists (deleted while the filter was applied) would otherwise leave
        // the dashboard showing nothing with no obvious way back.
        if (_storeFilter != AllStores && !_stores.Contains(_storeFilter, StringComparer.OrdinalIgnoreCase))
        {
            _storeFilter = AllStores;
        }
    }

    /// <summary>
    /// Toolbar refresh: re-read the branch list and force every tile to reload.
    /// </summary>
    private async Task Reload()
    {
        var started = Stopwatch.GetTimestamp();

        await LoadStores();
        _reloadToken++;

        Logger.LogInformation("Dashboard refreshed in {ElapsedMs:F0} ms", Stopwatch.GetElapsedTime(started).TotalMilliseconds);
    }

    /// <summary>
    /// Applies a new period to the whole dashboard. Resolving the window and bumping the reload token
    /// is all that is needed: every range-scoped card reads the new <see cref="DashboardRange"/> and
    /// reloads itself, so changing the filter moves the whole page, not just the charts above the fold.
    /// </summary>
    private Task OnDateRangeChanged(string v)
    {
        _dateRange = v;
        _range = DashboardRanges.Resolve(v, DateTime.UtcNow);
        _reloadToken++;
        return Task.CompletedTask;
    }

    /// <summary>
    /// The store selector narrows the cards that are per-store by nature. It is applied in memory by
    /// the store card, so no tile is re-queried and the choice is instant.
    /// </summary>
    private Task OnStoreFilterChanged(string v)
    {
        _storeFilter = v;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Runs the branch lookup and substitutes an empty list on failure. The failure is logged at
    /// Error with the full exception so an outage is visible in the log stream.
    /// </summary>
    private async Task<T> SafeAsync<T>(Func<Task<T>> call, T fallback, string label)
    {
        try
        {
            return await call();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Dashboard load '{DashboardStep}' failed.", label);
            return fallback;
        }
    }
}
