@page "/print/{documentType}/{Id:guid}"
@layout EmptyLayout
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web.HtmlRendering

<PageTitle>@DocTitle - IOMS</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="/print.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
</HeadContent>

<div class="doc-toolbar">
    <span class="doc-toolbar-title">@DocTitle @DocRef</span>
    <button class="doc-btn" @onclick="PrintNow">Print</button>
    <button class="doc-btn doc-btn-primary" @onclick="DownloadPdf">⬇ Download PDF</button>
</div>

@if (_loading)
{
    <div class="doc-page"><div class="doc-empty">Loading document…</div></div>
}
else if (_error is not null)
{
    <div class="doc-page"><div class="doc-empty">@_error</div></div>
}
else
{
    <PrintDocumentBody DocTitle="@DocTitle"
                       DocRef="@DocRef"
                       StatusText="@StatusText"
                       SalesOrder="_salesOrder"
                       PurchaseOrder="_purchaseOrder"
                       Quote="_quote"
                       SalesReturn="_salesReturn"
                       PurchaseReturn="_purchaseReturn"
                       Invoice="_invoice"
                       Product="_product" />

    <div class="print-chrome print-header">
        <div class="pc-left">
            <img src="/logo.png" class="pc-logo" alt="Avancer" />
            <span class="pc-text">
                <span class="pc-brand">AVANCER</span>
                <span class="pc-tag">Inventory &amp; Order Management</span>
            </span>
        </div>
        <div class="pc-right">
            <span class="pc-title">@DocTitle</span>
            <span class="pc-ref">@DocRef</span>
        </div>
    </div>
    <div class="print-chrome print-footer">
        <span>Avancer Inc. | 123 Business Park, New York, NY 10001, USA</span>
        <span>Phone: (212) 555-0000 | sales@avancer.com | www.avancer.com</span>
    </div>
}

@code {
    [Parameter] public string DocumentType { get; set; } = "";
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "action")] public string? Action { get; set; }

    [Inject] private IOrderService OrderService { get; set; } = default!;
    [Inject] private IPurchaseService PurchaseService { get; set; } = default!;
    [Inject] private IQuotationService QuotationService { get; set; } = default!;
    [Inject] private ISalesReturnService SalesReturnService { get; set; } = default!;
    [Inject] private IPurchaseReturnService PurchaseReturnService { get; set; } = default!;
    [Inject] private IInvoiceService InvoiceService { get; set; } = default!;
    [Inject] private IProductService ProductService { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private IServiceProvider Services { get; set; } = default!;
    [Inject] private ILoggerFactory LoggerFactory { get; set; } = default!;

    private bool _loading = true;
    private bool _autoHandled;
    private string? _error;

    private SalesOrderDto? _salesOrder;
    private PurchaseOrderDto? _purchaseOrder;
    private SalesQuoteDto? _quote;
    private SalesReturnDto? _salesReturn;
    private PurchaseReturnDto? _purchaseReturn;
    private InvoiceDto? _invoice;
    private ProductDetailViewDto? _product;

    private string Kind => DocumentType.Trim().ToLowerInvariant();

    private string DocTitle => Kind switch
    {
        "sales-order" => "Sales Order",
        "purchase-order" => "Purchase Order",
        "quotation" => "Sales Quotation",
        "sales-return" => "Sales Return",
        "purchase-return" => "Purchase Return",
        "invoice" => "Invoice",
        "product" => "Product Details",
        _ => "Document"
    };

    private string DocRef => Kind switch
    {
        "sales-order" => _salesOrder?.OrderNumber ?? "—",
        "purchase-order" => _purchaseOrder?.OrderNumber ?? "—",
        "quotation" => _quote?.QuoteNumber ?? "—",
        "sales-return" => _salesReturn?.ReturnNumber ?? "—",
        "purchase-return" => _purchaseReturn?.ReturnNumber ?? "—",
        "invoice" => _invoice?.InvoiceNumber ?? "—",
        "product" => _product?.SKU ?? "—",
        _ => "—"
    };

    private string StatusText => Kind switch
    {
        "sales-order" => _salesOrder?.Status.ToString() ?? "",
        "purchase-order" => _purchaseOrder?.Status.ToString() ?? "",
        "quotation" => _quote?.Status.ToString() ?? "",
        "sales-return" => _salesReturn?.Status.ToString() ?? "",
        "purchase-return" => _purchaseReturn?.Status.ToString() ?? "",
        "invoice" => _invoice?.Status.ToString() ?? "",
        _ => ""
    };

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _salesOrder = null;
        _purchaseOrder = null;
        _quote = null;
        _salesReturn = null;
        _purchaseReturn = null;
        _invoice = null;
        _product = null;

        try
        {
            switch (Kind)
            {
                case "sales-order":
                    _salesOrder = await OrderService.GetSalesOrderById(Id);
                    if (_salesOrder is null) _error = "Sales order not found.";
                    break;
                case "purchase-order":
                    _purchaseOrder = await PurchaseService.GetPurchaseOrderById(Id);
                    if (_purchaseOrder is null) _error = "Purchase order not found.";
                    break;
                case "quotation":
                    _quote = await QuotationService.GetSalesQuoteById(Id);
                    if (_quote is null) _error = "Quotation not found.";
                    break;
                case "sales-return":
                    _salesReturn = await SalesReturnService.GetSalesReturnById(Id);
                    if (_salesReturn is null) _error = "Sales return not found.";
                    break;
                case "purchase-return":
                    _purchaseReturn = await PurchaseReturnService.GetPurchaseReturnById(Id);
                    if (_purchaseReturn is null) _error = "Purchase return not found.";
                    break;
                case "invoice":
                    _invoice = await InvoiceService.GetInvoiceByIdAsync(Id);
                    if (_invoice is null) _error = "Invoice not found.";
                    break;
                case "product":
                    _product = await ProductService.GetProductDetailViewAsync(Id);
                    if (_product is null) _error = "Product not found.";
                    break;
                default:
                    _error = $"Unknown document type '{DocumentType}'.";
                    break;
            }
        }
        catch (Exception ex)
        {
            _error = $"Unable to load document: {ex.Message}";
        }

        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_autoHandled || _loading || _error is not null || string.IsNullOrWhiteSpace(Action)) return;
        _autoHandled = true;

        await Task.Delay(300);

        if (string.Equals(Action, "print", StringComparison.OrdinalIgnoreCase))
        {
            await PrintNow();
        }
        else if (string.Equals(Action, "pdf", StringComparison.OrdinalIgnoreCase))
        {
            await DownloadPdf();
        }
    }

    private async Task PrintNow() => await JS.InvokeVoidAsync("print");

    private async Task DownloadPdf()
    {
        var name = DocTitle + " " + (DocRef == "—" ? "" : DocRef);
        name = new string(name.Where(c => char.IsLetterOrDigit(c) || c == '-' || c == '_' || c == ' ').ToArray()).Trim();
        if (string.IsNullOrWhiteSpace(name)) name = "document";

        try
        {
            var html = await RenderDocumentHtmlAsync();
            await JS.InvokeVoidAsync("downloadFile", html, name + ".pdf", DocTitle, DocRef == "—" ? "" : DocRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Could not generate the PDF: " + ex.Message);
        }
    }

    private async Task<string> RenderDocumentHtmlAsync()
    {
        await using var renderer = new HtmlRenderer(Services, LoggerFactory);

        var parameters = ParameterView.FromDictionary(new Dictionary<string, object?>
        {
            [nameof(PrintDocumentBody.DocTitle)] = DocTitle,
            [nameof(PrintDocumentBody.DocRef)] = DocRef,
            [nameof(PrintDocumentBody.StatusText)] = StatusText,
            [nameof(PrintDocumentBody.SalesOrder)] = _salesOrder,
            [nameof(PrintDocumentBody.PurchaseOrder)] = _purchaseOrder,
            [nameof(PrintDocumentBody.Quote)] = _quote,
            [nameof(PrintDocumentBody.SalesReturn)] = _salesReturn,
            [nameof(PrintDocumentBody.PurchaseReturn)] = _purchaseReturn,
            [nameof(PrintDocumentBody.Invoice)] = _invoice,
            [nameof(PrintDocumentBody.Product)] = _product
        });

        return await renderer.Dispatcher.InvokeAsync(async () =>
        {
            var output = await renderer.RenderComponentAsync<PrintDocumentBody>(parameters);
            return output.ToHtmlString();
        });
    }
}
