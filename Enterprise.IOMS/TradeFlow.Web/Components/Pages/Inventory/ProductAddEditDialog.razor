    private Task<IEnumerable<CategoryDto>> SearchCategories(string text, CancellationToken _)
    {
        IEnumerable<CategoryDto> baseResults;

        if (string.IsNullOrWhiteSpace(text))
        {
            baseResults = Categories.Where(c => c.Id != Guid.Empty);
        }
        else
        {
            baseResults = Categories.Where(c =>
                c.Id != Guid.Empty &&
                (c.Name.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                 (c.Path != null && c.Path.Contains(text, StringComparison.OrdinalIgnoreCase))));
        }

        var results = new[] { AddNewCategoryOption }.Concat(baseResults).DistinctBy(c => c.Id);
        return Task.FromResult(results);
    }

    private Task<IEnumerable<BrandDto>> SearchBrands(string text, CancellationToken _)
    {
        IEnumerable<BrandDto> baseResults;

        if (string.IsNullOrWhiteSpace(text))
        {
            baseResults = Brands.Where(b => b.Id != Guid.Empty);
        }
        else
        {
            baseResults = Brands.Where(b =>
                b.Id != Guid.Empty &&
                b.Name.Contains(text, StringComparison.OrdinalIgnoreCase));
        }

        var results = new[] { AddNewBrandOption }.Concat(baseResults).DistinctBy(b => b.Id);
        return Task.FromResult(results);
    }

    private async Task OnCategoryChanged()
    {
        var cat = _selectedCategory;

        if (cat?.Id == Guid.Empty)
        {
            var previousCategory = _lastCategorySelection;
            var parameters = new DialogParameters<CategoryDialog>
            {
                { x => x.AllCategories, Categories.Where(c => c.Id != Guid.Empty).ToList() }
            };

            var dialog = await DialogService.ShowAsync<CategoryDialog>("New Category", parameters,
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true,CloseButton = true });
            var result = await dialog.Result;

            await CategoryDropDownControl.ResetAsync();

            if (result != null && !result.Canceled && result.Data is CreateCategoryDto dto)
            {
                var parent = await DbContext.Categories.FindAsync(dto.ParentCategoryId);
                var path = parent == null ? dto.Name : parent.ParentCategory == null ? $"{parent.Name} > {dto.Name}" : $"{parent.ParentCategory.Name} > {parent.Name} > {dto.Name}";

                var category = new IOMS.Domain.Entities.Category
                {
                    Name = dto.Name,
                    Path = path,
                    Description = dto.Description,
                    ParentCategoryId = dto.ParentCategoryId
                };
                DbContext.Categories.Add(category);
                await DbContext.SaveChangesAsync();
                //  Snackbar.Add("Category created", Severity.Success);
                //  await LoadCategories();

                cat = new CategoryDto(category.Id, category.Name, category.Description, category.ParentCategoryId, null, 0, category.Path);

                var myCategories = await DbContext.Categories.ToListAsync();
                Categories = myCategories.Select(c => new CategoryDto(c.Id, c.Name, c.Description, c.ParentCategoryId, null, 0, c.Path)).ToList();

                _selectedCategory = GetRealCategoryById(cat.Id);
                _lastCategorySelection = _selectedCategory;
                DataModel.CategoryId = _selectedCategory?.Id ?? Guid.Empty;
                _categoryText = CategoryToDisplay(_selectedCategory);

                _selectedCategoryIndex++;

                StateHasChanged();
            }
            else
            {
                _selectedCategory = previousCategory;
                _lastCategorySelection = _selectedCategory;
                DataModel.CategoryId = previousCategory?.Id ?? Guid.Empty;
                _categoryText = CategoryToDisplay(_selectedCategory);
                StateHasChanged();
            }
        }
        else
        {
            DataModel.CategoryId = cat?.Id ?? Guid.Empty;
            _lastCategorySelection = cat;
            _categoryText = CategoryToDisplay(_selectedCategory);
        }


    }

    private CategoryDto? GetRealCategoryById(Guid categoryId)
    {
        if (categoryId == Guid.Empty)
            return null;

        return Categories.FirstOrDefault(c => c.Id == categoryId);
    }

    private async Task OnBrandChanged()
    {
        var brand = _selectedBrand;

        if (brand?.Id == Guid.Empty)
        {
            var previousBrand = _lastBrandSelection;

            var dialog = await DialogService.ShowAsync<BrandDialog>("New Brand",
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
            var result = await dialog.Result;

            await BrandDropDownControl.ResetAsync();

            if (result != null && !result.Canceled && result.Data is CreateBrandDto dto)
            {
                var entity = new IOMS.Domain.Entities.Brand
                {
                    Name = dto.Name,
                    BrandCode = dto.BrandCode,
                    Description = dto.Description,
                    LogoUrl = dto.LogoUrl,
                    Status = string.IsNullOrWhiteSpace(dto.Status) ? "Active" : dto.Status,
                    OriginCompany = dto.OriginCompany,
                    OriginCountry = dto.OriginCountry,
                    FoundedYear = dto.FoundedYear
                };

                DbContext.Brands.Add(entity);
                await DbContext.SaveChangesAsync();

                var allBrands = await DbContext.Brands.OrderBy(b => b.Name).ToListAsync();
                Brands = allBrands.Select(b => new BrandDto
                {
                    Id = b.Id,
                    Name = b.Name,
                    BrandCode = b.BrandCode,
                    Description = b.Description,
                    LogoUrl = b.LogoUrl,
                    Status = b.Status,
                    OriginCompany = b.OriginCompany,
                    OriginCountry = b.OriginCountry,
                    FoundedYear = b.FoundedYear
                }).ToList();

                _selectedBrand = GetRealBrandById(entity.Id);
                _lastBrandSelection = _selectedBrand;
                DataModel.BrandId = _selectedBrand?.Id;
                _brandText = BrandToDisplay(_selectedBrand);

                _selectedBrandIndex++;
                StateHasChanged();
            }
            else
            {
                _selectedBrand = previousBrand;
                _lastBrandSelection = _selectedBrand;
                DataModel.BrandId = previousBrand?.Id;
                _brandText = BrandToDisplay(_selectedBrand);
                StateHasChanged();
            }

            return;
        }

        DataModel.BrandId = brand?.Id;
        _lastBrandSelection = brand;
        _brandText = BrandToDisplay(_selectedBrand);
    }

    private BrandDto? GetRealBrandById(Guid? brandId)
    {
        if (!brandId.HasValue || brandId.Value == Guid.Empty)
            return null;

        return Brands.FirstOrDefault(b => b.Id == brandId.Value);
    }

    private static string? CategoryToDisplay(CategoryDto? category)
        => category?.Path ?? category?.Name;

    private static string? BrandToDisplay(BrandDto? brand)
        => brand?.Name;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        MudDialog.Close(DialogResult.Ok(DataModel));
    }
