@using IOMS.Infrastructure.Data

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
        <MudGrid>
            @* === Basic Info === *@
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Basic Information</MudText>
                </MudItem>
                <MudItem xs="12" sm="4" Class="p-4 py-2 pt-4">
                    <MudTextField @bind-Value="DataModel.Name" Label="Name" Required="true" RequiredError="" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="p-4 py-2 pt-4">
                    <MudTextField @bind-Value="DataModel.SKU" Label="SKU" Required="true" RequiredError="" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="p-4 py-2 pt-4">
                    <MudTextField @bind-Value="this.DataModel.Barcode" Label="Barcode" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>

                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudAutocomplete T="CategoryDto"
                                     @ref="CategoryDropDownControl"
                                     Label="Category"
                                     @key="_lastCategorySelection"
                                     @bind-Value="_selectedCategory"
                                     @bind-Text="_categoryText"
                                     @bind-Value:after="OnCategoryChanged"
                                     SearchFunc="SearchCategories"
                                     ToStringFunc="@(c => c?.Path ?? c?.Name ?? "")"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     Clearable="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>

                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudAutocomplete T="BrandDto"
                                     Label="Brand"
                                     @ref="BrandDropDownControl"
                                     @key="_selectedBrandIndex"
                                     @bind-Value="_selectedBrand"
                                     @bind-Text="_brandText"
                                     @bind-Value:after="OnBrandChanged"
                                     SearchFunc="SearchBrands"
                                     ToStringFunc="@(b => b?.Name ?? "")"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     Clearable="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />

                </MudItem>
                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudTextField @bind-Value="DataModel.Model" Label="Model" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudNumericField @bind-Value="DataModel.CostPrice" Label="Cost Price" Format="N2" Min="0m" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudNumericField @bind-Value="DataModel.SellingPrice" Label="Selling Price" Format="N2" Min="0m" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudNumericField @bind-Value="DataModel.WholeSellingPrice" Label="Whole Selling Price" Format="N2" Min="0m" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudNumericField @bind-Value="DataModel.ReorderStockLevel" Label="Reorder Stock Level" Min="0" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudTextField @bind-Value="DataModel.OriginManufacturer" Label="Origin Manufacturer" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudTextField @bind-Value="DataModel.OriginCountry" Label="Origin Country" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>

           
            <MudItem xs="12" Class="py-0">
                <RichTextField @bind-Value="DataModel.Description" Label="Description" Lines="10" Class="mt-3" />
            </MudItem>

        </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>
