@page "/products"
@rendermode InteractiveServer
@inject IProductService ProductService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Products - IOMS</PageTitle>


<div class="tm-page">
    <!-- Header -->
    <div class="tm-card tm-header">
        <div class="tm-header-left">
            <div class="tm-header-icon">📦</div>
            <div>
                <h2 class="tm-title">Product Management</h2>
                <p class="tm-subtitle">Manage your inventory, track product details and stock — server-side paging &amp; search</p>
            </div>
        </div>
        <button class="tm-add-btn" @onclick="() => OpenAddEditDialog(null)">+ Add Product</button>
    </div>

    <!-- Stats -->
    @if (pagedResultNew.Stats != null && (pagedResultNew.Stats.Count > 0))
    {
        <div class="tm-stats">
            <div class="tm-stat tm-s-blue" @onclick="() => FilterByStatus(null)">
                <div class="tm-stat-ico">📦</div>
                <div><div class="tm-stat-num">@pagedResultNew.Stats["TotalCount"]</div><div class="tm-stat-label">Products</div></div>
                            <div class="tm-stat-arrow">›</div>
                        </div>
                        <div class="tm-stat tm-s-green" @onclick="() => FilterByStatus(StockFilter.InStock)">
                            <div class="tm-stat-ico">✔</div>
                            <div><div class="tm-stat-num">@pagedResultNew.Stats["InStockCount"]</div><div class="tm-stat-label">In Stock</div></div>
                            <div class="tm-stat-arrow">›</div>
                        </div>
                        <div class="tm-stat tm-s-yellow" @onclick="() => FilterByStatus(StockFilter.LowStock)">
                            <div class="tm-stat-ico">⚠</div>
                            <div><div class="tm-stat-num">@pagedResultNew.Stats["LowStockCount"]</div><div class="tm-stat-label">Low Stock</div></div>
                            <div class="tm-stat-arrow">›</div>
                        </div>      
                        <div class="tm-stat tm-s-red" @onclick="() => FilterByStatus(StockFilter.OutOfStock)">
                            <div class="tm-stat-ico">⛔</div>
                            <div><div class="tm-stat-num">@pagedResultNew.Stats["OutOfStockCount"]</div><div class="tm-stat-label">Out of Stock</div></div>
                            <div class="tm-stat-arrow">›</div>
                        </div>  
                        <div class="tm-stat tm-s-purple" @onclick="ClearFilterAndFocusCategory">
                            <div class="tm-stat-ico">🏷</div>
                            <div><div class="tm-stat-num">@_categories.Count()</div><div class="tm-stat-label">Categories</div></div>
                            <div class="tm-stat-arrow">›</div>
                        </div>
                        <div class="tm-stat tm-s-teal" @onclick="ClearFilterAndFocusBrand">
                            <div class="tm-stat-ico">🔧</div>
                            <div><div class="tm-stat-num">@_brands.Count()</div><div class="tm-stat-label">Brands</div></div>
                            <div class="tm-stat-arrow">›</div>
                        </div>
                    </div>
    }

    <!-- Filters -->
    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search products by name, SKU, barcode..." value="@pagedRequest.SearchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select @onchange="OnCategoryChanged">
                <option value="">All Categories</option>
                @foreach (var c in _categories)
                {
                    <option value="@c.Id" selected="@(pagedRequest.CategoryId == c.Id)">@c.Name</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select @onchange="OnBrandChanged">
                <option value="">All Brands</option>
                @foreach (var b in _brands)
                {
                    <option value="@b.Id" selected="@(pagedRequest.BrandId == b.Id)">@b.Name</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select @onchange="OnStockStatusChanged">
                <option value="">All Status</option>
                <option value="StockFilter.InStock" selected="@(pagedRequest.Status == StockFilter.InStock)">In Stock</option>
                <option value="StockFilter.LowStock" selected="@(pagedRequest.Status == StockFilter.LowStock)">Low Stock</option>
                <option value="StockFilter.OutOfStock" selected="@(pagedRequest.Status == StockFilter.OutOfStock)"> Out of Stock</option>
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <!-- Table -->
    <div class="tm-card tm-table-card">
           @if (_loading)
        {
            <div style="position:absolute; inset:0; background:rgba(255,255,255,0.62); backdrop-filter:blur(1px); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2; border-radius:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Style="margin-top:8px; color:#334155; font-weight:600;">Loading trucks...</MudText>
            </div>
        }
        <div class="tm-table-wrap">
            <table class="tm-table">
                <thead>
                    <tr>
                        <th>Product Name ▲</th>
                        <th>SKU</th>
                        <th>Barcode</th>
                        <th>Category</th>
                        <th>Brand / Model</th>
                        <th>Cost Price</th>
                        <th>Selling Price</th>
                        <th>Wholesale</th>
                        <th>Stock</th>
                        <th>Reorder Level</th>
                        <th>Branch</th>
                        <th>Status</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                     @if (!_hasLoadedOnce && _loading && !pagedResultNew.Items.Any())
                    {
                        @* Initial skeleton — keeps table chrome visible on first load *@
                        <tr><td colspan="13" style="text-align:center; padding:40px; color:#94a3b8;">Loading trucks...</td></tr>
                    }
                    else if (!pagedResultNew.Items.Any())
                    {
                        <tr>
                            <td colspan="13" style="text-align:center; padding:40px;">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#94a3b8;" Class="mb-2" />
                                <div style="color:#64748b;">No trucks found — try a different search or filter</div>
                                 @if (!string.IsNullOrWhiteSpace(pagedRequest.SearchTerm))
                                { 
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2">Clear filters</MudButton>
                                }
                            </td>
                        </tr>
                    }                    
                    else
                    {
                        @foreach (var p in pagedResultNew.Items)
                        {
                            var status = GetStockStatus(p);
                            var pill = status == "In Stock" ? "tm-pill tm-pill-green" : status == "Low Stock" ? "tm-pill tm-pill-amber" : "tm-pill tm-pill-red";
                            var icoBg = GetIconBg(p.CategoryName);
                            <tr>
                                <td>
                                    <span class="tm-veh">@p.Name</span>
                                </td>
                                <td class="tm-num">@p.SKU</td>
                                <td class="tm-num">@(string.IsNullOrWhiteSpace(p.Barcode) ? "-" : p.Barcode)</td>
                                <td class="tm-dim">@(p.CategoryName ?? "-")</td>
                                <td class="tm-dim">@((p.BrandName ?? "-") + (string.IsNullOrWhiteSpace(p.Model) ? "" : $" ({p.Model})"))</td>
                                <td class="tm-money">@p.CostPrice.ToString("0.00")</td>
                                <td class="tm-money">@p.SellingPrice.ToString("0.00")</td>
                                <td class="tm-money">@p.WholeSellingPrice.ToString("0.00")</td>
                                <td class="tm-num">@p.TotalStock</td>
                                <td class="tm-num">@p.ReorderStockLevel</td>
                                <td class="tm-branch">@p.OriginCountry</td>
                                <td><span class="@pill"><span class="tm-dot"></span>@status</span></td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-view" title="View" @onclick="() => NavigateToDetail(p.Id)">👁</button>
                                        <button class="tm-act tm-act-edit" title="Edit" @onclick="() => OpenAddEditDialog(p)">✎</button>
                                        <button class="tm-act tm-act-del" title="Delete" @onclick="() => DeleteProduct(p.Id)">🗑</button>
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
         <div style="opacity:@(_loading ? "0.55" : "1"); pointer-events:@(_loading ? "none" : "auto");">
            <PaginationFooter CurrentPage="pagedResultNew.CurrentPage" PageSize="pagedResultNew.PageSize" TotalCount="pagedResultNew.TotalCount" TotalPages="pagedResultNew.TotalPages" ItemLabel="trucks" OnGoToPage="GoFirstPage" OnPrev="GoPrevPage" OnNext="GoNextPage" OnPageSizeChanged="OnPageSizeChanged" />
        </div>

        <div class="tm-footer">
            @* <span>Showing @(_totalCount == 0 ? 0 : ((_currentPage - 1) * _pageSize + 1)) to @(Math.Min(_currentPage * _pageSize, _totalCount)) of @_totalCount products</span>
            <span class="tm-pager">
                <span>Rows per page:</span>
                <select class="tm-rows-select" @onchange="OnPageSizeSelectChanged">
                    <option value="10" selected="@(_pageSize == 10)">10</option>
                    <option value="20" selected="@(_pageSize == 20)">20</option>
                    <option value="50" selected="@(_pageSize == 50)">50</option>
                    <option value="100" selected="@(_pageSize == 100)">100</option>
                </select>
                <button class="tm-page-btn" disabled="@(_currentPage <= 1)" @onclick="GoFirstPage">|◀</button>
                <button class="tm-page-btn" disabled="@(_currentPage <= 1)" @onclick="GoPrevPage">‹</button>
                @foreach (var pg in GetPageNumbers())
                {
                    var isActive = pg == _currentPage;
                    <button class="tm-page-btn @(isActive ? "active" : "")" @onclick="() => OnPageChanged(pg)">@pg</button>
                }
                <button class="tm-page-btn" disabled="@(_currentPage >= _totalPages)" @onclick="GoNextPage">›</button>
                <button class="tm-page-btn" disabled="@(_currentPage >= _totalPages)" @onclick="GoLastPage">▶|</button>
            </span> *@
        </div>
    </div>
</div>

