    private void OnSearchInput(ChangeEventArgs e)
    {
        pagedRequest.SearchTerm = e.Value?.ToString() ?? "";
        _debounce?.Stop();
        _debounce?.Dispose();
        _debounce = new System.Timers.Timer(400) { AutoReset = false };
        _debounce.Elapsed += async (_, __) =>
        {
                               pagedRequest.CurrentPage = 0;
            await InvokeAsync(async () => { await LoadProducts(); StateHasChanged(); });
        };
        _debounce.Start();
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        pagedRequest.CategoryId = string.IsNullOrEmpty(v) ? Guid.Empty : Guid.Parse(v);
        pagedRequest.CurrentPage = 0;
        await LoadProducts();
    }

    private async Task OnBrandChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        pagedRequest.BrandId = string.IsNullOrEmpty(v) ? Guid.Empty : Guid.Parse(v);
        pagedRequest.CurrentPage = 0;
        await LoadProducts();
    }

    private async Task OnStockStatusChanged(ChangeEventArgs e)
    {
        pagedRequest.Status = Enum.TryParse<StockFilter>(e.Value?.ToString(), out var status) ? status : null;
        pagedRequest.CurrentPage = 0;
        await LoadProducts();
    }

    private async Task FilterByStatus(StockFilter? f)
    {
        pagedRequest.Status = f == null ? null : f;
        pagedRequest.CurrentPage = 0;
        await LoadProducts();
        StateHasChanged();
    }

