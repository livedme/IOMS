@page "/products"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IProductService ProductService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Products - IOMS</PageTitle>


<div class="tm-page">
    <!-- Header -->
    <div class="tm-card tm-header">
        <div class="tm-header-left">
            <div class="tm-header-icon">📦</div>
            <div>
                <h2 class="tm-title">Product Management</h2>
                <p class="tm-subtitle">Manage your inventory, track product details and stock — server-side paging &amp; search</p>
            </div>
        </div>
        <button class="tm-add-btn" @onclick="() => OpenAddEditDialog(null)">+ Add Product</button>
    </div>

    <!-- Stats -->
    @if (pagedResultNew.Stats != null && (pagedResultNew.Stats.Count > 0))
    {
        <div class="tm-stats">
            <div class="tm-stat tm-s-blue" @onclick="() => FilterByStatus(null)">
                <div class="tm-stat-ico">📦</div>
                <div><div class="tm-stat-num">@pagedResultNew.Stats["TotalCount"]</div><div class="tm-stat-label">Products</div></div>
                            <div class="tm-stat-arrow">›</div>
                        </div>
                        <div class="tm-stat tm-s-green" @onclick="() => FilterByStatus(StockFilter.InStock)">
                            <div class="tm-stat-ico">✔</div>
                            <div><div class="tm-stat-num">@pagedResultNew.Stats["InStockCount"]</div><div class="tm-stat-label">In Stock</div></div>
                            <div class="tm-stat-arrow">›</div>
                        </div>
                        <div class="tm-stat tm-s-yellow" @onclick="() => FilterByStatus(StockFilter.LowStock)">
                            <div class="tm-stat-ico">⚠</div>
                            <div><div class="tm-stat-num">@pagedResultNew.Stats["LowStockCount"]</div><div class="tm-stat-label">Low Stock</div></div>
                            <div class="tm-stat-arrow">›</div>
                        </div>      
                        <div class="tm-stat tm-s-red" @onclick="() => FilterByStatus(StockFilter.OutOfStock)">
                            <div class="tm-stat-ico">⛔</div>
                            <div><div class="tm-stat-num">@pagedResultNew.Stats["OutOfStockCount"]</div><div class="tm-stat-label">Out of Stock</div></div>
                            <div class="tm-stat-arrow">›</div>
                        </div>  
                        <div class="tm-stat tm-s-purple" @onclick="ClearFilterAndFocusCategory">
                            <div class="tm-stat-ico">🏷</div>
                            <div><div class="tm-stat-num">@_categories.Count()</div><div class="tm-stat-label">Categories</div></div>
                            <div class="tm-stat-arrow">›</div>
                        </div>
                        <div class="tm-stat tm-s-teal" @onclick="ClearFilterAndFocusBrand">
                            <div class="tm-stat-ico">🔧</div>
                            <div><div class="tm-stat-num">@_brands.Count()</div><div class="tm-stat-label">Brands</div></div>
                            <div class="tm-stat-arrow">›</div>
                        </div>
                    </div>
    }

    <!-- Filters -->
    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search products by name, SKU, barcode..." value="@pagedRequest.SearchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select @onchange="OnCategoryChanged">
                <option value="">All Categories</option>
                @foreach (var c in _categories)
                {
                    <option value="@c.Id" selected="@(pagedRequest.CategoryId == c.Id)">@c.Name</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select @onchange="OnBrandChanged">
                <option value="">All Brands</option>
                @foreach (var b in _brands)
                {
                    <option value="@b.Id" selected="@(pagedRequest.BrandId == b.Id)">@b.Name</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select @onchange="OnStockStatusChanged">
                <option value="">All Status</option>
                <option value="StockFilter.InStock" selected="@(pagedRequest.Status == StockFilter.InStock)">In Stock</option>
                <option value="StockFilter.LowStock" selected="@(pagedRequest.Status == StockFilter.LowStock)">Low Stock</option>
                <option value="StockFilter.OutOfStock" selected="@(pagedRequest.Status == StockFilter.OutOfStock)"> Out of Stock</option>
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <!-- Table -->
    <div class="tm-card tm-table-card">
           @if (_loading)
        {
            <div style="position:absolute; inset:0; background:rgba(255,255,255,0.62); backdrop-filter:blur(1px); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2; border-radius:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Style="margin-top:8px; color:#334155; font-weight:600;">Loading trucks...</MudText>
            </div>
        }
        <div class="tm-table-wrap">
            <table class="tm-table">
                <thead>
                    <tr>
                        <th>Product Name ▲</th>
                        <th>SKU</th>
                        <th>Barcode</th>
                        <th>Category</th>
                        <th>Brand / Model</th>
                        <th>Cost Price</th>
                        <th>Selling Price</th>
                        <th>Wholesale</th>
                        <th>Stock</th>
                        <th>Reorder Level</th>
                        <th>Branch</th>
                        <th>Status</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                     @if (!_hasLoadedOnce && _loading && !pagedResultNew.Items.Any())
                    {
                        @* Initial skeleton — keeps table chrome visible on first load *@
                        <tr><td colspan="13" style="text-align:center; padding:40px; color:#94a3b8;">Loading trucks...</td></tr>
                    }
                    else if (!pagedResultNew.Items.Any())
                    {
                        <tr>
                            <td colspan="13" style="text-align:center; padding:40px;">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#94a3b8;" Class="mb-2" />
                                <div style="color:#64748b;">No trucks found — try a different search or filter</div>
                                 @if (!string.IsNullOrWhiteSpace(pagedRequest.SearchTerm))
                                { 
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2">Clear filters</MudButton>
                                }
                            </td>
                        </tr>
                    }                    
                    else
                    {
                        @foreach (var p in pagedResultNew.Items)
                        {
                            var status = GetStockStatus(p);
                            var pill = status == "In Stock" ? "tm-pill tm-pill-green" : status == "Low Stock" ? "tm-pill tm-pill-amber" : "tm-pill tm-pill-red";
                            var icoBg = GetIconBg(p.CategoryName);
                            <tr>
                                <td>
                                    <span class="tm-veh">@p.Name</span>
                                </td>
                                <td class="tm-num">@p.SKU</td>
                                <td class="tm-num">@(string.IsNullOrWhiteSpace(p.Barcode) ? "-" : p.Barcode)</td>
                                <td class="tm-dim">@(p.CategoryName ?? "-")</td>
                                <td class="tm-dim">@((p.BrandName ?? "-") + (string.IsNullOrWhiteSpace(p.Model) ? "" : $" ({p.Model})"))</td>
                                <td class="tm-money">@p.CostPrice.ToString("0.00")</td>
                                <td class="tm-money">@p.SellingPrice.ToString("0.00")</td>
                                <td class="tm-money">@p.WholeSellingPrice.ToString("0.00")</td>
                                <td class="tm-num">@p.TotalStock</td>
                                <td class="tm-num">@p.ReorderStockLevel</td>
                                <td class="tm-branch">@p.OriginCountry</td>
                                <td><span class="@pill"><span class="tm-dot"></span>@status</span></td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-view" title="View" @onclick="() => NavigateToDetail(p.Id)">👁</button>
                                        <button class="tm-act tm-act-edit" title="Edit" @onclick="() => OpenAddEditDialog(p)">✎</button>
                                        <button class="tm-act tm-act-del" title="Delete" @onclick="() => DeleteProduct(p.Id)">🗑</button>
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
         <div style="opacity:@(_loading ? "0.55" : "1"); pointer-events:@(_loading ? "none" : "auto");">
            <TmPager CurrentPage="pagedResultNew.CurrentPage"
                     PageSize="pagedResultNew.PageSize"
                     TotalCount="pagedResultNew.TotalCount"
                     TotalPages="pagedResultNew.TotalPages"
                     ItemLabel="Products"
                     OnGoToPage="GoToPage"
                     OnPrev="GoPrevPage"
                     OnNext="GoNextPage"
                     OnPageSizeChanged="OnPageSizeChanged" />
        </div>
    </div>
</div>

@code {

    //private List<ProductDto> _products = new();
    private List<ProductDto> _statsCache = new();
    private List<CategoryDto> _categories = new();
    private List<BrandDto> _brands = new();
    private System.Timers.Timer? _debounce;

    private PagedResultNew<ProductDto> pagedResultNew = new();
    private ProductPagedRequest pagedRequest = new();

    // Paging state lives on pagedRequest (CurrentPage is zero-based) and TmPager binds straight
    // to pagedResultNew, so the pager highlight and the query always agree on the current page.
    private bool _loading = true;
    bool _hasLoadedOnce = false;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categories = await ProductService.GetAllCategoriesAsync();
            //_categoryCount = _categories.Count; 
        }
        catch { }
        try
        {
            _brands = await ProductService.GetAllBrandsAsync();
            //_brandCount = _brands.Count;
        }
        catch { }
        await LoadProducts();
    }

    private void NavigateToDetail(Guid id) => Navigation.NavigateTo($"/products/{id}");

    private string GetStockStatus(ProductDto p)
    {
        if (p.TotalStock <= 0) return "Out of Stock";
        if (p.TotalStock <= p.ReorderStockLevel) return "Low Stock";
        return "In Stock";
    }

    private string GetIconBg(string? cat)
    {
        var palettes = new[] { "#e0e9ff", "#fee2e2", "#dcfce7", "#ede9fe", "#ffedd5", "#e0f2fe", "#fef9c3" };
        if (string.IsNullOrEmpty(cat)) return palettes[0];
        return palettes[Math.Abs(cat.GetHashCode()) % palettes.Length];
    }

    private async Task LoadProducts()
    {
        _loading = true;
        try
        {
            pagedResultNew = await ProductService.GetProductsAsync(pagedRequest);

            // Deleting the last row on the last page, or narrowing a filter, can leave the
            // current page past the end. Step back until a page has content, otherwise the table
            // renders empty while the pager still points at a valid-looking page number.
            if (pagedResultNew.Items.Count == 0 && pagedRequest.CurrentPage > 0)
            {
                pagedRequest.CurrentPage--;
                pagedResultNew = await ProductService.GetProductsAsync(pagedRequest);
            }

            _hasLoadedOnce = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading products: {ex.Message}", Severity.Error);
        }
        finally { _loading = false; }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        pagedRequest.SearchTerm = e.Value?.ToString() ?? "";
        pagedRequest.CurrentPage = 0;
        _debounce?.Stop();
        _debounce?.Dispose();
        _debounce = new System.Timers.Timer(400) { AutoReset = false };
        _debounce.Elapsed += async (_, __) =>
        {
            await InvokeAsync(async () => { await LoadProducts(); StateHasChanged(); });
        };
        _debounce.Start();
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        pagedRequest.CategoryId = string.IsNullOrEmpty(v) ? Guid.Empty : Guid.Parse(v);
        pagedRequest.CurrentPage = 0;
        await LoadProducts();
    }

    private async Task OnBrandChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        pagedRequest.BrandId = string.IsNullOrEmpty(v) ? Guid.Empty : Guid.Parse(v);
        pagedRequest.CurrentPage = 0;
        await LoadProducts();
    }

    private async Task OnStockStatusChanged(ChangeEventArgs e)
    {
        pagedRequest.Status = Enum.TryParse<StockFilter>(e.Value?.ToString(), out var status) ? status : null;
        pagedRequest.CurrentPage = 0;
        await LoadProducts();
    }

    private async Task FilterByStatus(StockFilter? f)
    {
        pagedRequest.Status = f;
        pagedRequest.CurrentPage = 0;
        await LoadProducts();
        StateHasChanged();
    }

    private void ClearFilterAndFocusCategory() { }
    private void ClearFilterAndFocusBrand() { }

    private async Task ResetFilters()
    {
        pagedRequest.SearchTerm = "";
        pagedRequest.CategoryId = null;
        pagedRequest.BrandId = null;
        pagedRequest.Status = null;
        pagedRequest.CurrentPage = 0;
        await LoadProducts();
    }


    private async Task GoToPage(int page)
    {
        pagedRequest.CurrentPage = Math.Clamp(page, 0, Math.Max(0, pagedResultNew.TotalPages - 1));
        await LoadProducts();
    }
    private async Task GoPrevPage()
    {
        if (pagedRequest.CurrentPage > 0)
        {
            pagedRequest.CurrentPage--;
            await LoadProducts();
        }
    }

    private async Task GoNextPage()
    {
        if (pagedRequest.CurrentPage < pagedResultNew.TotalPages - 1)
        {
            pagedRequest.CurrentPage++;
            await LoadProducts();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sz))
        {
            pagedRequest.PageSize = Math.Clamp(sz, 1, 100);
            pagedRequest.CurrentPage = 0;
            await LoadProducts();
        }
    }

    private async Task OpenAddEditDialog(ProductDto? product)
    {
        var categories = await ProductService.GetAllCategoriesAsync();
        var brands = await ProductService.GetAllBrandsAsync();
        var detailsDto = new ProductDetailsDto();
        if (product != null)
        {
            var fullProduct = await ProductService.GetProductDetailsByIdAsync(product.Id);
            detailsDto = new ProductDetailsDto()
            {
                Id = fullProduct?.Id ?? Guid.Empty,
                Name = fullProduct?.Name,
                SKU = fullProduct?.SKU ?? "",
                Barcode = fullProduct?.Barcode,
                Description = fullProduct?.Description,
                CostPrice = fullProduct?.CostPrice ?? 0,
                SellingPrice = fullProduct?.SellingPrice ?? 0,
                WholeSellingPrice = fullProduct?.WholeSellingPrice ?? 0,
                ReorderStockLevel = fullProduct?.ReorderStockLevel ?? 0,
                MinOrderQuantity = fullProduct?.MinOrderQuantity ?? 0,
                CategoryId = fullProduct?.CategoryId ?? Guid.Empty,
                CategoryName = product?.CategoryName,
                BrandId = fullProduct?.BrandId,
                BrandName = fullProduct?.BrandName,
                ImageUrl = fullProduct?.ImageUrl,
                IsKit = fullProduct?.IsKit ?? false,
                Model = fullProduct?.Model,
                OriginCountry = fullProduct?.OriginCountry ?? "",
                OriginManufacturer = fullProduct?.OriginManufacturer ?? ""
            };
        };

        var parameters = new DialogParameters<ProductAddEditDialog>
        {
            { x => x.DataModel, detailsDto },
            { x => x.Categories, categories.ToList() },
            { x => x.Brands, brands.ToList() }
        };

        var dialog = await DialogService.ShowAsync<ProductAddEditDialog>("New Product", parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        });

        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is ProductDetailsDto dto)
        {
            if (dto.Id == Guid.Empty)
            {
                await ProductService.CreateProductAsync(dto);
            }
            else
            {
                await ProductService.UpdateProductDetailsAsync(dto);
            }
            Snackbar.Add(dto.Id == Guid.Empty ? "Product created successfully" : "Product updated successfully", Severity.Success);
            await LoadProducts();
        }
    }

    private async Task DeleteProduct(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Confirm Delete",
            "Are you sure you want to delete this product?", "Delete", "Cancel");
        if (confirm == true)
        {
            await ProductService.DeleteProductAsync(id);
            Snackbar.Add("Product deleted", Severity.Success);
            await LoadProducts();
        }
    }
}
