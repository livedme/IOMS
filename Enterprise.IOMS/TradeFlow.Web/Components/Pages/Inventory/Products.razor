    private async Task OnPageChanged(int page) { pagedRequest.CurrentPage = page; await LoadProducts(); }
    private async Task GoFirstPage() { if (pagedRequest.CurrentPage > 0) { pagedRequest.CurrentPage = 0; await LoadProducts(); } }
    private async Task GoPrevPage() { if (pagedRequest.CurrentPage > 0) { pagedRequest.CurrentPage--; await LoadProducts(); } }
    private async Task GoNextPage() { if (pagedRequest.CurrentPage < pagedResultNew.TotalPages - 1) { pagedRequest.CurrentPage++; await LoadProducts(); } }
    private async Task GoLastPage() { if (pagedRequest.CurrentPage < pagedResultNew.TotalPages - 1) { pagedRequest.CurrentPage = pagedResultNew.TotalPages - 1; await LoadProducts(); } }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sz)) { pagedRequest.PageSize = sz; pagedRequest.CurrentPage = 0; await LoadProducts(); }
    }

    private IEnumerable<int> GetPageNumbers()
    {
        var start = Math.Max(1, Math.Min(pagedRequest.CurrentPage - 1, Math.Max(1, pagedResultNew.TotalPages - 3)));
        var end = Math.Min(pagedResultNew.TotalPages, start + 3);
        for (var i = start; i <= end; i++) yield return i;
    }

    private async Task OpenAddEditDialog(ProductDto? product)
    {
        var categories = await ProductService.GetAllCategoriesAsync();
        var brands = await ProductService.GetAllBrandsAsync();
        var detailsDto = new ProductDetailsDto();
        if (product != null)
        {
            var fullProduct = await ProductService.GetProductDetailsByIdAsync(product.Id);
            detailsDto = new ProductDetailsDto()
            {
                Id = fullProduct?.Id ?? Guid.Empty,
                Name = fullProduct?.Name,
                SKU = fullProduct?.SKU ?? "",
                Barcode = fullProduct?.Barcode,
                Description = fullProduct?.Description,
                CostPrice = fullProduct?.CostPrice ?? 0,
                SellingPrice = fullProduct?.SellingPrice ?? 0,
                WholeSellingPrice = fullProduct?.WholeSellingPrice ?? 0,
                ReorderStockLevel = fullProduct?.ReorderStockLevel ?? 0,
                MinOrderQuantity = fullProduct?.MinOrderQuantity ?? 0,
                CategoryId = fullProduct?.CategoryId ?? Guid.Empty,
                CategoryName = product?.CategoryName,
                BrandId = fullProduct?.BrandId,
                BrandName = fullProduct?.BrandName,
                ImageUrl = fullProduct?.ImageUrl,
                IsKit = fullProduct?.IsKit ?? false,
                Model = fullProduct?.Model,
                OriginCountry = fullProduct?.OriginCountry ?? "",
                OriginManufacturer = fullProduct?.OriginManufacturer ?? ""
            };
        };

        var parameters = new DialogParameters<ProductAddEditDialog>
        {
            { x => x.DataModel, detailsDto },
            { x => x.Categories, categories.ToList() },
            { x => x.Brands, brands.ToList() }
        };

        var dialog = await DialogService.ShowAsync<ProductAddEditDialog>("New Product", parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        });

        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is ProductDetailsDto dto)
        {
            if (dto.Id == Guid.Empty)
            {
                await ProductService.CreateProductAsync(dto);
            }
            else
            {
                await ProductService.UpdateProductDetailsAsync(dto);
            }
            Snackbar.Add(dto.Id == Guid.Empty ? "Product created successfully" : "Product updated successfully", Severity.Success);
            await LoadProducts();
            await LoadStatsAsync();
        }
    }

    private async Task DeleteProduct(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Confirm Delete",
            "Are you sure you want to delete this product?", "Delete", "Cancel");
        if (confirm == true)
        {
            await ProductService.DeleteProductAsync(id);
            Snackbar.Add("Product deleted", Severity.Success);
            await LoadProducts();
            await LoadStatsAsync();
        }
    }
