@inject IInventoryService InventoryService
@inject IWarehousesService WarehousesService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (_open)
{
    <div class="so-backdrop" @onclick="Close"></div>

    <div class="so-side-panel @(_animateIn ? "so-panel-open" : "")">

        <!-- Header -->
        <div class="so-header">
            <div class="d-flex align-items-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Primary" />
                <div>
                    <div class="so-header-title">Stock Transfer</div>
                    @if (_transfer != null)
                    {
                        <div class="so-header-sub">@_transfer.TransferNumber</div>
                    }
                </div>
                @if (_transfer != null)
                {
                    <MudChip T="string" Color="@CommonUtility.GetStatusColor(_transfer.Status)" Size="Size.Small" Class="ms-1">
                        @_transfer.Status</MudChip>
                }
            </div>
            <div class="d-flex gap-1">
                @if (_transfer != null && _transfer.Status != StockTransferStatus.Cancelled)
                {
                    <MudTooltip Text="Edit Transfer">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="OpenEdit" />
                    </MudTooltip>
                }
                <MudTooltip Text="Close panel">
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="Close" />
                </MudTooltip>
            </div>
        </div>

        <!-- Body -->
        <div class="so-body">
            @if (_loading)
            {
                <div class="d-flex justify-center align-center" style="height:200px;">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                </div>
            }
            else if (_transfer != null)
            {
                <!-- Reference block -->
                <div class="so-ref-block mb-3">
                    <div class="d-flex justify-space-between">
                        <div>
                            <div class="so-lbl">Transfer Number</div>
                            <div class="so-val-lg">@_transfer.TransferNumber</div>
                        </div>
                        <div class="text-end">
                            <div class="so-lbl">Transfer Date</div>
                            <div class="so-val fw-semibold">@_transfer.TransferDate.ToString("dd MMM yyyy")</div>
                        </div>
                    </div>
                </div>

                <MudDivider Class="mb-3" />

                <!-- From & To warehouses -->
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="6">
                        <div class="so-info-card">
                            <div class="so-info-icon">
                                <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Small" Style="color:#fff;" />
                            </div>
                            <div class="overflow-hidden">
                                <div class="so-lbl">From Warehouse</div>
                                <div class="so-val fw-bold text-truncate">@_transfer.SourceWarehouseName</div>
                            </div>
                        </div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="so-info-card">
                            <div class="so-info-icon">
                                <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Small" Style="color:#fff;" />
                            </div>
                            <div class="overflow-hidden">
                                <div class="so-lbl">To Warehouse</div>
                                <div class="so-val fw-bold text-truncate">@_transfer.TargetWarehouseName</div>
                            </div>
                        </div>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="mb-3" />

                <!-- Items table, grouped by source warehouse -->
                <div class="so-section-lbl mb-2">Transfer Items (@_transfer.Items.Count)</div>
                <div class="so-items-wrapper">
                    <MudTable Items="@_items" Dense="true" Hover="true" Elevation="0" Class="so-items-table" GroupBy="@_groupDefinition">
                        <HeaderContent>
                            <MudTh>Product</MudTh>
                            <MudTh Style="text-align:right">Qty</MudTh>
                        </HeaderContent>
                        <GroupHeaderTemplate>
                            <MudTh colspan="2">🏬 @context.Key (@context.Items.Count() line(s) · @context.Items.Sum(i => i.Quantity) units)</MudTh>
                        </GroupHeaderTemplate>
                        <RowTemplate>
                            <MudTd>
                                <div class="so-val fw-semibold" style="line-height:1.2;">@context.ProductName</div>
                                <div class="so-sm text-muted">@context.ProductSKU</div>
                            </MudTd>
                            <MudTd Style="text-align:right;font-weight:600;">@context.Quantity</MudTd>
                        </RowTemplate>
                        <GroupFooterTemplate>
                            <MudTd colspan="2" Style="text-align:right;font-weight:600;">Subtotal: @context.Items.Sum(i => i.Quantity) units</MudTd>
                        </GroupFooterTemplate>
                    </MudTable>
                </div>

                <MudDivider Class="my-3" />

                <!-- Totals -->
                <div class="so-totals-box">
                    <div class="so-total-row">
                        <span>Total Lines</span>
                        <span>@_transfer.TotalLines</span>
                    </div>
                    <div class="so-total-row so-grand-total">
                        <span>TOTAL UNITS</span>
                        <span>@_transfer.TotalQuantity</span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_transfer.Notes))
                {
                    <MudDivider Class="my-3" />
                    <div class="so-lbl mb-1">Notes</div>
                    <div class="so-val">@_transfer.Notes</div>
                }
            }
        </div>

        <!-- Footer -->
        @if (_transfer != null)
        {
            <div class="so-footer">
                <MudButton Variant="Variant.Text" OnClick="Close" Size="Size.Small">Close</MudButton>
                @if (_transfer.Status != StockTransferStatus.Cancelled)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenEdit">Edit Transfer</MudButton>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public EventCallback OnTransferUpdated { get; set; }

    private bool _open;
    private bool _animateIn;
    private bool _loading;
    private StockTransferListDto? _transfer;
    private List<StockTransferItemDto> _items = new();

    private TableGroupDefinition<StockTransferItemDto> _groupDefinition = new()
    {
        GroupName = "Warehouse",
        Indentation = false,
        Expandable = true,
        IsInitiallyExpanded = true,
        Selector = (e) => e.SourceWarehouseName
    };

    /// <summary>Flattens lines for the grouped table (missing warehouse falls back to the header source).</summary>
    private void BuildItems()
    {
        var fallback = _transfer?.SourceWarehouseName ?? string.Empty;
        _items = (_transfer?.Items ?? new List<StockTransferItemDto>())
            .Select(i => string.IsNullOrWhiteSpace(i.SourceWarehouseName) ? i with { SourceWarehouseName = fallback } : i)
            .OrderBy(i => i.SourceWarehouseName)
            .ThenBy(i => i.ProductName)
            .ToList();
    }

    public async Task OpenAsync(Guid id)
    {
        _open = true;
        _loading = true;
        _animateIn = false;
        _transfer = null;
        StateHasChanged();

        // Small delay so the panel renders before the slide-in class is added
        await Task.Delay(20);
        _animateIn = true;
        StateHasChanged();

        try
        {
            _transfer = await InventoryService.GetStockTransferByIdAsync(id);
            BuildItems();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        _loading = false;
        StateHasChanged();
    }

    public void Close()
    {
        _open = false;
        _animateIn = false;
        _transfer = null;
        _items = new();
        StateHasChanged();
    }

