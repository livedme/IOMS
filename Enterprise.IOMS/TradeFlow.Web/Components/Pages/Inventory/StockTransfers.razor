@page "/inventory/transfers"
@rendermode InteractiveServer
@inject IInventoryService InventoryService
@inject ISnackbar Snackbar
@using TradeFlow.Infrastructure.Data
@inject ApplicationDbContext DbContext

<PageTitle>Stock Transfers - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="🚚" Title="Stock Transfers" Subtitle="Move stock between warehouses and review transfer history">
        <Actions>
            <button class="tm-add-btn" @onclick="Load">⟳ Refresh</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="🚚" Number="@_transfers.Count" Label="Transfers" Tone="blue" />
        <TmStatTile Icon="📦" Number="@_distinctProducts" Label="Products Moved" Tone="purple" />
        <TmStatTile Icon="⬆️" Number="@_totalUnits" Label="Total Units" Tone="green" />
        <TmStatTile Icon="🏬" Number="@_warehouses.Count" Label="Warehouses" Tone="teal" />
        <TmStatTile Icon="📅" Number="@_lastTransferText" Label="Last Transfer" Tone="yellow" />
        <TmStatTile Icon="📥" Number="@_latestIn" Label="Latest In" Tone="green" />
    </div>

    <!-- New transfer form -->
    <div class="tm-card tm-filters" style="flex-wrap:wrap">
        <div class="tm-select">
            <select @onchange="OnProductChanged">
                <option value="">Select Product</option>
                @foreach (var p in _products)
                {
                    <option value="@p.Id" selected="@(_transferProductId == p.Id)">@p.Name (@p.SKU)</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select @onchange="OnSourceChanged">
                <option value="">From Warehouse</option>
                @foreach (var w in _warehouses)
                {
                    <option value="@w.Id" selected="@(_sourceWarehouseId == w.Id)">@w.Name</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select @onchange="OnTargetChanged">
                <option value="">To Warehouse</option>
                @foreach (var w in _warehouses)
                {
                    <option value="@w.Id" selected="@(_targetWarehouseId == w.Id)">@w.Name</option>
                }
            </select>
        </div>
        <div class="tm-select" style="flex:0 0 130px; min-width:130px">
            <input type="number" min="1" style="width:100%; border:1px solid #c9ced6; border-radius:6px; padding:9px 12px; font-size:13.5px; outline:none"
                   value="@_transferQty" @onchange="OnQtyChanged" placeholder="Qty" />
        </div>
        <button class="tm-add-btn" @onclick="ExecuteTransfer">Transfer Stock</button>
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by product or reference..." value="@_search" @oninput="OnSearchInput" />
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:820px">
                <thead>
                    <tr>
                        <th>📅 Date</th>
                        <th>📦 Product</th>
                        <th>Warehouse</th>
                        <th style="text-align:right">Quantity</th>
                        <th>Reference</th>
                        <th>Direction</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="6"><TmLoading Message="Loading transfers..." /></td></tr>
                    }
                    else if (Paged.Count == 0)
                    {
                        <tr><td colspan="6"><div class="tm-loading">No transfers found</div></td></tr>
                    }
                    else
                    {
                        @foreach (var t in Paged)
                        {
                            var isIn = t.Quantity >= 0;
                            <tr>
                                <td class="tm-dim">@t.MovementDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#e0e9ff">📦</span>@t.ProductName</span></td>
                                <td class="tm-branch">@t.WarehouseName</td>
                                <td style="text-align:right">
                                    <span style="font-weight:700; color:@(isIn ? "#15803d" : "#dc2626")">
                                        @(isIn ? "+" : "")@t.Quantity
                                    </span>
                                </td>
                                <td class="tm-num">@(string.IsNullOrWhiteSpace(t.Reference) ? "-" : t.Reference)</td>
                                <td>
                                    <span class="tm-pill @(isIn ? "tm-pill-green" : "tm-pill-red")">
                                        <span class="tm-dot"></span>@(isIn ? "Stock In" : "Stock Out")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <TmPager Total="@Filtered.Count" Page="@_page" PageSize="@_pageSize" ItemNoun="transfers"
                  PageChanged="@(p => _page = p)" PageSizeChanged="@OnPageSizeChanged" />
    </div>
</div>

@code {
    private record TransferDisplay(DateTime MovementDate, string ProductName, string WarehouseName, int Quantity, string? Reference);

    private List<TransferDisplay> _transfers = new();
    private List<Product> _products = new();
    private List<Warehouse> _warehouses = new();
    private Guid _transferProductId, _sourceWarehouseId, _targetWarehouseId;
    private int _transferQty = 1;
    private bool _loading = true;
    private string _search = "";
    private int _page = 1;
    private int _pageSize = 10;
    private int _distinctProducts, _totalUnits, _latestIn;
    private string _lastTransferText = "-";

    protected override async Task OnInitializedAsync()
    {
        _products = await DbContext.Products.OrderBy(p => p.Name).ToListAsync();
        _warehouses = await DbContext.Warehouses.Where(w => w.IsActive).OrderBy(w => w.Name).ToListAsync();
        await Load();
    }

    private List<TransferDisplay> Filtered => _transfers.Where(t =>
        string.IsNullOrWhiteSpace(_search)
        || t.ProductName.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || (t.Reference?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    private List<TransferDisplay> Paged => Filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    private async Task Load()
    {
        _loading = true;
        try
        {
            _transfers = await DbContext.StockMovements
                .Include(m => m.Product).Include(m => m.Warehouse)
                .Where(m => m.Type == StockMovementType.Transfer)
                .OrderByDescending(m => m.MovementDate).Take(100)
                .Select(m => new TransferDisplay(m.MovementDate, m.Product.Name, m.Warehouse.Name, m.Quantity, m.Reference))
                .ToListAsync();

            _distinctProducts = _transfers.Select(t => t.ProductName).Distinct().Count();
            _totalUnits = _transfers.Sum(t => Math.Abs(t.Quantity));
            _latestIn = _transfers.FirstOrDefault(t => t.Quantity > 0)?.Quantity ?? 0;
            _lastTransferText = _transfers.Count > 0 ? _transfers[0].MovementDate.ToString("dd MMM") : "-";
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task ExecuteTransfer()
    {
        try
        {
            if (_transferProductId == Guid.Empty || _sourceWarehouseId == Guid.Empty || _targetWarehouseId == Guid.Empty)
            {
                Snackbar.Add("Please select a product, source and target warehouse.", Severity.Warning);
                return;
            }
            if (_sourceWarehouseId == _targetWarehouseId)
            {
                Snackbar.Add("Source and target warehouses must be different.", Severity.Warning);
                return;
            }
            await InventoryService.TransferStock(_transferProductId, _sourceWarehouseId, _targetWarehouseId, _transferQty);
            Snackbar.Add("Stock transferred successfully.", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void OnProductChanged(ChangeEventArgs e) => _transferProductId = ParseGuid(e.Value);
    private void OnSourceChanged(ChangeEventArgs e) => _sourceWarehouseId = ParseGuid(e.Value);
    private void OnTargetChanged(ChangeEventArgs e) => _targetWarehouseId = ParseGuid(e.Value);

    private void OnQtyChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var q) && q > 0) _transferQty = q;
    }

    private static Guid ParseGuid(object? v) =>
        Guid.TryParse(v?.ToString(), out var g) ? g : Guid.Empty;

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 1;
    }

    private void ResetFilters()
    {
        _search = "";
        _page = 1;
    }

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
    }
}
