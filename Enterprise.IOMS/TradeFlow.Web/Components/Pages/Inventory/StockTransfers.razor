@page "/inventory/transfers"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject IInventoryService InventoryService
@inject ISnackbar Snackbar
@inject IWarehousesService WarehousesService
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Stock Transfers - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="🚚" Title="Stock Transfers" Subtitle="Move stock between warehouses and review transfer history">
        <Actions>
            <button class="tm-reset" @onclick="Refresh">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="() => OpenTransferDialog()">+ New Transfer</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="🚚" Number="@TotalCountText" Label="Transfers" Tone="blue" OnClick="@ResetFilters" />
        <TmStatTile Icon="📦" Number="@TotalLinesText" Label="Lines" Tone="purple" />
        <TmStatTile Icon="⬆️" Number="@TotalUnitsText" Label="Total Units" Tone="green" />
        <TmStatTile Icon="🏬" Number="@WarehouseCountText" Label="Warehouses" Tone="teal" OnClick="@(() => Navigation.NavigateTo("/shop/warehouses"))" />
        <TmStatTile Icon="📅" Number="@LastTransferText" Label="Last Transfer" Tone="yellow" />
        <TmStatTile Icon="✅" Number="@CompletedCountText" Label="Completed" Tone="green" OnClick="@FilterCompleted" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by transfer #, product, warehouse or notes..." value="@pagedRequest.SearchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.WarehouseId?.ToString() ?? "")" @onchange="OnWarehouseChanged">
                <option value="">All Warehouses</option>
                @foreach (var w in _warehouses)
                {
                    <option value="@w.Id">@w.Name</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.Status?.ToString() ?? "")" @onchange="OnStatusChanged">
                <option value="">All Statuses</option>
                @foreach (var s in Enum.GetValues<StockTransferStatus>())
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <input type="date" value="@FormatDate(pagedRequest.From)" @onchange="OnFromChanged" title="From date" />
        </div>
        <div class="tm-select">
            <input type="date" value="@FormatDate(pagedRequest.To)" @onchange="OnToChanged" title="To date" />
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        @if (_loading)
        {
            <div style="position:absolute; inset:0; background:rgba(255,255,255,0.62); backdrop-filter:blur(1px); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2; border-radius:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Style="margin-top:8px; color:#334155; font-weight:600;">Loading transfers...</MudText>
            </div>
        }
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:900px">
                <thead>
                    <tr>
                        <th style="width:36px;"></th>
                        <th @onclick="@(() => SortBy(Col.TransferNumber))"># Transfer @SortIcon(Col.TransferNumber)</th>
                        <th @onclick="@(() => SortBy(Col.TransferDate))">📅 Date @SortIcon(Col.TransferDate)</th>
                        <th @onclick="@(() => SortBy(Col.SourceWarehouse))">From @SortIcon(Col.SourceWarehouse)</th>
                        <th @onclick="@(() => SortBy(Col.TargetWarehouse))">To @SortIcon(Col.TargetWarehouse)</th>
                        <th style="text-align:right">Lines</th>
                        <th style="text-align:right" @onclick="@(() => SortBy(Col.TotalQuantity))">Units @SortIcon(Col.TotalQuantity)</th>
                        <th>Status</th>
                        <th style="width:60px;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_hasLoadedOnce && _loading)
                    {
                        <tr><td colspan="9" style="text-align:center; padding:40px; color:#94a3b8;">Loading transfers...</td></tr>
                    }
                    else if (pagedResultNew.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="9" style="text-align:center; padding:40px;">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#94a3b8;" Class="mb-2" />
                                <div style="color:#64748b;">No transfers found — try a different search or filter</div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="ResetFilters">Clear filters</MudButton>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in pagedResultNew.Items)
                        {
                            var expanded = _expanded.Contains(t.Id);
                            <tr>
                                <td>
                                    <MudIconButton Icon="@(expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                   Size="Size.Small" Color="Color.Default" OnClick="@(() => ToggleExpand(t.Id))" />
                                </td>
                                <td class="tm-num">@t.TransferNumber</td>
                                <td class="tm-dim">@t.TransferDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#fee2e2">🏬</span>@t.SourceWarehouseName</span></td>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#dcfce7">🏬</span>@t.TargetWarehouseName</span></td>
                                <td style="text-align:right">@t.TotalLines</td>
                                <td style="text-align:right"><span style="font-weight:700;">@t.TotalQuantity</span></td>
                                <td>
                                    <span class="tm-pill @StatusPill(t.Status)">
                                        <span class="tm-dot"></span>@t.Status
                                    </span>
                                </td>
                                <td class="text-end">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Default"
                                                   OnClick="@(() => _viewPanel?.OpenAsync(t.Id))" />
                                    @if (t.Status != StockTransferStatus.Cancelled)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info"
                                                       OnClick="@(() => OpenTransferDialog(t))" />
                                    }
                                </td>
                            </tr>
                            @if (expanded)
                            {
                                <tr>
                                    <td></td>
                                    <td colspan="8" style="background:#f8fafc; padding:8px 12px 12px 0;">
                                        <table class="tm-table" style="min-width:0; background:#fff;">
                                            <thead>
                                                <tr>
                                                    <th>📦 Product</th>
                                                    <th>SKU</th>
                                                    <th style="text-align:right">Qty</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var line in t.Items)
                                                {
                                                    <tr>
                                                        <td>@line.ProductName</td>
                                                        <td class="tm-dim">@line.ProductSKU</td>
                                                        <td style="text-align:right; font-weight:700;">@line.Quantity</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        @if (!string.IsNullOrWhiteSpace(t.Notes))
                                        {
                                            <div class="tm-dim" style="margin-top:6px;">📝 @t.Notes</div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
        <div style="opacity:@(_loading ? "0.55" : "1"); pointer-events:@(_loading ? "none" : "auto");">
            <TmPager CurrentPage="pagedResultNew.CurrentPage"
                     PageSize="pagedResultNew.PageSize"
                     TotalCount="pagedResultNew.TotalCount"
                     TotalPages="pagedResultNew.TotalPages"
                     ItemLabel="Stock Transfers"
                     OnGoToPage="GoToPage"
                     OnPrev="GoPrevPage"
                     OnNext="GoNextPage"
                     OnPageSizeChanged="OnPageSizeChanged" />
        </div>
    </div>
</div>

<StockTransferViewPanel @ref="_viewPanel" OnTransferUpdated="Refresh" />

@code {
    private static class Col
    {
        public const string TransferDate = "TransferDate";
        public const string TransferNumber = "TransferNumber";
        public const string SourceWarehouse = "SourceWarehouse";
        public const string TargetWarehouse = "TargetWarehouse";
        public const string TotalQuantity = "TotalQuantity";
    }

    // ─── List state ───
    // The grid lists StockTransfer batches (one row per transfer, expandable lines).
    private PagedResultNew<StockTransferListDto> pagedResultNew = new();
    private StockTransferPagedRequest pagedRequest = new()
    {
        SortColumn = Col.TransferDate,
        SortAscending = false
    };

    private readonly HashSet<Guid> _expanded = new();
    private StockTransferViewPanel? _viewPanel;

    private List<(Guid Id, string Name)> _warehouses = new();
    private bool _loading = true;
    private bool _hasLoadedOnce;
    private bool _loadRunning;
    private bool _loadQueued;
    private CancellationTokenSource? _debounceCts;

    protected override async Task OnInitializedAsync()
    {  
        try
        {
            var warehouses = await WarehousesService.GetAllWarehousesAsync();
            _warehouses = warehouses
                .OrderBy(w => w.Name)
                .Select(w => (w.Id, w.Name))
                .ToList();
        }
        catch { }

        await Load();
    }

    private async Task Refresh() => await Load();

    /// <summary>
    /// Single-flight loader. The page and the services share one scoped DbContext, so two
    /// overlapping queries would throw "A second operation was started on this context
    /// instance". Callers that arrive mid-flight set a flag instead of starting a parallel
    /// query, and the running load then re-runs once with the newest filter state.
    /// </summary>
    private async Task Load()
    {
        if (_loadRunning)
        {
            _loadQueued = true;
            return;
        }

        _loadRunning = true;
        try
        {
            do
            {
                _loadQueued = false;
                await LoadCore();
            }
            while (_loadQueued);
        }
        finally { _loadRunning = false; }
    }

    private async Task LoadCore()
    {
        _loading = true;
        try
        {
            pagedResultNew = await InventoryService.GetStockTransfersPagedAsync(pagedRequest);
            _hasLoadedOnce = true;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    // ─── Stats / sorting helpers ───
    private string TotalCountText => Stat("TotalCount");
    private string TotalLinesText => Stat("TotalLines");
    private string TotalUnitsText => Stat("TotalUnits");
    private string WarehouseCountText => Stat("WarehouseCount");
    private string CompletedCountText => Stat("CompletedCount");

    // The newest transfer on the current page — the grid is date-sorted, so it is the first row.
    private string LastTransferText =>
        pagedResultNew.Items.Count > 0 ? pagedResultNew.Items[0].TransferDate.ToString("dd MMM") : "-";

    private string Stat(string key) =>
        pagedResultNew.Stats != null && pagedResultNew.Stats.TryGetValue(key, out var v) ? v.ToString() : "0";

    private async Task SortBy(string column)
    {
        if (pagedRequest.SortColumn == column)
            pagedRequest.SortAscending = !pagedRequest.SortAscending;
        else
        {
            pagedRequest.SortColumn = column;
            pagedRequest.SortAscending = true;
        }
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private string SortIcon(string column)
    {
        if (pagedRequest.SortColumn != column) return "";
        return pagedRequest.SortAscending ? "▲" : "▼";
    }

    private void ToggleExpand(Guid id)
    {
        if (!_expanded.Add(id))
            _expanded.Remove(id);
    }

    private static string StatusPill(StockTransferStatus status) => status switch
    {
        StockTransferStatus.Completed => "tm-pill-green",
        StockTransferStatus.Cancelled => "tm-pill-red",
        _ => "tm-pill-blue"
    };

    private async Task OpenTransferDialog(StockTransferListDto? existing = null)
    {
        StockTransferDtoModel model;
        string title;
        if (existing is null)
        {
            model = new StockTransferDtoModel();
            title = "New Stock Transfer";
        }
        else
        {
            model = new StockTransferDtoModel
            {
                TransferDate = existing.TransferDate,
                SourceWarehouseIds = new() { existing.SourceWarehouseId },
                TargetWarehouseId = existing.TargetWarehouseId,
                Notes = existing.Notes,
                ItemsLine = existing.Items
                    .Select(i => new StockTransferLineDto(Guid.NewGuid(), i.ProductId, i.Quantity, existing.SourceWarehouseId))
                    .ToList()
            };
            // Blank entry row on top so more lines can be added immediately.
            model.ItemsLine.Insert(0, new StockTransferLineDto(Guid.NewGuid(), Guid.Empty, 0));
            title = $"Edit Transfer {existing.TransferNumber}";
        }

        var parameters = new DialogParameters<StockTransferDialog>
        {
            { x => x.WareHouses, _warehouses },
            { x => x.dataModel, model }
        };

        var dialog = await DialogService.ShowAsync<StockTransferDialog>(title, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is List<StockTransferCreateDto> batches && batches.Count > 0)
        {
            try
            {
                if (existing is not null && batches.Count == 1 && batches[0].SourceWarehouseId == existing.SourceWarehouseId)
                {
                    // Same single source: update in place, keeps the transfer number.
                    var transferNumber = await InventoryService.UpdateStockTransferAsync(existing.Id, batches[0]);
                    Snackbar.Add($"Transfer {transferNumber} saved ({batches[0].Items.Count} line(s)).", Severity.Success);
                }
                else
                {
                    // Sources changed: reverse the old transfer, then post one batch per source.
                    if (existing is not null)
                        await InventoryService.CancelStockTransferAsync(existing.Id);
                    var numbers = new List<string>();
                    foreach (var batch in batches)
                        numbers.Add(await InventoryService.CreateStockTransferAsync(batch));
                    Snackbar.Add($"Transfer(s) {string.Join(", ", numbers)} completed.", Severity.Success);
                }
                await Load();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private static Guid ParseGuid(object? v) =>
        Guid.TryParse(v?.ToString(), out var g) ? g : Guid.Empty;

    // ─── Filters ───
    private void OnSearchInput(ChangeEventArgs e)
    {
        pagedRequest.SearchTerm = e.Value?.ToString() ?? "";
        pagedRequest.CurrentPage = 0;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(async () =>
                {
                    await Load();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task OnWarehouseChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        pagedRequest.WarehouseId = string.IsNullOrEmpty(v) ? null : ParseGuid(v);
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task OnFromChanged(ChangeEventArgs e)
    {
        pagedRequest.From = ParseDate(e.Value);
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task OnToChanged(ChangeEventArgs e)
    {
        pagedRequest.To = ParseDate(e.Value);
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task ResetFilters()
    {
        pagedRequest.SearchTerm = "";
        pagedRequest.WarehouseId = null;
        pagedRequest.Status = null;
        pagedRequest.From = null;
        pagedRequest.To = null;
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    /// <summary>
    /// "Completed" tile: toggles the completed-only view.
    /// </summary>
    private async Task FilterCompleted()
    {
        pagedRequest.Status = pagedRequest.Status == StockTransferStatus.Completed ? null : StockTransferStatus.Completed;
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        pagedRequest.Status = Enum.TryParse<StockTransferStatus>(v, out var s) ? s : null;
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private static DateTime? ParseDate(object? value) =>
        DateTime.TryParse(value?.ToString(), out var d) ? d : null;

    private static string FormatDate(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";

    // ─── Paging (zero-based, matches TmPager) ───
    private async Task GoToPage(int page)
    {
        pagedRequest.CurrentPage = Math.Clamp(page, 0, Math.Max(0, pagedResultNew.TotalPages - 1));
        await Load();
    }

    private async Task GoPrevPage()
    {
        if (pagedRequest.CurrentPage > 0)
        {
            pagedRequest.CurrentPage--;
            await Load();
        }
    }

    private async Task GoNextPage()
    {
        if (pagedRequest.CurrentPage < pagedResultNew.TotalPages - 1)
        {
            pagedRequest.CurrentPage++;
            await Load();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sz))
        {
            pagedRequest.PageSize = Math.Clamp(sz, 1, 100);
            pagedRequest.CurrentPage = 0;
            await Load();
        }
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
