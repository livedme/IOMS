<MudDialog Class="bg-dialog-sales">
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="3">
                <MudDatePicker @bind-Date="dataModel.TransferDate" Label="Transfer Date" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="Guid" @ref="RefTarget"
                           Value="dataModel.TargetWarehouseId"
                           ValueChanged="OnTargetChanged"
                           Label="To Warehouse"
                           Clearable="true"
                           Required="true"
                           SelectionOnEnter="true"  
                           ToStringFunc="@(id => WareHouses.FirstOrDefault(g => g.Id == id).Name ?? string.Empty)"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    @foreach (var s in WareHouses)
                    {
                        <MudSelectItem Value="@s.Id">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudTextField @ref="RefNote" @bind-Value="dataModel.Notes" Label="Notes" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.h6" Class="mt-4 mb-2">Item Line</MudText>

        <MudTable Items="@dataModel.ItemsLine" Dense="true" Elevation="0" Class="product-item-list" FixedHeader="true" ContainerClass="mud-table-container">
            <HeaderContent>
                <MudTh Style="width:190px;">From Warehouse</MudTh>
                <MudTh Style="width:auto;">Product</MudTh>
                <MudTh Style="width:110px;">Qty</MudTh>
                <MudTh Style="width:70px;" Class="text-end">
                    <MudIconButton Icon="@Icons.Material.Outlined.Add" Size="Size.Small" Color="Color.Primary" OnClick="AddNewItemForm" />
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                @if (context.ProductId == Guid.Empty)
                {
                    <MudTd Style="width:190px;">
                        <MudSelect T="Guid"
                                    @ref="RefSource"
                                   Value="dataModel.ProductObj.SourceWarehouseId"
                                   ValueChanged="OnEntrySourceChanged"
                                   ToStringFunc="@(id => WareHouses.FirstOrDefault(g => g.Id == id).Name ?? string.Empty)"
                                   SelectionOnEnter="true"  
                                   Label="From Warehouse" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var s in WareHouses)
                            {
                                if(dataModel.TargetWarehouseId!=s.Id)
                                {
                                    <MudSelectItem Value="@s.Id">@s.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd Style="width:auto;">
                        <MudAutocomplete T="ControlItemsDto"
                                         @ref="dataModel.ProductObj.ProductDdlControl.ControlRef"
                                         Required="true"
                                         @key="dataModel.ProductObj.ProductDdlControl.SelectedIndex"
                                         @bind-Value="dataModel.ProductObj.ProductDdlControl.SelectedItem"
                                         @bind-Text="dataModel.ProductObj.ProductDdlControl.SelectedText"
                                         @bind-Value:after="OnProductChanged"
                                         SearchFunc="SearchProducts"
                                         ToStringFunc="@(c => c?.Name ?? "")"
                                         Placeholder="@(dataModel.ProductObj.SourceWarehouseId == Guid.Empty ? "Select a warehouse first" : "Search product")"
                                         Disabled="@(dataModel.ProductObj.SourceWarehouseId == Guid.Empty)"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         Clearable="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudTd>
                    <MudTd Style="width:110px;">
                        <MudNumericField @ref="RefQuantity" @bind-Value="dataModel.ProductObj.Quantity" Min="1" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudTd>
                    <MudTd Style="width:70px; padding:6px !important;">
                        <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Outlined.Check" Size="Size.Small" Class="float-start" Color="Color.Primary" OnClick="AddItem" />
                        <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Outlined.Close" Size="Size.Small" Class="float-end" Color="Color.Secondary" OnClick="@(() => RemoveEditItem(context))" />
                    </MudTd>
                }
                else
                {
                    var itemIndex = dataModel.ItemsLine.IndexOf(context);
                    @if (_editingItemIndex == itemIndex)
                    {
                        <MudTd Style="width:190px;">
                            <MudSelect T="Guid"
                                    @ref="RefSource"
                                       Value="dataModel.ProductObj.SourceWarehouseId"
                                       ValueChanged="OnEntrySourceChanged"
                                       SelectionOnEnter="true"  
                                       ToStringFunc="@(id => WareHouses.FirstOrDefault(g => g.Id == id).Name ?? string.Empty)"
                                       Label="From Warehouse" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                                @foreach (var s in WareHouses)
                                {
                                    if(dataModel.TargetWarehouseId!=s.Id)
                                {
                                    <MudSelectItem Value="@s.Id">@s.Name</MudSelectItem>
                                }
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd Style="width:auto;">
                            <MudAutocomplete T="ControlItemsDto"
                                             Required="true"
                                             @ref="dataModel.ProductObj.ProductDdlControl.ControlRef"
                                             @key="dataModel.ProductObj.ProductDdlControl.SelectedIndex"
                                             @bind-Value="dataModel.ProductObj.ProductDdlControl.SelectedItem"
                                             @bind-Text="dataModel.ProductObj.ProductDdlControl.SelectedText"
                                             @bind-Value:after="OnEditProductChanged"
                                             SearchFunc="SearchProducts"
                                             ToStringFunc="@(c => c?.Name ?? "")"
                                             Placeholder="@(dataModel.ProductObj.SourceWarehouseId == Guid.Empty ? "Select a warehouse first" : "Search product")"
                                             Disabled="@(dataModel.ProductObj.SourceWarehouseId == Guid.Empty)"
                                             ResetValueOnEmptyText="true"
                                             CoerceText="true"
                                             Clearable="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudTd>
                        <MudTd Style="width:110px;">
                            <MudNumericField @ref="RefQuantity" @bind-Value="dataModel.ProductObj.Quantity" Min="1" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudTd>
                        <MudTd Style="width:70px; padding:6px !important;">
                            <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Outlined.Check" Size="Size.Small" Class="float-start" Color="Color.Primary" OnClick="@(() => SaveEditItem(itemIndex))" />
                            <MudIconButton Variant="Variant.Text" Icon="@Icons.Material.Outlined.Close" Size="Size.Small" Class="float-end" Color="Color.Secondary" OnClick="CancelEditItem" />
                        </MudTd>
                    }
                    else
                    {
                        <MudTd Style="width:190px;">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@SourceName(context.SourceWarehouseId)</MudChip>
                        </MudTd>
                        <MudTd Style="width:auto;">
                            @(Products.FirstOrDefault(p => p.Id == context.ProductId).Name)
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                @(Products.FirstOrDefault(p => p.Id == context.ProductId).AvailableQuantity)
                            </MudChip>
                        </MudTd>
                        <MudTd Style="width:110px;">@context.Quantity</MudTd>
                        <MudTd Style="width:70px;" Class="text-end d-inline-flex justify-content-between">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info"
                                           OnClick="@(() => StartEditItem(itemIndex, context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => dataModel.ItemsLine.Remove(context))" />
                        </MudTd>
                    }
                }
            </RowTemplate>
        </MudTable>

        <MudText Typo="Typo.caption" Class="mt-2" Style="color:#64748b;">
            @dataModel.ItemsLine.Count(i => i.ProductId != Guid.Empty) line(s) · @dataModel.ItemsLine.Where(i => i.ProductId != Guid.Empty).Sum(i => i.Quantity) unit(s)
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!dataModel.ItemsLine.Any(i => i.ProductId != Guid.Empty))">
            Transfer
        </MudButton>
    </DialogActions>
</MudDialog>

@inject ISnackbar Snackbar
@inject IInventoryService InventoryService
@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<(Guid Id, string Name)> WareHouses { get; set; } = new();        
    [Parameter] public StockTransferDtoModel dataModel { get; set; } = new();

    private List<(Guid Id, string Name, string SKU, Guid WarehouseId, string WarehouseName, int AvailableQuantity)> Products { get; set; } = new();
    private int _editingItemIndex = -1;
    private static readonly ControlItemsDto AddNewOption = new() { Id = Guid.Empty, Name = "Add New", IsSelected = false };
    private MudNumericField<int>? RefQuantity;
    private MudSelect<Guid>? RefTarget;
    private MudSelect<Guid>? RefSource;
    private MudTextField<string>? RefNote;
    private bool _productsLoaded;

    protected override async Task OnInitializedAsync()
    {
        await EnsureProductsLoaded(WareHouses.Select(w => w.Id));

        if (dataModel.ItemsLine.Count == 0)
            dataModel.ItemsLine.Insert(0, new StockTransferLineDto(Guid.NewGuid(), Guid.Empty, 0));
    }

    private string SourceName(Guid id) =>
        WareHouses.FirstOrDefault(w => w.Id == id).Name ?? "—";

    private int AvailableFor(Guid productId, Guid warehouseId) =>
        Products.Where(p => p.Id == productId && p.WarehouseId == warehouseId).Sum(p => p.AvailableQuantity);

    private async Task EnsureProductsLoaded(IEnumerable<Guid> warehouseIds)
    {
        if (_productsLoaded) return;
        _productsLoaded = true;

        var ids = warehouseIds.Where(w => w != Guid.Empty).Distinct().ToList();
        if (ids.Count == 0) return;

        try
        {
            var inventoryTracking = await InventoryService.GetInventoryTrackingByWarehouses(ids, 1, 100000);
            Products = inventoryTracking.Items
                .Select(x => (x.ProductId, x.ProductName, x.ProductSKU, x.WarehouseId, x.WarehouseName, x.AvailableQuantity))
                .ToList();
        }
        catch (Exception ex)
        {
            _productsLoaded = false;
            Snackbar.Add($"Could not load warehouse stock: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnTargetChanged(Guid value)
    {
        dataModel.TargetWarehouseId = value;
        dataModel.TargetWarehouseText = WareHouses.FirstOrDefault(w => w.Id == value).Name;
        if (RefNote is not null)
            await RefNote.FocusAsync();
    }

    private async Task UpdateControlSelection(ControlDto control, ControlItemsDto? selectedItem)
    {
        if (selectedItem != null)
        {
            control.SelectedItem = selectedItem;
            control.LastSelectedItem = selectedItem;
            control.SelectedText = selectedItem.Name ?? selectedItem.Text1;
            control.SelectedIndex++;
        }
    }

    private Task<IEnumerable<ControlItemsDto>> SearchProducts(string text, CancellationToken _)
    {
        // Only products stocked in the line's warehouse, with available quantity.
        var sourceId = dataModel.ProductObj.SourceWarehouseId;
        if (sourceId == Guid.Empty)
            return Task.FromResult(Enumerable.Empty<ControlItemsDto>());

        var query = Products.Where(c => c.Id != Guid.Empty
            && c.WarehouseId == sourceId
            && c.AvailableQuantity > 0);
        if (!string.IsNullOrWhiteSpace(text))
            query = query.Where(c => (c.Name ?? "").Contains(text, StringComparison.OrdinalIgnoreCase)
                || (c.SKU ?? "").Contains(text, StringComparison.OrdinalIgnoreCase));

        IEnumerable<ControlItemsDto> baseResults = query
            .OrderByDescending(c => c.AvailableQuantity)
            .Select(c => new ControlItemsDto() { Id = c.Id, Name = $"{c.Name} ({c.SKU}) - {c.AvailableQuantity} avail", IsSelected = false });

        return Task.FromResult(baseResults);
    }

    /// <summary>Warehouse picked first in the line: the product list changes, so any picked product is cleared.</summary>
    private void OnEntrySourceChanged(Guid value)
    {
        dataModel.ProductObj.SourceWarehouseId = value;
        dataModel.ProductObj.ProductId = Guid.Empty;
        dataModel.ProductObj.Quantity = 1;
        dataModel.ProductObj.ProductDdlControl.SelectedItem = null;
        dataModel.ProductObj.ProductDdlControl.SelectedText = null;
        dataModel.ProductObj.ProductDdlControl.SelectedIndex++;
    }

    private async Task OnProductChanged()
    {
        var prod = dataModel.ProductObj.ProductDdlControl.SelectedItem;
        if (prod == null || prod.Id == Guid.Empty) return;

        dataModel.ProductObj.ProductId = (Guid)prod.Id;
        if (dataModel.ProductObj.Quantity <= 0)
            dataModel.ProductObj.Quantity = 1;

        await UpdateControlSelection(dataModel.ProductObj.ProductDdlControl, prod);

        if (RefQuantity is not null)
            await RefQuantity.FocusAsync();
    }

    private async Task OnEditProductChanged()
    {
        var prod = dataModel.ProductObj.ProductDdlControl.SelectedItem;
        if (prod == null || prod.Id == Guid.Empty) return;

        dataModel.ProductObj.ProductId = (Guid)prod.Id;
        if (dataModel.ProductObj.Quantity <= 0)
            dataModel.ProductObj.Quantity = 1;

        await UpdateControlSelection(dataModel.ProductObj.ProductDdlControl, prod);

        if (RefQuantity is not null)
            await RefQuantity.FocusAsync();
    }

    private void StartEditItem(int index, StockTransferLineDto item)
    {
        if (dataModel.ItemsLine.Any(x => x.ProductId == Guid.Empty)) return;

        _editingItemIndex = index;
        var product = Products.FirstOrDefault(p => p.Id == item.ProductId);
        dataModel.ProductObj.ProductId = item.ProductId;
        dataModel.ProductObj.SourceWarehouseId = item.SourceWarehouseId;
        dataModel.ProductObj.ProductDdlControl.SelectedItem = product != default
            ? new ControlItemsDto() { Id = product.Id, Name = $"{product.Name} ({product.SKU})", IsSelected = false }
            : new ControlItemsDto() { Id = Guid.Empty, Name = "", IsSelected = false };
        dataModel.ProductObj.Quantity = item.Quantity;
    }

    private void SaveEditItem(int index)
    {
        if (dataModel.ProductObj.ProductId == Guid.Empty || dataModel.ProductObj.Quantity <= 0) return;
        if (!ValidateLineSource(dataModel.ProductObj.SourceWarehouseId, dataModel.ProductObj.ProductId, dataModel.ProductObj.Quantity)) return;

        dataModel.ItemsLine[index] = new StockTransferLineDto(
            dataModel.ItemsLine[index].Id,
            dataModel.ProductObj.ProductId,
            dataModel.ProductObj.Quantity,
            dataModel.ProductObj.SourceWarehouseId);
        _editingItemIndex = -1;
    }

    private void CancelEditItem() => _editingItemIndex = -1;

    private void RemoveEditItem(StockTransferLineDto item)
    {
        // Keep at least the entry row; removing the only blank row re-adds it on next Add.
        dataModel.ItemsLine.Remove(item);
    }

    private async Task AddNewItemForm()
    {
        if (dataModel.ItemsLine.Any(x => x.ProductId == Guid.Empty)) return;

        if (_editingItemIndex < 0)
        {
            dataModel.ProductObj.ProductId = Guid.Empty;
            dataModel.ProductObj.SourceWarehouseId = Guid.Empty;
            dataModel.ProductObj.Quantity = 1;
            dataModel.ProductObj.ProductDdlControl = new ControlDto();
            dataModel.ItemsLine.Insert(0, new StockTransferLineDto(Guid.NewGuid(), Guid.Empty, 0));
        }

        await FocusSelectBox();
    }

    private bool ValidateLineSource(Guid sourceWarehouseId, Guid productId, int quantity)
    {
        if (sourceWarehouseId == Guid.Empty)
        {
            Snackbar.Add("Please select the source warehouse for this line.", Severity.Warning);
            return false;
        }
        if (sourceWarehouseId == dataModel.TargetWarehouseId)
        {
            Snackbar.Add("A line cannot move stock into its own source warehouse.", Severity.Warning);
            return false;
        }
        var avail = AvailableFor(productId, sourceWarehouseId);
        if (quantity > avail)
        {
            Snackbar.Add($"Only {avail} unit(s) available in {SourceName(sourceWarehouseId)}.", Severity.Warning);
            return false;
        }
        return true;
    }

    private async Task AddItem()
    {
        if (dataModel.ProductObj.ProductId == Guid.Empty || dataModel.ProductObj.Quantity <= 0) return;
        if (!ValidateLineSource(dataModel.ProductObj.SourceWarehouseId, dataModel.ProductObj.ProductId, dataModel.ProductObj.Quantity)) return;

        // var placeholder = dataModel.ItemsLine.FirstOrDefault(i => i.ProductId == Guid.Empty);
        // if (placeholder is not null)
        //     dataModel.ItemsLine.Remove(placeholder);

        dataModel.ItemsLine.Insert(dataModel.ItemsLine.Count,new StockTransferLineDto(Guid.NewGuid(), dataModel.ProductObj.ProductId, dataModel.ProductObj.Quantity, dataModel.ProductObj.SourceWarehouseId));

        dataModel.ProductObj.ProductId = Guid.Empty;
        dataModel.ProductObj.SourceWarehouseId = Guid.Empty;
        dataModel.ProductObj.Quantity = 1;

        await FocusSelectBox();
    }

    private async Task FocusSelectBox()
    {
        await Task.Delay(100);
        if (RefSource is not null)
        {
            await RefSource.ResetAsync();
            await RefSource.FocusAsync();
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (dataModel.TargetWarehouseId == Guid.Empty)
        {
            Snackbar.Add("Please select the destination warehouse.", Severity.Warning);
            return;
        }
        var lines = dataModel.ItemsLine.Where(i => i.ProductId != Guid.Empty && i.Quantity > 0).ToList();
        if (lines.Count == 0)
        {
            Snackbar.Add("Please add at least one item line.", Severity.Warning);
            return;
        }
        if (lines.Any(i => i.SourceWarehouseId == Guid.Empty))
        {
            Snackbar.Add("Each line needs a source warehouse.", Severity.Warning);
            return;
        }
        if (lines.Any(i => i.SourceWarehouseId == dataModel.TargetWarehouseId))
        {
            Snackbar.Add("A line cannot move stock into its own source warehouse.", Severity.Warning);
            return;
        }

        // One batch per source warehouse, all into the single destination.        

        MudDialog.Close(DialogResult.Ok(dataModel));
    }
}
