@page "/products/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ApplicationDbContext DbContext
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation


<PageTitle>@(_product?.Name ?? "Product Detail") - IOMS</PageTitle>


@if (_loading)
{
    <div class="tm-page"><div class="tm-card"><TmLoading Message="Loading product..." /></div></div>
}
else if (_product == null)
{
    <div class="tm-page"><div class="tm-card"><div class="tm-loading">Product not found.</div></div></div>
}
else
{
<div class="tm-page">
    <div class="pd-toprow">
        <div class="pd-crumb"><span class="pd-link" @onclick="GoBack">Products</span><span class="pd-sep">/</span><span>@_product.Name</span></div>
        <div class="pd-actions">
            <button class="act-btn act-btn-primary" @onclick="AddStock">+&nbsp; Add Stock</button>
            <button class="act-btn" @onclick="AdjustStock">☰&nbsp; Adjust Stock</button>
            <button class="act-btn" @onclick="TransferStock">↩&nbsp; Transfer Stock</button>
            <button class="act-btn" @onclick="GoCreatePurchaseOrder">🛒&nbsp; Create Purchase Order</button>
            <button class="act-btn" @onclick="GoCreateSalesOrder">🧾&nbsp; Create Sales Order</button>
        </div>
    </div>

    <!-- Hero exactly like screenshot -->
    <div class="tm-card pd-hero">
        <div class="pd-img">
            @if (!string.IsNullOrEmpty(_product.ImageUrl))
            {
                <img src="@_product.ImageUrl" alt="@_product.Name" />
            }
            else
            {
                <span>🗄</span>
            }
        </div>
        <div class="pd-main">
            <h2 class="pd-title">@_product.Name</h2>
            <div class="pd-sku-row">
                <span class="pd-sku-lbl">SKU:</span>
                <span class="pd-sku-val">@_product.SKU</span>
                <span class="pd-barcode">| | | @_product.Barcode | | |</span>
            </div>
            <div class="pd-active"><i></i>Active</div>
        </div>
        <div class="pd-stats">
            <div class="pd-stat"><div class="pd-stat-lbl">Cost</div><div class="pd-stat-val">@_product.CostPrice.ToString("C")</div></div>
            <div class="pd-stat"><div class="pd-stat-lbl">Sell Price</div><div class="pd-stat-val">@_product.SellingPrice.ToString("C")</div></div>
            <div class="pd-stat"><div class="pd-stat-lbl">Whole Sell Price</div><div class="pd-stat-val">@_product.WholeSellingPrice.ToString("C")</div></div>
            <div class="pd-stat"><div class="pd-stat-lbl">Margin</div><div class="pd-stat-val green">@Margin%</div></div>
        </div>
    </div>

    <div class="tm-card tm-tabs-card">
        <div class="tm-tabs">
            <button class="tm-tab @(_activeTab == "overview" ? "active" : "")" @onclick='() => _activeTab = "overview"'>OVERVIEW</button>
            <button class="tm-tab @(_activeTab == "stock" ? "active" : "")" @onclick='() => _activeTab = "stock"'>📦 STOCK (@_inventories.Count)</button>
            <button class="tm-tab @(_activeTab == "trans" ? "active" : "")" @onclick='() => _activeTab = "trans"'>⛽ TRANSACTIONS (@_movements.Count)</button>
            <button class="tm-tab @(_activeTab == "sales" ? "active" : "")" @onclick='() => _activeTab = "sales"'>🧾 SALES ORDERS (@_salesOrderLines.Count)</button>
            <button class="tm-tab @(_activeTab == "purchase" ? "active" : "")" @onclick='() => _activeTab = "purchase"'>📥 PURCHASE ORDERS (@_purchaseOrderLines.Count)</button>
        </div>

        @if (_activeTab == "overview")
        {
            <div class="ov-cards">
                <div class="ov-card"><div class="n">@_totalAvailable</div><div class="l">Total Available</div></div>
                <div class="ov-card"><div class="n">@_inventories.Sum(x => x.ReservedQuantity)</div><div class="l">Total Reserved</div></div>
                <div class="ov-card"><div class="n">@_last30DaysSales</div><div class="l">Last 30 Days Sales</div></div>
                <div class="ov-card"><div class="n">@((_totalAvailable * _product.CostPrice).ToString("C"))</div><div class="l">Stock Value (Cost)</div></div>
            </div>
            <div class="ov-grid">
                <div>
                    <div class="ov-label">Product Details:</div>
                    <div class="ov-desc">@(_product.Description ?? "-")</div>
                    <div class="ov-label">Status</div>
                    <div class="ov-value"><span class="@GetStockPillClass()"><span class="tm-dot"></span>@GetStockStatus()</span></div>
                    <hr class="ov-divider" />
                    <div class="ov-label">Preferred Supplier</div>
                    <div class="ov-value">@(_preferredSupplier?.SupplierName ?? "N/A")</div>
                    <hr class="ov-divider" />
                    <div class="ov-label">Origin Country / Manufacturer</div>
                    <div class="ov-value">@(_product.OriginCountry ?? "-") / @(_product.OriginManufacturer ?? "-")</div>
                </div>
                <div>
                    <div class="ov-label">Category</div>
                    <div class="ov-value">@(!string.IsNullOrEmpty(_parentCategoryName) ? _parentCategoryName + " > " : "")@(_product.Category?.Name ?? "-")</div>
                    <hr class="ov-divider" />
                    <div class="ov-label">Brand</div>
                    <div class="ov-value">@(_product.Brand?.Name ?? "-")</div>
                    <hr class="ov-divider" />
                    <div class="ov-label">Model</div>
                    <div class="ov-value">@(_product.Model ?? "-")</div>
                    <hr class="ov-divider" />
                    <div class="ov-label">Whole Selling Price</div>
                    <div class="ov-value">@_product.WholeSellingPrice.ToString("C")</div>
                    <hr class="ov-divider" />
                    <div class="ov-label">Reorder Level</div>
                    <div class="ov-value">@_product.ReorderStockLevel</div>
                    <hr class="ov-divider" />
                    <div class="ov-label">Minimum Order Quantity</div>
                    <div class="ov-value">@_product.MinOrderQuantity</div>
                </div>
            </div>
        }
        else if (_activeTab == "stock")
        {
            <h4 class="tm-section-title">Stock</h4>
            <div class="tm-table-wrap">
                <table class="tm-table">
                    <thead><tr><th>Warehouse</th><th>Available</th><th>Reserved</th><th>Stock Value</th><th>Status</th></tr></thead>
                    <tbody>
                        @if (!_inventories.Any()) { <tr><td colspan="5" style="text-align:center;color:#6b7280">No stock records found.</td></tr> }
                        else { @foreach (var inv in _inventories) {
                            <tr>
                                <td class="tm-strong">@inv.Warehouse.Name</td>
                                <td>@inv.AvailableQuantity</td>
                                <td>@inv.ReservedQuantity</td>
                                <td>@((inv.AvailableQuantity * _product.CostPrice).ToString("C"))</td>
                                <td><span class="@(inv.AvailableQuantity <= _product.ReorderStockLevel ? "tm-pill tm-pill-amber" : "tm-pill tm-pill-green")"><span class="tm-dot"></span>@(inv.AvailableQuantity <= 0 ? "Out" : inv.AvailableQuantity <= _product.ReorderStockLevel ? "Low" : "In Stock")</span></td>
                            </tr>
                        } }
                    </tbody>
                </table>
            </div>
        }
        else if (_activeTab == "trans")
        {
            <h4 class="tm-section-title">Transactions</h4>
            <div class="tm-table-wrap">
                <table class="tm-table">
                    <thead><tr><th>Date</th><th>Warehouse</th><th>Type</th><th>Quantity</th><th>Reference</th><th>Notes</th><th>Status</th></tr></thead>
                    <tbody>
                        @if (!_movements.Any()) { <tr><td colspan="7" style="text-align:center;color:#6b7280">No inventory transactions found.</td></tr> }
                        else { @foreach (var m in _movements) {
                            <tr>
                                <td>@m.MovementDate.ToString("dd MMM yyyy")</td>
                                <td>@m.Warehouse?.Name</td>
                                <td>@m.Type</td>
                                <td class="@(m.Quantity >= 0 ? "tm-green" : "tm-red")">@(m.Quantity > 0 ? "+" : "")@m.Quantity</td>
                                <td>@m.Reference</td>
                                <td>@m.Notes</td>
                                <td><span class="tm-pill tm-pill-green"><span class="tm-dot"></span>Completed</span></td>
                            </tr>
                        } }
                    </tbody>
                </table>
            </div>
        }
        else if (_activeTab == "sales")
        {
            <h4 class="tm-section-title">Sales Orders</h4>
            <div class="tm-table-wrap">
                <table class="tm-table">
                    <thead><tr><th>Order No.</th><th>Customer</th><th>Date</th><th>Qty</th><th>Unit Price</th><th>Total</th><th>Status</th></tr></thead>
                    <tbody>
                        @if (!_salesOrderLines.Any()) { <tr><td colspan="7" style="text-align:center;color:#6b7280">No sales orders found.</td></tr> }
                        else { @foreach (var s in _salesOrderLines) {
                            <tr>
                                <td class="tm-strong">@s.OrderNumber</td>
                                <td>@s.CustomerName</td>
                                <td>@s.OrderDate.ToString("dd MMM yyyy")</td>
                                <td>@s.Quantity</td>
                                <td>@s.UnitPrice.ToString("C")</td>
                                <td class="tm-green">@((s.Quantity * s.UnitPrice).ToString("C"))</td>
                                <td><span class="tm-pill @GetOrderPill(s.Status)"><span class="tm-dot"></span>@s.Status</span></td>
                            </tr>
                        } }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <h4 class="tm-section-title">Purchase Orders</h4>
            <div class="tm-table-wrap">
                <table class="tm-table">
                    <thead><tr><th>Order No.</th><th>Supplier</th><th>Date</th><th>Qty</th><th>Unit Price</th><th>Total</th><th>Status</th></tr></thead>
                    <tbody>
                        @if (!_purchaseOrderLines.Any()) { <tr><td colspan="7" style="text-align:center;color:#6b7280">No purchase orders found.</td></tr> }
                        else { @foreach (var p in _purchaseOrderLines) {
                            <tr>
                                <td class="tm-strong">@p.OrderNumber</td>
                                <td>@p.SupplierName</td>
                                <td>@p.OrderDate.ToString("dd MMM yyyy")</td>
                                <td>@p.Quantity</td>
                                <td>@p.UnitPrice.ToString("C")</td>
                                <td class="tm-green">@((p.Quantity * p.UnitPrice).ToString("C"))</td>
                                <td><span class="tm-pill @GetOrderPill(p.Status)"><span class="tm-dot"></span>@p.Status</span></td>
                            </tr>
                        } }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="tm-bottom">
        <button class="tm-btn tm-btn-primary" @onclick="SaveChanges">✔ Save Changes</button>
        <button class="tm-btn" style="color:#dc2626;border-color:#fecaca" @onclick="DeleteProduct">🗑 Delete Product</button>
    </div>
</div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Product? _product;
    private bool _loading = true;
    private string _activeTab = "overview";
    private List<Inventory> _inventories = new();
    private List<StockMovement> _movements = new();
    private List<SalesOrderLineView> _salesOrderLines = new();
    private List<PurchaseOrderLineView> _purchaseOrderLines = new();
    private Supplier? _preferredSupplier;
    private string? _parentCategoryName;
    private bool _isFastMoving;
    private int _last30DaysSales;
    private int _totalAvailable;

    private int Margin => _product is { SellingPrice: > 0 }
        ? (int)((_product.SellingPrice - _product.CostPrice) / _product.SellingPrice * 100)
        : 0;

    protected override async Task OnInitializedAsync() => await LoadProduct();

    private string GetStockStatus()
    {
        if (_product == null) return "-";
        var total = _totalAvailable;
        if (total <= 0) return "Out of Stock";
        if (total <= _product.ReorderStockLevel) return "Low Stock";
        return "In Stock";
    }

    private string GetStockPillClass()
    {
        var s = GetStockStatus();
        return s == "In Stock" ? "tm-pill tm-pill-green" : s == "Low Stock" ? "tm-pill tm-pill-amber" : "tm-pill tm-pill-red";
    }

    private string GetOrderPill(string status)
    {
        var s = (status ?? "").ToLower();
        if (s.Contains("complet") || s.Contains("deliver")) return "tm-pill-green";
        if (s.Contains("cancel")) return "tm-pill-red";
        if (s.Contains("load") || s.Contains("pend")) return "tm-pill-amber";
        if (s.Contains("assign") || s.Contains("approv")) return "tm-pill-blue";
        if (s.Contains("route") || s.Contains("process")) return "tm-pill-purple";
        return "tm-pill-gray";
    }

    private void GoBack() => Navigation.NavigateTo("/products");

    private async Task LoadProduct()
    {
        _loading = true;
        try
        {
            _product = await DbContext.Products
                .Include(p => p.Category)
                    .ThenInclude(c => c!.ParentCategory)
                .Include(p => p.Brand)
                .Include(p => p.Inventories)
                    .ThenInclude(i => i.Warehouse)
                .FirstOrDefaultAsync(p => p.Id == Id);

            if (_product != null)
            {
                _parentCategoryName = _product.Category?.ParentCategory?.Name;

                _inventories = _product.Inventories
                    .OrderBy(i => i.Warehouse.Name)
                    .ToList();

                _totalAvailable = _inventories.Sum(i => i.AvailableQuantity);

                _movements = await DbContext.StockMovements
                    .Include(m => m.Warehouse)
                    .Where(m => m.ProductId == Id)
                    .OrderByDescending(m => m.MovementDate)
                    .Take(50)
                    .ToListAsync();

                var cutoff = DateTime.UtcNow.AddDays(-30);
                _last30DaysSales = await DbContext.SalesOrderItems
                    .Where(x => x.ProductId == Id && x.SalesOrder.OrderDate >= cutoff)
                    .SumAsync(x => (int?)x.Quantity) ?? 0;

                _isFastMoving = _last30DaysSales > 20;

                var latestSupplierId = await DbContext.PurchaseOrderItems
                    .Where(x => x.ProductId == Id)
                    .OrderByDescending(x => x.PurchaseOrder)
                    .Select(x => (Guid?)x.PurchaseOrder.SupplierId)
                    .FirstOrDefaultAsync();

                if (latestSupplierId.HasValue)
                    _preferredSupplier = await DbContext.Suppliers.FindAsync(latestSupplierId.Value);

                _salesOrderLines = await DbContext.SalesOrderItems
                    .Include(x => x.SalesOrder)
                        .ThenInclude(o => o.Customer)
                    .Where(x => x.ProductId == Id)
                    .OrderByDescending(x => x.SalesOrder.OrderDate)
                    .Take(50)
                    .Select(x => new SalesOrderLineView(
                        x.SalesOrder.Id,
                        x.SalesOrder.OrderNumber,
                        x.SalesOrder.Customer.CustomerName,
                        x.SalesOrder.OrderDate,
                        x.SalesOrder.Status.ToString(),
                        x.Quantity,
                        x.UnitPrice))
                    .ToListAsync();

                _purchaseOrderLines = await DbContext.PurchaseOrderItems
                    .Include(x => x.PurchaseOrder)
                        .ThenInclude(o => o.Supplier)
                    .Where(x => x.ProductId == Id)
                    .OrderByDescending(x => x.PurchaseOrder.PurchaseDate)
                    .Take(50)
                    .Select(x => new PurchaseOrderLineView(
                        x.PurchaseOrder.Id,
                        x.PurchaseOrder.OrderNumber,
                        x.PurchaseOrder.Supplier.SupplierName,
                        x.PurchaseOrder.PurchaseDate,
                        x.PurchaseOrder.Status.ToString(),
                        x.Quantity,
                        x.UnitPrice))
                    .ToListAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading product: {ex.Message}", Severity.Error);
        }
        _loading = false;
    }

    private Task AddStock()
    {
        Snackbar.Add("Use the Adjust Stock dialog to add stock.", Severity.Info);
        return Task.CompletedTask;
    }

    private Task AdjustStock()
    {
        Snackbar.Add("Stock adjustment — open from Stock Movements page.", Severity.Info);
        return Task.CompletedTask;
    }

    private Task TransferStock()
    {
        Navigation.NavigateTo("/inventory/transfers");
        return Task.CompletedTask;
    }

    private Task GoCreatePurchaseOrder()
    {
        Navigation.NavigateTo("/orders/purchase");
        return Task.CompletedTask;
    }

    private Task GoCreateSalesOrder()
    {
        Navigation.NavigateTo("/orders/sales");
        return Task.CompletedTask;
    }

    private async Task SaveChanges()
    {
        try
        {
            await DbContext.SaveChangesAsync();
            Snackbar.Add("Product saved successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteProduct()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Product",
            $"Are you sure you want to delete '{_product?.Name}'? This action cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed == true && _product != null)
        {
            _product.IsDeleted = true;
            await DbContext.SaveChangesAsync();
            Snackbar.Add("Product deleted.", Severity.Success);
            Navigation.NavigateTo("/products");
        }
    }

    private record SalesOrderLineView(Guid OrderId, string OrderNumber, string CustomerName,
        DateTime OrderDate, string Status, int Quantity, decimal UnitPrice);

    private record PurchaseOrderLineView(Guid OrderId, string OrderNumber, string SupplierName,
        DateTime OrderDate, string Status, int Quantity, decimal UnitPrice);
}
