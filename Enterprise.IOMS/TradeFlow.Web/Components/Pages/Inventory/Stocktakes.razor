@page "/inventory/stocktakes"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject IStocktakeService StocktakeService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

@inject IWarehousesService WarehousesService


<PageTitle>Stocktakes</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="🧮" Title="Stocktakes" Subtitle="Plan, count and approve physical stock counts">
        <Actions>
            <button class="tm-reset" @onclick="Refresh">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="CreateNew">+ New Stocktake</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="🧮" Number="@TotalCountText" Label="Stocktakes" Tone="blue" OnClick="@(() => FilterByStatus(null))" />
        <TmStatTile Icon="📝" Number="@DraftCountText" Label="Draft" Tone="purple" OnClick="@(() => FilterByStatus(StocktakeStatus.Draft))" />
        <TmStatTile Icon="⏳" Number="@InProgressCountText" Label="In Progress" Tone="yellow" OnClick="@(() => FilterByStatus(StocktakeStatus.InProgress))" />
        <TmStatTile Icon="🔍" Number="@PendingApprovalCountText" Label="Pending Approval" Tone="teal" OnClick="@(() => FilterByStatus(StocktakeStatus.PendingApproval))" />
        <TmStatTile Icon="✔" Number="@ApprovedCountText" Label="Approved" Tone="green" OnClick="@(() => FilterByStatus(StocktakeStatus.Approved))" />
        <TmStatTile Icon="✕" Number="@CancelledCountText" Label="Cancelled" Tone="red" OnClick="@(() => FilterByStatus(StocktakeStatus.Cancelled))" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by warehouse or notes..." value="@pagedRequest.SearchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.WarehouseId?.ToString() ?? "")" @onchange="OnWarehouseChanged">
                <option value="">All Warehouses</option>
                @foreach (var w in _warehouses)
                {
                    <option value="@w.Id">@w.Name</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.Status?.ToString() ?? "")" @onchange="OnStatusChanged">
                <option value="">All Status</option>
                @foreach (var s in StocktakeStatuses)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <input type="date" value="@FormatDate(pagedRequest.From)" @onchange="OnFromChanged" title="From date" />
        </div>
        <div class="tm-select">
            <input type="date" value="@FormatDate(pagedRequest.To)" @onchange="OnToChanged" title="To date" />
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        @if (_loading)
        {
            <div style="position:absolute; inset:0; background:rgba(255,255,255,0.62); backdrop-filter:blur(1px); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2; border-radius:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Style="margin-top:8px; color:#334155; font-weight:600;">Loading stocktakes...</MudText>
            </div>
        }
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:900px">
                <thead>
                    <tr>
                        <th @onclick="@(() => SortBy(Col.Warehouse))">🏬 Warehouse @SortIcon(Col.Warehouse)</th>
                        <th @onclick="@(() => SortBy(Col.StartDate))">📅 Start Date @SortIcon(Col.StartDate)</th>
                        <th @onclick="@(() => SortBy(Col.EndDate))">📅 End Date @SortIcon(Col.EndDate)</th>
                        <th @onclick="@(() => SortBy(Col.Status))">Status @SortIcon(Col.Status)</th>
                        <th style="text-align:right">Total Items</th>
                        <th style="text-align:right">Counted</th>
                        <th>Progress</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_hasLoadedOnce && _loading)
                    {
                        <tr><td colspan="8" style="text-align:center; padding:40px; color:#94a3b8;">Loading stocktakes...</td></tr>
                    }
                    else if (pagedResultNew.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="8" style="text-align:center; padding:40px;">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#94a3b8;" Class="mb-2" />
                                <div style="color:#64748b;">No stocktakes found — try a different search or filter</div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="ResetFilters">Clear filters</MudButton>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var s in pagedResultNew.Items)
                        {
                            var pct = s.TotalItems <= 0 ? 0 : (double)s.CountedItems / s.TotalItems * 100;
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#e0e9ff">🏬</span>@s.WarehouseName</span></td>
                                <td class="tm-dim">@s.StartDate.ToString("dd MMM yyyy")</td>
                                <td class="tm-dim">@(s.EndDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td><span class="@GetStatusPill(s.Status)"><span class="tm-dot"></span>@s.Status</span></td>
                                <td style="text-align:right" class="tm-num">@s.TotalItems</td>
                                <td style="text-align:right" class="tm-num">@s.CountedItems</td>
                                <td style="min-width:130px">
                                    <div class="tm-row-bar">
                                        <div class="tm-row-bar-fill" style="width:@pct.ToString("0")%; background:@(pct >= 100 ? "#16a34a" : "#3b82f6");"></div>
                                    </div>
                                    <span class="tm-row-bar-label">@pct.ToString("0")%</span>
                                </td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-view" title="View" @onclick='() => Navigation.NavigateTo($"/inventory/stocktakes/{s.Id}")'>👁</button>
                                        @if (s.Status == StocktakeStatus.PendingApproval)
                                        {
                                            <button class="tm-act" style="color:#16a34a" title="Approve" @onclick="() => Approve(s.Id)">✔</button>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div style="opacity:@(_loading ? "0.55" : "1"); pointer-events:@(_loading ? "none" : "auto");">
            <TmPager CurrentPage="pagedResultNew.CurrentPage"
                     PageSize="pagedResultNew.PageSize"
                     TotalCount="pagedResultNew.TotalCount"
                     TotalPages="pagedResultNew.TotalPages"
                     ItemLabel="Stocktakes"
                     OnGoToPage="GoToPage"
                     OnPrev="GoPrevPage"
                     OnNext="GoNextPage"
                     OnPageSizeChanged="OnPageSizeChanged" />
        </div>
    </div>
</div>

@code {
    private static class Col
    {
        public const string Warehouse = "Warehouse";
        public const string StartDate = "StartDate";
        public const string EndDate = "EndDate";
        public const string Status = "Status";
    }

    private readonly List<StocktakeStatus> StocktakeStatuses = Enum.GetValues<StocktakeStatus>().ToList();

    // ─── List state ───
    private PagedResultNew<StocktakeDto> pagedResultNew = new();
    private StocktakePagedRequest pagedRequest = new()
    {
        SortColumn = Col.StartDate,
        SortAscending = false
    };

    private List<WarehouseDto> _warehouses = new();
    private bool _loading = true;
    private bool _hasLoadedOnce;
    private bool _loadRunning;
    private bool _loadQueued;
    private CancellationTokenSource? _debounceCts;

    protected override async Task OnInitializedAsync()
    {
        try { _warehouses = await WarehousesService.GetAllWarehousesAsync(); }
        catch { }

        await LoadData();
    }

    private async Task Refresh() => await LoadData();

    /// <summary>
    /// Single-flight loader. The page and the services share one scoped DbContext, so two
    /// overlapping queries would throw "A second operation was started on this context
    /// instance". Callers that arrive mid-flight set a flag instead of starting a parallel
    /// query, and the running load then re-runs once with the newest filter state.
    /// </summary>
    private async Task LoadData()
    {
        if (_loadRunning)
        {
            _loadQueued = true;
            return;
        }

        _loadRunning = true;
        try
        {
            do
            {
                _loadQueued = false;
                await LoadDataCore();
            }
            while (_loadQueued);
        }
        finally { _loadRunning = false; }
    }

    private async Task LoadDataCore()
    {
        _loading = true;
        try
        {
            pagedResultNew = await StocktakeService.GetStocktakesPagedAsync(pagedRequest);
            _hasLoadedOnce = true;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    // ─── Stats / sorting helpers ───
    private string TotalCountText => Stat("TotalCount");
    private string DraftCountText => Stat("DraftCount");
    private string InProgressCountText => Stat("InProgressCount");
    private string PendingApprovalCountText => Stat("PendingApprovalCount");
    private string ApprovedCountText => Stat("ApprovedCount");
    private string CancelledCountText => Stat("CancelledCount");

    private string Stat(string key) =>
        pagedResultNew.Stats != null && pagedResultNew.Stats.TryGetValue(key, out var v) ? v.ToString() : "0";

    private async Task SortBy(string column)
    {
        if (pagedRequest.SortColumn == column)
            pagedRequest.SortAscending = !pagedRequest.SortAscending;
        else
        {
            pagedRequest.SortColumn = column;
            pagedRequest.SortAscending = true;
        }
        pagedRequest.CurrentPage = 0;
        await LoadData();
    }

    private string SortIcon(string column)
    {
        if (pagedRequest.SortColumn != column) return "";
        return pagedRequest.SortAscending ? "▲" : "▼";
    }

    private async Task CreateNew()
    {
        var warehouses = await WarehousesService.GetActiveWarehousesAsync();
        var parameters = new DialogParameters<StocktakeCreateDialog> { { x => x.Warehouses, warehouses } };
        var dialog = await DialogService.ShowAsync<StocktakeCreateDialog>("New Stocktake", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await LoadData();
    }

    private async Task Approve(Guid id)
    {
        try
        {
            await StocktakeService.ApproveStocktake(id);
            Snackbar.Add("Stocktake approved.", Severity.Success);
            await LoadData();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    // ─── Filters ───
    private void OnSearchInput(ChangeEventArgs e)
    {
        pagedRequest.SearchTerm = e.Value?.ToString() ?? "";
        pagedRequest.CurrentPage = 0;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(async () =>
                {
                    await LoadData();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task OnWarehouseChanged(ChangeEventArgs e)
    {
        pagedRequest.WarehouseId = ParseGuid(e.Value);
        pagedRequest.CurrentPage = 0;
        await LoadData();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        pagedRequest.Status = Enum.TryParse<StocktakeStatus>(e.Value?.ToString(), out var s) ? s : null;
        pagedRequest.CurrentPage = 0;
        await LoadData();
    }

    private async Task OnFromChanged(ChangeEventArgs e)
    {
        pagedRequest.From = ParseDate(e.Value);
        pagedRequest.CurrentPage = 0;
        await LoadData();
    }

    private async Task OnToChanged(ChangeEventArgs e)
    {
        pagedRequest.To = ParseDate(e.Value);
        pagedRequest.CurrentPage = 0;
        await LoadData();
    }

    private async Task FilterByStatus(StocktakeStatus? status)
    {
        pagedRequest.Status = pagedRequest.Status == status ? null : status;
        pagedRequest.CurrentPage = 0;
        await LoadData();
    }

    private async Task ResetFilters()
    {
        pagedRequest.SearchTerm = "";
        pagedRequest.Status = null;
        pagedRequest.WarehouseId = null;
        pagedRequest.From = null;
        pagedRequest.To = null;
        pagedRequest.CurrentPage = 0;
        await LoadData();
    }

    private static Guid? ParseGuid(object? value) =>
        Guid.TryParse(value?.ToString(), out var g) && g != Guid.Empty ? g : null;

    private static DateTime? ParseDate(object? value) =>
        DateTime.TryParse(value?.ToString(), out var d) ? d : null;

    private static string FormatDate(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";

    // ─── Paging (zero-based, matches TmPager) ───
    private async Task GoToPage(int page)
    {
        pagedRequest.CurrentPage = Math.Clamp(page, 0, Math.Max(0, pagedResultNew.TotalPages - 1));
        await LoadData();
    }

    private async Task GoPrevPage()
    {
        if (pagedRequest.CurrentPage > 0)
        {
            pagedRequest.CurrentPage--;
            await LoadData();
        }
    }

    private async Task GoNextPage()
    {
        if (pagedRequest.CurrentPage < pagedResultNew.TotalPages - 1)
        {
            pagedRequest.CurrentPage++;
            await LoadData();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sz))
        {
            pagedRequest.PageSize = Math.Clamp(sz, 1, 100);
            pagedRequest.CurrentPage = 0;
            await LoadData();
        }
    }

    private static string GetStatusPill(StocktakeStatus s) => s switch
    {
        StocktakeStatus.Draft => "tm-pill tm-pill-purple",
        StocktakeStatus.InProgress => "tm-pill tm-pill-amber",
        StocktakeStatus.PendingApproval => "tm-pill tm-pill-blue",
        StocktakeStatus.Approved => "tm-pill tm-pill-green",
        StocktakeStatus.Cancelled => "tm-pill tm-pill-red",
        _ => "tm-pill tm-pill-blue"
    };

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
