@page "/inventory/stocktakes"
@rendermode InteractiveServer
@inject IStocktakeService StocktakeService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject TradeFlow.Infrastructure.Data.ApplicationDbContext DbContext

<PageTitle>Stocktakes</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="🧮" Title="Stocktakes" Subtitle="Plan, count and approve physical stock counts">
        <Actions>
            <button class="tm-reset" @onclick="LoadData">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="CreateNew">+ New Stocktake</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="🧮" Number="@_all.Count" Label="Stocktakes" Tone="blue" />
        <TmStatTile Icon="📝" Number="@CountOf(StocktakeStatus.Draft)" Label="Draft" Tone="purple" OnClick="@(() => PickStatus(StocktakeStatus.Draft))" />
        <TmStatTile Icon="⏳" Number="@CountOf(StocktakeStatus.InProgress)" Label="In Progress" Tone="yellow" OnClick="@(() => PickStatus(StocktakeStatus.InProgress))" />
        <TmStatTile Icon="🔍" Number="@CountOf(StocktakeStatus.PendingApproval)" Label="Pending Approval" Tone="teal" OnClick="@(() => PickStatus(StocktakeStatus.PendingApproval))" />
        <TmStatTile Icon="✔" Number="@CountOf(StocktakeStatus.Approved)" Label="Approved" Tone="green" OnClick="@(() => PickStatus(StocktakeStatus.Approved))" />
        <TmStatTile Icon="✕" Number="@CountOf(StocktakeStatus.Cancelled)" Label="Cancelled" Tone="red" OnClick="@(() => PickStatus(StocktakeStatus.Cancelled))" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by warehouse..." value="@_search" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select @onchange="OnStatusChanged">
                <option value="" selected="@(_statusFilter == null)">All Status</option>
                @foreach (StocktakeStatus s in Enum.GetValues<StocktakeStatus>())
                {
                    <option value="@s" selected="@(_statusFilter == s)">@s</option>
                }
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:900px">
                <thead>
                    <tr>
                        <th>🏬 Warehouse</th>
                        <th>📅 Start Date</th>
                        <th>📅 End Date</th>
                        <th>Status</th>
                        <th style="text-align:right">Total Items</th>
                        <th style="text-align:right">Counted</th>
                        <th>Progress</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="8"><div class="tm-loading">Loading stocktakes...</div></td></tr>
                    }
                    else if (Paged.Count == 0)
                    {
                        <tr><td colspan="8"><div class="tm-loading">No stocktakes found</div></td></tr>
                    }
                    else
                    {
                        @foreach (var s in Paged)
                        {
                            var pct = s.TotalItems <= 0 ? 0 : (double)s.CountedItems / s.TotalItems * 100;
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#e0e9ff">🏬</span>@s.WarehouseName</span></td>
                                <td class="tm-dim">@s.StartDate.ToString("dd MMM yyyy")</td>
                                <td class="tm-dim">@(s.EndDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td><span class="@GetStatusPill(s.Status)"><span class="tm-dot"></span>@s.Status</span></td>
                                <td style="text-align:right" class="tm-num">@s.TotalItems</td>
                                <td style="text-align:right" class="tm-num">@s.CountedItems</td>
                                <td style="min-width:130px">
                                    <div class="tm-row-bar">
                                        <div class="tm-row-bar-fill" style="width:@pct.ToString("0")%; background:@(pct >= 100 ? "#16a34a" : "#3b82f6");"></div>
                                    </div>
                                    <span class="tm-row-bar-label">@pct.ToString("0")%</span>
                                </td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-view" title="View" @onclick='() => Navigation.NavigateTo($"/inventory/stocktakes/{s.Id}")'>👁</button>
                                        @if (s.Status == StocktakeStatus.PendingApproval)
                                        {
                                            <button class="tm-act" style="color:#16a34a" title="Approve" @onclick="() => Approve(s.Id)">✔</button>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <TmPager Total="@Filtered.Count" Page="@_page" PageSize="@_pageSize" ItemNoun="stocktakes"
                  PageChanged="@(p => _page = p)" PageSizeChanged="@OnPageSizeChanged" />
    </div>
</div>

@code {
    private List<StocktakeDto> _all = new();
    private StocktakeStatus? _statusFilter;
    private string _search = "";
    private int _page = 1;
    private int _pageSize = 10;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadData();

    private List<StocktakeDto> Filtered => _all.Where(s =>
        (_statusFilter == null || s.Status == _statusFilter.Value)
        && (string.IsNullOrWhiteSpace(_search) || (s.WarehouseName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))).ToList();

    private List<StocktakeDto> Paged => Filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    private int CountOf(StocktakeStatus s) => _all.Count(x => x.Status == s);

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var result = await StocktakeService.GetStocktakes(null, _page, _pageSize);
            _all = result.Items;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task CreateNew()
    {
        var warehouses = await DbContext.Set<Warehouse>().Where(w => w.IsActive).OrderBy(w => w.Name).ToListAsync();
        var parameters = new DialogParameters<StocktakeCreateDialog> { { x => x.Warehouses, warehouses } };
        var dialog = await DialogService.ShowAsync<StocktakeCreateDialog>("New Stocktake", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await LoadData();
    }

    private async Task Approve(Guid id)
    {
        try
        {
            await StocktakeService.ApproveStocktake(id);
            Snackbar.Add("Stocktake approved.", Severity.Success);
            await LoadData();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void PickStatus(StocktakeStatus s)
    {
        _statusFilter = _statusFilter == s ? null : s;
        _page = 1;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 1;
    }

    private void OnStatusChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _statusFilter = string.IsNullOrEmpty(v) ? null : Enum.Parse<StocktakeStatus>(v);
        _page = 1;
    }

    private void ResetFilters()
    {
        _search = "";
        _statusFilter = null;
        _page = 1;
    }

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
    }

    private static string GetStatusPill(StocktakeStatus s) => s switch
    {
        StocktakeStatus.Draft => "tm-pill tm-pill-purple",
        StocktakeStatus.InProgress => "tm-pill tm-pill-amber",
        StocktakeStatus.PendingApproval => "tm-pill tm-pill-blue",
        StocktakeStatus.Approved => "tm-pill tm-pill-green",
        StocktakeStatus.Cancelled => "tm-pill tm-pill-red",
        _ => "tm-pill tm-pill-blue"
    };
}
