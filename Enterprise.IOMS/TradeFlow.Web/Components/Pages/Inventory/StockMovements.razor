@page "/inventory/stock-movements"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject IInventoryService InventoryService
@inject ISnackbar Snackbar
@inject IWarehousesService WarehousesService

<PageTitle>Stock Movements - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="🔄" Title="Stock Movements" Subtitle="Track every stock in, out, transfer and adjustment">
        <Actions>
            <button class="tm-add-btn" @onclick="Refresh">⟳ Refresh</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="🔄" Number="@TotalCountText" Label="Movements" Tone="blue" />
        <TmStatTile Icon="⬆️" Number="@InCountText" Label="Stock In" Tone="green" />
        <TmStatTile Icon="⬇️" Number="@OutCountText" Label="Stock Out" Tone="red" />
        <TmStatTile Icon="🔁" Number="@TransferCountText" Label="Transfers" Tone="purple" />
        <TmStatTile Icon="⚙️" Number="@AdjustmentCountText" Label="Adjustments" Tone="yellow" />
        <TmStatTile Icon="📈" Number="@NetQuantityText" Label="Net Qty" Tone="teal" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by product or reference..." value="@pagedRequest.SearchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.Type?.ToString() ?? "")" @onchange="OnTypeChanged">
                <option value="">All Types</option>
                @foreach (var t in MovementTypes)
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.WarehouseId?.ToString() ?? "")" @onchange="OnWarehouseChanged">
                <option value="">All Warehouses</option>
                @foreach (var w in _warehouses)
                {
                    <option value="@w.Id">@w.Name</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <input type="date" value="@FormatDate(pagedRequest.From)" @onchange="OnFromChanged" title="From date" />
        </div>
        <div class="tm-select">
            <input type="date" value="@FormatDate(pagedRequest.To)" @onchange="OnToChanged" title="To date" />
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        @if (_loading)
        {
            <div style="position:absolute; inset:0; background:rgba(255,255,255,0.62); backdrop-filter:blur(1px); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2; border-radius:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Style="margin-top:8px; color:#334155; font-weight:600;">Loading movements...</MudText>
            </div>
        }
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:1050px">
                <thead>
                    <tr>
                        <th @onclick="@(() => SortBy(Col.MovementDate))">📅 Date @SortIcon(Col.MovementDate)</th>
                        <th @onclick="@(() => SortBy(Col.ProductName))">📦 Product @SortIcon(Col.ProductName)</th>
                        <th @onclick="@(() => SortBy(Col.WarehouseName))">Warehouse @SortIcon(Col.WarehouseName)</th>
                        <th @onclick="@(() => SortBy(Col.Type))">Type @SortIcon(Col.Type)</th>
                        <th style="text-align:right" @onclick="@(() => SortBy(Col.Quantity))">Quantity @SortIcon(Col.Quantity)</th>
                        <th @onclick="@(() => SortBy(Col.Reference))">Reference @SortIcon(Col.Reference)</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_hasLoadedOnce && _loading)
                    {
                        <tr><td colspan="7" style="text-align:center; padding:40px; color:#94a3b8;">Loading movements...</td></tr>
                    }
                    else if (pagedResultNew.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" style="text-align:center; padding:40px;">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#94a3b8;" Class="mb-2" />
                                <div style="color:#64748b;">No stock movements found — try a different search or filter</div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="ResetFilters">Clear filters</MudButton>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var m in pagedResultNew.Items)
                        {
                            <tr>
                                <td class="tm-dim">@m.MovementDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:@GetIconBg(m.Type)">📦</span>@m.ProductName</span></td>
                                <td class="tm-branch">@m.WarehouseName</td>
                                <td><span class="@GetTypePill(m.Type)"><span class="tm-dot"></span>@m.Type</span></td>
                                <td style="text-align:right">
                                    <span style="font-weight:700; color:@(m.Quantity >= 0 ? "#15803d" : "#dc2626")">
                                        @(m.Quantity > 0 ? "+" : "")@m.Quantity.ToString("0.##")
                                    </span>
                                </td>
                                <td class="tm-num">@(string.IsNullOrWhiteSpace(m.Reference) ? "-" : m.Reference)</td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(m.Notes) ? "-" : m.Notes)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div style="opacity:@(_loading ? "0.55" : "1"); pointer-events:@(_loading ? "none" : "auto");">
            <TmPager CurrentPage="pagedResultNew.CurrentPage"
                     PageSize="pagedResultNew.PageSize"
                     TotalCount="pagedResultNew.TotalCount"
                     TotalPages="pagedResultNew.TotalPages"
                     ItemLabel="Stock Movements"
                     OnGoToPage="GoToPage"
                     OnPrev="GoPrevPage"
                     OnNext="GoNextPage"
                     OnPageSizeChanged="OnPageSizeChanged" />
        </div>
    </div>
</div>

@code {
    private static class Col
    {
        public const string MovementDate = "MovementDate";
        public const string ProductName = "ProductName";
        public const string WarehouseName = "WarehouseName";
        public const string Type = "Type";
        public const string Quantity = "Quantity";
        public const string Reference = "Reference";
    }

    private readonly List<StockMovementType> MovementTypes = Enum.GetValues<StockMovementType>().ToList();

    // ─── List state ───
    // Type stays null here; the Stock Transfers grid is this same query pinned to Transfer.
    private PagedResultNew<StockMovementDto> pagedResultNew = new();
    private StockMovementPagedRequest pagedRequest = new()
    {
        SortColumn = Col.MovementDate,
        SortAscending = false
    };

    private List<(Guid Id, string Name)> _warehouses = new();
    private bool _loading = true;
    private bool _hasLoadedOnce;
    private bool _loadRunning;
    private bool _loadQueued;
    private CancellationTokenSource? _debounceCts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var warehouses = await WarehousesService.GetAllWarehousesAsync();
            _warehouses = warehouses
                .OrderBy(w => w.Name)
                .Select(w => (w.Id, w.Name))
                .ToList();
        }
        catch { }

        await Load();
    }

    private async Task Refresh() => await Load();

    /// <summary>
    /// Single-flight loader. The page and the services share one scoped DbContext, so two
    /// overlapping queries would throw "A second operation was started on this context
    /// instance". Callers that arrive mid-flight set a flag instead of starting a parallel
    /// query, and the running load then re-runs once with the newest filter state.
    /// </summary>
    private async Task Load()
    {
        if (_loadRunning)
        {
            _loadQueued = true;
            return;
        }

        _loadRunning = true;
        try
        {
            do
            {
                _loadQueued = false;
                await LoadCore();
            }
            while (_loadQueued);
        }
        finally { _loadRunning = false; }
    }

    private async Task LoadCore()
    {
        _loading = true;
        try
        {
            pagedResultNew = await InventoryService.GetStockMovementsPagedAsync(pagedRequest);
            _hasLoadedOnce = true;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    // ─── Stats / sorting helpers ───
    private string TotalCountText => Stat("TotalCount");
    private string InCountText => Stat("StockInCount");
    private string OutCountText => Stat("StockOutCount");
    private string TransferCountText => Stat("TransferCount");
    private string AdjustmentCountText => Stat("AdjustmentCount");
    private string NetQuantityText => Stat("NetQuantity");

    private string Stat(string key) =>
        pagedResultNew.Stats != null && pagedResultNew.Stats.TryGetValue(key, out var v) ? v.ToString() : "0";

    private void SortBy(string column)
    {
        if (pagedRequest.SortColumn == column)
            pagedRequest.SortAscending = !pagedRequest.SortAscending;
        else
        {
            pagedRequest.SortColumn = column;
            pagedRequest.SortAscending = true;
        }
        pagedRequest.CurrentPage = 0;
    }

    private string SortIcon(string column)
    {
        if (pagedRequest.SortColumn != column) return "";
        return pagedRequest.SortAscending ? "▲" : "▼";
    }

    private static string GetTypePill(StockMovementType type) => type switch
    {
        StockMovementType.In => "tm-pill tm-pill-green",
        StockMovementType.Out => "tm-pill tm-pill-red",
        StockMovementType.Transfer => "tm-pill tm-pill-blue",
        StockMovementType.Adjustment => "tm-pill tm-pill-amber",
        StockMovementType.Return => "tm-pill tm-pill-purple",
        _ => "tm-pill tm-pill-blue"
    };

    private static string GetIconBg(StockMovementType type) => type switch
    {
        StockMovementType.In => "#dcfce7",
        StockMovementType.Out => "#fee2e2",
        StockMovementType.Transfer => "#dbeafe",
        StockMovementType.Adjustment => "#fef3c7",
        StockMovementType.Return => "#ede9fe",
        _ => "#e0e9ff"
    };

    // ─── Filters ───
    private void OnSearchInput(ChangeEventArgs e)
    {
        pagedRequest.SearchTerm = e.Value?.ToString() ?? "";
        pagedRequest.CurrentPage = 0;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(async () =>
                {
                    await Load();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        pagedRequest.Type = Enum.TryParse<StockMovementType>(e.Value?.ToString(), out var t) ? t : null;
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task OnWarehouseChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        pagedRequest.WarehouseId = string.IsNullOrEmpty(v) || !Guid.TryParse(v, out var g) ? null : g;
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task OnFromChanged(ChangeEventArgs e)
    {
        pagedRequest.From = ParseDate(e.Value);
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task OnToChanged(ChangeEventArgs e)
    {
        pagedRequest.To = ParseDate(e.Value);
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task ResetFilters()
    {
        pagedRequest.SearchTerm = "";
        pagedRequest.Type = null;
        pagedRequest.WarehouseId = null;
        pagedRequest.From = null;
        pagedRequest.To = null;
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private static DateTime? ParseDate(object? value) =>
        DateTime.TryParse(value?.ToString(), out var d) ? d : null;

    private static string FormatDate(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";

    // ─── Paging (zero-based, matches TmPager) ───
    private async Task GoToPage(int page)
    {
        pagedRequest.CurrentPage = Math.Clamp(page, 0, Math.Max(0, pagedResultNew.TotalPages - 1));
        await Load();
    }

    private async Task GoPrevPage()
    {
        if (pagedRequest.CurrentPage > 0)
        {
            pagedRequest.CurrentPage--;
            await Load();
        }
    }

    private async Task GoNextPage()
    {
        if (pagedRequest.CurrentPage < pagedResultNew.TotalPages - 1)
        {
            pagedRequest.CurrentPage++;
            await Load();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sz))
        {
            pagedRequest.PageSize = Math.Clamp(sz, 1, 100);
            pagedRequest.CurrentPage = 0;
            await Load();
        }
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
