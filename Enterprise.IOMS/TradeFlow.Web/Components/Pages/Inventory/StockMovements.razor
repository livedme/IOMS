@page "/stock-movements"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ISnackbar Snackbar
@using TradeFlow.Infrastructure.Data
@inject ApplicationDbContext DbContext

<PageTitle>Stock Movements - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="🔄" Title="Stock Movements" Subtitle="Track every stock in, out, transfer and adjustment">
        <Actions>
            <button class="tm-add-btn" @onclick="Load">⟳ Refresh</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="🔄" Number="@_movements.Count" Label="Movements" Tone="blue" />
        <TmStatTile Icon="⬆️" Number="@_inCount" Label="Stock In" Tone="green" />
        <TmStatTile Icon="⬇️" Number="@_outCount" Label="Stock Out" Tone="red" />
        <TmStatTile Icon="🔁" Number="@_transferCount" Label="Transfers" Tone="purple" />
        <TmStatTile Icon="⚙️" Number="@_adjustmentCount" Label="Adjustments" Tone="yellow" />
        <TmStatTile Icon="📈" Number="@_netQuantity" Label="Net Qty" Tone="teal" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by product or reference..." value="@_search" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select @onchange="OnTypeChanged">
                <option value="" selected="@(_typeFilter == null)">All Types</option>
                @foreach (StockMovementType t in Enum.GetValues<StockMovementType>())
                {
                    <option value="@t" selected="@(_typeFilter == t)">@t</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select @onchange="OnWarehouseChanged">
                <option value="" selected="@(_warehouseFilter == null)">All Warehouses</option>
                @foreach (var w in _warehouses)
                {
                    <option value="@w.Id" selected="@(_warehouseFilter == w.Id)">@w.Name</option>
                }
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:1050px">
                <thead>
                    <tr>
                        <th>📅 Date</th>
                        <th>📦 Product</th>
                        <th>Warehouse</th>
                        <th>Type</th>
                        <th style="text-align:right">Quantity</th>
                        <th>Reference</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="7"><TmLoading Message="Loading movements..." /></td></tr>
                    }
                    else if (Paged.Count == 0)
                    {
                        <tr><td colspan="7"><div class="tm-loading">No stock movements found</div></td></tr>
                    }
                    else
                    {
                        @foreach (var m in Paged)
                        {
                            <tr>
                                <td class="tm-dim">@m.MovementDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:@GetIconBg(m.MovementType)">📦</span>@m.ProductName</span></td>
                                <td class="tm-branch">@m.WarehouseName</td>
                                <td><span class="@GetTypePill(m.MovementType)"><span class="tm-dot"></span>@m.MovementType</span></td>
                                <td style="text-align:right">
                                    <span style="font-weight:700; color:@(m.Quantity >= 0 ? "#15803d" : "#dc2626")">
                                        @(m.Quantity > 0 ? "+" : "")@m.Quantity.ToString("0.##")
                                    </span>
                                </td>
                                <td class="tm-num">@(string.IsNullOrWhiteSpace(m.ReferenceNumber) ? "-" : m.ReferenceNumber)</td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(m.Notes) ? "-" : m.Notes)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <TmPager Total="@Filtered.Count" Page="@_page" PageSize="@_pageSize" ItemNoun="movements"
                  PageChanged="@(p => _page = p)" PageSizeChanged="@OnPageSizeChanged" />
    </div>
</div>

@code {
    private List<StockMovementDisplay> _movements = new();
    private List<Warehouse> _warehouses = new();
    private string _search = "";
    private StockMovementType? _typeFilter;
    private Guid? _warehouseFilter;
    private bool _loading = true;
    private int _page = 1;
    private int _pageSize = 10;
    private int _inCount, _outCount, _transferCount, _adjustmentCount;
    private decimal _netQuantity;
    private System.Timers.Timer? _debounce;

    protected override async Task OnInitializedAsync()
    {
        _warehouses = await DbContext.Warehouses.OrderBy(w => w.Name).ToListAsync();
        await Load();
    }

    private List<StockMovementDisplay> Filtered => _movements.Where(m =>
        (string.IsNullOrWhiteSpace(_search)
            || m.ProductName.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || m.ReferenceNumber.Contains(_search, StringComparison.OrdinalIgnoreCase))
        && (_typeFilter == null || m.MovementType == _typeFilter.Value)
        && (_warehouseFilter == null || m.WarehouseId == _warehouseFilter.Value)).ToList();

    private List<StockMovementDisplay> Paged => Filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    private async Task Load()
    {
        _loading = true;
        try
        {
            var query = DbContext.StockMovements
                .Include(m => m.Product)
                .Include(m => m.Warehouse)
                .AsQueryable();

            if (_typeFilter.HasValue) query = query.Where(m => m.Type == _typeFilter.Value);
            if (_warehouseFilter.HasValue) query = query.Where(m => m.WarehouseId == _warehouseFilter.Value);
            if (!string.IsNullOrWhiteSpace(_search))
                query = query.Where(m => m.Product.Name.Contains(_search) || (m.Reference != null && m.Reference.Contains(_search)));

            var data = await query.OrderByDescending(m => m.MovementDate).Take(200).ToListAsync();
            _movements = data.Select(m => new StockMovementDisplay
            {
                MovementDate = m.MovementDate,
                ProductName = m.Product?.Name ?? "",
                WarehouseName = m.Warehouse?.Name ?? "",
                WarehouseId = m.WarehouseId,
                MovementType = m.Type,
                Quantity = m.Quantity,
                ReferenceNumber = m.Reference ?? "",
                Notes = m.Notes ?? ""
            }).ToList();

            _inCount = _movements.Count(x => x.Quantity > 0);
            _outCount = _movements.Count(x => x.Quantity < 0);
            _transferCount = _movements.Count(x => x.MovementType == StockMovementType.Transfer);
            _adjustmentCount = _movements.Count(x => x.MovementType == StockMovementType.Adjustment);
            _netQuantity = _movements.Sum(x => x.Quantity);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _loading = false;
    }

    private static string GetTypePill(StockMovementType type) => type switch
    {
        StockMovementType.In => "tm-pill tm-pill-green",
        StockMovementType.Out => "tm-pill tm-pill-red",
        StockMovementType.Transfer => "tm-pill tm-pill-blue",
        StockMovementType.Adjustment => "tm-pill tm-pill-amber",
        StockMovementType.Return => "tm-pill tm-pill-purple",
        _ => "tm-pill tm-pill-blue"
    };

    private static string GetIconBg(StockMovementType type) => type switch
    {
        StockMovementType.In => "#dcfce7",
        StockMovementType.Out => "#fee2e2",
        StockMovementType.Transfer => "#dbeafe",
        StockMovementType.Adjustment => "#fef3c7",
        StockMovementType.Return => "#ede9fe",
        _ => "#e0e9ff"
    };

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 1;
        _debounce?.Stop();
        _debounce?.Dispose();
        _debounce = new System.Timers.Timer(350) { AutoReset = false };
        _debounce.Elapsed += async (_, __) =>
        {
            await Load();
            await InvokeAsync(StateHasChanged);
        };
        _debounce.Start();
    }

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _typeFilter = string.IsNullOrEmpty(v) ? null : Enum.Parse<StockMovementType>(v);
        _page = 1;
        await Load();
    }

    private async Task OnWarehouseChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _warehouseFilter = string.IsNullOrEmpty(v) ? null : Guid.Parse(v);
        _page = 1;
        await Load();
    }

    private async Task ResetFilters()
    {
        _search = "";
        _typeFilter = null;
        _warehouseFilter = null;
        _page = 1;
        await Load();
    }

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
    }

    private class StockMovementDisplay
    {
        public DateTime MovementDate { get; set; }
        public string ProductName { get; set; } = "";
        public string WarehouseName { get; set; } = "";
        public Guid WarehouseId { get; set; }
        public StockMovementType MovementType { get; set; }
        public decimal Quantity { get; set; }
        public string ReferenceNumber { get; set; } = "";
        public string Notes { get; set; } = "";
    }
}
