@page "/product/categories"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICategoryService CategoryService

<PageTitle>Categories - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="🏷" Title="Category Management" Subtitle="Organise your product hierarchy — parent/child categories and product counts">
        <Actions>
            <button class="tm-reset" @onclick="Refresh">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="OpenCreateDialog">+ Add Category</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="🏷" Number="@TotalCountText" Label="Categories" Tone="blue" OnClick="@ResetFilters" />
        <TmStatTile Icon="📂" Number="@TopLevelCountText" Label="Top Level" Tone="green" OnClick="@(() => FilterByLevel(1))" />
        <TmStatTile Icon="🌳" Number="@SubLevelCountText" Label="Sub Categories" Tone="purple" OnClick="@(() => FilterByLevel(2))" />
        <TmStatTile Icon="📦" Number="@WithProductsCountText" Label="With Products" Tone="teal" OnClick="@(() => FilterByProducts("With Products"))" />
        <TmStatTile Icon="⛔" Number="@WithoutProductsCountText" Label="Empty" Tone="red" OnClick="@(() => FilterByProducts("Without Products"))" />
        <TmStatTile Icon="🪜" Number="@MaxDepthText" Label="Max Depth" Tone="yellow" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search categories by name, description, path..." value="@pagedRequest.SearchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select value="@LevelValue" @onchange="OnLevelChanged">
                <option value="">All Levels</option>
                <option value="1">Top Level Only</option>
                <option value="2">Sub Categories</option>
            </select>
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.ProductFilter ?? "")" @onchange="OnProductsChanged">
                <option value="">All Categories</option>
                <option value="With Products">With Products</option>
                <option value="Without Products">Without Products</option>
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        @if (_loading)
        {
            <div style="position:absolute; inset:0; background:rgba(255,255,255,0.62); backdrop-filter:blur(1px); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2; border-radius:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Style="margin-top:8px; color:#334155; font-weight:600;">Loading categories...</MudText>
            </div>
        }
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:1050px">
                <thead>
                    <tr>
                        <th @onclick="@(() => SortBy(Col.Name))">🏷 Category Name @SortIcon(Col.Name)</th>                        
                        <th>Level</th>
                        <th>Main Category</th>                        
                        <th @onclick="@(() => SortBy(Col.Path))">Path @SortIcon(Col.Path)</th>
                        <th style="text-align:right" @onclick="@(() => SortBy(Col.ProductCount))">Products @SortIcon(Col.ProductCount)</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_hasLoadedOnce && _loading)
                    {
                        <tr><td colspan="7" style="text-align:center; padding:40px; color:#94a3b8;">Loading categories...</td></tr>
                    }
                    else if (pagedResultNew.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" style="text-align:center; padding:40px;">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#94a3b8;" Class="mb-2" />
                                <div style="color:#64748b;">No categories found — try a different search or filter</div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="ResetFilters">Clear filters</MudButton>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var items= pagedResultNew.Items.OrderBy(c => c.Path).ToList();
                        @foreach (var c in items)
                        {
                            var icoBg = GetIconBg(c.Name);
                            var pill = (c.ProductCount ?? 0) > 0 ? "tm-pill tm-pill-green" : "tm-pill tm-pill-amber";
                            <tr>
                                <td>
                                    <span class="tm-veh">
                                        <span class="tm-veh-ico" style="background:@icoBg">🏷</span>@c.Name
                                    </span>
                                </td>
                                <td class="tm-num">Level @GetLevel(c)</td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(c.ParentCategoryName) ? "-" : c.ParentCategoryName)</td>                                
                                <td class="tm-branch">@(string.IsNullOrWhiteSpace(c.Path) ? "-" : c.Path)</td>
                                    <td style="text-align:right"><span class="@pill"><span class="tm-dot"></span>@(c.ProductCount ?? 0)</span></td>                                
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-edit" title="Edit" @onclick="() => OpenEditDialog(c)">✎</button>
                                        <button class="tm-act tm-act-del" title="Delete" @onclick="() => DeleteCategory(c.Id)">🗑</button>
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div style="opacity:@(_loading ? "0.55" : "1"); pointer-events:@(_loading ? "none" : "auto");">
            <TmPager CurrentPage="pagedResultNew.CurrentPage"
                     PageSize="pagedResultNew.PageSize"
                     TotalCount="pagedResultNew.TotalCount"
                     TotalPages="pagedResultNew.TotalPages"
                     ItemLabel="Categories"
                     OnGoToPage="GoToPage"
                     OnPrev="GoPrevPage"
                     OnNext="GoNextPage"
                     OnPageSizeChanged="OnPageSizeChanged" />
        </div>
    </div>
</div>

@code {
    private static class Col
    {
        public const string Name = "Name";
        public const string Description = "Description";
        public const string Path = "Path";
        public const string ProductCount = "ProductCount";
    }

    // ─── List state ───
    private PagedResultNew<CategoryDto> pagedResultNew = new();
    private CategoryPagedRequest pagedRequest = new()
    {
        SortColumn = Col.Name,
        SortAscending = true
    };

    private List<CategoryDto> _allCategories = new();
    private bool _loading = true;
    private bool _hasLoadedOnce;
    private bool _loadRunning;
    private bool _loadQueued;
    private CancellationTokenSource? _debounceCts;

    private string LevelValue => pagedRequest.Level?.ToString() ?? "";

    protected override async Task OnInitializedAsync()
    {
        // The create/edit dialogs offer the full category tree as a parent picker, so the whole
        // (small) list is fetched once through the service rather than the grid query.
        try { _allCategories = await CategoryService.GetAllCategoriesAsync(); }
        catch { }

        await LoadCategories();
    }

    private async Task Refresh() => await LoadCategories();

    /// <summary>
    /// Single-flight loader. The page and the services share one scoped DbContext, so two
    /// overlapping queries would throw "A second operation was started on this context
    /// instance". Callers that arrive mid-flight set a flag instead of starting a parallel
    /// query, and the running load then re-runs once with the newest filter state.
    /// </summary>
    private async Task LoadCategories()
    {
        if (_loadRunning)
        {
            _loadQueued = true;
            return;
        }

        _loadRunning = true;
        try
        {
            do
            {
                _loadQueued = false;
                await LoadCategoriesCore();
            }
            while (_loadQueued);
        }
        finally { _loadRunning = false; }
    }

    private async Task LoadCategoriesCore()
    {
        _loading = true;
        try
        {
            pagedResultNew = await CategoryService.GetCategoriesPagedAsync(pagedRequest);
            _hasLoadedOnce = true;
        }
        catch (Exception ex) { Snackbar.Add($"Error loading categories: {ex.Message}", Severity.Error); }
        finally { _loading = false; }
    }

    // ─── Stats / sorting helpers ───
    private string TotalCountText => Stat("TotalCount");
    private string TopLevelCountText => Stat("TopLevelCount");
    private string SubLevelCountText => Stat("SubLevelCount");
    private string WithProductsCountText => Stat("WithProductsCount");
    private string WithoutProductsCountText => Stat("WithoutProductsCount");
    private string MaxDepthText => Stat("MaxDepth");

    private string Stat(string key) =>
        pagedResultNew.Stats != null && pagedResultNew.Stats.TryGetValue(key, out var v) ? v.ToString() : "0";

    private void SortBy(string column)
    {
        if (pagedRequest.SortColumn == column)
            pagedRequest.SortAscending = !pagedRequest.SortAscending;
        else
        {
            pagedRequest.SortColumn = column;
            pagedRequest.SortAscending = true;
        }
        pagedRequest.CurrentPage = 0;
    }

    private string SortIcon(string column)
    {
        if (pagedRequest.SortColumn != column) return "";
        return pagedRequest.SortAscending ? "▲" : "▼";
    }

    private static string Truncate(string value, int max)
        => value.Length <= max ? value : value[..max] + "…";

    private static int GetLevel(CategoryDto c)
    {
        if (string.IsNullOrWhiteSpace(c.Path)) return 1;
        return c.Path.Count(ch => ch == '>') + 1;
    }

    private static string GetIconBg(string? name)
    {
        var palettes = new[] { "#e0e9ff", "#fee2e2", "#dcfce7", "#ede9fe", "#ffedd5", "#e0f2fe", "#fef9c3" };
        if (string.IsNullOrEmpty(name)) return palettes[0];
        return palettes[Math.Abs(name.GetHashCode()) % palettes.Length];
    }

    // ─── Filters ───
    private void OnSearchInput(ChangeEventArgs e)
    {
        pagedRequest.SearchTerm = e.Value?.ToString() ?? "";
        pagedRequest.CurrentPage = 0;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(async () =>
                {
                    await LoadCategories();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task OnLevelChanged(ChangeEventArgs e)
    {
        pagedRequest.Level = int.TryParse(e.Value?.ToString(), out var lvl) ? lvl : null;
        pagedRequest.CurrentPage = 0;
        await LoadCategories();
    }

    private async Task OnProductsChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        pagedRequest.ProductFilter = string.IsNullOrEmpty(v) ? null : v;
        pagedRequest.CurrentPage = 0;
        await LoadCategories();
    }

    private async Task FilterByLevel(int level)
    {
        pagedRequest.Level = pagedRequest.Level == level ? null : level;
        pagedRequest.CurrentPage = 0;
        await LoadCategories();
    }

    private async Task FilterByProducts(string productFilter)
    {
        pagedRequest.ProductFilter = pagedRequest.ProductFilter == productFilter ? null : productFilter;
        pagedRequest.CurrentPage = 0;
        await LoadCategories();
    }

    private async Task ResetFilters()
    {
        pagedRequest.SearchTerm = "";
        pagedRequest.Level = null;
        pagedRequest.ProductFilter = null;
        pagedRequest.CurrentPage = 0;
        await LoadCategories();
    }

    // ─── Paging (zero-based, matches TmPager) ───
    private async Task GoToPage(int page)
    {
        pagedRequest.CurrentPage = Math.Clamp(page, 0, Math.Max(0, pagedResultNew.TotalPages - 1));
        await LoadCategories();
    }

    private async Task GoPrevPage()
    {
        if (pagedRequest.CurrentPage > 0)
        {
            pagedRequest.CurrentPage--;
            await LoadCategories();
        }
    }

    private async Task GoNextPage()
    {
        if (pagedRequest.CurrentPage < pagedResultNew.TotalPages - 1)
        {
            pagedRequest.CurrentPage++;
            await LoadCategories();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sz))
        {
            pagedRequest.PageSize = Math.Clamp(sz, 1, 100);
            pagedRequest.CurrentPage = 0;
            await LoadCategories();
        }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<CategoryDialog>
        {
            { x => x.AllCategories, _allCategories }
        };
        var dialog = await DialogService.ShowAsync<CategoryDialog>("New Category", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateCategoryDto dto)
        {
            await CategoryService.CreateCategoryAsync(dto);
            Snackbar.Add("Category created", Severity.Success);
            await ReloadAll();
        }
    }

    private async Task OpenEditDialog(CategoryDto category)
    {
        var parameters = new DialogParameters<CategoryDialog>
        {
            { x => x.Category, category },
            { x => x.AllCategories, _allCategories }
        };
        var dialog = await DialogService.ShowAsync<CategoryDialog>("Edit Category", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateCategoryDto dto)
        {
            await CategoryService.UpdateCategoryAsync(category.Id, dto);
            Snackbar.Add("Category updated", Severity.Success);
            await ReloadAll();
        }
    }

    private async Task DeleteCategory(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Confirm Delete", "Are you sure you want to delete this category?", "Delete", "Cancel");
        if (confirm == true)
        {
            await CategoryService.DeleteCategoryAsync(id);
            Snackbar.Add("Category deleted", Severity.Success);
            await ReloadAll();
        }
    }

    /// <summary>Refetches the parent-picker tree alongside the grid after a write.</summary>
    private async Task ReloadAll()
    {
        try { _allCategories = await CategoryService.GetAllCategoriesAsync(); }
        catch { }
        await LoadCategories();
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
