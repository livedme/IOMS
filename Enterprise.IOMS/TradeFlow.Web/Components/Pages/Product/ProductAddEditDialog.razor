<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
        <MudGrid>
            @* === Basic Info === *@
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Basic Information</MudText>
                </MudItem>
                <MudItem xs="12" sm="4" Class="p-4 py-2 pt-4">
                    <MudTextField @bind-Value="DataModel.Name" Label="Name11" Required="true" RequiredError="" ErrorText="" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
               @*  <MudItem xs="12" sm="4" Class="p-4 py-2 pt-4">
                    <MudTextField @bind-Value="DataModel.SKU" Label="SKU" Required="true" RequiredError="" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem> *@
                <MudItem xs="12" sm="4" Class="p-4 py-2 pt-4">
                    <MudTextField @bind-Value="this.DataModel.Barcode" Label="Barcode" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>

                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudAutocomplete T="ControlItemsDto"
                                     @ref="DataModel.CategoryControl.ControlRef"
                                     Label="Category"
                                     @key="DataModel.CategoryControl.SelectedIndex"
                                     @bind-Value="DataModel.CategoryControl.SelectedItem"
                                     @bind-Text="DataModel.CategoryControl.SelectedText"
                                     @bind-Value:after="OnCategoryChanged"
                                     SearchFunc="SearchCategories"
                                     ToStringFunc="@(c => c?.Name ?? c?.Text1 ?? "")"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     Clearable="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>

                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudAutocomplete T="ControlItemsDto"
                                     Label="Brand"
                                     @ref="DataModel.BrandControl.ControlRef"
                                     @key="DataModel.BrandControl.SelectedIndex"
                                     @bind-Value="DataModel.BrandControl.SelectedItem"
                                     @bind-Text="DataModel.BrandControl.SelectedText"
                                     @bind-Value:after="OnBrandChanged"
                                     SearchFunc="SearchBrands"
                                     ToStringFunc="@(b => b?.Name ?? "")"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true"
                                     Clearable="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />

                </MudItem>
                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudTextField @ref="RefModel" @bind-Value="DataModel.Model" Label="Model" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>
                 <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudNumericField @bind-Value="DataModel.ReorderStockLevel" Label="Reorder Stock Level" Min="0" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudNumericField @bind-Value="DataModel.CostPrice" Label="Cost Price" Format="N2" Min="0m" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudNumericField @bind-Value="DataModel.SellingPrice" Label="Selling Price" Format="N2" Min="0m" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudNumericField @bind-Value="DataModel.WholeSellingPrice" Label="Whole Selling Price" Format="N2" Min="0m" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>               
                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudTextField @bind-Value="DataModel.OriginManufacturer" Label="Origin Manufacturer" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudTextField @bind-Value="DataModel.OriginCountry" Label="Origin Country" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>
                   <MudItem xs="12" sm="4" Class="p-4 py-2">
                    <MudNumericField @bind-Value="DataModel.WarrantyInMonths" Label="Warranty (month)" Min="0" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="" />
                </MudItem>           
                <MudItem xs="12" Class="py-0">
                    <RichTextField @bind-Value="DataModel.Description" Label="Description" Lines="10" Class="mt-3" />
                </MudItem>

        </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@inject IDialogService DialogService
@inject ICategoryService CategoryService
@inject IBrandService BrandService

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ProductDetailsDto DataModel { get; set; }
    [Parameter] public List<CategoryDto> Categories { get; set; } = new();
    [Parameter] public List<BrandDto> Brands { get; set; } = new();
    private MudForm _form = default!;
    MudTextField<string> RefModel = default!;


    [Parameter] public List<ControlItemsDto> AllCategories { get; set; } = new();
    [Parameter] public List<ControlItemsDto> AllBrands { get; set; } = new();
    private static readonly ControlItemsDto AddNewCategoryOption = new ControlItemsDto { Id = Guid.Empty, Name = "Add New", Text1 = "Add New", Text2 = string.Empty };
    private static readonly ControlItemsDto AddNewBrandOption = new ControlItemsDto { Id = Guid.Empty, Name = "Add New", Text1 = "Add New", Text2 = string.Empty };

    protected override async Task OnInitializedAsync()
    {
        Categories = Categories.Where(c => c.Id != Guid.Empty).ToList();
        Brands = Brands.Where(b => b.Id != Guid.Empty).ToList();

        if (Categories is List<CategoryDto> cat)
        {
            AllCategories.AddRange(cat.Select(c => new ControlItemsDto { Id = c.Id, Name = c.Name, Text1 = c.Path, Text2 = c.ParentCategoryId?.ToString() }));
        }

        if (Brands is List<BrandDto> brand)
        {
            AllBrands.AddRange(brand.Select(b => new ControlItemsDto { Id = b.Id, Name = b.Name, Text1 = b.Description, Text2 = b.LogoUrl }));
        }   

        if (DataModel is ProductDetailsDto details)
        {
            // _categoryId = details.CategoryId;
            var selectedCategory = GetRealCategoryById(details.CategoryId);
            await UpdateCategorySelection(selectedCategory);
            // DataModel.CategoryControl.SelectedItem = GetRealCategoryById(details.CategoryId);
            // DataModel.CategoryControl.LastSelectedItem = DataModel.CategoryControl.SelectedItem;
            // DataModel.CategoryControl.SelectedText = CategoryToDisplay(DataModel.CategoryControl.SelectedItem);
            // DataModel.CategoryControl.SelectedIndex = 1;


            //    _brandId = details.BrandId;

            var selectedBrand = GetRealBrandById(details.BrandId);
            await UpdateBrandSelection(selectedBrand);

            // DataModel.BrandControl.SelectedItem = GetRealBrandById(details.BrandId);
            // DataModel.BrandControl.LastSelectedItem = DataModel.BrandControl.SelectedItem;
            // DataModel.BrandControl.SelectedText = BrandToDisplay(DataModel.BrandControl.SelectedItem);
            // DataModel.BrandControl.SelectedIndex = 2;
        }

    }

    private Task<IEnumerable<ControlItemsDto>> SearchCategories(string text, CancellationToken _)
    {
        IEnumerable<ControlItemsDto> baseResults;

        if (string.IsNullOrWhiteSpace(text))
        {
            baseResults = AllCategories.Where(c => c.Id != Guid.Empty);
        }
        else
        {
            baseResults = AllCategories.Where(c =>
                c.Id != Guid.Empty &&
                (c.Name.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                 (c.Text1 != null && c.Text1.Contains(text, StringComparison.OrdinalIgnoreCase))));
        }

        var results = baseResults.OrderBy(x => x.Name).DistinctBy(c => c.Id);
        results = baseResults.Concat(new[] { AddNewCategoryOption });
        return Task.FromResult(results);
    }

    private Task<IEnumerable<ControlItemsDto>> SearchBrands(string text, CancellationToken _)
    {
        IEnumerable<ControlItemsDto> baseResults;

        if (string.IsNullOrWhiteSpace(text))
        {
            baseResults = AllBrands.Where(b => b.Id != Guid.Empty);
        }
        else
        {
            baseResults = AllBrands.Where(b =>
                b.Id != Guid.Empty &&
                b.Name.Contains(text, StringComparison.OrdinalIgnoreCase));
        }

        
        var results = baseResults.OrderBy(x => x.Name).DistinctBy(c => c.Id);
        results = baseResults.Concat(new[] { AddNewBrandOption });
        
        return Task.FromResult(results);
    }

    private async Task OnCategoryChanged()
    {
        var cat = DataModel.CategoryControl.SelectedItem;

        if (cat?.Id == Guid.Empty)
        {
            var previousCategory = DataModel.CategoryControl.LastSelectedItem;
            var parameters = new DialogParameters<CategoryDialog>
            {
                { x => x.AllCategories, Categories.Where(c => c.Id != Guid.Empty).Select(c => new CategoryDto(c.Id, c.Name, c.Description, c.ParentCategoryId, null, 0, c.Path)).ToList() }
            };

            var dialog = await DialogService.ShowAsync<CategoryDialog>("New Category", parameters,
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
            var result = await dialog.Result;

            await DataModel.CategoryControl.ControlRef.ResetAsync();

            if (result != null && !result.Canceled && result.Data is CreateCategoryDto dto)
            {
                var categoryId = await CategoryService.CreateCategoryAsync(dto);
                var created = await CategoryService.GetCategoryByIdAsync(categoryId);

                cat = new ControlItemsDto() { Id = created.Id, Name = created.Name, Text1 = created.Description, Text2 = created.Path };

                Categories = await CategoryService.GetAllCategoriesAsync();

                await UpdateCategorySelection(cat);

                StateHasChanged();
            }
            else
            {
                // DataModel.CategoryControl.SelectedItem = previousCategory;
                // DataModel.CategoryControl.LastSelectedItem = previousCategory;
                // DataModel.CategoryId = previousCategory?.Id ?? Guid.Empty;
                // DataModel.CategoryControl.SelectedText = CategoryToDisplay(previousCategory);
                // DataModel.CategoryControl.SelectedIndex++;

                await UpdateCategorySelection(previousCategory);
                StateHasChanged();
            }
        }
        else
        {
            await UpdateCategorySelection(cat);

            // DataModel.CategoryId = cat?.Id ?? Guid.Empty;
            // DataModel.CategoryControl.LastSelectedItem = cat;
            // DataModel.CategoryControl.SelectedText = CategoryToDisplay(cat);
        }

        if (DataModel.BrandControl.ControlRef is not null)
        {   
            await Task.Delay(50);
            await DataModel.BrandControl.ControlRef.FocusAsync();
        }
    }

    private async Task UpdateCategorySelection(ControlItemsDto? selectedCategory)
    {
        if (selectedCategory!=null){
            DataModel.CategoryControl.SelectedItem = selectedCategory;
            DataModel.CategoryControl.LastSelectedItem = selectedCategory;
            DataModel.CategoryId = selectedCategory?.Id ?? Guid.Empty;
            DataModel.CategoryControl.SelectedText = selectedCategory.Name??selectedCategory.Text1;
            DataModel.CategoryControl.SelectedIndex++;
        }
    }
    private async Task UpdateBrandSelection(ControlItemsDto? selectedBrand)
    {
        if (selectedBrand != null)
        {
            DataModel.BrandControl.SelectedItem = selectedBrand;
            DataModel.BrandControl.LastSelectedItem = selectedBrand;
            DataModel.BrandId = selectedBrand?.Id ?? Guid.Empty;
            DataModel.BrandControl.SelectedText = selectedBrand.Name ?? selectedBrand.Text1;
            DataModel.BrandControl.SelectedIndex++;
        }
    }

    private ControlItemsDto? GetRealCategoryById(Guid categoryId)
    {
        if (categoryId == Guid.Empty)
            return null;

        return AllCategories.FirstOrDefault(c => c.Id == categoryId);
    }

    private async Task OnBrandChanged()
    {
        var brand = DataModel.BrandControl.SelectedItem;

        if (brand?.Id == Guid.Empty)
        {
            var previousBrand = DataModel.BrandControl.LastSelectedItem; ;

            var dialog = await DialogService.ShowAsync<BrandDialog>("New Brand",
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
            var result = await dialog.Result;

            await DataModel.BrandControl.ControlRef.ResetAsync();

            if (result != null && !result.Canceled && result.Data is CreateBrandDto dto)
            {
                var brandId = await BrandService.CreateBrandAsync(dto);

                Brands = await BrandService.GetAllBrandsAsync();

                var newBrand = new ControlItemsDto { Id = brandId, Name = dto.Name, Text1 = dto.Description, Text2 = dto.LogoUrl };
                AllBrands.Add(newBrand);

                await UpdateBrandSelection(newBrand);
                // _selectedBrand = GetRealBrandById(entity.Id);
                // _lastBrandSelection = _selectedBrand;
                // DataModel.BrandId = _selectedBrand?.Id;
                // _brandText = BrandToDisplay(_selectedBrand);
                // _selectedBrandIndex++;

                StateHasChanged();
            }
            else
            {
                await UpdateBrandSelection(previousBrand);

                // _selectedBrand = previousBrand;
                // _lastBrandSelection = _selectedBrand;
                // DataModel.BrandId = previousBrand?.Id;
                // _brandText = BrandToDisplay(_selectedBrand);
                StateHasChanged();
            }

            return;
        }

        await UpdateBrandSelection(brand);


        if (RefModel is not null)
        {
            await RefModel.FocusAsync();
        }
    }

    private ControlItemsDto? GetRealBrandById(Guid? brandId)
    {
        if (!brandId.HasValue || brandId.Value == Guid.Empty)
            return null;

        return AllBrands.FirstOrDefault(b => b.Id == brandId.Value);
    }

    private static string? CategoryToDisplay(ControlItemsDto? category)
        => category?.Text1 ?? category?.Name;

    private static string? BrandToDisplay(ControlItemsDto? brand)
        => brand?.Name ?? brand?.Text1;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        DataModel.BrandId = DataModel.BrandControl.SelectedItem?.Id;
        DataModel.BrandName = DataModel.BrandControl.SelectedItem?.Name;
        DataModel.CategoryId = DataModel.CategoryControl.SelectedItem?.Id;
        DataModel.CategoryName = DataModel.CategoryControl.SelectedItem?.Name;

        MudDialog.Close(DialogResult.Ok(DataModel));
    }
}
