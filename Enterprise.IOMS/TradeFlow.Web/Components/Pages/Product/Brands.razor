@page "/product/brands"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IBrandService BrandService

<PageTitle>Brands - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="🔧" Title="Brand Management" Subtitle="Manage your brands, origin details and linked products">
        <Actions>
            <button class="tm-reset" @onclick="Refresh">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="OpenCreateDialog">+ Add Brand</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="🔧" Number="@TotalCountText" Label="Brands" Tone="blue" OnClick="@ResetFilters" />
        <TmStatTile Icon="✔" Number="@ActiveCountText" Label="Active" Tone="green" OnClick="@(() => FilterByStatus("Active"))" />
        <TmStatTile Icon="⛔" Number="@InactiveCountText" Label="Inactive" Tone="red" OnClick="@(() => FilterByStatus("Inactive"))" />
        <TmStatTile Icon="📦" Number="@WithProductsCountText" Label="With Products" Tone="teal" OnClick="@(() => FilterByProducts("With Products"))" />
        <TmStatTile Icon="🖼" Number="@WithLogoCountText" Label="With Logo" Tone="purple" OnClick="@ToggleWithLogo" />
        <TmStatTile Icon="🌐" Number="@CountryCountText" Label="Countries" Tone="yellow" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search brands by name, code, company, country..." value="@pagedRequest.SearchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.Status ?? "")" @onchange="OnStatusChanged">
                <option value="">All Status</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.OriginCountry ?? "")" @onchange="OnCountryChanged">
                <option value="">All Countries</option>
                @foreach (var c in _countries)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.ProductFilter ?? "")" @onchange="OnProductsChanged">
                <option value="">All Brands</option>
                <option value="With Products">With Products</option>
                <option value="Without Products">Without Products</option>
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        @if (_loading)
        {
            <div style="position:absolute; inset:0; background:rgba(255,255,255,0.62); backdrop-filter:blur(1px); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2; border-radius:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Style="margin-top:8px; color:#334155; font-weight:600;">Loading brands...</MudText>
            </div>
        }
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:1250px">
                <thead>
                    <tr>
                        <th @onclick="@(() => SortBy(Col.Name))">🔧 Brand Name @SortIcon(Col.Name)</th>
                        <th @onclick="@(() => SortBy(Col.BrandCode))">Code @SortIcon(Col.BrandCode)</th>
                        <th @onclick="@(() => SortBy(Col.Status))">Status @SortIcon(Col.Status)</th>
                        <th @onclick="@(() => SortBy(Col.OriginCompany))">Origin Company @SortIcon(Col.OriginCompany)</th>
                        <th @onclick="@(() => SortBy(Col.OriginCountry))">Origin Country @SortIcon(Col.OriginCountry)</th>
                        <th @onclick="@(() => SortBy(Col.FoundedYear))">Founded @SortIcon(Col.FoundedYear)</th>
                        <th @onclick="@(() => SortBy(Col.Description))">Description @SortIcon(Col.Description)</th>
                        <th style="text-align:right" @onclick="@(() => SortBy(Col.ProductCount))">Products @SortIcon(Col.ProductCount)</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_hasLoadedOnce && _loading)
                    {
                        <tr><td colspan="9" style="text-align:center; padding:40px; color:#94a3b8;">Loading brands...</td></tr>
                    }
                    else if (pagedResultNew.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="9" style="text-align:center; padding:40px;">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#94a3b8;" Class="mb-2" />
                                <div style="color:#64748b;">No brands found — try a different search or filter</div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="ResetFilters">Clear filters</MudButton>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in pagedResultNew.Items)
                        {
                            var pill = IsActive(b) ? "tm-pill tm-pill-green" : "tm-pill tm-pill-red";
                            var icoBg = GetIconBg(b.Name);
                            <tr>
                                <td>
                                    <span class="tm-veh"><span class="tm-veh-ico" style="background:@icoBg">🔧</span>@b.Name</span>
                                </td>
                                <td class="tm-num">@(string.IsNullOrWhiteSpace(b.BrandCode) ? "-" : b.BrandCode)</td>
                                <td><span class="@pill"><span class="tm-dot"></span>@b.Status</span></td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(b.OriginCompany) ? "-" : b.OriginCompany)</td>
                                <td class="tm-branch">@(string.IsNullOrWhiteSpace(b.OriginCountry) ? "-" : b.OriginCountry)</td>
                                <td class="tm-num">@(b.FoundedYear?.ToString() ?? "-")</td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(b.Description) ? "-" : Truncate(b.Description, 60))</td>
                                <td style="text-align:right" class="tm-num">@(b.ProductCount ?? 0)</td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-edit" title="Edit" @onclick="() => OpenEditDialog(b)">✎</button>
                                        <button class="tm-act tm-act-del" title="Delete" @onclick="() => DeleteBrand(b.Id)">🗑</button>
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div style="opacity:@(_loading ? "0.55" : "1"); pointer-events:@(_loading ? "none" : "auto");">
            <TmPager CurrentPage="pagedResultNew.CurrentPage"
                     PageSize="pagedResultNew.PageSize"
                     TotalCount="pagedResultNew.TotalCount"
                     TotalPages="pagedResultNew.TotalPages"
                     ItemLabel="Brands"
                     OnGoToPage="GoToPage"
                     OnPrev="GoPrevPage"
                     OnNext="GoNextPage"
                     OnPageSizeChanged="OnPageSizeChanged" />
        </div>
    </div>
</div>

@code {
    private static class Col
    {
        public const string Name = "Name";
        public const string BrandCode = "BrandCode";
        public const string Status = "Status";
        public const string OriginCompany = "OriginCompany";
        public const string OriginCountry = "OriginCountry";
        public const string FoundedYear = "FoundedYear";
        public const string Description = "Description";
        public const string ProductCount = "ProductCount";
    }

    // ─── List state ───
    private PagedResultNew<BrandDto> pagedResultNew = new();
    private BrandPagedRequest pagedRequest = new()
    {
        SortColumn = Col.Name,
        SortAscending = true
    };

    private List<string> _countries = new();
    private bool _loading = true;
    private bool _hasLoadedOnce;
    private bool _loadRunning;
    private bool _loadQueued;
    private CancellationTokenSource? _debounceCts;

    protected override async Task OnInitializedAsync()
    {
        // The country dropdown lists every known origin, so it is fetched from the full
        // reference list once rather than from the current (filtered) page of the grid.
        try
        {
            var all = await BrandService.GetAllBrandsAsync();
            _countries = all
                .Select(b => b.OriginCountry)
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Select(c => c!)
                .Distinct()
                .OrderBy(c => c)
                .ToList();
        }
        catch { }

        await LoadBrands();
    }

    private async Task Refresh() => await LoadBrands();

    /// <summary>
    /// Single-flight loader. The page and the services share one scoped DbContext, so two
    /// overlapping queries would throw "A second operation was started on this context
    /// instance". Callers that arrive mid-flight set a flag instead of starting a parallel
    /// query, and the running load then re-runs once with the newest filter state.
    /// </summary>
    private async Task LoadBrands()
    {
        if (_loadRunning)
        {
            _loadQueued = true;
            return;
        }

        _loadRunning = true;
        try
        {
            do
            {
                _loadQueued = false;
                await LoadBrandsCore();
            }
            while (_loadQueued);
        }
        finally { _loadRunning = false; }
    }

    private async Task LoadBrandsCore()
    {
        _loading = true;
        try
        {
            pagedResultNew = await BrandService.GetBrandsPagedAsync(pagedRequest);
            _hasLoadedOnce = true;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    // ─── Stats / sorting helpers ───
    private string TotalCountText => Stat("TotalCount");
    private string ActiveCountText => Stat("ActiveCount");
    private string InactiveCountText => Stat("InactiveCount");
    private string WithProductsCountText => Stat("WithProductsCount");
    private string WithLogoCountText => Stat("WithLogoCount");
    private string CountryCountText => Stat("CountryCount");

    private string Stat(string key) =>
        pagedResultNew.Stats != null && pagedResultNew.Stats.TryGetValue(key, out var v) ? v.ToString() : "0";

    private void SortBy(string column)
    {
        if (pagedRequest.SortColumn == column)
            pagedRequest.SortAscending = !pagedRequest.SortAscending;
        else
        {
            pagedRequest.SortColumn = column;
            pagedRequest.SortAscending = true;
        }
        pagedRequest.CurrentPage = 0;
    }

    private string SortIcon(string column)
    {
        if (pagedRequest.SortColumn != column) return "";
        return pagedRequest.SortAscending ? "▲" : "▼";
    }

    private static bool IsActive(BrandDto b) => string.Equals(b.Status, "Active", StringComparison.OrdinalIgnoreCase);

    private static string Truncate(string value, int max)
        => value.Length <= max ? value : value[..max] + "…";

    private static string GetIconBg(string? name)
    {
        var palettes = new[] { "#e0e9ff", "#fee2e2", "#dcfce7", "#ede9fe", "#ffedd5", "#e0f2fe", "#fef9c3" };
        if (string.IsNullOrEmpty(name)) return palettes[0];
        return palettes[Math.Abs(name.GetHashCode()) % palettes.Length];
    }

    // ─── Filters ───
    private void OnSearchInput(ChangeEventArgs e)
    {
        pagedRequest.SearchTerm = e.Value?.ToString() ?? "";
        pagedRequest.CurrentPage = 0;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(async () =>
                {
                    await LoadBrands();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        pagedRequest.Status = string.IsNullOrEmpty(v) ? null : v;
        pagedRequest.CurrentPage = 0;
        await LoadBrands();
    }

    private async Task OnCountryChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        pagedRequest.OriginCountry = string.IsNullOrEmpty(v) ? null : v;
        pagedRequest.CurrentPage = 0;
        await LoadBrands();
    }

    private async Task OnProductsChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        pagedRequest.ProductFilter = string.IsNullOrEmpty(v) ? null : v;
        pagedRequest.CurrentPage = 0;
        await LoadBrands();
    }

    private async Task FilterByStatus(string status)
    {
        pagedRequest.Status = pagedRequest.Status == status ? null : status;
        pagedRequest.CurrentPage = 0;
        await LoadBrands();
    }

    private async Task FilterByProducts(string productFilter)
    {
        pagedRequest.ProductFilter = pagedRequest.ProductFilter == productFilter ? null : productFilter;
        pagedRequest.CurrentPage = 0;
        await LoadBrands();
    }

    private async Task ToggleWithLogo()
    {
        pagedRequest.HasLogo = pagedRequest.HasLogo == true ? null : true;
        pagedRequest.CurrentPage = 0;
        await LoadBrands();
    }

    private async Task ResetFilters()
    {
        pagedRequest.SearchTerm = "";
        pagedRequest.Status = null;
        pagedRequest.OriginCountry = null;
        pagedRequest.ProductFilter = null;
        pagedRequest.HasLogo = null;
        pagedRequest.CurrentPage = 0;
        await LoadBrands();
    }

    // ─── Paging (zero-based, matches TmPager) ───
    private async Task GoToPage(int page)
    {
        pagedRequest.CurrentPage = Math.Clamp(page, 0, Math.Max(0, pagedResultNew.TotalPages - 1));
        await LoadBrands();
    }

    private async Task GoPrevPage()
    {
        if (pagedRequest.CurrentPage > 0)
        {
            pagedRequest.CurrentPage--;
            await LoadBrands();
        }
    }

    private async Task GoNextPage()
    {
        if (pagedRequest.CurrentPage < pagedResultNew.TotalPages - 1)
        {
            pagedRequest.CurrentPage++;
            await LoadBrands();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sz))
        {
            pagedRequest.PageSize = Math.Clamp(sz, 1, 100);
            pagedRequest.CurrentPage = 0;
            await LoadBrands();
        }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<BrandDialog>("New Brand",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateBrandDto dto)
        {
            await BrandService.CreateBrandAsync(new CreateBrandDto
            {
                Name = dto.Name,
                BrandCode = dto.BrandCode,
                Description = dto.Description,
                LogoUrl = dto.LogoUrl,
                Status = string.IsNullOrWhiteSpace(dto.Status) ? "Active" : dto.Status,
                OriginCompany = dto.OriginCompany,
                OriginCountry = dto.OriginCountry,
                FoundedYear = dto.FoundedYear
            });

            Snackbar.Add("Brand created", Severity.Success);
            await ReloadCountries();
            await LoadBrands();
        }
    }

    private async Task OpenEditDialog(BrandDto brand)
    {
        var parameters = new DialogParameters<BrandDialog>
        {
            { x => x.Brand, brand }
        };

        var dialog = await DialogService.ShowAsync<BrandDialog>("Edit Brand", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateBrandDto dto)
        {
            var entity = await BrandService.UpdateBrandAsync(brand.Id, dto);
            if (entity)
            {
                Snackbar.Add("Brand updated", Severity.Success);
                await ReloadCountries();
                await LoadBrands();
            }
        }
    }

    private async Task DeleteBrand(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Confirm Delete", "Are you sure you want to delete this brand?", "Delete", "Cancel");
        if (confirm == true)
        {
            await BrandService.DeleteBrandAsync(id);
            Snackbar.Add("Brand deleted", Severity.Success);
            await ReloadCountries();
            await LoadBrands();
        }
    }

    /// <summary>Refetches the country dropdown after a write so a new origin shows up.</summary>
    private async Task ReloadCountries()
    {
        try
        {
            var all = await BrandService.GetAllBrandsAsync();
            _countries = all
                .Select(b => b.OriginCountry)
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Select(c => c!)
                .Distinct()
                .OrderBy(c => c)
                .ToList();
        }
        catch { }
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
