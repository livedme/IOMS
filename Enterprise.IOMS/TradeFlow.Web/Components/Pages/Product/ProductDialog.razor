@using TradeFlow.Web.Utility
@using MudBlazor


<MudDialog>
    <DialogContent>
        <MudGrid>
            @* === Basic Info === *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Basic Information</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" Class="p-4 py-3">
                <MudTextField @bind-Value="_name" Label="Name" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" Class="p-4 py-3">
                <MudTextField @bind-Value="_sku" Label="SKU" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"  />
            </MudItem>           
            <MudItem xs="12" sm="6" Class="p-4 py-3">
                <MudTextField @bind-Value="_barcode" Label="Barcode" Class="pb-5" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"  />
                <MudAutocomplete T="CategoryDto"
                                 @ref="CategoryDropDownControl"
                                 Label="Category"
                                 Required="true"
                                 @key="_lastCategorySelection"
                                 @bind-Value="_selectedCategory"
                                 @bind-Text="_categoryText"
                                 @bind-Value:after="OnCategoryChanged"
                                 SearchFunc="SearchCategories"
                                 ToStringFunc="@(c => c?.Path ?? c?.Name ?? "")"                                 
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 Clearable="true" Class="pb-5" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" ErrorText="" />

                <MudAutocomplete T="BrandDto"
                                 Label="Brand"
                                 @ref="BrandDropDownControl"
                                 @key="_selectedBrandIndex"
                                 @bind-Value="_selectedBrand"
                                 @bind-Text="_brandText"
                                 @bind-Value:after="OnBrandChanged"
                                 SearchFunc="SearchBrands"
                                 ToStringFunc="@(b => b?.Name ?? "")"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 Clearable="true" Class="pb-5" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" ErrorText="" />
                <MudTextField @bind-Value="_model" Label="Model" Class="pb-5" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" ErrorText="" />
                <MudTextField @bind-Value="_originManufacturer" Label="Origin Manufacturer" Class="pb-5" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" ErrorText="" />
            </MudItem>          
            <MudItem xs="12" sm="6" Class="p-4 py-3">
                <MudNumericField @bind-Value="_costPrice" Label="Cost Price" Format="N2" Min="0m" Class="pb-5" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                <MudNumericField @bind-Value="_sellingPrice" Label="Selling Price" Format="N2" Min="0m" Class="pb-5" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                <MudNumericField @bind-Value="_wholeSellingPrice" Label="Whole Selling Price" Format="N2" Min="0m" Class="pb-5" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                <MudNumericField @bind-Value="_ReorderStockLevel" Label="Reorder Stock Level" Min="0" Class="pb-5" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="_originCountry" Label="Origin Country" Class="pb-5" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" ErrorText="" />

            </MudItem>
            <MudItem xs="12" Class="py-0">
                <RichTextField @bind-Value="_description" Label="Description" Lines="10" Class="mt-3" />
            </MudItem>
        
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@inject IDialogService DialogService
@inject ICategoryService CategoryService
@inject IBrandService BrandService

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public object? Product { get; set; }
    [Parameter] public List<CategoryDto> Categories { get; set; } = new();
    [Parameter] public List<BrandDto> Brands { get; set; } = new();

    private MudAutocomplete<CategoryDto> CategoryDropDownControl = default!;
    private MudAutocomplete<BrandDto> BrandDropDownControl = default!;


    // Basic fields
    private string _name = "";
    private string _sku = "";
    private string? _barcode;
    private string? _description;
    private Guid _categoryId;
    private CategoryDto? _selectedCategory;
    private CategoryDto? _lastCategorySelection;
    private int _selectedCategoryIndex=0;
    private string? _categoryText;
    private Guid? _brandId;
    private BrandDto? _selectedBrand;
    private BrandDto? _lastBrandSelection;
    private int _selectedBrandIndex=0;

    private string? _brandText;
    private decimal _costPrice;
    private decimal _sellingPrice;
    private decimal _wholeSellingPrice;
    private int _ReorderStockLevel = 10;
    private int _MinOrderQuantity = 1;
    private string? _model;
    private string? _originCountry;
    private string? _originManufacturer;


    private static readonly CategoryDto AddNewCategoryOption =
        new(Guid.Empty, "Add New", "Create a new category", null, null, 0, "Add New");
    private static readonly BrandDto AddNewBrandOption =
        new(Guid.Empty, "Add New","", "Create a new brand", 0);

    protected override void OnInitialized()
    {
        Categories = Categories.Where(c => c.Id != Guid.Empty).ToList();
        Brands = Brands.Where(b => b.Id != Guid.Empty).ToList();

        if (Product is ProductDetailsDto details)
        {
            _name = details.Name;
            _sku = details.SKU;
            _barcode = details.Barcode;
            _description = details.Description;
            _categoryId = details.CategoryId;
            _selectedCategory = GetRealCategoryById(details.CategoryId);
            _lastCategorySelection = _selectedCategory;
            _categoryText = CategoryToDisplay(_selectedCategory);
            _costPrice = details.CostPrice;
            _wholeSellingPrice = details.WholeSellingPrice;
            _sellingPrice = details.SellingPrice;
            _ReorderStockLevel = details.ReorderStockLevel;
            _MinOrderQuantity = details.MinOrderQuantity;
            _model = details.Model;
            _brandId = details.BrandId;
            _selectedBrand = GetRealBrandById(details.BrandId);
            _lastBrandSelection = _selectedBrand;
            _brandText = BrandToDisplay(_selectedBrand);
            _originCountry = details.OriginCountry;
            _originManufacturer = details.OriginManufacturer;
        }
        else if (Product is ProductDto p)
        {
            _name = p.Name;
            _sku = p.SKU;
            _barcode = p.Barcode;
            _description = p.Description;
            _categoryId = p.CategoryId;
            _selectedCategory = GetRealCategoryById(p.CategoryId);
            _lastCategorySelection = _selectedCategory;
            _categoryText = CategoryToDisplay(_selectedCategory);
            _brandId = p.BrandId;
            _selectedBrand = GetRealBrandById(p.BrandId);
            _lastBrandSelection = _selectedBrand;
            _brandText = BrandToDisplay(_selectedBrand);
            _costPrice = p.CostPrice;
            _wholeSellingPrice = p.WholeSellingPrice;
            _sellingPrice = p.SellingPrice;
            _ReorderStockLevel = p.ReorderStockLevel;
            _MinOrderQuantity = p.MinOrderQuantity;
            _originCountry = p.OriginCountry;
            _originManufacturer = p.OriginManufacturer;
        }
        else if (Categories.Any(c => c.Id != Guid.Empty))
        {
            _selectedCategory = Categories.First(c => c.Id != Guid.Empty);
            _lastCategorySelection = _selectedCategory;
            _categoryId = _selectedCategory.Id;
            _categoryText = CategoryToDisplay(_selectedCategory);
        }
    }

    private Task<IEnumerable<CategoryDto>> SearchCategories(string text, CancellationToken _)
    {
        IEnumerable<CategoryDto> baseResults;

        if (string.IsNullOrWhiteSpace(text))
        {
            baseResults = Categories.Where(c => c.Id != Guid.Empty);
        }
        else
        {
            baseResults = Categories.Where(c =>
                c.Id != Guid.Empty &&
                (c.Name.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                 (c.Path != null && c.Path.Contains(text, StringComparison.OrdinalIgnoreCase))));
        }

        var results = new[] { AddNewCategoryOption }.Concat(baseResults).DistinctBy(c => c.Id);
        return Task.FromResult(results);
    }

    private Task<IEnumerable<BrandDto>> SearchBrands(string text, CancellationToken _)
    {
        IEnumerable<BrandDto> baseResults;

        if (string.IsNullOrWhiteSpace(text))
        {
            baseResults = Brands.Where(b => b.Id != Guid.Empty);
        }
        else
        {
            baseResults = Brands.Where(b =>
                b.Id != Guid.Empty &&
                b.Name.Contains(text, StringComparison.OrdinalIgnoreCase));
        }

        var results = new[] { AddNewBrandOption }.Concat(baseResults).DistinctBy(b => b.Id);
        return Task.FromResult(results);
    }

    private async Task OnCategoryChanged()
    {
        var cat = _selectedCategory;

        if (cat?.Id == Guid.Empty)
        {
            var previousCategory = _lastCategorySelection;
            var parameters = new DialogParameters<CategoryDialog>
            {
                { x => x.AllCategories, Categories.Where(c => c.Id != Guid.Empty).ToList() }
            };

            var dialog = await DialogService.ShowAsync<CategoryDialog>("New Category", parameters,
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
            var result = await dialog.Result;

            await CategoryDropDownControl.ResetAsync();

            if (result != null && !result.Canceled && result.Data is CreateCategoryDto dto)
            {
                // CategoryService.CreateCategoryAsync does not derive the hierarchy Path, and the old
                // razor code read it off a ParentCategory navigation that was never loaded - so the
                // path was always wrong for anything below level 2. Rebuild it from the already-loaded
                // tree (parent, then grandparent) instead.
                var allCategories = await CategoryService.GetAllCategoriesAsync();
                var path = BuildCategoryPath(allCategories, dto.Name, dto.ParentCategoryId);

                var newCategoryId = await CategoryService.CreateCategoryAsync(dto);

                cat = new CategoryDto(newCategoryId, dto.Name, dto.Description, dto.ParentCategoryId, null, 0, path);

                Categories = allCategories.Append(cat).ToList();

                _selectedCategory = GetRealCategoryById(cat.Id);
                _lastCategorySelection = _selectedCategory;
                _categoryId = _selectedCategory?.Id ?? Guid.Empty;
                _categoryText = CategoryToDisplay(_selectedCategory);

                _selectedCategoryIndex++;

                StateHasChanged();
            }
            else
            {
                _selectedCategory = previousCategory;
                _lastCategorySelection = _selectedCategory;
                _categoryId = previousCategory?.Id ?? Guid.Empty;
                _categoryText = CategoryToDisplay(_selectedCategory);
                StateHasChanged();
            }
        }
        else
        {
            _categoryId = cat?.Id ?? Guid.Empty;
            _lastCategorySelection = cat;
            _categoryText = CategoryToDisplay(_selectedCategory);
        }


    }

    private CategoryDto? GetRealCategoryById(Guid categoryId)
    {
        if (categoryId == Guid.Empty)
            return null;

        return Categories.FirstOrDefault(c => c.Id == categoryId);
    }

    /// <summary>
    /// Rebuilds "Grandparent &gt; Parent &gt; Child" from the loaded category tree. The tree is the
    /// whole category table (<see cref="ICategoryService.GetAllCategoriesAsync"/>), so no context or
    /// navigation property is needed - and a missing/blank parent id is treated as a root category
    /// rather than being passed to a lookup that would throw on null.
    /// </summary>
    private static string BuildCategoryPath(List<CategoryDto> tree, string name, Guid? parentCategoryId)
    {
        if (parentCategoryId is null || parentCategoryId == Guid.Empty)
            return name;

        var parent = tree.FirstOrDefault(c => c.Id == parentCategoryId.Value);
        if (parent is null)
            return name;

        var grandParent = parent.ParentCategoryId is Guid grandParentId && grandParentId != Guid.Empty
            ? tree.FirstOrDefault(c => c.Id == grandParentId)
            : null;

        return grandParent is null
            ? $"{parent.Name} > {name}"
            : $"{grandParent.Name} > {parent.Name} > {name}";
    }

    private async Task OnBrandChanged()
    {
        var brand = _selectedBrand;

        if (brand?.Id == Guid.Empty)
        {
            var previousBrand = _lastBrandSelection;

            var dialog = await DialogService.ShowAsync<BrandDialog>("New Brand",
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
            var result = await dialog.Result;

            await BrandDropDownControl.ResetAsync();

            if (result != null && !result.Canceled && result.Data is CreateBrandDto dto)
            {
                var newBrandId = await BrandService.CreateBrandAsync(dto);

                Brands = await BrandService.GetAllBrandsAsync();

                _selectedBrand = GetRealBrandById(newBrandId);
                _lastBrandSelection = _selectedBrand;
                _brandId = _selectedBrand?.Id;
                _brandText = BrandToDisplay(_selectedBrand);

                _selectedBrandIndex++;
                StateHasChanged();
            }
            else
            {
                _selectedBrand = previousBrand;
                _lastBrandSelection = _selectedBrand;
                _brandId = previousBrand?.Id;
                _brandText = BrandToDisplay(_selectedBrand);
                StateHasChanged();
            }

            return;
        }

        _brandId = brand?.Id;
        _lastBrandSelection = brand;
        _brandText = BrandToDisplay(_selectedBrand);
    }

    private BrandDto? GetRealBrandById(Guid? brandId)
    {
        if (!brandId.HasValue || brandId.Value == Guid.Empty)
            return null;

        return Brands.FirstOrDefault(b => b.Id == brandId.Value);
    }

    private static string? CategoryToDisplay(CategoryDto? category)
        => category?.Path ?? category?.Name;

    private static string? BrandToDisplay(BrandDto? brand)
        => brand?.Name;

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        var dto = new ProductDetailsDto()
            {
                Name = _name,
                SKU = _sku,
                Barcode = _barcode,
                Description = _description,
                CostPrice = _costPrice,
                SellingPrice = _sellingPrice,
                WholeSellingPrice = _wholeSellingPrice,
                ReorderStockLevel = _ReorderStockLevel,
                MinOrderQuantity = _MinOrderQuantity,
                CategoryId = _categoryId,
                BrandId = _brandId,
                ImageUrl = null, // ImageUrl
                Model = _model
            };

        MudDialog.Close(DialogResult.Ok(dto));
    }
}
