@inject IPricingService PricingService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Create Price List</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_name" Label="Name" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
            <MudTextField @bind-Value="_description" Label="Description" Class="mt-3" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
            <MudDatePicker @bind-Date="_effectiveDate" Label="Effective Date" Required="true" Class="mt-3" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
            <MudDatePicker @bind-Date="_expiryDate" Label="Expiry Date" Class="mt-3" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
            <MudCheckBox @bind-Value="_isActive" Label="Active" Class="mt-3" CheckedIcon="@Icons.Material.Filled.CheckBox" UncheckedIcon="@Icons.Material.Outlined.CheckBoxOutlineBlank" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private MudForm _form = null!;

    private string _name = "", _description = "";
    private DateTime? _effectiveDate = DateTime.Today;
    private DateTime? _expiryDate;
    private bool _isActive = true;

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        try
        {
            await PricingService.CreatePriceList(new CreatePriceListDto(
                _name, _description, _effectiveDate ?? DateTime.Today, _expiryDate, _isActive));
            Snackbar.Add("Price list created", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void Cancel() => MudDialog.Cancel();
}
