@page "/accounting/credit-notes"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ICreditDebitNoteService NoteService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Credit Notes - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="🧾" Title="Credit Notes" Subtitle="Issue credits against customer invoices">
        <Actions>
            <button class="tm-reset" @onclick="Load">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="CreateNote">+ New Credit Note</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="🧾" Number="@_notes.Count" Label="Credit Notes" Tone="blue" />
        <TmStatTile Icon="📝" Number="@DraftCount" Label="Draft" Tone="amber" OnClick="@(() => PickStatus(CreditNoteStatus.Draft))" />
        <TmStatTile Icon="✅" Number="@ApprovedCount" Label="Approved" Tone="green" OnClick="@(() => PickStatus(CreditNoteStatus.Approved))" />
        <TmStatTile Icon="🔁" Number="@AppliedCount" Label="Applied" Tone="purple" OnClick="@(() => PickStatus(CreditNoteStatus.Applied))" />
        <TmStatTile Icon="🚫" Number="@CancelledCount" Label="Cancelled" Tone="red" OnClick="@(() => PickStatus(CreditNoteStatus.Cancelled))" />
        <TmStatTile Icon="💵" Number="@TotalAmount" Label="Total Credit Amount" Tone="teal" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by credit note number, invoice number or reason..." value="@_search" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select @onchange="OnStatusChanged">
                <option value="" selected="@(_statusFilter == null)">All Statuses</option>
                @foreach (CreditNoteStatus s in Enum.GetValues<CreditNoteStatus>())
                {
                    <option value="@s" selected="@(_statusFilter == s)">@s</option>
                }
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:1000px">
                <thead>
                    <tr>
                        <th>🧾 Credit Note #</th>
                        <th>Invoice #</th>
                        <th>📅 Date</th>
                        <th>Status</th>
                        <th style="text-align:right">Amount</th>
                        <th>Reason</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="7"><TmLoading Message="Loading credit notes..." /></td></tr>
                    }
                    else if (Paged.Count == 0)
                    {
                        <tr><td colspan="7"><div class="tm-loading">No credit notes found</div></td></tr>
                    }
                    else
                    {
                        @foreach (var n in Paged)
                        {
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#e0e9ff">🧾</span>@n.CreditNoteNumber</span></td>
                                <td class="tm-dim">@n.InvoiceNumber</td>
                                <td class="tm-dim">@n.Date.ToString("dd MMM yyyy")</td>
                                <td><span class="@StatusPill(n.Status)"><span class="tm-dot"></span>@n.Status</span></td>
                                <td style="text-align:right" class="tm-money">@n.Amount.ToString("N2")</td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(n.Reason) ? "-" : n.Reason)</td>
                                <td>
                                    @if (n.Status == CreditNoteStatus.Draft)
                                    {
                                        <button class="tm-reset" @onclick="@(async () => await ApproveNote(n.Id))" title="Approve">Approve</button>
                                    }
                                    else
                                    {
                                        <span class="tm-dim">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <TmPager CurrentPage="@(_page - 1)"
                  PageSize="_pageSize"
                  TotalCount="@Filtered.Count"
                  TotalPages="@PageTotal"
                  ItemLabel="Credit Notes"
                  OnGoToPage="GoToPage"
                  OnPrev="GoPrevPage"
                  OnNext="GoNextPage"
                  OnPageSizeChanged="OnPageSizeChanged" />
    </div>
</div>

@code {
    private List<CreditNoteDto> _notes = new();
    private bool _loading = true;
    private string _search = "";
    private CreditNoteStatus? _statusFilter;
    private int _page = 1;
    private int _pageSize = 10;

    private int DraftCount => _notes.Count(n => n.Status == CreditNoteStatus.Draft);
    private int ApprovedCount => _notes.Count(n => n.Status == CreditNoteStatus.Approved);
    private int AppliedCount => _notes.Count(n => n.Status == CreditNoteStatus.Applied);
    private int CancelledCount => _notes.Count(n => n.Status == CreditNoteStatus.Cancelled);
    private string TotalAmount => _notes.Sum(n => n.Amount).ToString("N2");

    private static string StatusPill(CreditNoteStatus s) => s switch
    {
        CreditNoteStatus.Draft => "tm-pill tm-pill-amber",
        CreditNoteStatus.Approved => "tm-pill tm-pill-green",
        CreditNoteStatus.Applied => "tm-pill tm-pill-blue",
        CreditNoteStatus.Cancelled => "tm-pill tm-pill-red",
        _ => "tm-pill tm-pill-gray"
    };

    private List<CreditNoteDto> Filtered => _notes.Where(n =>
        (_statusFilter == null || n.Status == _statusFilter.Value)
        && (string.IsNullOrWhiteSpace(_search)
            || n.CreditNoteNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || n.InvoiceNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (n.Reason?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))).ToList();

    private List<CreditNoteDto> Paged => Filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        try
        {
            var result = await NoteService.GetCreditNotes(null, 1, 500);
            _notes = result.Items;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task CreateNote()
    {
        var dialog = await DialogService.ShowAsync<CreditNoteDialog>("New Credit Note",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await Load();
    }

    private async Task ApproveNote(Guid id)
    {
        try
        {
            await NoteService.ApproveCreditNote(id);
            Snackbar.Add("Credit note approved.", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 1;
    }

    private void OnStatusChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _statusFilter = string.IsNullOrEmpty(v) ? null : Enum.Parse<CreditNoteStatus>(v);
        _page = 1;
    }

    private void PickStatus(CreditNoteStatus s)
    {
        _statusFilter = _statusFilter == s ? null : s;
        _page = 1;
    }

    private void ResetFilters()
    {
        _search = "";
        _statusFilter = null;
        _page = 1;
    }

    private int PageTotal => Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)_pageSize));

    private Task GoToPage(int pageIndex)
    {
        _page = Math.Clamp(pageIndex + 1, 1, PageTotal);
        return Task.CompletedTask;
    }

    private Task GoPrevPage() => GoToPage(_page - 2);

    private Task GoNextPage() => GoToPage(_page);

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            _pageSize = size;
            _page = 1;
        }
    }
}
