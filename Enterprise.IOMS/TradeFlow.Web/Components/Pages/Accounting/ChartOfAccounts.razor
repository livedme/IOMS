@page "/accounting/accounts"
@using TradeFlow.Shared.Helpers
@rendermode InteractiveServer
@attribute [Authorize]
@inject IAccountingService AccountingService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Chart of Accounts - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="📚" Title="Chart of Accounts" Subtitle="Define your ledger structure, account types and hierarchies">
        <Actions>
            <button class="tm-reset" @onclick="LoadAccounts">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="OpenCreate">+ New Account</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="📚" Number="@_accounts.Count" Label="Accounts" Tone="blue" />
        <TmStatTile Icon="💰" Number="@CountOf(AccountType.Asset)" Label="Assets" Tone="teal" OnClick="@(() => PickType(AccountType.Asset))" />
        <TmStatTile Icon="📄" Number="@CountOf(AccountType.Liability)" Label="Liabilities" Tone="red" OnClick="@(() => PickType(AccountType.Liability))" />
        <TmStatTile Icon="📈" Number="@CountOf(AccountType.Revenue)" Label="Revenue" Tone="green" OnClick="@(() => PickType(AccountType.Revenue))" />
        <TmStatTile Icon="📉" Number="@CountOf(AccountType.Expense)" Label="Expenses" Tone="yellow" OnClick="@(() => PickType(AccountType.Expense))" />
        <TmStatTile Icon="⚖" Number="@CountOf(AccountType.Equity)" Label="Equity" Tone="purple" OnClick="@(() => PickType(AccountType.Equity))" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by code, name or parent account..." value="@_search" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select @onchange="OnTypeChanged">
                <option value="" selected="@(_typeFilter == null)">All Account Types</option>
                @foreach (var type in Enum.GetValues<AccountType>())
                {
                    <option value="@type" selected="@(_typeFilter == type)">@type</option>
                }
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:950px">
                <thead>
                    <tr>
                        <th>🔢 Code</th>
                        <th>📚 Account Name</th>
                        <th>Type</th>
                        @* <th>🌳 Parent</th> *@
                        <th style="text-align:right">Balance</th>
                        <th>🔒 System</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="6"><TmLoading Message="Loading accounts..." /></td></tr>
                    }
                    else if (_accountsIncludChilds.Count == 0)
                    {
                        <tr><td colspan="6"><div class="tm-loading">No accounts found</div></td></tr>
                    }
                    else
                    {
                        @foreach (var row in _accountsIncludChilds)
                        {
                            <tr class="tm-parent-row">
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#e0e9ff">🔢</span>@row.Code</span></td>
                                <td class="tm-branch">@row.Name</td>
                                <td><span class="@CommonUtility.GetTypePill(row.AccountType)"><span class="tm-dot"></span>@row.AccountType</span></td>
                                @* <td class="tm-dim">@row.ParentAccountName</td> *@
                                <td style="text-align:right" class="tm-money">@row.Balance</td>
                                <td>
                                    @if (row.IsSystemAccount == true)
                                    {
                                        <span class="tm-pill tm-pill-amber"><span class="tm-dot"></span>System</span>
                                    }
                                    else
                                    {
                                        <span class="tm-dim">-</span>
                                    }
                                </td>
                            </tr>

                            @foreach (var childrow in row.ChildAccounts)
                            {
                                <tr class="tm-child-row">
                                    <td>
                                        <span class="tm-veh" style="padding-left: 15px;"><span class="tm-veh-ico" style="background:#e0e9ff">🔢</span>@childrow.Code</span>
                                    </td>
                                    <td class="tm-branch">@childrow.Name</td>
                                    <td><span class="@CommonUtility.GetTypePill(childrow.AccountType)"><span class="tm-dot"></span>@childrow.AccountType</span></td>
                                    @* <td class="tm-dim">@childrow.ParentAccountName</td> *@
                                    <td style="text-align:right" class="tm-money">@childrow.Balance</td>
                                    <td>
                                        @if (childrow.IsSystemAccount == true)
                                        {
                                            <span class="tm-pill tm-pill-amber"><span class="tm-dot"></span>System</span>
                                        }
                                        else
                                        {
                                            <span class="tm-dim">-</span>
                                        }
                                    </td>
                                </tr>                                
                            }
                        }




                       @*  @foreach (var row in _displayRows)
                        {
                            if (row.Type == "GroupHeader")
                            {
                                <tr class="tm-group-header">
                                    <td colspan="6">@row.GroupLabel</td>
                                </tr>
                            }
                            else if (row.Type == "GroupFooter")
                            {
                                <tr class="tm-group-footer">
                                    <td colspan="6">Total Balance: @row.BalanceTotalDisplay</td>
                                </tr>
                            }
                            else
                            {
                                <tr class="@(row.Type == "Standalone" ? "" : "tm-child-row")">
                                    <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#e0e9ff">🔢</span>@row.Code</span></td>
                                    <td class="tm-branch">@row.AccountName</td>
                                    <td><span class="@CommonUtility.GetTypePill(row.AccountType)"><span class="tm-dot"></span>@row.AccountType</span></td>
                                    <td class="tm-dim">@row.ParentAccountName</td>
                                    <td style="text-align:right" class="tm-money">@row.BalanceDisplay</td>
                                    <td>
                                        @if (row.IsSystemAccount)
                                        {
                                            <span class="tm-pill tm-pill-amber"><span class="tm-dot"></span>System</span>
                                        }
                                        else
                                        {
                                            <span class="tm-dim">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        } *@
                    }
                </tbody>
            </table>
        </div>
        <TmPager CurrentPage="@(_page - 1)"
                  PageSize="_pageSize"
                  TotalCount="@Filtered.Count"
                  TotalPages="@PageTotal"
                  ItemLabel="Accounts"
                  OnGoToPage="GoToPage"
                  OnPrev="GoPrevPage"
                  OnNext="GoNextPage"
                  OnPageSizeChanged="OnPageSizeChanged" />
    </div>
</div>
<style>
    
</style>

@code {
    private List<AccountModelDto> _accounts = new();
    private List<AccountModelDto> _accountsIncludChilds = new();
    private List<AccountRow> _displayRows = new();

    private AccountType? _typeFilter;
    private string _search = "";
    private bool _loading = true;
    private int _page = 1;
    private int _pageSize = 10;

    private class AccountRow
    {
        public string Type { get; set; } = "Row";
        public Guid? Id { get; set; }
        public string Code { get; set; } = string.Empty;
        public string AccountName { get; set; } = string.Empty;
        public AccountType AccountType { get; set; }
        public string ParentAccountName { get; set; } = string.Empty;
        public decimal Balance { get; set; }
        public string BalanceDisplay => Balance.ToString("N0");
        public bool IsSystemAccount { get; set; }
        public string GroupLabel { get; set; } = string.Empty;
        public decimal BalanceTotal { get; set; }
        public string BalanceTotalDisplay => BalanceTotal.ToString("N0");
    }

    private List<AccountModelDto> Filtered => _accounts.Where(a =>
        (_typeFilter == null || a.AccountType == _typeFilter.Value)
        && (string.IsNullOrWhiteSpace(_search)
            || a.Code.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || a.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (a.ParentAccountName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))).ToList();

    protected override async Task OnInitializedAsync() => await LoadAccounts();

    private async Task LoadAccounts()
    {
        _loading = true;
        try
        {
            if (_typeFilter.HasValue)
            {
                var result = await AccountingService.GetAccounts(null, _typeFilter, 1, 500);
                _accounts = result.Items;
            }
            else
            {
                _accounts = await AccountingService.GetChartOfAccounts();
            }

            var _parentAccounts = _accounts.Where(x => x.ParentAccountId == null).ToList();

            foreach (var account in _parentAccounts)
            {
                account.ChildAccounts = _accounts.Where(a => a.ParentAccountId == account.Id).OrderBy(a => a.Code).ToList();
                _accountsIncludChilds.Add(account);
            }
            


            //BuildDisplayRows();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private void BuildDisplayRows()
    {
        var filtered = Filtered;
        _displayRows = new List<AccountRow>();

        foreach (var parent in filtered.Where(a => a.ParentAccountId == null).OrderBy(a => a.Code))
        {
            var children = filtered.Where(a => a.ParentAccountId == parent.Id).OrderBy(a => a.Code).ToList();

            if (children.Count > 0)
            {
                // Parent WITH children: group header + children + group footer
                _displayRows.Add(new AccountRow
                {
                    Type = "GroupHeader",
                    GroupLabel = parent.Name,
                    Code = parent.Code,
                    AccountName = parent.Name,
                    AccountType = parent.AccountType,
                    ParentAccountName = parent.ParentAccountName ?? "-",
                    Balance = parent.Balance ?? 0m,
                    IsSystemAccount = parent.IsSystemAccount ?? false
                });

                foreach (var child in children)
                {
                    _displayRows.Add(new AccountRow
                    {
                        Type = "Row",
                        Id = child.Id,
                        Code = child.Code,
                        AccountName = child.Name,
                        AccountType = child.AccountType,
                        ParentAccountName = child.ParentAccountName ?? "-",
                        Balance = child.Balance ?? 0m,
                        IsSystemAccount = child.IsSystemAccount ?? false
                    });
                }

                _displayRows.Add(new AccountRow
                {
                    Type = "GroupFooter",
                    BalanceTotal = children.Sum(c => c.Balance ?? 0m)
                });
            }
            else
            {
                // Parent WITHOUT children: standalone row (no group wrapper)
                _displayRows.Add(new AccountRow
                {
                    Type = "Standalone",
                    Id = parent.Id,
                    Code = parent.Code,
                    AccountName = parent.Name,
                    AccountType = parent.AccountType,
                    ParentAccountName = parent.ParentAccountName ?? "-",
                    Balance = parent.Balance ?? 0m,
                    IsSystemAccount = parent.IsSystemAccount ?? false
                });
            }
        }

        // Add orphaned children (accounts with a parent not in the filtered set)
        var shownChildIds = _displayRows.Where(r => r.Type == "Row").Select(r => r.Id).ToHashSet();
        foreach (var orphan in filtered.Where(a => a.ParentAccountId != null && !shownChildIds.Contains(a.Id)).OrderBy(a => a.Code))
        {
            _displayRows.Add(new AccountRow
            {
                Type = "Row",
                Id = orphan.Id,
                Code = orphan.Code,
                AccountName = orphan.Name,
                AccountType = orphan.AccountType,
                ParentAccountName = orphan.ParentAccountName ?? "-",
                Balance = orphan.Balance ?? 0m,
                IsSystemAccount = orphan.IsSystemAccount ?? false
            });
        }
    }

    private int CountOf(AccountType t) => _accounts.Count(a => a.AccountType == t);

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<AccountDialog>
        {
            { x => x.dataModel, new AccountModelDto(){ Code = NumberGenerator.GenerateAccountCode() } }
        };
        var dialog = await DialogService.ShowAsync<AccountDialog>("New Account", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is AccountModelDto dto)
        {
            try
            {
                await AccountingService.CreateAccount(dto);
                Snackbar.Add("Account created", Severity.Success);
                await LoadAccounts();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
    }

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _typeFilter = string.IsNullOrEmpty(v) ? null : Enum.Parse<AccountType>(v);
        await LoadAccounts();
    }

    private async Task PickType(AccountType t)
    {
        _typeFilter = _typeFilter == t ? null : t;
        await LoadAccounts();
    }

    private async Task ResetFilters()
    {
        _search = "";
        _typeFilter = null;
        await LoadAccounts();
    }

    private int PageTotal => Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)_pageSize));

    private Task GoToPage(int pageIndex)
    {
        _page = Math.Clamp(pageIndex + 1, 1, PageTotal);
        return Task.CompletedTask;
    }

    private Task GoPrevPage() => GoToPage(_page - 2);

    private Task GoNextPage() => GoToPage(_page);

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            _pageSize = size;
            _page = 1;
        }
    }
}
