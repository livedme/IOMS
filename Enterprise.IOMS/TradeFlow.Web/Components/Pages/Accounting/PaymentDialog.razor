@inject IAccountingService AccountingService
@inject ISnackbar Snackbar
@using IOMS.Infrastructure.Data
@inject ApplicationDbContext DbContext

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Record Payment</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_paymentType" Label="Payment Type" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="PaymentType.Receipt">Receipt (from Customer)</MudSelectItem>
                        <MudSelectItem Value="PaymentType.Payment">Payment (to Supplier)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_paymentDate" Label="Payment Date" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </MudItem>
                @if (_paymentType == PaymentType.Receipt)
                {
                    <MudItem xs="12">
                        <MudSelect @bind-Value="_customerId" Label="Customer" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var c in _customers)
                            {
                                <MudSelectItem Value="@c.Id">@c.CustomerName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudSelect @bind-Value="_supplierId" Label="Supplier" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var s in _suppliers)
                            {
                                <MudSelectItem Value="@s.Id">@s.SupplierName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_paymentMethod" Label="Payment Method" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (PaymentMethod m in Enum.GetValues<PaymentMethod>())
                        {
                            <MudSelectItem Value="@m">@m</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_amount" Label="Amount" Min="0.01m" Required="true"
                                     Format="N2" Adornment="Adornment.Start" AdornmentText="$" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_reference" Label="Reference / Check #" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </MudItem>
                <MudItem xs="12">
                    <RichTextField @bind-Value="_notes" Label="Notes" Lines="2" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Record</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private MudForm _form = null!;

    private PaymentType _paymentType = PaymentType.Receipt;
    private DateTime? _paymentDate = DateTime.Today;
    private Guid _customerId;
    private Guid _supplierId;
    private PaymentMethod _paymentMethod = PaymentMethod.BankTransfer;
    private decimal _amount;
    private string _reference = "";
    private string _notes = "";

    private List<Customer> _customers = new();
    private List<Supplier> _suppliers = new();

    protected override async Task OnInitializedAsync()
    {
        _customers = await DbContext.Customers.Where(c => c.IsActive).OrderBy(c => c.CustomerName).ToListAsync();
        _suppliers = await DbContext.Suppliers.Where(s => s.IsActive).OrderBy(s => s.SupplierName).ToListAsync();
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        try
        {
            var dto = new RecordPaymentDto(
                _paymentType,
                _paymentType == PaymentType.Receipt ? _customerId : null,
                _paymentType == PaymentType.Payment ? _supplierId : null,
                null,
                _amount,
                _paymentMethod,
                _reference,
                _paymentDate ?? DateTime.Today);

            await AccountingService.RecordPayment(dto);
            Snackbar.Add("Payment recorded successfully", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void Cancel() => MudDialog.Cancel();
}
