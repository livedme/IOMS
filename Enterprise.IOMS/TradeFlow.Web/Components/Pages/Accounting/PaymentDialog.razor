@inject IAccountingService AccountingService
@inject ICustomerService CustomerService
@inject ISupplierService SupplierService
@inject IInvoiceService InvoiceService
@inject ISnackbar Snackbar


<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Record Payment</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="paymentModelDto.PaymentType" Label="Payment Type" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="PaymentType.Receipt">Receipt (from Customer)</MudSelectItem>
                        <MudSelectItem Value="PaymentType.Payment">Payment (to Supplier)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="paymentModelDto.PaymentDate" Label="Payment Date" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                @if (paymentModelDto.PaymentType == PaymentType.Receipt)
                {
                    <MudItem xs="(_invoices != null && _invoices.Count > 0 ? 6 : 12)">
                        <MudAutocomplete T="ControlItemsDto"
                                         Label="Customer"
                                         Required="true"
                                         @bind-Value="paymentModelDto.SelectedParty"
                                         @bind-Value:after="OnPartyChanged"
                                         SearchFunc="SearchCustomers"
                                         ToStringFunc="@(c => c?.Name ?? "")"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         Clearable="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="(_invoices != null && _invoices.Count > 0 ? 6 : 12)">
                        <MudAutocomplete T="ControlItemsDto"
                                         Label="Supplier"
                                         Required="true"
                                         @bind-Value="paymentModelDto.SelectedParty"
                                         @bind-Value:after="OnPartyChanged"
                                         SearchFunc="SearchSuppliers"
                                         ToStringFunc="@(c => c?.Name ?? "")"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         Clearable="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                }
                @if (_invoices != null && _invoices.Count > 0)
                {
                    <MudItem xs="6" sm="6">
                        <MudSelect T="Guid?" @bind-Value="paymentModelDto.InvoiceId" Label="Invoice" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="Guid?" Value="@Guid.Empty">Select an invoice</MudSelectItem>
                            @foreach (var invoice in _invoices)
                            {
                                <MudSelectItem T="Guid?" Value="@invoice.Id">@invoice.InvoiceNumber</MudSelectItem>
                            }
                        </MudSelect>
                        @{
                            var selectedInvoice = _invoices.FirstOrDefault(i => i.Id == paymentModelDto.InvoiceId);
                            <span style="font-size: 11px;position: absolute;color: red;">
                                @selectedInvoice?.TotalAmount
                            </span>
                        }
                    </MudItem>
                }

                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="paymentModelDto.Amount" Label="Amount" Min="0.01m" Required="true" Format="N2" Adornment="Adornment.Start" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="paymentModelDto.Method" Label="Payment Method" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (PaymentMethod m in Enum.GetValues<PaymentMethod>())
                        {
                            <MudSelectItem Value="@m">@m</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @if (paymentModelDto.Method == PaymentMethod.BankTransfer || paymentModelDto.Method == PaymentMethod.Check || paymentModelDto.Method == PaymentMethod.CreditCard)
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="paymentModelDto.PaymentMediaName" Label="Bank Name" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="paymentModelDto.AccountName" Label="Account Name" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    @if (paymentModelDto.Method != PaymentMethod.CreditCard)
                    {
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="paymentModelDto.AccountNumber" Label="Account Number" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    }
                    @if (paymentModelDto.Method == PaymentMethod.Check || paymentModelDto.Method == PaymentMethod.CreditCard)
                    {
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="paymentModelDto.CheckOrCardNumber" Label="@(paymentModelDto.Method == PaymentMethod.Check ? "Check Number" : "Card Number")" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>                        
                    }

                    if (paymentModelDto.Method == PaymentMethod.Check)
                    {
                        <MudItem xs="12">
                            <MudTextField @bind-Value="paymentModelDto.Reference" Label="Reference / Check #" ShrinkLabel="true" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    }else{
                        <MudItem xs="6">
                            <MudTextField @bind-Value="paymentModelDto.Reference" Label="Reference / Check #" ShrinkLabel="true" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    }
                }
                @if (paymentModelDto.Method == PaymentMethod.Bkash ||paymentModelDto.Method == PaymentMethod.Nagad)
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="paymentModelDto.AccountName" Label="Account Name" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="paymentModelDto.AccountNumber" Label="Account Number" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="paymentModelDto.Reference" Label="Reference / Check #" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                }
                <MudItem xs="12">
                    <RichTextField @bind-Value="paymentModelDto.Notes" Label="Notes" Lines="2" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Record</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private MudForm _form = null!;

    private PaymentModelDto paymentModelDto = new PaymentModelDto();
    // private DateTime? _paymentDate = DateTime.Today;
    // private ControlItemsDto? _selectedCustomer;
    // private ControlItemsDto? _selectedSupplier;
    // private PaymentMethod _paymentMethod = PaymentMethod.BankTransfer;
    // private decimal _amount;
    // private string _reference = "";
    // private string _notes = "";

    private List<CustomerDto> _customers = new();
    private List<SupplierDto> _suppliers = new();
    private List<InvoiceDto> _invoices = new();

    protected override async Task OnInitializedAsync()
    {
        _customers = await CustomerService.GetActiveCustomersAsync();
        _suppliers = await SupplierService.GetActiveSuppliersAsync();
    }

    private Task<IEnumerable<ControlItemsDto>> SearchCustomers(string text, CancellationToken token)
    {
        IEnumerable<ControlItemsDto> results;
        if (string.IsNullOrWhiteSpace(text))
        {
            results = _customers.Select(c => new ControlItemsDto { Id = c.Id, Name = c.CustomerName });
        }
        else
        {
            results = _customers.Where(c => c.CustomerName.Contains(text, StringComparison.OrdinalIgnoreCase))
                .Select(c => new ControlItemsDto { Id = c.Id, Name = c.CustomerName });
        }
        return Task.FromResult(results);
    }

    private Task<IEnumerable<ControlItemsDto>> SearchSuppliers(string text, CancellationToken token)
    {
        IEnumerable<ControlItemsDto> results;
        if (string.IsNullOrWhiteSpace(text))
        {
            results = _suppliers.Select(s => new ControlItemsDto { Id = s.Id, Name = s.SupplierName });
        }
        else
        {
            results = _suppliers.Where(s => s.SupplierName.Contains(text, StringComparison.OrdinalIgnoreCase))
                .Select(s => new ControlItemsDto { Id = s.Id, Name = s.SupplierName });
        }
        return Task.FromResult(results);
    }
    private async Task OnPartyChanged()
    {
        var cust = paymentModelDto.SelectedParty;
        if (paymentModelDto.PaymentType == PaymentType.Receipt && cust != null)
        {
            _invoices = await InvoiceService.GetInvoiceByCustomer((Guid)cust.Id);
            //paymentModelDto.Invoices = invoices.Where(i => i != null).Select(i => new ControlItemsDto { Id = i!.Id, Name = i.InvoiceNumber }).ToList();
        }
        else if (paymentModelDto.PaymentType == PaymentType.Payment && cust != null)
        {
            _invoices = await InvoiceService.GetInvoiceBySupplier((Guid)cust.Id);
            //paymentModelDto.Invoices = invoices.Where(i => i != null).Select(i => new ControlItemsDto { Id = i!.Id, Name = i.InvoiceNumber }).ToList();
        }

    }
    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        try
        {
            
    //public record RecordPaymentDto(PaymentType PaymentType, Guid? CustomerId, Guid? SupplierId,
      //  Guid? InvoiceId, decimal Amount, PaymentMethod PaymentMethod,
//        string? Reference, DateTime PaymentDate);

            var dto = new RecordPaymentDto(
                paymentModelDto.PaymentType,
                paymentModelDto.PaymentType == PaymentType.Receipt ? (Guid)paymentModelDto.SelectedParty!.Id : null,
                paymentModelDto.PaymentType == PaymentType.Payment ? (Guid)paymentModelDto.SelectedParty!.Id : null,
                null,
                paymentModelDto.Amount,
                paymentModelDto.Method,
                paymentModelDto.Reference,
                paymentModelDto.PaymentDate ?? DateTime.Today);

            await AccountingService.RecordPayment(dto);
            Snackbar.Add("Payment recorded successfully", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void Cancel() => MudDialog.Cancel();
}
