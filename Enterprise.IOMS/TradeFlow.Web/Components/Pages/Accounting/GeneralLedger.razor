@page "/accounting/general-ledger"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IAccountingService AccountingService
@inject ISnackbar Snackbar

<PageTitle>General Ledger - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="📒" Title="General Ledger" Subtitle="Journal lines by account — server-side filtering with paging">
        <Actions>
            <button class="tm-reset" @onclick="LoadLedger">⟳ Refresh</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="Σ" Number="@TotalDebitsText" Label="Total Debits" Tone="blue" />
        <TmStatTile Icon="Σ" Number="@TotalCreditsText" Label="Total Credits" Tone="purple" />
        <TmStatTile Icon="⚖" Number="@NetBalanceText" Label="Net Balance" Tone="teal" />
        <TmStatTile Icon="📄" Number="@_allEntries.Count" Label="Entries" Tone="green" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-select col-md-6" style="flex:0 0 auto;">
            <select value="@(_selectedAccountId?.ToString() ?? "")" @onchange="OnAccountChanged">
                <option value="">All Accounts</option>
                @foreach (var a in _accounts)
                {
                    <option value="@a.Id">@a.Code - @a.Name</option>
                }
            </select>
        </div>
        <TmDateRange From="_fromDate" To="_toDate" RangeChanged="OnRangeChanged" />
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        @if (_loading)
        {
            <div style="position:absolute; inset:0; background:rgba(255,255,255,0.62); backdrop-filter:blur(1px); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2; border-radius:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Style="margin-top:8px; color:#334155; font-weight:600;">Loading ledger...</MudText>
            </div>
        }
        <div class="tm-table-wrap">
            <table class="tm-table">
                <thead>
                    <tr>
                        <th>📅 Date</th>
                        <th>Journal #</th>
                        <th>Account</th>
                        <th>Description</th>
                        <th style="text-align:right">Debit</th>
                        <th style="text-align:right">Credit</th>
                        <th style="text-align:right">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_hasLoadedOnce && _loading)
                    {
                        <tr><td colspan="7" style="text-align:center; padding:40px; color:#94a3b8;">Loading ledger...</td></tr>
                    }
                    else if (!_entries.Any())
                    {
                        <tr>
                            <td colspan="7" style="text-align:center; padding:40px;">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#94a3b8;" Class="mb-2" />
                                <div style="color:#64748b;">No journal entries found — try a different account or date range</div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="ResetFilters">Clear filters</MudButton>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var e in _entries)
                        {
                            <tr>
                                <td class="tm-dim">@e.EntryDate.ToString("dd MMM yyyy")</td>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#e0e9ff">📄</span>@e.JournalNumber</span></td>
                                <td><span class="tm-pill tm-pill-blue"><span class="tm-dot"></span>@e.AccountCode - @e.AccountName</span></td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(e.Description) ? "-" : e.Description)</td>
                                <td style="text-align:right" class="tm-money">@(e.DebitAmount > 0 ? e.DebitAmount.ToString("N2") : "-")</td>
                                <td style="text-align:right" class="tm-money">@(e.CreditAmount > 0 ? e.CreditAmount.ToString("N2") : "-")</td>
                                <td style="text-align:right" class="tm-money"><strong>@e.RunningBalance.ToString("N2")</strong></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div style="opacity:@(_loading ? "0.55" : "1"); pointer-events:@(_loading ? "none" : "auto");">
            <TmPager CurrentPage="@_currentPage"
                     PageSize="@_pageSize"
                     TotalCount="@_allEntries.Count"
                     TotalPages="@_totalPages"
                     ItemLabel="Entries"
                     OnGoToPage="GoToPage"
                     OnPrev="GoPrevPage"
                     OnNext="GoNextPage"
                     OnPageSizeChanged="OnPageSizeChanged" />
        </div>
    </div>
</div>

@code {
    private List<AccountDto> _accounts = new();
    private List<GeneralLedgerEntryDto> _allEntries = new();
    private List<GeneralLedgerEntryDto> _entries = new();
    private Guid? _selectedAccountId;
    private DateTime? _fromDate = new DateTime(DateTime.Today.Year, 1, 1);
    private DateTime? _toDate = DateTime.Today;
    private bool _loading = true;
    private bool _hasLoadedOnce;

    private int _currentPage;
    private int _pageSize = 25;
    private int _totalPages = 1;

    private string TotalDebitsText => _allEntries.Sum(e => e.DebitAmount).ToString("N2");
    private string TotalCreditsText => _allEntries.Sum(e => e.CreditAmount).ToString("N2");
    private string NetBalanceText => (_allEntries.Sum(e => e.DebitAmount) - _allEntries.Sum(e => e.CreditAmount)).ToString("N2");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await AccountingService.GetAccounts(null, null, 1, 1000);
            _accounts = result.Items;
        }
        catch (Exception ex) { Snackbar.Add($"Error loading accounts: {ex.Message}", Severity.Error); }
        await LoadLedger();
    }

    private async Task LoadLedger()
    {
        _loading = true;
        try
        {
            var lines = await AccountingService.GetGeneralLedgerLines(_selectedAccountId, _fromDate, _toDate);

            decimal runningBalance = 0;
            _allEntries = lines.Select(l =>
            {
                runningBalance += l.Debit - l.Credit;
                return new GeneralLedgerEntryDto(l.EntryDate, l.EntryNumber, l.AccountCode, l.AccountName, l.Description, l.Debit, l.Credit, runningBalance);
            }).ToList();

            _hasLoadedOnce = true;
            ApplyPage();
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _loading = false; }
    }

    // Running balance is computed over the full filtered set before paging, so it stays
    // continuous across pages; this only re-slices the loaded list.
    private void ApplyPage()
    {
        _totalPages = Math.Max(1, (int)Math.Ceiling(_allEntries.Count / (double)_pageSize));
        _currentPage = Math.Clamp(_currentPage, 0, _totalPages - 1);
        _entries = _allEntries.Skip(_currentPage * _pageSize).Take(_pageSize).ToList();
    }

    private async Task OnAccountChanged(ChangeEventArgs e)
    {
        _selectedAccountId = ParseGuid(e.Value);
        _currentPage = 0;
        await LoadLedger();
    }

    private async Task OnRangeChanged((DateTime? From, DateTime? To) range)
    {
        _fromDate = range.From;
        _toDate = range.To;
        _currentPage = 0;
        await LoadLedger();
    }

    private async Task ResetFilters()
    {
        _selectedAccountId = null;
        _fromDate = new DateTime(DateTime.Today.Year, 1, 1);
        _toDate = DateTime.Today;
        _currentPage = 0;
        await LoadLedger();
    }

    private static Guid? ParseGuid(object? value) =>
        Guid.TryParse(value?.ToString(), out var g) && g != Guid.Empty ? g : null;

    private Task GoToPage(int page)
    {
        _currentPage = Math.Clamp(page, 0, _totalPages - 1);
        ApplyPage();
        return Task.CompletedTask;
    }

    private Task GoPrevPage()
    {
        if (_currentPage > 0)
        {
            _currentPage--;
            ApplyPage();
        }
        return Task.CompletedTask;
    }

    private Task GoNextPage()
    {
        if (_currentPage < _totalPages - 1)
        {
            _currentPage++;
            ApplyPage();
        }
        return Task.CompletedTask;
    }

    private Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sz))
        {
            _pageSize = Math.Clamp(sz, 1, 100);
            _currentPage = 0;
            ApplyPage();
        }
        return Task.CompletedTask;
    }

    private record GeneralLedgerEntryDto(DateTime EntryDate, string JournalNumber, string AccountCode, string AccountName, string? Description, decimal DebitAmount, decimal CreditAmount, decimal RunningBalance);
}
