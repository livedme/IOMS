@using TradeFlow.Web.Components.Shared
@inject ICreditDebitNoteService NoteService
@inject IInvoiceService InvoiceService
@inject ISnackbar Snackbar
<MudDialog>
    <DialogContent>
         <MudForm @ref="_form" Class="gap-3">
            <MudAutocomplete T="ControlItemsDto"
                             @ref="dataModel.CustomerDdlControl.ControlRef"
                             Label="Supplier Invoice"
                             Required="true"
                             @key="dataModel.CustomerDdlControl.LastSelectedItem"
                             @bind-Value="dataModel.CustomerDdlControl.SelectedItem"
                             @bind-Text="dataModel.CustomerDdlControl.SelectedText"
                             SearchFunc="SearchInvoice"
                             ToStringFunc="@(c => c?.Name ?? "")"
                             ResetValueOnEmptyText="true"
                             Placeholder="name,invoice no, price, email"
                             CoerceText="true"
                             Clearable="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudNumericField @bind-Value="dataModel.Amount" Label="Amount" Min="0.01m" Format="N2" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <RichTextField @bind-Value="dataModel.Reason" Label="Reason" Lines="3" Required="true" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    private MudForm _form = default!;
    private PaymentNoteDto dataModel = new PaymentNoteDto();
    private List<InvoiceOptionDto> _invoices = new();

    protected override async Task OnInitializedAsync()
    {
        _invoices = await InvoiceService.GetRecentInvoiceOptions(1000, InvoiceType.Purchase);
    }
    private Task<IEnumerable<ControlItemsDto>> SearchInvoice(string text, CancellationToken _)
    {
        IEnumerable<ControlItemsDto> baseResults;

        if (string.IsNullOrWhiteSpace(text))
        {
            baseResults = _invoices.Where(c => c.Id != Guid.Empty).Select(c => new ControlItemsDto() { Id = c.Id, Name = $"{c.Name} > {c.InvoiceNumber} - {c.BalanceDue:C}" });
        }
        else
        {
            baseResults = _invoices.Where(c =>
                c.Id != Guid.Empty && (
                    (c.Name.Contains(text, StringComparison.OrdinalIgnoreCase)) ||
                    (c.InvoiceNumber.Contains(text, StringComparison.OrdinalIgnoreCase)) ||
                    (c.BalanceDue.ToString().Contains(text, StringComparison.OrdinalIgnoreCase)) ||
                    (c.Email.Contains(text, StringComparison.OrdinalIgnoreCase))
                )).Select(c => new ControlItemsDto() { Id = c.Id, Name = $"{c.Name} > {c.InvoiceNumber} - {c.BalanceDue:C}" });
        }

        var results = baseResults.OrderBy(x => x.Name).DistinctBy(c => c.Id);
        //results = baseResults.Concat(new[] { AddNewCustomerOption });

        // var results = new[] { AddNewCustomerOption }.Concat(baseResults).DistinctBy(c => c.Id);
        //var results = baseResults.Append(AddNewCustomerOption).DistinctBy(c => c.Id).ToList();

        return Task.FromResult(results);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        try
        {
            if (dataModel.CustomerDdlControl.SelectedItem != null)
            {
                var dto = new CreateDebitNoteDto((Guid)dataModel.CustomerDdlControl.SelectedItem.Id, dataModel.Amount, dataModel.Reason);
                await NoteService.CreateDebitNote(dto);
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
