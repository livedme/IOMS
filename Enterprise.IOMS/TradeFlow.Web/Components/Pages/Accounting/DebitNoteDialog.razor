@using TradeFlow.Web.Components.Shared
@inject ICreditDebitNoteService NoteService
@inject IInvoiceService InvoiceService
@inject ISnackbar Snackbar
<MudDialog>
    <DialogContent>
         <MudForm @ref="_form" Class="gap-3">
            <MudSelect T="Guid?" @bind-Value="_invoiceId" Label="Invoice" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var inv in _invoices)
                {
                    <MudSelectItem Value="@inv.Id">@inv.InvoiceNumber - @inv.TotalAmount.ToString("C")</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField @bind-Value="_amount" Label="Amount" Min="0.01m" Format="N2" Required="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <RichTextField @bind-Value="_reason" Label="Reason" Lines="3" Required="true" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    private MudForm _form = default!;
    private Guid? _invoiceId;
    private decimal _amount;
    private string? _reason;
    private List<InvoiceOptionDto> _invoices = new();

    protected override async Task OnInitializedAsync()
    {
        _invoices = await InvoiceService.GetRecentInvoiceOptions(100);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        try
        {
            if (_invoiceId != null)
            {
                var dto = new CreateDebitNoteDto( (Guid)_invoiceId, _amount, _reason);
                await NoteService.CreateDebitNote(dto);
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
