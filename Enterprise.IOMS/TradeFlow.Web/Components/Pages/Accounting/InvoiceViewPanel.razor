@inject IInvoiceService InvoiceService
@inject ICreditDebitNoteService CreditDebitNoteService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IPrintDocumentRenderer PrintRenderer

@if (_open)
{
    <div class="so-backdrop" @onclick="Close"></div>

    <div class="so-side-panel @(_animateIn ? "so-panel-open" : "")">

        <!-- Header -->
        <div class="so-header">
            <div class="d-flex align-items-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Primary" />
                <div>
                    <div class="so-header-title">Invoice</div>
                    @if (_invoice != null)
                    {
                        <div class="so-header-sub">@_invoice.InvoiceNumber</div>
                    }
                </div>
                @if (_invoice != null)
                {
                    <MudChip T="string" Color="@GetInvoiceStatusColor(_invoice.Status)" Size="Size.Small" Class="ms-1">
                        @_invoice.Status</MudChip>
                }
            </div>
            <div class="d-flex gap-1">
                <MudTooltip Text="Close panel">
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="Close" />
                </MudTooltip>
            </div>
        </div>

        <!-- Body -->
        <div class="so-body">
            @if (_loading)
            {
                <div class="d-flex justify-center align-center" style="height:200px;">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                </div>
            }
            else if (_invoice != null)
            {
                <!-- Reference block -->
                <div class="so-ref-block mb-3">
                    <div class="d-flex justify-space-between">
                        <div>
                            <div class="so-lbl">Invoice Number</div>
                            <div class="so-val-lg">@_invoice.InvoiceNumber</div>
                        </div>
                        <div class="text-end">
                            <div class="so-lbl">Invoice Date</div>
                            <div class="so-val fw-semibold">@_invoice.InvoiceDate.ToString("dd MMM yyyy")</div>
                            <div class="so-sm">Due <span class="@(_invoice.DueDate < DateTime.Today && _invoice.Status != InvoiceStatus.Paid && _invoice.Status != InvoiceStatus.Cancelled ? "text-danger fw-semibold" : "")">@_invoice.DueDate.ToString("dd MMM yyyy")</span></div>
                        </div>
                    </div>
                </div>

                <MudDivider Class="mb-3" />

                <!-- Party -->
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="12">
                        <div class="so-info-card">
                            <div class="so-info-icon">
                                <MudIcon Icon="@(_invoice.InvoiceType == InvoiceType.Sales ? Icons.Material.Filled.Person : Icons.Material.Filled.Business)" Size="Size.Small" Style="color:#fff;" />
                            </div>
                            <div class="overflow-hidden">
                                <div class="so-lbl">@(_invoice.InvoiceType == InvoiceType.Sales ? "Customer" : "Supplier")</div>
                                <div class="so-val fw-bold text-truncate">@(_invoice.CustomerName ?? _invoice.SupplierName ?? "—")</div>
                            </div>
                            @if (_detail != null && _detail.SourceOrderNumber != null)
                            {
                                <div class="ms-auto text-end">
                                    <div class="so-lbl">@(_invoice.InvoiceType == InvoiceType.Sales ? "Sales Order No" : "Purchase Order No")</div>
                                    <div class="so-val fw-semibold">@_detail.SourceOrderNumber</div>
                                    
                                </div>
                                    <div class="ms-auto text-end">
                                    <div class="so-sm">Order Date <br /> @(_detail.SourceOrderDate?.ToString("dd MMM yyyy") ?? "—")</div>
                                </div>
                            }
                        </div>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="mb-3" />

                <!-- Products -->
                @if (_detail is { Items.Count: > 0 })
                {
                    <div class="so-section-lbl mb-2">Products</div>
                    <div class="so-items-card mb-3">
                        <table class="so-items-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _detail.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="so-item-name">@item.ProductName</div>
                                            @if (!string.IsNullOrEmpty(item.ProductSKU))
                                            {
                                                <div class="so-item-sku">@item.ProductSKU</div>
                                            }
                                        </td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">@Taka.H(item.UnitPrice)</td>
                                        <td class="text-end fw-semibold">@Taka.H(item.LineTotal)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }


                <MudDivider Class="mb-3" />

                <!-- Charges -->
                <div class="so-section-lbl mb-2">Summary</div>
                <div class="so-totals-box mb-3">
                    <div class="so-total-row">
                        <span>Subtotal</span>
                        <span>@Taka.H(_invoice.SubTotal)</span>
                    </div>
                    @if (_invoice.TaxAmount > 0)
                    {
                        <div class="so-total-row">
                            <span>Tax</span>
                            <span>@Taka.H(_invoice.TaxAmount)</span>
                        </div>
                    }
                    <div class="so-total-row so-grand-total">
                        <span>TOTAL</span>
                        <span>@Taka.H(_invoice.TotalAmount)</span>
                    </div>
                    <div class="so-total-row">
                        <span>Paid</span>
                        <span class="text-success">@Taka.H(_invoice.PaidAmount)</span>
                    </div>
                    <div class="so-total-row @(_invoice.BalanceDue > 0 ? "so-due-row" : "")">
                        <span>Balance Due</span>
                        <span>@Taka.H(_invoice.BalanceDue)</span>
                    </div>
                </div>


                
                <MudDivider Class="mb-3" />

                <!-- Credit & Debit Notes -->
                @if (_creditNotes.Count > 0 || _debitNotes.Count > 0)
                {
                    if (_invoice.InvoiceType == InvoiceType.Sales)
                    {
                        <div class="so-section-lbl mb-2">Payment Notes</div>
                        <div class="so-items-card mb-3">
                            @if (_creditNotes.Count > 0)
                            {
                               @*  <div class="so-lbl ps-3 pt-2" style="color:#2e7d32;">Credit Notes</div> *@
                                <table class="so-items-table">
                                    <thead>
                                        <tr>
                                            <th>Number</th>
                                            <th class="text-center">Date</th>
                                            <th class="text-end">Reason</th>
                                            <th class="text-end">Amount</th>
                                            <th class="text-center">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cn in _creditNotes)
                                        {
                                            <tr>
                                                <td><div class="so-item-name">@cn.CreditNoteNumber</div></td>
                                                <td class="text-center">@cn.Date.ToString("dd MMM yyyy")</td>
                                                <td class="text-end so-item-sku">@cn.Reason</td>
                                                <td class="text-end fw-semibold">@Taka.H(cn.Amount)</td>
                                                <td class="text-center">
                                                    <MudChip T="string" Size="Size.Small" Color="@GetNoteStatusColor(cn.Status.ToString())">@cn.Status</MudChip>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="so-section-lbl mb-2">Payment Notes</div>

                        <div class="so-items-card mb-3">

                            @if (_debitNotes.Count > 0)
                            {
                                @if (_creditNotes.Count > 0)
                                {
                                    <MudDivider Class="my-1" />
                                }
                               @*  <div class="so-lbl ps-3 pt-2" style="color:#b71c1c;">Debit Notes</div> *@
                                <table class="so-items-table">
                                    <thead>
                                        <tr>
                                            <th>Number</th>
                                            <th class="text-center">Date</th>
                                            <th class="text-end">Reason</th>
                                            <th class="text-end">Amount</th>
                                            <th class="text-center">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var dn in _debitNotes)
                                        {
                                            <tr>
                                                <td><div class="so-item-name">@dn.DebitNoteNumber</div></td>
                                                <td class="text-center">@dn.Date.ToString("dd MMM yyyy")</td>
                                                <td class="text-end so-item-sku">@dn.Reason</td>
                                                <td class="text-end fw-semibold">@Taka.H(dn.Amount)</td>
                                                <td class="text-center">
                                                    <MudChip T="string" Size="Size.Small" Color="@GetNoteStatusColor(dn.Status.ToString())">@dn.Status</MudChip>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    }
                }
            }
        </div>

        <!-- Footer -->
        @if (_invoice != null)
        {
            <div class="so-footer">
                <MudButton Variant="Variant.Text" OnClick="Close" Size="Size.Small">Close</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick="PrintDoc">Print</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="DownloadPdf">Download PDF</MudButton>
                @* <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.OpenInNew"
                           Href="@($"/print/invoice/{_invoice.Id}")" Target="_blank">Open in New Tab</MudButton> *@
            </div>
        }
    </div>
}

@code {
    private bool _open;
    private bool _animateIn;
    private bool _loading;
    private InvoiceDetailDto? _detail;
    private List<CreditNoteDto> _creditNotes = new();
    private List<DebitNoteDto> _debitNotes = new();

    private InvoiceDto? _invoice => _detail?.Invoice;

    private Color GetInvoiceStatusColor(InvoiceStatus status) => status switch
    {
        InvoiceStatus.Paid => Color.Success,
        InvoiceStatus.PartiallyPaid => Color.Warning,
        InvoiceStatus.Sent => Color.Info,
        InvoiceStatus.Draft => Color.Default,
        InvoiceStatus.Overdue => Color.Error,
        InvoiceStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private Color GetNoteStatusColor(string status) => status switch
    {
        "Approved" => Color.Success,
        "Applied" => Color.Info,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };

    private async Task DownloadPdf()
    {
        if (_invoice is null) return;
        try
        {
            var doc = await PrintRenderer.RenderInvoiceAsync(_detail!);
            await JS.InvokeVoidAsync("downloadFile", doc.Html, doc.FileName + ".pdf", doc.Title, doc.Reference);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Could not generate the PDF: " + ex.Message);
        }
    }

    private async Task PrintDoc()
    {
        if (_invoice is null) return;
        try
        {
            var doc = await PrintRenderer.RenderInvoiceAsync(_detail!);
            await JS.InvokeVoidAsync("printHtml", doc.Html, doc.Title, doc.Reference);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Could not print the document: " + ex.Message);
        }
    }

    public async Task OpenAsync(Guid id)
    {
        _open = true;
        _loading = true;
        _animateIn = false;
        _detail = null;
        _creditNotes = new();
        _debitNotes = new();
        StateHasChanged();

        await Task.Delay(20);
        _animateIn = true;
        StateHasChanged();

        try
        {
            _detail = await InvoiceService.GetInvoiceDetailAsync(id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        if (_detail != null)
        {
            try
            {
                _creditNotes = await CreditDebitNoteService.GetCreditNotesForInvoice(id);
                _debitNotes = await CreditDebitNoteService.GetDebitNotesForInvoice(id);
            }
            catch (Exception ex)
            {
                Snackbar.Add("Could not load notes: " + ex.Message, Severity.Warning);
            }
        }

        _loading = false;
        StateHasChanged();
    }

    public void Close()
    {
        _open = false;
        _animateIn = false;
        _detail = null;
        _creditNotes = new();
        _debitNotes = new();
        StateHasChanged();
    }
}
