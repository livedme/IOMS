@page "/accounting/payments"
@rendermode InteractiveServer
@inject IAccountingService AccountingService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using TradeFlow.Infrastructure.Data
@inject ApplicationDbContext DbContext

<PageTitle>Payments - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="💳" Title="Payments" Subtitle="Record customer receipts and supplier disbursements">
        <Actions>
            <button class="tm-reset" @onclick="Load">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="OpenCreateDialog">+ Record Payment</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="💳" Number="@_payments.Count" Label="Payments" Tone="blue" />
        <TmStatTile Icon="📥" Number="@_receiptCount" Label="Receipts" Tone="green" OnClick="@(() => PickType(PaymentType.Receipt))" />
        <TmStatTile Icon="📤" Number="@_paymentCount" Label="Payments Out" Tone="red" OnClick="@(() => PickType(PaymentType.Payment))" />
        <TmStatTile Icon="💵" Number="@ReceiptTotal" Label="Total Received" Tone="teal" />
        <TmStatTile Icon="💸" Number="@PaymentTotal" Label="Total Paid" Tone="yellow" />
        <TmStatTile Icon="⚖" Number="@NetBalance" Label="Net Balance" Tone="purple" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by payment number, entity or reference..." value="@_search" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select @onchange="OnTypeChanged">
                <option value="" selected="@(_typeFilter == null)">All Types</option>
                @foreach (PaymentType t in Enum.GetValues<PaymentType>())
                {
                    <option value="@t" selected="@(_typeFilter == t)">@t</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select @onchange="OnMethodChanged">
                <option value="" selected="@(_methodFilter == null)">All Methods</option>
                @foreach (PaymentMethod m in Enum.GetValues<PaymentMethod>())
                {
                    <option value="@m" selected="@(_methodFilter == m)">@m</option>
                }
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:1000px">
                <thead>
                    <tr>
                        <th>💳 Payment #</th>
                        <th>📅 Date</th>
                        <th>Type</th>
                        <th>👤 Entity</th>
                        <th>Method</th>
                        <th>🔖 Reference</th>
                        <th style="text-align:right">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="7"><TmLoading Message="Loading payments..." /></td></tr>
                    }
                    else if (Paged.Count == 0)
                    {
                        <tr><td colspan="7"><div class="tm-loading">No payments found</div></td></tr>
                    }
                    else
                    {
                        @foreach (var p in Paged)
                        {
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#e0e9ff">💳</span>@p.PaymentNumber</span></td>
                                <td class="tm-dim">@p.PaymentDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="@(p.PaymentType == PaymentType.Receipt ? "tm-pill tm-pill-green" : "tm-pill tm-pill-amber")">
                                        <span class="tm-dot"></span>@p.PaymentType
                                    </span>
                                </td>
                                <td class="tm-branch">@(string.IsNullOrWhiteSpace(p.EntityName) ? "-" : p.EntityName)</td>
                                <td><span class="tm-pill tm-pill-blue"><span class="tm-dot"></span>@p.PaymentMethod</span></td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(p.Reference) ? "-" : p.Reference)</td>
                                <td style="text-align:right" class="tm-money">@p.Amount.ToString("N0")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <TmPager Total="@Filtered.Count" Page="@_page" PageSize="@_pageSize" ItemNoun="payments"
                  PageChanged="@(p => _page = p)" PageSizeChanged="@OnPageSizeChanged" />
    </div>
</div>

@code {
    private List<PaymentDisplayDto> _payments = new();
    private bool _loading = true;
    private string _search = "";
    private PaymentType? _typeFilter;
    private PaymentMethod? _methodFilter;
    private int _page = 1;
    private int _pageSize = 10;

    private int _receiptCount => _payments.Count(p => p.PaymentType == PaymentType.Receipt);
    private int _paymentCount => _payments.Count(p => p.PaymentType != PaymentType.Receipt);
    private string ReceiptTotal => _payments.Where(p => p.PaymentType == PaymentType.Receipt).Sum(p => p.Amount).ToString("N0");
    private string PaymentTotal => _payments.Where(p => p.PaymentType != PaymentType.Receipt).Sum(p => p.Amount).ToString("N0");
    private string NetBalance
    {
        get
        {
            var net = _payments.Where(p => p.PaymentType == PaymentType.Receipt).Sum(p => p.Amount)
                   - _payments.Where(p => p.PaymentType != PaymentType.Receipt).Sum(p => p.Amount);
            return net.ToString("N0");
        }
    }

    private List<PaymentDisplayDto> Filtered => _payments.Where(p =>
        (_typeFilter == null || p.PaymentType == _typeFilter.Value)
        && (_methodFilter == null || p.PaymentMethod == _methodFilter.Value)
        && (string.IsNullOrWhiteSpace(_search)
            || p.PaymentNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || p.EntityName.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || p.Reference.Contains(_search, StringComparison.OrdinalIgnoreCase))).ToList();

    private List<PaymentDisplayDto> Paged => Filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        try
        {
            var data = await DbContext.Payments
                .Include(p => p.Customer)
                .Include(p => p.Supplier)
                .OrderByDescending(p => p.PaymentDate)
                .Take(500)
                .ToListAsync();

            _payments = data.Select(p => new PaymentDisplayDto
            {
                PaymentNumber = p.PaymentNumber,
                PaymentDate = p.PaymentDate,
                PaymentType = p.PaymentType,
                PaymentMethod = p.PaymentMethod,
                Amount = p.Amount,
                Reference = p.Reference ?? "",
                EntityName = p.Customer?.CustomerName ?? p.Supplier?.SupplierName ?? ""
            }).ToList();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<PaymentDialog>("Record Payment", new DialogParameters(),
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
            await Load();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 1;
    }

    private void OnTypeChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _typeFilter = string.IsNullOrEmpty(v) ? null : Enum.Parse<PaymentType>(v);
        _page = 1;
    }

    private void OnMethodChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _methodFilter = string.IsNullOrEmpty(v) ? null : Enum.Parse<PaymentMethod>(v);
        _page = 1;
    }

    private void PickType(PaymentType t)
    {
        _typeFilter = _typeFilter == t ? null : t;
        _page = 1;
    }

    private void ResetFilters()
    {
        _search = "";
        _typeFilter = null;
        _methodFilter = null;
        _page = 1;
    }

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
    }

    private class PaymentDisplayDto
    {
        public string PaymentNumber { get; set; } = "";
        public DateTime PaymentDate { get; set; }
        public PaymentType PaymentType { get; set; }
        public PaymentMethod PaymentMethod { get; set; }
        public decimal Amount { get; set; }
        public string Reference { get; set; } = "";
        public string EntityName { get; set; } = "";
    }
}
