@page "/search"

@rendermode InteractiveServer
@attribute [Authorize]
@using TradeFlow.Web.Components.Pages.Product
@using TradeFlow.Web.Components.Pages.Sales
@using TradeFlow.Web.Components.Pages.Purchasing
@inject ISearchService SearchService
@inject ISnackbar Snackbar

<PageTitle>Global Search - IOMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Global Search</MudText>

<MudTextField @bind-Value="_query" Label="Search..." Placeholder="Search products, orders, customers, suppliers..." Class="mb-4"
              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
              OnAdornmentClick="Search" OnKeyUp="OnSearchKeyUp" Immediate="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />

@if (_hasSearched)
{
    <MudText Typo="Typo.subtitle1" Class="mb-3">@TotalResults result(s) for "@_query"</MudText>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (TotalResults == 0)
    {
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.body2" Style="color:#64748b;">No results found — try a different search.</MudText>
        </MudPaper>
    }
    else
    {
        <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0">
            <MudTabPanel Text="@($"Products ({_results.ProductItems.Count})")">
                @if (_results.ProductItems.Count == 0)
                {
                    <MudText Typo="Typo.body2" Style="color:#64748b;">No matching products.</MudText>
                }
                else
                {
                    <MudTable Items="@_results.ProductItems" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>SKU</MudTh>
                            <MudTh>Category</MudTh>
                            <MudTh>Subcategory</MudTh>
                            <MudTh>Brand</MudTh>
                            <MudTh>Cost</MudTh>
                            <MudTh>Selling</MudTh>
                            <MudTh>Last Rate</MudTh>
                            <MudTh>Stock</MudTh>
                            <MudTh>Avail</MudTh>
                            <MudTh>Warehouses</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name"><strong>@context.Name</strong><br /><small style="color:#64748b;">@context.Barcode</small></MudTd>
                            <MudTd DataLabel="SKU">@context.SKU</MudTd>
                            <MudTd DataLabel="Category">@(context.ParentCategoryName ?? context.SubCategoryName ?? context.CategoryName ?? "—")</MudTd>
                            <MudTd DataLabel="Subcategory">@(context.ParentCategoryName != null ? (context.SubCategoryName ?? "—") : "—")</MudTd>
                            <MudTd DataLabel="Brand">@(context.BrandName ?? "—")</MudTd>
                            <MudTd DataLabel="Cost">@context.CostPrice.ToString("C")</MudTd>
                            <MudTd DataLabel="Selling">@context.SellingPrice.ToString("C")</MudTd>
                            <MudTd DataLabel="Last Rate">@(context.LastSalesRate.HasValue ? context.LastSalesRate.Value.ToString("C") : "—")</MudTd>
                            <MudTd DataLabel="Stock">@context.TotalStock</MudTd>
                            <MudTd DataLabel="Avail">@context.AvailableQuantity</MudTd>
                            <MudTd DataLabel="Warehouses">
                                @if (context.WarehouseStocks == null || context.WarehouseStocks.Count == 0)
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    @foreach (var w in context.WarehouseStocks)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@w.WarehouseName: @w.Quantity</MudChip>
                                    }
                                }
                            </MudTd>
                            <MudTd Style="text-align:right">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => OpenProduct(context.Id))">View</MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>

            <MudTabPanel Text="@($"Customers ({_results.CustomersItems.Count})")">
                @if (_results.CustomersItems.Count == 0)
                {
                    <MudText Typo="Typo.body2" Style="color:#64748b;">No matching customers.</MudText>
                }
                else
                {
                    <MudTable Items="@_results.CustomersItems" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Email</MudTh>
                            <MudTh>Phone</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name"><strong>@context.CustomerName</strong></MudTd>
                            <MudTd DataLabel="Email">@context.CustomerEmail</MudTd>
                            <MudTd DataLabel="Phone">@context.CustomerPhone</MudTd>
                            <MudTd Style="text-align:right">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => OpenCustomer(context.Id))">View</MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>

            <MudTabPanel Text="@($"Suppliers ({_results.SuppliersItems.Count})")">
                @if (_results.SuppliersItems.Count == 0)
                {
                    <MudText Typo="Typo.body2" Style="color:#64748b;">No matching suppliers.</MudText>
                }
                else
                {
                    <MudTable Items="@_results.SuppliersItems" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Email</MudTh>
                            <MudTh>Phone</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name"><strong>@context.SupplierName</strong></MudTd>
                            <MudTd DataLabel="Email">@context.SupplierEmail</MudTd>
                            <MudTd DataLabel="Phone">@context.SupplierPhone</MudTd>
                            <MudTd Style="text-align:right">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => OpenSupplier(context.Id))">View</MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>

            <MudTabPanel Text="@($"Sales Orders ({_results.SalesOrdersItems.Count})")">
                @if (_results.SalesOrdersItems.Count == 0)
                {
                    <MudText Typo="Typo.body2" Style="color:#64748b;">No matching sales orders.</MudText>
                }
                else
                {
                    <MudTable Items="@_results.SalesOrdersItems" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Order #</MudTh>
                            <MudTh>Customer</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Total</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Order #"><strong>@context.OrderNumber</strong></MudTd>
                            <MudTd DataLabel="Customer">@(context.Customer?.CustomerName ?? "—")</MudTd>
                            <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@CommonUtility.GetStatusColor(context.Status)">@context.Status</MudChip></MudTd>
                            <MudTd DataLabel="Total">@context.TotalAmount.ToString("C")</MudTd>
                            <MudTd Style="text-align:right">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => OpenSalesOrder(context.Id))">View</MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>

            <MudTabPanel Text="@($"Purchase Orders ({_results.PurchaseOrdersItems.Count})")">
                @if (_results.PurchaseOrdersItems.Count == 0)
                {
                    <MudText Typo="Typo.body2" Style="color:#64748b;">No matching purchase orders.</MudText>
                }
                else
                {
                    <MudTable Items="@_results.PurchaseOrdersItems" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Order #</MudTh>
                            <MudTh>Supplier</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Total</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Order #"><strong>@context.OrderNumber</strong></MudTd>
                            <MudTd DataLabel="Supplier">@context.SupplierName</MudTd>
                            <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@CommonUtility.GetStatusColor(context.Status)">@context.Status</MudChip></MudTd>
                            <MudTd DataLabel="Total">@context.TotalAmount.ToString("C")</MudTd>
                            <MudTd Style="text-align:right">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => OpenPurchaseOrder(context.Id))">View</MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>
        </MudTabs>
    }
}

<ProductViewPanel @ref="_productViewPanel" />
<CustomerViewPanel @ref="_customerViewPanel" />
<SupplierViewPanel @ref="_supplierViewPanel" />
<SalesOrderViewPanel @ref="_salesOrderViewPanel" />
<PurchaseOrderViewPanel @ref="_purchaseOrderViewPanel" />

@code {
    private const int MaxResults = 500;

    private string _query = "";
    private GlobalSearchResultDto _results = new();
    private bool _loading;
    private bool _hasSearched;
    private int _activeTab;

    private ProductViewPanel? _productViewPanel;
    private CustomerViewPanel? _customerViewPanel;
    private SupplierViewPanel? _supplierViewPanel;
    private SalesOrderViewPanel? _salesOrderViewPanel;
    private PurchaseOrderViewPanel? _purchaseOrderViewPanel;

    private async Task OpenProduct(Guid id)
    {
        if (_productViewPanel != null)
            await _productViewPanel.OpenAsync(id);
    }

    private async Task OpenCustomer(Guid id)
    {
        if (_customerViewPanel != null)
            await _customerViewPanel.OpenAsync(id);
    }

    private async Task OpenSupplier(Guid id)
    {
        if (_supplierViewPanel != null)
            await _supplierViewPanel.OpenAsync(id);
    }

    private async Task OpenSalesOrder(Guid id)
    {
        if (_salesOrderViewPanel != null)
            await _salesOrderViewPanel.OpenAsync(id);
    }

    private async Task OpenPurchaseOrder(Guid id)
    {
        if (_purchaseOrderViewPanel != null)
            await _purchaseOrderViewPanel.OpenAsync(id);
    }

    private int TotalResults =>
        _results.ProductItems.Count +
        _results.CustomersItems.Count +
        _results.SuppliersItems.Count +
        _results.SalesOrdersItems.Count +
        _results.PurchaseOrdersItems.Count;

    private int FirstTabWithResults()
    {
        if (_results.ProductItems.Count > 0) return 0;
        if (_results.CustomersItems.Count > 0) return 1;
        if (_results.SuppliersItems.Count > 0) return 2;
        if (_results.SalesOrdersItems.Count > 0) return 3;
        return 4;
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Search();
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(_query)) return;
        _loading = true;
        _hasSearched = true;
        try
        {
            _results = await SearchService.Search(_query, MaxResults);
            _activeTab = FirstTabWithResults();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }
}