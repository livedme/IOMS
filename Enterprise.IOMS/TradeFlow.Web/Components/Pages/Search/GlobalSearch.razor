@page "/search"

@rendermode InteractiveServer
@attribute [Authorize]
@inject ISearchService SearchService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Global Search - IOMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Global Search</MudText>

<MudGrid Class="mb-4">
    <MudItem xs="12" md="8">
        <MudTextField @bind-Value="_query" Label="Search..." Placeholder="Search products, orders, customers, invoices..."
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnAdornmentClick="Search" OnKeyDown="OnKeyDown" Immediate="true" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudSelect Value="_entityFilter" ValueChanged="@((string v) => OnEntityFilterChanged(v))" Label="Filter by Entity" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem Value="@("")">All</MudSelectItem>
            <MudSelectItem Value="@("Product")">Products</MudSelectItem>
            <MudSelectItem Value="@("Customer")">Customers</MudSelectItem>
            <MudSelectItem Value="@("Supplier")">Suppliers</MudSelectItem>
            <MudSelectItem Value="@("Sales Order")">Sales Orders</MudSelectItem>
            <MudSelectItem Value="@("Purchase Order")">Purchase Orders</MudSelectItem>
        </MudSelect>
    </MudItem>
</MudGrid>

@if (_hasSearched)
{
    <MudText Typo="Typo.subtitle1" Class="mb-3">@FilteredResults.Count result(s) for "@_query"</MudText>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (FilteredResults.Count == 0)
    {
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.body2" Style="color:#64748b;">No results found — try a different search or filter.</MudText>
        </MudPaper>
    }
    else
    {
        @foreach (var group in GroupedResults)
        {
            <MudPaper Elevation="2" Class="pa-4 mb-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <MudChip T="string" Size="Size.Small" Color="@CommonUtility.GetTypeColor(group.Type)">@group.Type</MudChip>
                        <MudText Typo="Typo.subtitle2">@group.Items.Count item(s)</MudText>
                    </div>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward"
                               OnClick="@(() => OpenAll(group.Type))">View all</MudButton>
                </div>
                <MudTable Items="@group.Items.Take(PreviewSize)" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Name/Number</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><strong>@context.Title</strong></MudTd>
                        <MudTd>@context.SubTitle</MudTd>
                        <MudTd Style="text-align:right">
                            @if (!string.IsNullOrEmpty(context.Url))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="() => Navigation.NavigateTo(context.Url)">View</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }
    }
}

@* ─── All-items right slider ─── *@
<TmSlideDrawer @bind-Open="_drawerOpen" Title="@_drawerTitle" Width="900px">
    @if (_drawerItems.Count == 0)
    {
        <MudText Typo="Typo.body2" Style="color:#64748b;">No items.</MudText>
    }
    else
    {
        <MudTable Items="@_drawerItems" Dense="true" Hover="true" Elevation="0">
            <HeaderContent>
                <MudTh>Type</MudTh>
                <MudTh>Name/Number</MudTh>
                <MudTh>Description</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@CommonUtility.GetTypeColor(context.EntityType)">@context.EntityType</MudChip></MudTd>
                <MudTd><strong>@context.Title</strong></MudTd>
                <MudTd>@context.SubTitle</MudTd>
                <MudTd Style="text-align:right">
                    @if (!string.IsNullOrEmpty(context.Url))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="() => Navigation.NavigateTo(context.Url)">View</MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</TmSlideDrawer>

@code {
    private const int PreviewSize = 5;

    private static readonly string[] GroupOrder =
        ["Product", "Customer", "Supplier", "Sales Order", "Purchase Order"];

    private record ResultGroup(string Type, List<GlobalSearchResultDto> Items);

    private string _query = "";
    private string _entityFilter = "";
    private List<GlobalSearchResultDto> _results = new();
    private bool _loading;
    private bool _hasSearched;

    // ─── All-items slider state ───
    private bool _drawerOpen;
    private string _drawerTitle = "";
    private List<GlobalSearchResultDto> _drawerItems = new();

    private List<GlobalSearchResultDto> FilteredResults =>
        string.IsNullOrWhiteSpace(_entityFilter)
            ? _results
            : _results.Where(r => r.EntityType == _entityFilter).ToList();

    private List<ResultGroup> GroupedResults =>
        FilteredResults
            .GroupBy(r => r.EntityType)
            .OrderBy(g => Array.IndexOf(GroupOrder, g.Key) is var i && i >= 0 ? i : int.MaxValue)
            .Select(g => new ResultGroup(g.Key, g.ToList()))
            .ToList();

    private void OpenAll(string entityType)
    {
        _drawerItems = FilteredResults.Where(r => r.EntityType == entityType).ToList();
        _drawerTitle = $"{entityType} ({_drawerItems.Count})";
        _drawerOpen = true;
    }

    /// <summary>
    /// Each entity in "Filter by Entity" gets its own right-slider view: picking one
    /// opens the slider with every match of that entity. "All" closes the slider
    /// and shows the grouped page instead.
    /// </summary>
    private void OnEntityFilterChanged(string value)
    {
        _entityFilter = value ?? "";
        if (string.IsNullOrWhiteSpace(_entityFilter) || !_hasSearched)
        {
            _drawerOpen = false;
            return;
        }
        if (FilteredResults.Count > 0)
            OpenAll(_entityFilter);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Search();
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(_query)) return;
        _loading = true;
        _hasSearched = true;
        _drawerOpen = false;
        try
        {
            _results = await SearchService.Search(_query);
            // A pinned entity filter means the entity slider view: open it on its matches.
            if (!string.IsNullOrWhiteSpace(_entityFilter) && FilteredResults.Count > 0)
                OpenAll(_entityFilter);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _loading = false;
    }
}
