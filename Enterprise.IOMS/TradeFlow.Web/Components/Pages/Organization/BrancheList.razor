@page "/orgs/branches"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject IBranchService BranchService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Branches - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="🏢" Title="Branches" Subtitle="Manage your outlet locations, codes and branch details">
        <Actions>
            <button class="tm-reset" @onclick="Refresh">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="OpenCreate">+ New Branch</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="🏢" Number="@TotalCountText" Label="Branches" Tone="blue" OnClick="@(() => FilterByStatus(null))" />
        <TmStatTile Icon="✔" Number="@ActiveCountText" Label="Active" Tone="green" OnClick="@(() => FilterByStatus(true))" />
        <TmStatTile Icon="⏸" Number="@InactiveCountText" Label="Inactive" Tone="red" OnClick="@(() => FilterByStatus(false))" />
        <TmStatTile Icon="📍" Number="@WithLocationCountText" Label="With Location" Tone="purple" />
        <TmStatTile Icon="🏷" Number="@UniqueCodeCountText" Label="Unique Codes" Tone="teal" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by name, code or location..." value="@pagedRequest.SearchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select value="@StatusValue" @onchange="OnStatusChanged">
                <option value="">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        @if (_loading)
        {
            <div style="position:absolute; inset:0; background:rgba(255,255,255,0.62); backdrop-filter:blur(1px); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2; border-radius:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Style="margin-top:8px; color:#334155; font-weight:600;">Loading branches...</MudText>
            </div>
        }
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:900px">
                <thead>
                    <tr>
                        <th @onclick="@(() => SortBy(Col.Name))">🏢 Branch @SortIcon(Col.Name)</th>
                        <th @onclick="@(() => SortBy(Col.Code))">🏷 Code @SortIcon(Col.Code)</th>
                        <th @onclick="@(() => SortBy(Col.Location))">📍 Location @SortIcon(Col.Location)</th>
                        <th @onclick="@(() => SortBy(Col.Address))">🏠 Address @SortIcon(Col.Address)</th>
                        <th @onclick="@(() => SortBy(Col.IsActive))">Status @SortIcon(Col.IsActive)</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_hasLoadedOnce && _loading)
                    {
                        <tr><td colspan="6" style="text-align:center; padding:40px; color:#94a3b8;">Loading branches...</td></tr>
                    }
                    else if (pagedResultNew.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" style="text-align:center; padding:40px;">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#94a3b8;" Class="mb-2" />
                                <div style="color:#64748b;">No branches found — try a different search or filter</div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="ResetFilters">Clear filters</MudButton>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in pagedResultNew.Items)
                        {
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#ede9fe">🏢</span>@b.Name</span></td>
                                <td><span class="tm-pill tm-pill-purple"><span class="tm-dot"></span>@(string.IsNullOrWhiteSpace(b.Code) ? "-" : b.Code)</span></td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(b.Location) ? "-" : b.Location)</td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(b.Address) ? "-" : b.Address)</td>
                                <td>
                                    <span class="@(b.IsActive ? "tm-pill tm-pill-green" : "tm-pill tm-pill-red")">
                                        <span class="tm-dot"></span>@(b.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-edit" title="Edit" @onclick="() => OpenEdit(b)">✎</button>
                                        <button class="tm-act tm-act-del" title="Delete" @onclick="() => Delete(b.Id)">🗑</button>
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div style="opacity:@(_loading ? "0.55" : "1"); pointer-events:@(_loading ? "none" : "auto");">
            <TmPager CurrentPage="pagedResultNew.CurrentPage"
                     PageSize="pagedResultNew.PageSize"
                     TotalCount="pagedResultNew.TotalCount"
                     TotalPages="pagedResultNew.TotalPages"
                     ItemLabel="Branches"
                     OnGoToPage="GoToPage"
                     OnPrev="GoPrevPage"
                     OnNext="GoNextPage"
                     OnPageSizeChanged="OnPageSizeChanged" />
        </div>
    </div>
</div>

@code {
    private static class Col
    {
        public const string Name = "Name";
        public const string Code = "Code";
        public const string Location = "Location";
        public const string Address = "Address";
        public const string IsActive = "IsActive";
    }

    // ─── List state ───
    private PagedResultNew<BranchDto> pagedResultNew = new();
    private BranchPagedRequest pagedRequest = new()
    {
        SortColumn = Col.Name,
        SortAscending = true
    };

    private BranchDto _branchTemplate = new BranchDto(Guid.Empty, "", "", null, null, true);
    private bool _loading = true;
    private bool _hasLoadedOnce;
    private bool _loadRunning;
    private bool _loadQueued;
    private CancellationTokenSource? _debounceCts;

    private string StatusValue => pagedRequest.IsActive switch
    {
        true => "active",
        false => "inactive",
        _ => ""
    };

    protected override async Task OnInitializedAsync() => await LoadBranches();

    private async Task Refresh() => await LoadBranches();

    /// <summary>
    /// Single-flight loader. The page and the services share one scoped DbContext, so two
    /// overlapping queries would throw "A second operation was started on this context
    /// instance". Callers that arrive mid-flight set a flag instead of starting a parallel
    /// query, and the running load then re-runs once with the newest filter state.
    /// </summary>
    private async Task LoadBranches()
    {
        if (_loadRunning)
        {
            _loadQueued = true;
            return;
        }

        _loadRunning = true;
        try
        {
            do
            {
                _loadQueued = false;
                await LoadBranchesCore();
            }
            while (_loadQueued);
        }
        finally { _loadRunning = false; }
    }

    private async Task LoadBranchesCore()
    {
        _loading = true;
        try
        {
            pagedResultNew = await BranchService.GetBranchesPagedAsync(pagedRequest);
            _hasLoadedOnce = true;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    // ─── Stats / sorting helpers ───
    private string TotalCountText => Stat("TotalCount");
    private string ActiveCountText => Stat("ActiveCount");
    private string InactiveCountText => Stat("InactiveCount");
    private string WithLocationCountText => Stat("WithLocationCount");
    private string UniqueCodeCountText => Stat("UniqueCodeCount");

    private string Stat(string key) =>
        pagedResultNew.Stats != null && pagedResultNew.Stats.TryGetValue(key, out var v) ? v.ToString() : "0";

    private void SortBy(string column)
    {
        if (pagedRequest.SortColumn == column)
            pagedRequest.SortAscending = !pagedRequest.SortAscending;
        else
        {
            pagedRequest.SortColumn = column;
            pagedRequest.SortAscending = true;
        }
        pagedRequest.CurrentPage = 0;
    }

    private string SortIcon(string column)
    {
        if (pagedRequest.SortColumn != column) return "";
        return pagedRequest.SortAscending ? "▲" : "▼";
    }


    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<BrancheDialog>
        {
            { x => x.Branch, _branchTemplate }
        };

        var dialog = await DialogService.ShowAsync<BrancheDialog>("New Branch", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = false, CloseButton = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateBranchDto dto)
        {
            try
            {
                await BranchService.CreateBranch(dto);
                Snackbar.Add("Branch created successfully", Severity.Success);
                await LoadBranches();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task OpenEdit(BranchDto item)
    {
        var entity = await BranchService.GetBranchById(item.Id);
        if (entity == null) return;

        var dto = new BranchDto(entity.Id, entity.Name, entity.Code, entity.Location, entity.Address, entity.IsActive);

        var parameters = new DialogParameters<BrancheDialog> { { x => x.Branch, dto } };
        var dialog = await DialogService.ShowAsync<BrancheDialog>("Edit Branch", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is CreateBranchDto updated)
        {
            await BranchService.UpdateBranch(entity.Id, updated);
            Snackbar.Add("Branch updated", Severity.Success);
            await LoadBranches();
        }
    }

    private async Task Delete(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Confirm", "Delete this branch?", "Delete", "Cancel");
        if (confirm == true)
        {
            var entity = await BranchService.GetBranchById(id);
            if (entity != null) { await BranchService.DeleteBranch(id); await LoadBranches(); }
        }
    }

    // ─── Filters ───
    private void OnSearchInput(ChangeEventArgs e)
    {
        pagedRequest.SearchTerm = e.Value?.ToString() ?? "";
        pagedRequest.CurrentPage = 0;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(async () =>
                {
                    await LoadBranches();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        pagedRequest.IsActive = e.Value?.ToString() switch
        {
            "active" => true,
            "inactive" => false,
            _ => null
        };
        pagedRequest.CurrentPage = 0;
        await LoadBranches();
    }

    private async Task FilterByStatus(bool? isActive)
    {
        pagedRequest.IsActive = pagedRequest.IsActive == isActive ? null : isActive;
        pagedRequest.CurrentPage = 0;
        await LoadBranches();
    }

    private async Task ResetFilters()
    {
        pagedRequest.SearchTerm = "";
        pagedRequest.IsActive = null;
        pagedRequest.CurrentPage = 0;
        await LoadBranches();
    }

    // ─── Paging (zero-based, matches TmPager) ───
    private async Task GoToPage(int page)
    {
        pagedRequest.CurrentPage = Math.Clamp(page, 0, Math.Max(0, pagedResultNew.TotalPages - 1));
        await LoadBranches();
    }

    private async Task GoPrevPage()
    {
        if (pagedRequest.CurrentPage > 0)
        {
            pagedRequest.CurrentPage--;
            await LoadBranches();
        }
    }

    private async Task GoNextPage()
    {
        if (pagedRequest.CurrentPage < pagedResultNew.TotalPages - 1)
        {
            pagedRequest.CurrentPage++;
            await LoadBranches();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sz))
        {
            pagedRequest.PageSize = Math.Clamp(sz, 1, 100);
            pagedRequest.CurrentPage = 0;
            await LoadBranches();
        }
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
