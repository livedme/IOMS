@page "/suppliers"
@rendermode InteractiveServer
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ISupplierService SupplierService

<PageTitle>Suppliers - IOMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Suppliers</MudText>

<MudPaper Elevation="2" Class="pa-4">
    <MudGrid>
        <MudItem xs="12" sm="8">
            <MudTextField @bind-Value="_searchString" Placeholder="Search suppliers..." Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                          DebounceInterval="300" OnDebounceIntervalElapsed="LoadData" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/>
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreate">New Supplier</MudButton>
        </MudItem>
    </MudGrid>

    <MudTable Items="@_items" Dense="true" Hover="true" Striped="true" Loading="@_loading" Class="mt-4" Elevation="0">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Phone</MudTh>
            <MudTh>Contact Person</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.SupplierName</MudTd>
            <MudTd>@context.SupplierEmail</MudTd>
            <MudTd>@context.SupplierPhone</MudTd>
            <MudTd>
@context.ContactPersonName, 
                @context.ContactPersonEmail,
                @context.ContactPersonPhone

</MudTd>            
            <MudTd>
                <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Default)" Size="Size.Small">
                    @(context.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => OpenEdit(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => Delete(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private List<SupplierDto> _items = new();
    private string _searchString = "";
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        _loading = true;
        var query =await SupplierService.GetSuppliersAsync(search: _searchString);      
        var data=query.Items.OrderBy(s => s.SupplierName).Take(100).ToList();
        _items = data.Select(s => new SupplierDto()
            {
                Id = s.Id,
                SupplierName = s.SupplierName,
                SupplierEmail = s.SupplierEmail,
                SupplierPhone = s.SupplierPhone,
                ContactPersonName = s.ContactPersonName,
                ContactPersonEmail = s.ContactPersonEmail,
                ContactPersonPhone = s.ContactPersonPhone,
                Address = s.Address,
                City = s.City,
                Zila = s.Zila,
                State = s.State,
                Country = s.Country,
                PostalCode = s.PostalCode,
                DefaultCurrencyId = s.DefaultCurrencyId,
                PaymentTerms = s.PaymentTerms,
                LeadTimeDays = s.LeadTimeDays,
                Rating = s.Rating,
                IsActive = s.IsActive
            }).ToList();

        _loading = false;
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<SupplierDialog> { { x => x.Supplier, new SupplierDto() } };
        var dialog = await DialogService.ShowAsync<SupplierDialog>("New Supplier", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is SupplierDto dto)
        {
            var model = new IOMS.Domain.Entities.Supplier
                {
                    SupplierName = dto.SupplierName,
                    SupplierEmail = dto.SupplierEmail,
                    SupplierPhone = dto.SupplierPhone,
                    ContactPersonName = dto.ContactPersonName,
                    ContactPersonEmail = dto.ContactPersonEmail,
                    ContactPersonPhone = dto.ContactPersonPhone,
                    Address = dto.Address,
                    City = dto.City,
                    Zila = dto.Zila,
                    State = dto.State,
                    Country = dto.Country,
                    PostalCode = dto.PostalCode,
                    PaymentTerms = dto.PaymentTerms,
                    LeadTimeDays = dto.LeadTimeDays
                };

            await SupplierService.CreateSupplierAsync(dto);
            Snackbar.Add("Supplier created", Severity.Success);
            await LoadData();
        }
    }

    private async Task OpenEdit(SupplierDto entity)
    {
        if (entity == null) return;

        var parameters = new DialogParameters<SupplierDialog> { { x => x.Supplier, entity } };
        var dialog = await DialogService.ShowAsync<SupplierDialog>("Edit Supplier", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is SupplierDto updated)
        {
            // entity.SupplierName = updated.SupplierName; entity.SupplierEmail = updated.SupplierEmail; entity.SupplierPhone = updated.SupplierPhone;
            // entity.Address = updated.Address; entity.City = updated.City; entity.State = updated.State;
            //  entity.Country = updated.Country; entity.PostalCode = updated.PostalCode;
            //  entity.DefaultCurrencyId = updated.DefaultCurrencyId; entity.PaymentTerms = updated.PaymentTerms; entity.LeadTimeDays = updated.LeadTimeDays;
            await SupplierService.UpdateSupplierAsync(updated.Id, updated);
            //            await DbContext.SaveChangesAsync();
            Snackbar.Add("Supplier updated", Severity.Success);
            await LoadData();
        }
    }

    private async Task Delete(SupplierDto supplier)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Confirm", "Delete this supplier?", "Delete", "Cancel");
        if (confirm == true)
        {
            await SupplierService.DeleteSupplierAsync(supplier.Id);
            Snackbar.Add($" Supplier {supplier.SupplierName} deleted", Severity.Warning);
            await LoadData(); 
        }
    }
}
