@page "/Purchasing/suppliers"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ISupplierService SupplierService

<PageTitle>Suppliers - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="🏭" Title="Suppliers" Subtitle="Manage vendor contacts, payment terms and lead times">
        <Actions>
            <button class="tm-reset" @onclick="Refresh">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="OpenCreate">+ New Supplier</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="🏭" Number="@TotalCountText" Label="Suppliers" Tone="blue" OnClick="@(() => FilterByStatus(null))" />
        <TmStatTile Icon="✔" Number="@ActiveCountText" Label="Active" Tone="green" OnClick="@(() => FilterByStatus(true))" />
        <TmStatTile Icon="⏸" Number="@InactiveCountText" Label="Inactive" Tone="red" OnClick="@(() => FilterByStatus(false))" />
        <TmStatTile Icon="📧" Number="@WithEmailCountText" Label="With Email" Tone="purple" />
        <TmStatTile Icon="⏱" Number="@AvgLeadTimeText" Label="Avg Lead Time" Tone="yellow" />
        <TmStatTile Icon="⭐" Number="@AvgRatingText" Label="Avg Rating" Tone="teal" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by supplier, contact, email or phone..." value="@pagedRequest.SearchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select value="@StatusValue" @onchange="OnStatusChanged">
                <option value="">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.City ?? "")" @onchange="OnCityChanged">
                <option value="">All Cities</option>
                @foreach (var c in Cities)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        @if (_loading)
        {
            <div style="position:absolute; inset:0; background:rgba(255,255,255,0.62); backdrop-filter:blur(1px); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2; border-radius:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Style="margin-top:8px; color:#334155; font-weight:600;">Loading suppliers...</MudText>
            </div>
        }
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:1050px">
                <thead>
                    <tr>
                        <th @onclick="@(() => SortBy(Col.SupplierName))">🏭 Supplier @SortIcon(Col.SupplierName)</th>
                        <th @onclick="@(() => SortBy(Col.Email))">📧 Email @SortIcon(Col.Email)</th>
                        <th @onclick="@(() => SortBy(Col.Phone))">📞 Phone @SortIcon(Col.Phone)</th>
                        <th @onclick="@(() => SortBy(Col.ContactPerson))">👤 Contact Person @SortIcon(Col.ContactPerson)</th>
                        <th @onclick="@(() => SortBy(Col.City))">📍 City @SortIcon(Col.City)</th>
                        <th @onclick="@(() => SortBy(Col.PaymentTerms))">💳 Terms @SortIcon(Col.PaymentTerms)</th>
                        <th @onclick="@(() => SortBy(Col.IsActive))">Status @SortIcon(Col.IsActive)</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_hasLoadedOnce && _loading)
                    {
                        <tr><td colspan="8" style="text-align:center; padding:40px; color:#94a3b8;">Loading suppliers...</td></tr>
                    }
                    else if (pagedResultNew.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="8" style="text-align:center; padding:40px;">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#94a3b8;" Class="mb-2" />
                                <div style="color:#64748b;">No suppliers found — try a different search or filter</div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="ResetFilters">Clear filters</MudButton>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var s in pagedResultNew.Items)
                        {
                            <tr>
                                <td>
                                    <span class="tm-veh">
                                        <span class="tm-veh-ico" style="background:#fef3c7">@GetInitials(s.SupplierName)</span>
                                        <span>
                                            @s.SupplierName
                                            @if (!string.IsNullOrWhiteSpace(s.Country))
                                            {
                                                <span class="tm-dim" style="display:block;font-weight:400;font-size:11.5px">@s.Country</span>
                                            }
                                        </span>
                                    </span>
                                </td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(s.SupplierEmail) ? "-" : s.SupplierEmail)</td>
                                <td class="tm-num">@(string.IsNullOrWhiteSpace(s.SupplierPhone) ? "-" : s.SupplierPhone)</td>
                                <td class="tm-branch">
                                    @(string.IsNullOrWhiteSpace(s.ContactPersonName) ? "-" : s.ContactPersonName)
                                    @if (!string.IsNullOrWhiteSpace(s.ContactPersonEmail))
                                    {
                                        <span class="tm-dim" style="display:block;font-size:11.5px">@s.ContactPersonEmail</span>
                                    }
                                </td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(s.City) ? "-" : s.City)</td>
                                <td>
                                    <span class="tm-pill tm-pill-blue"><span class="tm-dot"></span>@(string.IsNullOrWhiteSpace(s.PaymentTerms) ? "-" : s.PaymentTerms)</span>
                                </td>
                                <td>
                                    <span class="@(s.IsActive ? "tm-pill tm-pill-green" : "tm-pill tm-pill-red")">
                                        <span class="tm-dot"></span>@(s.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-view" title="View" @onclick="() => ViewSupplier(s.Id)">👁</button>
                                        <button class="tm-act tm-act-edit" title="Edit" @onclick="() => OpenEdit(s)">✎</button>
                                        <button class="tm-act tm-act-del" title="Delete" @onclick="() => Delete(s)">🗑</button>
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div style="opacity:@(_loading ? "0.55" : "1"); pointer-events:@(_loading ? "none" : "auto");">
            <TmPager CurrentPage="pagedResultNew.CurrentPage"
                     PageSize="pagedResultNew.PageSize"
                     TotalCount="pagedResultNew.TotalCount"
                     TotalPages="pagedResultNew.TotalPages"
                     ItemLabel="Suppliers"
                     OnGoToPage="GoToPage"
                     OnPrev="GoPrevPage"
                     OnNext="GoNextPage"
                     OnPageSizeChanged="OnPageSizeChanged" />
        </div>
    </div>
</div>

@* ─── Supplier Detail Slider Panel (consistent with Global Search) ─── *@
<SupplierViewPanel @ref="_supplierViewPanel" />

@code {
    private static class Col
    {
        public const string SupplierName = "SupplierName";
        public const string Email = "Email";
        public const string Phone = "Phone";
        public const string ContactPerson = "ContactPerson";
        public const string City = "City";
        public const string PaymentTerms = "PaymentTerms";
        public const string IsActive = "IsActive";
    }

    // ─── List state ───
    private PagedResultNew<SupplierDto> pagedResultNew = new();
    private SupplierPagedRequest pagedRequest = new()
    {
        SortColumn = Col.SupplierName,
        SortAscending = true
    };

    private List<string> _cities = new();
    private bool _loading = true;
    private bool _hasLoadedOnce;
    private bool _loadRunning;
    private bool _loadQueued;
    private CancellationTokenSource? _debounceCts;

    private SupplierViewPanel? _supplierViewPanel;

    private List<string> Cities => _cities;
    private string StatusValue => pagedRequest.IsActive switch
    {
        true => "active",
        false => "inactive",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        try { _cities = await SupplierService.GetSupplierCitiesAsync(); } catch { }
        await LoadData();
    }

    private async Task Refresh() => await LoadData();

    /// <summary>
    /// Single-flight loader. The page and the services share one scoped DbContext, so two
    /// overlapping queries would throw "A second operation was started on this context
    /// instance". Callers that arrive mid-flight set a flag instead of starting a parallel
    /// query, and the running load then re-runs once with the newest filter state.
    /// </summary>
    private async Task LoadData()
    {
        if (_loadRunning)
        {
            _loadQueued = true;
            return;
        }

        _loadRunning = true;
        try
        {
            do
            {
                _loadQueued = false;
                await LoadDataCore();
            }
            while (_loadQueued);
        }
        finally { _loadRunning = false; }
    }

    private async Task LoadDataCore()
    {
        _loading = true;
        try
        {
            pagedResultNew = await SupplierService.GetSuppliersAsync(pagedRequest);
            _hasLoadedOnce = true;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    // ─── Stats / sorting helpers ───
    private string TotalCountText => Stat("TotalCount");
    private string ActiveCountText => Stat("ActiveCount");
    private string InactiveCountText => Stat("InactiveCount");
    private string WithEmailCountText => Stat("WithEmailCount");
    private string AvgLeadTimeText => Stat("AverageLeadTime");
    private string AvgRatingText =>
        int.TryParse(Stat("AverageRating"), out var v) ? (v / 10m).ToString("0.0") : "0.0";

    private string Stat(string key) =>
        pagedResultNew.Stats != null && pagedResultNew.Stats.TryGetValue(key, out var v) ? v.ToString() : "0";

    private async Task SortBy(string column)
    {
        if (pagedRequest.SortColumn == column)
            pagedRequest.SortAscending = !pagedRequest.SortAscending;
        else
        {
            pagedRequest.SortColumn = column;
            pagedRequest.SortAscending = true;
        }
        pagedRequest.CurrentPage = 0;
        await LoadData();
    }

    private string SortIcon(string column)
    {
        if (pagedRequest.SortColumn != column) return "";
        return pagedRequest.SortAscending ? "▲" : "▼";
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<SupplierDialog> { { x => x.Supplier, new SupplierDto() } };
        var dialog = await DialogService.ShowAsync<SupplierDialog>("New Supplier", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is SupplierDto dto)
        {
            await SupplierService.CreateSupplierAsync(dto);
            Snackbar.Add("Supplier created", Severity.Success);
            await LoadData();
        }
    }

    private async Task OpenEdit(SupplierDto entity)
    {
        if (entity == null) return;

        var parameters = new DialogParameters<SupplierDialog> { { x => x.Supplier, entity } };
        var dialog = await DialogService.ShowAsync<SupplierDialog>("Edit Supplier", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is SupplierDto updated)
        {
            await SupplierService.UpdateSupplierAsync(updated.Id, updated);
            Snackbar.Add("Supplier updated", Severity.Success);
            await LoadData();
        }
    }

    private async Task Delete(SupplierDto supplier)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Confirm", "Delete this supplier?", "Delete", "Cancel");
        if (confirm == true)
        {
            await SupplierService.DeleteSupplierAsync(supplier.Id);
            Snackbar.Add($" Supplier {supplier.SupplierName} deleted", Severity.Warning);
            await LoadData();
        }
    }

    private async Task ViewSupplier(Guid id)
    {
        if (_supplierViewPanel != null)
            await _supplierViewPanel.OpenAsync(id);
    }

    private static string GetStatusPill(PurchaseOrderStatus s) => s switch
    {
        PurchaseOrderStatus.Draft => "tm-pill tm-pill-purple",
        PurchaseOrderStatus.Submitted => "tm-pill tm-pill-blue",
        PurchaseOrderStatus.Approved => "tm-pill tm-pill-green",
        PurchaseOrderStatus.PartiallyReceived => "tm-pill tm-pill-amber",
        PurchaseOrderStatus.Received => "tm-pill tm-pill-teal",
        PurchaseOrderStatus.Closed => "tm-pill tm-pill-blue",
        PurchaseOrderStatus.Cancelled => "tm-pill tm-pill-red",
        _ => "tm-pill tm-pill-blue"
    };

    // ─── Filters ───
    private void OnSearchInput(ChangeEventArgs e)
    {
        pagedRequest.SearchTerm = e.Value?.ToString() ?? "";
        pagedRequest.CurrentPage = 0;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(async () =>
                {
                    await LoadData();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        pagedRequest.IsActive = e.Value?.ToString() switch
        {
            "active" => true,
            "inactive" => false,
            _ => null
        };
        pagedRequest.CurrentPage = 0;
        await LoadData();
    }

    private async Task OnCityChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        pagedRequest.City = string.IsNullOrEmpty(v) ? null : v;
        pagedRequest.CurrentPage = 0;
        await LoadData();
    }

    private async Task FilterByStatus(bool? isActive)
    {
        pagedRequest.IsActive = pagedRequest.IsActive == isActive ? null : isActive;
        pagedRequest.CurrentPage = 0;
        await LoadData();
    }

    private async Task ResetFilters()
    {
        pagedRequest.SearchTerm = "";
        pagedRequest.IsActive = null;
        pagedRequest.City = null;
        pagedRequest.CurrentPage = 0;
        await LoadData();
    }

    // ─── Paging (zero-based, matches TmPager) ───
    private async Task GoToPage(int page)
    {
        pagedRequest.CurrentPage = Math.Clamp(page, 0, Math.Max(0, pagedResultNew.TotalPages - 1));
        await LoadData();
    }

    private async Task GoPrevPage()
    {
        if (pagedRequest.CurrentPage > 0)
        {
            pagedRequest.CurrentPage--;
            await LoadData();
        }
    }

    private async Task GoNextPage()
    {
        if (pagedRequest.CurrentPage < pagedResultNew.TotalPages - 1)
        {
            pagedRequest.CurrentPage++;
            await LoadData();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sz))
        {
            pagedRequest.PageSize = Math.Clamp(sz, 1, 100);
            pagedRequest.CurrentPage = 0;
            await LoadData();
        }
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
