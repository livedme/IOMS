@page "/orders/purchase-returns"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject IPurchaseReturnService PurchaseReturnService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Purchase Returns - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="↩️" Title="Purchase Returns" Subtitle="Send goods back to suppliers and track refunds">
        <Actions>
            <button class="tm-reset" @onclick="Refresh">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="OpenCreate">+ New Return</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="↩️" Number="@TotalCountText" Label="Returns" Tone="blue" OnClick="@(() => FilterByStatus(null))" />
        <TmStatTile Icon="📝" Number="@DraftCountText" Label="Draft" Tone="purple" OnClick="@(() => FilterByStatus(PurchaseReturnStatus.Draft))" />
        <TmStatTile Icon="✔" Number="@ApprovedCountText" Label="Approved" Tone="yellow" OnClick="@(() => FilterByStatus(PurchaseReturnStatus.Approved))" />
        <TmStatTile Icon="🚚" Number="@ShippedCountText" Label="Shipped" Tone="teal" OnClick="@(() => FilterByStatus(PurchaseReturnStatus.Shipped))" />
        <TmStatTile Icon="✅" Number="@CompletedCountText" Label="Completed" Tone="green" OnClick="@(() => FilterByStatus(PurchaseReturnStatus.Completed))" />
        <TmStatTile Icon="💰" Number="@TotalReturnedText" Label="Total Returned" Tone="red" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by return number, PO number or reason..." value="@pagedRequest.SearchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.Status?.ToString() ?? "")" @onchange="OnStatusChanged">
                <option value="">All Status</option>
                @foreach (var s in ReturnStatuses)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <input type="date" value="@FormatDate(pagedRequest.From)" @onchange="OnFromChanged" title="From date" />
        </div>
        <div class="tm-select">
            <input type="date" value="@FormatDate(pagedRequest.To)" @onchange="OnToChanged" title="To date" />
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        @if (_loading)
        {
            <div style="position:absolute; inset:0; background:rgba(255,255,255,0.62); backdrop-filter:blur(1px); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2; border-radius:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Style="margin-top:8px; color:#334155; font-weight:600;">Loading purchase returns...</MudText>
            </div>
        }
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:900px">
                <thead>
                    <tr>
                        <th @onclick="@(() => SortBy(Col.ReturnNumber))">↩️ Return # @SortIcon(Col.ReturnNumber)</th>
                        <th @onclick="@(() => SortBy(Col.PurchaseOrderNumber))">🧾 PO # @SortIcon(Col.PurchaseOrderNumber)</th>
                        <th @onclick="@(() => SortBy(Col.Status))">Status @SortIcon(Col.Status)</th>
                        <th style="text-align:right" @onclick="@(() => SortBy(Col.TotalAmount))">Total @SortIcon(Col.TotalAmount)</th>
                        <th @onclick="@(() => SortBy(Col.Reason))">Reason @SortIcon(Col.Reason)</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_hasLoadedOnce && _loading)
                    {
                        <tr><td colspan="6" style="text-align:center; padding:40px; color:#94a3b8;">Loading purchase returns...</td></tr>
                    }
                    else if (pagedResultNew.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" style="text-align:center; padding:40px;">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#94a3b8;" Class="mb-2" />
                                <div style="color:#64748b;">No purchase returns found — try a different search or filter</div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="ResetFilters">Clear filters</MudButton>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in pagedResultNew.Items)
                        {
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#fef3c7">↩️</span>@r.ReturnNumber</span></td>
                                <td class="tm-num">@(string.IsNullOrWhiteSpace(r.PurchaseOrderNumber) ? "-" : r.PurchaseOrderNumber)</td>
                                <td><span class="@GetStatusPill(r.Status)"><span class="tm-dot"></span>@r.Status</span></td>
                                <td style="text-align:right" class="tm-money">@r.TotalAmount.ToString("N0")</td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(r.Reason) ? "-" : r.Reason)</td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-view" title="View" @onclick="() => ViewReturn(r.Id)">👁</button>
                                        @if (r.Status == PurchaseReturnStatus.Draft)
                                        {
                                            <button class="tm-act" style="color:#16a34a" title="Approve" @onclick="() => Approve(r.Id)">✔</button>
                                        }
                                        @if (r.Status == PurchaseReturnStatus.Approved)
                                        {
                                            <button class="tm-act tm-act-view" title="Complete" @onclick="() => Complete(r.Id)">✅</button>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div style="opacity:@(_loading ? "0.55" : "1"); pointer-events:@(_loading ? "none" : "auto");">
            <TmPager CurrentPage="pagedResultNew.CurrentPage"
                     PageSize="pagedResultNew.PageSize"
                     TotalCount="pagedResultNew.TotalCount"
                     TotalPages="pagedResultNew.TotalPages"
                     ItemLabel="Purchase Returns"
                     OnGoToPage="GoToPage"
                     OnPrev="GoPrevPage"
                     OnNext="GoNextPage"
                     OnPageSizeChanged="OnPageSizeChanged" />
        </div>
    </div>
</div>

<TmSlideDrawer @bind-Open="_drawerOpen" Title="@_drawerTitle" Width="1000px">
    @if (_viewReturn == null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <div class="tm-info-card mb-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="text-muted small">Purchase Order</div>
                    <strong>@(string.IsNullOrWhiteSpace(_viewReturn.PurchaseOrderNumber) ? "-" : _viewReturn.PurchaseOrderNumber)</strong>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Status</div>
                    <MudChip T="string" Color="@CommonUtility.GetStatusColor(_viewReturn.Status)" Size="Size.Small">
                        @_viewReturn.Status
                    </MudChip>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Reason</div>
                    <strong>@(string.IsNullOrWhiteSpace(_viewReturn.Reason) ? "-" : _viewReturn.Reason)</strong>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <table class="tm-slide-items">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th style="text-align:right">Qty</th>
                            <th style="text-align:right">Unit Cost</th>
                            <th style="text-align:right">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_viewReturn.ItemsLine == null || _viewReturn.ItemsLine.Count == 0)
                        {
                            <tr><td colspan="5"><div class="tm-loading">No items on this return</div></td></tr>
                        }
                        else
                        {
                            @for (var i = 0; i < _viewReturn.ItemsLine.Count; i++)
                            {
                                var it = _viewReturn.ItemsLine[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@it.ProductName</td>
                                    <td style="text-align:right">@it.Quantity</td>
                                    <td style="text-align:right">@it.UnitCost.ToString("C")</td>
                                    <td style="text-align:right">@it.LineTotal.ToString("C")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="col-lg-4">
                <div class="tm-summary-card">
                    <h6 class="text-primary mb-3">RETURN SUMMARY</h6>
                    <div class="tm-summary-item"><span>Items</span><strong>@(_viewReturn.ItemsLine?.Count ?? 0)</strong></div>
                    <div class="tm-summary-item"><span>Total Units</span><strong>@((_viewReturn.ItemsLine?.Sum(x => x.Quantity)) ?? 0)</strong></div>
                    <div class="pt-3 border-top mt-2">
                        <div class="d-flex justify-content-between">
                            <strong>TOTAL</strong>
                            <span class="text-primary fw-bold fs-5">@_viewReturn.TotalAmount.ToString("C")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            @if (_viewReturn.Status == PurchaseReturnStatus.Draft)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle"
                           OnClick="@(() => ApproveAndRefresh(_viewReturn.Id))">Approve</MudButton>
            }
            @if (_viewReturn.Status == PurchaseReturnStatus.Approved)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Done"
                           OnClick="@(() => CompleteAndRefresh(_viewReturn.Id))">Complete</MudButton>
            }
        </div>
    }
</TmSlideDrawer>

@code {
    private static class Col
    {
        public const string ReturnNumber = "ReturnNumber";
        public const string PurchaseOrderNumber = "PurchaseOrderNumber";
        public const string TotalAmount = "TotalAmount";
        public const string Reason = "Reason";
        public const string Status = "Status";
    }

    private readonly List<PurchaseReturnStatus> ReturnStatuses = Enum.GetValues<PurchaseReturnStatus>().ToList();

    // ─── List state ───
    private PagedResultNew<PurchaseReturnDto> pagedResultNew = new();
    private PurchaseReturnPagedRequest pagedRequest = new()
    {
        SortColumn = "CreatedAt",
        SortAscending = false
    };

    private bool _loading = true;
    private bool _hasLoadedOnce;
    private bool _loadRunning;
    private bool _loadQueued;
    private CancellationTokenSource? _debounceCts;

    // ─── Drawer state ───
    private bool _drawerOpen;
    private string _drawerTitle = "";
    private PurchaseReturnDto? _viewReturn;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Refresh() => await Load();

    /// <summary>
    /// Single-flight loader. The page and the services share one scoped DbContext, so two
    /// overlapping queries would throw "A second operation was started on this context
    /// instance". Callers that arrive mid-flight set a flag instead of starting a parallel
    /// query, and the running load then re-runs once with the newest filter state.
    /// </summary>
    private async Task Load()
    {
        if (_loadRunning)
        {
            _loadQueued = true;
            return;
        }

        _loadRunning = true;
        try
        {
            do
            {
                _loadQueued = false;
                await LoadCore();
            }
            while (_loadQueued);
        }
        finally { _loadRunning = false; }
    }

    private async Task LoadCore()
    {
        _loading = true;
        try
        {
            pagedResultNew = await PurchaseReturnService.GetPurchaseReturnsAsync(pagedRequest);
            _hasLoadedOnce = true;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    // ─── Stats / sorting helpers ───
    private string TotalCountText => Stat("TotalCount");
    private string DraftCountText => Stat("DraftCount");
    private string ApprovedCountText => Stat("ApprovedCount");
    private string ShippedCountText => Stat("ShippedCount");
    private string CompletedCountText => Stat("CompletedCount");
    private string TotalReturnedText =>
        int.TryParse(Stat("TotalReturned"), out var v) ? v.ToString("N0") : "0";

    private string Stat(string key) =>
        pagedResultNew.Stats != null && pagedResultNew.Stats.TryGetValue(key, out var v) ? v.ToString() : "0";

    private void SortBy(string column)
    {
        if (pagedRequest.SortColumn == column)
            pagedRequest.SortAscending = !pagedRequest.SortAscending;
        else
        {
            pagedRequest.SortColumn = column;
            pagedRequest.SortAscending = true;
        }
        pagedRequest.CurrentPage = 0;
    }

    private string SortIcon(string column)
    {
        if (pagedRequest.SortColumn != column) return "";
        return pagedRequest.SortAscending ? "▲" : "▼";
    }

    private async Task OpenCreate()
    {
        var dialog = await DialogService.ShowAsync<PurchaseReturnDialog>("New Purchase Return",
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });

        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is PurchaseReturnDto dto)
        {
            await PurchaseReturnService.CreatePurchaseReturn(dto);
            Snackbar.Add(dto.Id == Guid.Empty ? "Purchase return created successfully" : "Purchase return updated successfully", Severity.Success);
            await Load();
        }
    }

    private async Task Approve(Guid id)
    {
        try { await PurchaseReturnService.ApprovePurchaseReturn(id); Snackbar.Add("Approved.", Severity.Success); await Load(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Complete(Guid id)
    {
        try { await PurchaseReturnService.CompletePurchaseReturn(id); Snackbar.Add("Completed.", Severity.Success); await Load(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ViewReturn(Guid id)
    {
        _viewReturn = null;
        _drawerTitle = "Loading…";
        _drawerOpen = true;
        try
        {
            _viewReturn = await PurchaseReturnService.GetPurchaseReturnById(id);
            _drawerTitle = $"Return #{_viewReturn?.ReturnNumber}";
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void CloseDrawer() => _drawerOpen = false;

    private async Task ApproveAndRefresh(Guid id)
    {
        await Approve(id);
        await ReloadView(id);
    }

    private async Task CompleteAndRefresh(Guid id)
    {
        await Complete(id);
        await ReloadView(id);
    }

    private async Task ReloadView(Guid id)
    {
        if (!_drawerOpen) return;
        var refreshed = await PurchaseReturnService.GetPurchaseReturnById(id);
        if (refreshed != null) _viewReturn = refreshed;
    }

    // ─── Filters ───
    private void OnSearchInput(ChangeEventArgs e)
    {
        pagedRequest.SearchTerm = e.Value?.ToString() ?? "";
        pagedRequest.CurrentPage = 0;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(async () =>
                {
                    await Load();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        pagedRequest.Status = Enum.TryParse<PurchaseReturnStatus>(e.Value?.ToString(), out var s) ? s : null;
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task OnFromChanged(ChangeEventArgs e)
    {
        pagedRequest.From = ParseDate(e.Value);
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task OnToChanged(ChangeEventArgs e)
    {
        pagedRequest.To = ParseDate(e.Value);
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task FilterByStatus(PurchaseReturnStatus? status)
    {
        pagedRequest.Status = pagedRequest.Status == status ? null : status;
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private async Task ResetFilters()
    {
        pagedRequest.SearchTerm = "";
        pagedRequest.Status = null;
        pagedRequest.From = null;
        pagedRequest.To = null;
        pagedRequest.CurrentPage = 0;
        await Load();
    }

    private static DateTime? ParseDate(object? value) =>
        DateTime.TryParse(value?.ToString(), out var d) ? d : null;

    private static string FormatDate(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";

    // ─── Paging (zero-based, matches TmPager) ───
    private async Task GoToPage(int page)
    {
        pagedRequest.CurrentPage = Math.Clamp(page, 0, Math.Max(0, pagedResultNew.TotalPages - 1));
        await Load();
    }

    private async Task GoPrevPage()
    {
        if (pagedRequest.CurrentPage > 0)
        {
            pagedRequest.CurrentPage--;
            await Load();
        }
    }

    private async Task GoNextPage()
    {
        if (pagedRequest.CurrentPage < pagedResultNew.TotalPages - 1)
        {
            pagedRequest.CurrentPage++;
            await Load();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sz))
        {
            pagedRequest.PageSize = Math.Clamp(sz, 1, 100);
            pagedRequest.CurrentPage = 0;
            await Load();
        }
    }

    private static string GetStatusPill(PurchaseReturnStatus s) => s switch
    {
        PurchaseReturnStatus.Draft => "tm-pill tm-pill-purple",
        PurchaseReturnStatus.Approved => "tm-pill tm-pill-amber",
        PurchaseReturnStatus.Shipped => "tm-pill tm-pill-blue",
        PurchaseReturnStatus.Completed => "tm-pill tm-pill-green",
        PurchaseReturnStatus.Cancelled => "tm-pill tm-pill-red",
        _ => "tm-pill tm-pill-blue"
    };

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
