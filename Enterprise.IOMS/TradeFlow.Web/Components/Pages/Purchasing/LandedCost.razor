@page "/purchasing/landed-cost"
@rendermode InteractiveServer
@inject ILandedCostService LandedCostService
@inject ISnackbar Snackbar
@using TradeFlow.Infrastructure.Data
@inject ApplicationDbContext DbContext

<PageTitle>Landed Costs - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="⚓" Title="Landed Cost Management" Subtitle="Define cost components and allocate them across purchase orders">
        <Actions>
            <button class="tm-reset" @onclick="Load">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="() => _showAdd = true">+ Add Component</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="🧩" Number="@_components.Count" Label="Components" Tone="blue" />
        <TmStatTile Icon="📄" Number="@_allocations.Count" Label="Allocations" Tone="purple" />
        <TmStatTile Icon="💰" Number="@TotalAllocated" Label="Total Allocated" Tone="teal" />
        <TmStatTile Icon="📊" Number="@AvgRate" Label="Avg Default Rate" Tone="yellow" />
        <TmStatTile Icon="📋" Number="@_purchaseOrders.Count" Label="Purchase Orders" Tone="green" />
    </div>

    @if (_showAdd)
    {
        <div class="tm-card tm-filters" style="flex-wrap:wrap">
            <div class="tm-search" style="max-width:240px">
                <span>🏷</span>
                <input placeholder="Component name" @bind="_newName" />
            </div>
            <div class="tm-search" style="max-width:200px">
                <span>🏷</span>
                <input placeholder="Type" @bind="_newType" />
            </div>
            <div class="tm-search" style="max-width:200px">
                <span>%</span>
                <input placeholder="Default rate" @bind="_newRate" />
            </div>
            <button class="tm-add-btn" @onclick="AddComponent">Save Component</button>
            <button class="tm-reset" @onclick="CancelAdd">Cancel</button>
        </div>
    }

    <div class="tm-card tm-table-card" style="margin-bottom:10px">
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:800px">
                <thead>
                    <tr>
                        <th>🧩 Component</th>
                        <th>Type</th>
                        <th style="text-align:right">Default Rate</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_components.Count == 0)
                    {
                        <tr><td colspan="3"><div class="tm-loading">No cost components defined</div></td></tr>
                    }
                    else
                    {
                        @foreach (var c in _components)
                        {
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#e0e9ff">🧩</span>@c.Name</span></td>
                                <td><span class="tm-pill tm-pill-purple"><span class="tm-dot"></span>@(string.IsNullOrWhiteSpace(c.Type) ? "-" : c.Type)</span></td>
                                <td style="text-align:right" class="tm-money">@c.DefaultRate.ToString("P2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-select">
            <select @onchange="OnPoChanged">
                <option value="" selected="@(_filterPoId == null)">All Purchase Orders</option>
                @foreach (var po in _purchaseOrders)
                {
                    <option value="@po.Id" selected="@(_filterPoId == po.Id)">@po.OrderNumber</option>
                }
            </select>
        </div>
        <button class="tm-reset" @onclick="ClearPoFilter">Clear PO Filter</button>
    </div>

    <div class="tm-card tm-table-card">
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:800px">
                <thead>
                    <tr>
                        <th>🧾 PO #</th>
                        <th>🧩 Component</th>
                        <th style="text-align:right">Amount</th>
                        <th>Allocation Method</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_allocations.Count == 0)
                    {
                        <tr><td colspan="4"><div class="tm-loading">No cost allocations found</div></td></tr>
                    }
                    else
                    {
                        @foreach (var a in _allocations)
                        {
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#fef3c7">🧾</span>@(a.PurchaseOrderNumber ?? "-")</span></td>
                                <td class="tm-branch">@a.ComponentName</td>
                                <td style="text-align:right" class="tm-money">@a.Amount.ToString("N0")</td>
                                <td><span class="tm-pill tm-pill-blue"><span class="tm-dot"></span>@a.AllocationMethod</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<LandedCostComponentDto> _components = new();
    private List<LandedCostAllocationDto> _allocations = new();
    private List<PurchaseOrder> _purchaseOrders = new();
    private Guid? _filterPoId;
    private bool _showAdd;
    private string _newName = "", _newType = "";
    private decimal _newRate;

    private string TotalAllocated => _allocations.Sum(a => a.Amount).ToString("N0");

    private string AvgRate => _components.Count == 0
        ? "0.00%"
        : _components.Average(c => (double)c.DefaultRate).ToString("P2");

    protected override async Task OnInitializedAsync()
    {
        _purchaseOrders = await DbContext.PurchaseOrders.OrderByDescending(p => p.PurchaseDate).Take(100).ToListAsync();
        await Load();
    }

    private async Task Load()
    {
        try
        {
            _components = await LandedCostService.GetComponents();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        await LoadAllocations();
    }

    private async Task LoadAllocations()
    {
        try { _allocations = await LandedCostService.GetAllocations(_filterPoId); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task AddComponent()
    {
        try
        {
            await LandedCostService.CreateComponent(new CreateLandedCostComponentDto(_newName, _newType, _newRate));
            Snackbar.Add("Component added.", Severity.Success);
            _showAdd = false;
            _newName = ""; _newType = ""; _newRate = 0;
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void CancelAdd()
    {
        _showAdd = false;
        _newName = ""; _newType = ""; _newRate = 0;
    }

    private async Task OnPoChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _filterPoId = string.IsNullOrEmpty(v) ? null : Guid.Parse(v);
        await LoadAllocations();
    }

    private async Task ClearPoFilter()
    {
        _filterPoId = null;
        await LoadAllocations();
    }
}
