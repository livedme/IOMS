@page "/Purchasing/list"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@inject IPurchaseService PurchaseService
@inject ISupplierService SupplierService
@inject IProductService ProductService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<PurchaseOrders> Logger
@inject IWarehousesService WarehousesService

<PageTitle>Purchase Order - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="📦" Title="Purchase Orders" Subtitle="Raise POs, approve them and receive supplier goods">
        <Actions>
            <button class="tm-reset" @onclick="Refresh">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="() => OpenCreateEdit(null)">+ New PO</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="📦" Number="@TotalCountText" Label="Purchase Orders" Tone="blue" OnClick="@(() => FilterByStatus(null))" />
        <TmStatTile Icon="📝" Number="@DraftCountText" Label="Draft" Tone="purple" OnClick="@(() => FilterByStatus(PurchaseOrderStatus.Draft))" />
        <TmStatTile Icon="✔" Number="@ApprovedCountText" Label="Approved" Tone="green" OnClick="@(() => FilterByStatus(PurchaseOrderStatus.Approved))" />
        <TmStatTile Icon="📥" Number="@PartialCountText" Label="Partially Received" Tone="yellow" OnClick="@(() => FilterByStatus(PurchaseOrderStatus.PartiallyReceived))" />
        <TmStatTile Icon="✅" Number="@ReceivedCountText" Label="Received" Tone="teal" OnClick="@(() => FilterByStatus(PurchaseOrderStatus.Received))" />
        <TmStatTile Icon="💰" Number="@PageValueText" Label="Page Value" Tone="red" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by PO number, supplier or warehouse..." value="@pagedRequest.SearchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.SupplierId?.ToString() ?? "")" @onchange="OnSupplierChanged">
                <option value="">All Suppliers</option>
                @foreach (var s in _suppliers)
                {
                    <option value="@s.Id">@s.SupplierName</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.WarehouseId?.ToString() ?? "")" @onchange="OnWarehouseChanged">
                <option value="">All Warehouses</option>
                @foreach (var w in _warehouses)
                {
                    <option value="@w.Id">@w.Name</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <select value="@(pagedRequest.Status?.ToString() ?? "")" @onchange="OnStatusChanged">
                <option value="">All Status</option>
                @foreach (var status in OrderStatuses)
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>
        <div class="tm-select">
            <input type="date" value="@FormatDate(pagedRequest.From)" @onchange="OnFromChanged" title="From date" />
        </div>
        <div class="tm-select">
            <input type="date" value="@FormatDate(pagedRequest.To)" @onchange="OnToChanged" title="To date" />
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        @if (_loading)
        {
            <div style="position:absolute; inset:0; background:rgba(255,255,255,0.62); backdrop-filter:blur(1px); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:2; border-radius:12px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Style="margin-top:8px; color:#334155; font-weight:600;">Loading purchase orders...</MudText>
            </div>
        }
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:1100px">
                <thead>
                    <tr>
                        <th @onclick="@(() => SortBy(Col.OrderNumber))">📦 PO # @SortIcon(Col.OrderNumber)</th>
                        <th @onclick="@(() => SortBy(Col.Supplier))">🏭 Supplier @SortIcon(Col.Supplier)</th>
                        <th @onclick="@(() => SortBy(Col.Warehouse))">🏬 Warehouse @SortIcon(Col.Warehouse)</th>
                        <th @onclick="@(() => SortBy(Col.PurchaseDate))">📅 Date @SortIcon(Col.PurchaseDate)</th>
                        <th @onclick="@(() => SortBy(Col.Status))">Status @SortIcon(Col.Status)</th>
                        <th style="text-align:right" @onclick="@(() => SortBy(Col.TotalAmount))">Total @SortIcon(Col.TotalAmount)</th>
                        <th style="text-align:right" @onclick="@(() => SortBy(Col.DueAmount))">Due @SortIcon(Col.DueAmount)</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_hasLoadedOnce && _loading)
                    {
                        <tr><td colspan="8" style="text-align:center; padding:40px; color:#94a3b8;">Loading purchase orders...</td></tr>
                    }
                    else if (pagedResultNew.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="8" style="text-align:center; padding:40px;">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Style="color:#94a3b8;" Class="mb-2" />
                                <div style="color:#64748b;">No purchase orders found — try a different search or filter</div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="ResetFilters">Clear filters</MudButton>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var po in pagedResultNew.Items)
                        {
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#fef3c7">📦</span>@po.OrderNumber</span></td>
                                <td class="tm-branch">@(string.IsNullOrWhiteSpace(po.SupplierName) ? "-" : po.SupplierName)</td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(po.WarehouseName) ? "-" : po.WarehouseName)</td>
                                <td class="tm-dim">@po.PurchaseDate.ToString("dd MMM yyyy")</td>
                                <td><span class="@GetStatusPill(po.Status)"><span class="tm-dot"></span>@po.Status</span></td>
                                <td style="text-align:right" class="tm-money">@po.TotalAmount.ToString("N0")</td>
                                <td style="text-align:right">
                                    <span style="font-weight:700; color:@(po.DueAmount > 0 ? "#dc2626" : "#15803d")">
                                        @(po.DueAmount > 0 ? po.DueAmount.ToString("N0") : "-")
                                    </span>
                                </td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-view" title="View" @onclick="() => ViewOrder(po.Id)">👁</button>
                                        <button class="tm-act tm-act-edit" title="Edit" @onclick="() => OpenCreateEdit(po.Id)">✎</button>
                                        <button class="tm-act" style="color:#16a34a" title="Approve" @onclick="() => Approve(po.Id)">✔</button>
                                        <button class="tm-act tm-act-view" title="Receive Goods" @onclick="() => ReceiveGoods(po)">📥</button>
                                        <button class="tm-act" style="color:#d97706" title="Cancel PO" @onclick="() => CancelPO(po.Id)">✕</button>
                                        <button class="tm-act tm-act-del" title="Delete PO" @onclick="() => DeletePO(po.Id)">🗑</button>
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div style="opacity:@(_loading ? "0.55" : "1"); pointer-events:@(_loading ? "none" : "auto");">
            <TmPager CurrentPage="pagedResultNew.CurrentPage"
                     PageSize="pagedResultNew.PageSize"
                     TotalCount="pagedResultNew.TotalCount"
                     TotalPages="pagedResultNew.TotalPages"
                     ItemLabel="Purchase Orders"
                     OnGoToPage="GoToPage"
                     OnPrev="GoPrevPage"
                     OnNext="GoNextPage"
                     OnPageSizeChanged="OnPageSizeChanged" />
        </div>
    </div>
</div>

<PurchaseOrderViewPanel @ref="_purchaseOrderViewPanel" />

    @code {
    private static class Col
    {
        public const string OrderNumber = "OrderNumber";
        public const string PurchaseDate = "PurchaseDate";
        public const string Supplier = "Supplier";
        public const string Warehouse = "Warehouse";
        public const string TotalAmount = "TotalAmount";
        public const string DueAmount = "DueAmount";
        public const string Status = "Status";
    }

    private readonly List<PurchaseOrderStatus> OrderStatuses = Enum.GetValues<PurchaseOrderStatus>().ToList();

    // ─── List state ───
    private PagedResultNew<PurchaseOrderDto> pagedResultNew = new();
    private PurchaseOrderPagedRequest pagedRequest = new()
    {
        SortColumn = Col.PurchaseDate,
        SortAscending = false
    };


    private List<SupplierDto> _suppliers = new();
    private List<ProductDto> productDtos = new();

    private List<(Guid Id, string Name)> _warehouses = new();
    private bool _loading = true;
    private bool _hasLoadedOnce;
    private bool _loadRunning;
    private bool _loadQueued;
    private decimal _pageValue;
    private CancellationTokenSource? _debounceCts;

    private PurchaseOrderViewPanel? _purchaseOrderViewPanel;

    private async Task ViewOrder(Guid id)
    {
        if (_purchaseOrderViewPanel != null)
            await _purchaseOrderViewPanel.OpenAsync(id);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var suppliers = await SupplierService.GetSuppliersAsync("", 1, 1000);
            _suppliers = suppliers.Items;
            var result = await ProductService.GetProductsAsync(new ProductPagedRequest());
            productDtos = result.Items;

        }
        catch (Exception ex)
        {
            // Previously an empty catch. An unlogged swallow here left the supplier picker silently
            // empty, which is indistinguishable from a tenant that has no suppliers — and left no
            // error anywhere to diagnose it from.
            Logger.LogError(ex, "Supplier lookup failed; the new-order supplier picker will be empty.");
            Snackbar.Add("Could not load suppliers.", Severity.Error);
        }

        try
        {
            var warehouses = await WarehousesService.GetAllWarehousesAsync();
            _warehouses = warehouses
                .OrderBy(w => w.Name)
                .Select(w => new ValueTuple<Guid, string>(w.Id, w.Name))
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Warehouse lookup failed; the new-order warehouse picker will be empty.");
            Snackbar.Add("Could not load warehouses.", Severity.Error);
        }

        await LoadOrders();
    }

    private async Task Refresh() => await LoadOrders();

    /// <summary>
    /// Single-flight loader. The page and the services share one scoped DbContext, so two
    /// overlapping queries would throw "A second operation was started on this context
    /// instance". Callers that arrive mid-flight set a flag instead of starting a parallel
    /// query, and the running load then re-runs once with the newest filter state.
    /// </summary>
    private async Task LoadOrders()
    {
        if (_loadRunning)
        {
            _loadQueued = true;
            return;
        }

        _loadRunning = true;
        try
        {
            do
            {
                _loadQueued = false;
                await LoadOrdersCore();
            }
            while (_loadQueued);
        }
        finally { _loadRunning = false; }
    }

    private async Task LoadOrdersCore()
    {
        _loading = true;
        try
        {
            pagedResultNew = await PurchaseService.GetPurchaseOrdersAsync(pagedRequest);
            _pageValue = pagedResultNew.Items.Sum(o => o.TotalAmount);
            _hasLoadedOnce = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load purchase orders for page {Page}.", pagedRequest.CurrentPage);
            Snackbar.Add($"Error loading purchase orders: {ex.Message}", Severity.Error);
        }
        finally { _loading = false; }
    }

    // ─── Stats / sorting helpers ───
    private string TotalCountText => Stat("TotalCount");
    private string DraftCountText => Stat("DraftCount");
    private string ApprovedCountText => Stat("ApprovedCount");
    private string PartialCountText => Stat("PartiallyReceivedCount");
    private string ReceivedCountText => Stat("ReceivedCount");
    private string PageValueText => _pageValue.ToString("N0");

    private string Stat(string key) =>
        pagedResultNew.Stats != null && pagedResultNew.Stats.TryGetValue(key, out var v) ? v.ToString() : "0";

    private void SortBy(string column)
    {
        if (pagedRequest.SortColumn == column)
            pagedRequest.SortAscending = !pagedRequest.SortAscending;
        else
        {
            pagedRequest.SortColumn = column;
            pagedRequest.SortAscending = true;
        }
        pagedRequest.CurrentPage = 0;
    }

    private string SortIcon(string column)
    {
        if (pagedRequest.SortColumn != column) return "";
        return pagedRequest.SortAscending ? "▲" : "▼";
    }

    // ─── Filters ───
    private void OnSearchInput(ChangeEventArgs e)
    {
        pagedRequest.SearchTerm = e.Value?.ToString() ?? "";
        pagedRequest.CurrentPage = 0;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(async () =>
                {
                    await LoadOrders();
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task OnSupplierChanged(ChangeEventArgs e)
    {
        pagedRequest.SupplierId = ParseGuid(e.Value);
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task OnWarehouseChanged(ChangeEventArgs e)
    {
        pagedRequest.WarehouseId = ParseGuid(e.Value);
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        pagedRequest.Status = Enum.TryParse<PurchaseOrderStatus>(e.Value?.ToString(), out var s) ? s : null;
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task OnFromChanged(ChangeEventArgs e)
    {
        pagedRequest.From = ParseDate(e.Value);
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task OnToChanged(ChangeEventArgs e)
    {
        pagedRequest.To = ParseDate(e.Value);
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task FilterByStatus(PurchaseOrderStatus? status)
    {
        pagedRequest.Status = pagedRequest.Status == status ? null : status;
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private async Task ResetFilters()
    {
        pagedRequest.SearchTerm = "";
        pagedRequest.Status = null;
        pagedRequest.SupplierId = null;
        pagedRequest.WarehouseId = null;
        pagedRequest.From = null;
        pagedRequest.To = null;
        pagedRequest.CurrentPage = 0;
        await LoadOrders();
    }

    private static Guid? ParseGuid(object? value) =>
        Guid.TryParse(value?.ToString(), out var g) && g != Guid.Empty ? g : null;

    private static DateTime? ParseDate(object? value) =>
        DateTime.TryParse(value?.ToString(), out var d) ? d : null;

    private static string FormatDate(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";

    // ─── Paging (zero-based, matches TmPager) ───
    private async Task GoToPage(int page)
    {
        pagedRequest.CurrentPage = Math.Clamp(page, 0, Math.Max(0, pagedResultNew.TotalPages - 1));
        await LoadOrders();
    }

    private async Task GoPrevPage()
    {
        if (pagedRequest.CurrentPage > 0)
        {
            pagedRequest.CurrentPage--;
            await LoadOrders();
        }
    }

    private async Task GoNextPage()
    {
        if (pagedRequest.CurrentPage < pagedResultNew.TotalPages - 1)
        {
            pagedRequest.CurrentPage++;
            await LoadOrders();
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var sz))
        {
            pagedRequest.PageSize = Math.Clamp(sz, 1, 100);
            pagedRequest.CurrentPage = 0;
            await LoadOrders();
        }
    }

    private static string GetStatusPill(PurchaseOrderStatus s) => s switch
    {
        PurchaseOrderStatus.Draft => "tm-pill tm-pill-purple",
        PurchaseOrderStatus.Submitted => "tm-pill tm-pill-blue",
        PurchaseOrderStatus.Approved => "tm-pill tm-pill-green",
        PurchaseOrderStatus.PartiallyReceived => "tm-pill tm-pill-amber",
        PurchaseOrderStatus.Received => "tm-pill tm-pill-teal",
        PurchaseOrderStatus.Closed => "tm-pill tm-pill-blue",
        PurchaseOrderStatus.Cancelled => "tm-pill tm-pill-red",
        _ => "tm-pill tm-pill-blue"
    };

    private async Task Approve(Guid id)
    {
        try
        {
            await PurchaseService.ApprovePurchaseOrder(id);
            Snackbar.Add("PO approved", Severity.Success);
            await LoadOrders();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ReceiveGoods(PurchaseOrderDto po)
    {
        var detail = await PurchaseService.GetPurchaseOrderById(po.Id);
        if (detail == null) return;

        var lines = detail.Items
            .Where(i => i.ReceivedQuantity < i.Quantity)
            .Select(i => new GoodsReceivedLineDto(i.Id, i.ProductId, i.Quantity - i.ReceivedQuantity))
            .ToList();

        if (!lines.Any()) { Snackbar.Add("All items already received", Severity.Info); return; }

        var confirm = await DialogService.ShowMessageBoxAsync("Receive Goods",
            $"Receive all outstanding items for {po.OrderNumber}?", "Receive", "Cancel");
        if (confirm == true)
        {
            try
            {
                await PurchaseService.ReceiveGoods(po.Id, lines);
                Snackbar.Add("Goods received successfully", Severity.Success);
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task OpenCreateEdit(Guid? orderId)
    {
        // Reference data comes from the services, not the page's DbContext — the page and the
        // services share one scoped context, so querying it directly races the list query.
        var suppliers = _suppliers;
        var wareHouse = _warehouses;
        var dataModel = new PurchaseOrderDtoModels();
        string dialogTitle = "New Purchase Order";

        if (orderId.HasValue){
            var order = await PurchaseService.GetPurchaseOrderById(orderId.Value);
            if (order == null) { Snackbar.Add("Purchase order not found", Severity.Error); return; }

            dialogTitle = $"Edit PO #{order.OrderNumber}";
            var supplierItem = suppliers.Where(s => s.Id == order.SupplierId)
                .Select(s => new ControlItemsDto() {Id= s.Id, IsSelected = false, Name = s.SupplierName })
                .FirstOrDefault() ?? new ControlItemsDto() { Id = order.SupplierId, Name = order.SupplierName, IsSelected = false };

            dataModel = new PurchaseOrderDtoModels()
            {
                PurchaseDate = order.PurchaseDate,
                SupplierId = order.SupplierId,              
                WarehouseId = order.WarehouseId,
                DiscountAmount = order.DiscountAmount,
                TaxAmount = order.TaxAmount,
                DiscountType = (int)order.DiscountType,
                DueAmount = order.DueAmount,
                TotalAmount = order.TotalAmount,
                //LabourCharge = order.LabourCharge,
                //TruckCharge = order.TruckCharge,
                SubTotal = order.SubTotal,
                PaidAmount = order.PaidAmount,
                Notes = order.Notes,
                SupplierDdlControl = new ControlDto() { 
                    SelectedItem = supplierItem,
                    SelectedText = supplierItem?.Name,
                    LastSelectedItem = supplierItem
                },
                ItemsLine = order.Items.Select(i => new CreatePurchaseOrderItemDto(i.Id, i.ProductId, i.Quantity, i.UnitPrice, i.DiscountAmount,
                    (DiscountType)i.DiscountType, i.TotalDiscountAmount, i.LineTotalPrice, null, null)).ToList()
            };
        }

        var parameters = new DialogParameters<PurchaseOrderDialog>
        {
            { x => x.Suppliers, suppliers.Where(s => s.IsActive).ToList() },
            { x => x.Products, productDtos.Select(p => (p.Id, p.Name, p.SKU, p.CostPrice)).ToList() },
            { x => x.WareHouses, wareHouse.Select(p => (p.Id, p.Name)).ToList() },
            {x=>x.dataModel, dataModel }
        };

        var dialog = await DialogService.ShowAsync<PurchaseOrderDialog>(dialogTitle, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreatePurchaseOrderDto dto)
        {
            try
            {
                if (orderId.HasValue)
                {
                    await PurchaseService.UpdatePurchaseOrder(orderId.Value, dto);
                    Snackbar.Add("Purchase order updated", Severity.Success);
                }
                else
                {
                    await PurchaseService.CreatePurchaseOrder(dto);
                    Snackbar.Add("Purchase order created", Severity.Success);
                }
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task CancelPO(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Cancel Purchase Order",
            "Are you sure you want to cancel this purchase order?", "Yes, Cancel", "No");
        if (confirm == true)
        {
            try
            {
                await PurchaseService.CancelPurchaseOrder(id);
                Snackbar.Add("Purchase order cancelled", Severity.Warning);
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task DeletePO(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Delete Purchase Order",
            "This will permanently delete the purchase order. Continue?", "Yes, Delete", "No");
        if (confirm == true)
        {
            try
            {
                await PurchaseService.DeletePurchaseOrder(id);
                Snackbar.Add("Purchase order deleted", Severity.Success);
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
