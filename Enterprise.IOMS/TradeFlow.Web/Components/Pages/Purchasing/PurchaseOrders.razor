@page "/orders/purchase"
@rendermode InteractiveServer
@inject IPurchaseService PurchaseService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using TradeFlow.Infrastructure.Data
@inject ApplicationDbContext DbContext

<PageTitle>Purchase Order - IOMS</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="📦" Title="Purchase Orders" Subtitle="Raise POs, approve them and receive supplier goods">
        <Actions>
            <button class="tm-reset" @onclick="LoadOrders">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="() => OpenCreateEdit(null)">+ New PO</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="📦" Number="@_totalCount" Label="Purchase Orders" Tone="blue" />
        <TmStatTile Icon="📝" Number="@CountOf(PurchaseOrderStatus.Draft)" Label="Draft" Tone="purple" OnClick="@(() => PickStatus(PurchaseOrderStatus.Draft))" />
        <TmStatTile Icon="✔" Number="@CountOf(PurchaseOrderStatus.Approved)" Label="Approved" Tone="green" OnClick="@(() => PickStatus(PurchaseOrderStatus.Approved))" />
        <TmStatTile Icon="📥" Number="@CountOf(PurchaseOrderStatus.PartiallyReceived)" Label="Partially Received" Tone="yellow" OnClick="@(() => PickStatus(PurchaseOrderStatus.PartiallyReceived))" />
        <TmStatTile Icon="✅" Number="@CountOf(PurchaseOrderStatus.Received)" Label="Received" Tone="teal" OnClick="@(() => PickStatus(PurchaseOrderStatus.Received))" />
        <TmStatTile Icon="💰" Number="@_pageValue" Label="Page Value" Tone="red" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by PO number, supplier or warehouse..." value="@_search" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select @onchange="OnStatusChanged">
                <option value="" selected="@(_statusFilter == null)">All Status</option>
                @foreach (var status in Enum.GetValues<PurchaseOrderStatus>())
                {
                    <option value="@status" selected="@(_statusFilter == status)">@status</option>
                }
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:1100px">
                <thead>
                    <tr>
                        <th>📦 PO #</th>
                        <th>🏭 Supplier</th>
                        <th>🏬 Warehouse</th>
                        <th>📅 Date</th>
                        <th>Status</th>
                        <th style="text-align:right">Total</th>
                        <th style="text-align:right">Due</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="8"><TmLoading Message="Loading purchase orders..." /></td></tr>
                    }
                    else if (_orders.Items.Count == 0)
                    {
                        <tr><td colspan="8"><div class="tm-loading">No purchase orders found</div></td></tr>
                    }
                    else
                    {
                        @foreach (var po in _orders.Items)
                        {
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#fef3c7">📦</span>@po.OrderNumber</span></td>
                                <td class="tm-branch">@(string.IsNullOrWhiteSpace(po.SupplierName) ? "-" : po.SupplierName)</td>
                                <td class="tm-dim">@(string.IsNullOrWhiteSpace(po.WarehouseName) ? "-" : po.WarehouseName)</td>
                                <td class="tm-dim">@po.PurchaseDate.ToString("dd MMM yyyy")</td>
                                <td><span class="@GetStatusPill(po.Status)"><span class="tm-dot"></span>@po.Status</span></td>
                                <td style="text-align:right" class="tm-money">@po.TotalAmount.ToString("N0")</td>
                                <td style="text-align:right">
                                    <span style="font-weight:700; color:@(po.DueAmount > 0 ? "#dc2626" : "#15803d")">
                                        @(po.DueAmount > 0 ? po.DueAmount.ToString("N0") : "-")
                                    </span>
                                </td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-view" title="View" @onclick="() => ViewOrder(po.Id)">👁</button>
                                        <button class="tm-act tm-act-edit" title="Edit" @onclick="() => OpenCreateEdit(po.Id)">✎</button>
                                        <button class="tm-act" style="color:#16a34a" title="Approve" @onclick="() => Approve(po.Id)">✔</button>
                                        <button class="tm-act tm-act-view" title="Receive Goods" @onclick="() => ReceiveGoods(po)">📥</button>
                                        <button class="tm-act" style="color:#d97706" title="Cancel PO" @onclick="() => CancelPO(po.Id)">✕</button>
                                        <button class="tm-act tm-act-del" title="Delete PO" @onclick="() => DeletePO(po.Id)">🗑</button>
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <TmPager Total="@_totalCount" Page="@_page" PageSize="@_pageSize" ItemNoun="purchase orders"
                  PageChanged="@OnPageChanged" PageSizeChanged="@OnPageSizeChanged" />
    </div>
</div>

<TmSlideDrawer @bind-Open="_drawerOpen" Title="@_drawerTitle">
    @if (_viewOrder == null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <div class="tm-info-card mb-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="text-muted small">Supplier</div>
                    <strong>@(string.IsNullOrWhiteSpace(_viewOrder.SupplierName) ? "-" : _viewOrder.SupplierName)</strong>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Warehouse</div>
                    <strong>@(string.IsNullOrWhiteSpace(_viewOrder.WarehouseName) ? "-" : _viewOrder.WarehouseName)</strong>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Purchase Date</div>
                    <strong>@_viewOrder.PurchaseDate.ToString("dd-MMM-yyyy")</strong>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Status</div>
                    <MudChip T="string" Color="@CommonUtility.GetStatusColor(_viewOrder.Status)" Size="Size.Small">
                        @_viewOrder.Status
                    </MudChip>
                </div>
            </div>
            @if (_viewOrder.ExpectedDeliveryDate.HasValue)
            {
                <div class="mt-2">
                    <div class="text-muted small">Expected Delivery</div>
                    <strong>@_viewOrder.ExpectedDeliveryDate.Value.ToString("dd-MMM-yyyy")</strong>
                </div>
            }
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <MudTable Items="@_viewOrder.Items" Dense="true" Hover="true" Elevation="2">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>Product</MudTh>
                        <MudTh>SKU</MudTh>
                        <MudTh Style="text-align:right">Qty</MudTh>
                        <MudTh Style="text-align:right">Received</MudTh>
                        <MudTh Style="text-align:right">Unit Price</MudTh>
                        <MudTh Style="text-align:right">Discount</MudTh>
                        <MudTh Style="text-align:right">Total</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@(_viewOrder.Items.IndexOf(context) + 1)</MudTd>
                        <MudTd>@context.ProductName</MudTd>
                        <MudTd>@context.ProductSKU</MudTd>
                        <MudTd Style="text-align:right">@context.Quantity</MudTd>
                        <MudTd Style="text-align:right">
                            <span style="color:@(context.ReceivedQuantity >= context.Quantity ? "#15803d" : "#d97706")">
                                @context.ReceivedQuantity
                            </span>
                        </MudTd>
                        <MudTd Style="text-align:right">@context.UnitPrice.ToString("C")</MudTd>
                        <MudTd Style="text-align:right">@context.TotalDiscountAmount.ToString("C")</MudTd>
                        <MudTd Style="text-align:right">@context.LineTotalPrice.ToString("C")</MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
            <div class="col-lg-4">
                <div class="tm-summary-card">
                    <h6 class="text-primary mb-3">PO SUMMARY</h6>
                    <div class="tm-summary-item"><span>Subtotal</span><strong>@_viewOrder.SubTotal.ToString("C")</strong></div>
                    <div class="tm-summary-item"><span>Discount</span><strong>@_viewOrder.DiscountAmount.ToString("C")</strong></div>
                    <div class="tm-summary-item"><span>Labour</span><strong>@_viewOrder.LabourCharge.ToString("C")</strong></div>
                    <div class="tm-summary-item"><span>Truck</span><strong>@_viewOrder.TruckCharge.ToString("C")</strong></div>
                    <div class="tm-summary-item"><span>Tax</span><strong>@_viewOrder.TaxAmount.ToString("C")</strong></div>
                    <div class="pt-3 border-top mt-2">
                        <div class="d-flex justify-content-between">
                            <strong>TOTAL</strong>
                            <span class="text-primary fw-bold fs-5">@_viewOrder.TotalAmount.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span class="text-muted">Paid</span>
                            <span class="text-success fw-semibold">@_viewOrder.PaidAmount.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span class="text-muted">Due</span>
                            <span class="text-danger fw-semibold">@_viewOrder.DueAmount.ToString("C")</span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_viewOrder.Notes))
                {
                    <MudField Label="Notes" Class="mt-3">@_viewOrder.Notes</MudField>
                }
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="@(() => EditFromDrawer(_viewOrder.Id))">Edit</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Download"
                       OnClick="@(() => ReceiveFromDrawer(_viewOrder))">Receive Goods</MudButton>
            @if (_viewOrder.Status == PurchaseOrderStatus.Draft)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle"
                           OnClick="@(() => ApproveAndRefresh(_viewOrder.Id))">Approve</MudButton>
            }
            @if (_viewOrder.Status != PurchaseOrderStatus.Received && _viewOrder.Status != PurchaseOrderStatus.Cancelled)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel"
                           OnClick="@(() => CancelAndRefresh(_viewOrder.Id))">Cancel PO</MudButton>
            }
        </div>
    }
</TmSlideDrawer>

@code {
    private PagedResult<PurchaseOrderDto> _orders = new(new(), 0, 1, 10);
    private string _search = "";
    private PurchaseOrderStatus? _statusFilter;
    private bool _loading = true;
    private int _page = 1;
    private int _pageSize = 10;
    private int _totalCount;
    private decimal _pageValue;
    private int _draftCount, _approvedCount, _partialCount, _receivedCount;
    private System.Timers.Timer? _debounce;

    // ─── Drawer state ───
    private bool _drawerOpen;
    private string _drawerTitle = "";
    private PurchaseOrderDto? _viewOrder;

    private async Task ViewOrder(Guid id)
    {
        _viewOrder = null;
        _drawerTitle = "Loading…";
        _drawerOpen = true;
        try
        {
            _viewOrder = await PurchaseService.GetPurchaseOrderById(id);
            _drawerTitle = $"PO #{_viewOrder?.OrderNumber}";
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void CloseDrawer() => _drawerOpen = false;

    private async Task EditFromDrawer(Guid id)
    {
        CloseDrawer();
        await OpenCreateEdit(id);
    }

    private async Task ReceiveFromDrawer(PurchaseOrderDto po)
    {
        CloseDrawer();
        await ReceiveGoods(po);
    }

    private async Task ApproveAndRefresh(Guid id)
    {
        await Approve(id);
        await ReloadView(id);
    }

    private async Task CancelAndRefresh(Guid id)
    {
        await CancelPO(id);
        await ReloadView(id);
    }

    private async Task ReloadView(Guid id)
    {
        if (!_drawerOpen) return;
        var refreshed = await PurchaseService.GetPurchaseOrderById(id);
        if (refreshed != null) _viewOrder = refreshed;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
        await LoadCountsAsync();
    }

    private async Task LoadOrders()
    {
        _loading = true;
        try
        {
            _orders = await PurchaseService.GetPurchaseOrders(_search, _statusFilter, _page, _pageSize);
            _totalCount = _orders.TotalCount;
            _pageValue = _orders.Items.Sum(o => o.TotalAmount);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _loading = false;
    }

    private async Task LoadCountsAsync()
    {
        try
        {
            var all = await PurchaseService.GetPurchaseOrders("", null, 1, 1000);
            var items = all.Items;
            _draftCount = items.Count(o => o.Status == PurchaseOrderStatus.Draft);
            _approvedCount = items.Count(o => o.Status == PurchaseOrderStatus.Approved);
            _partialCount = items.Count(o => o.Status == PurchaseOrderStatus.PartiallyReceived);
            _receivedCount = items.Count(o => o.Status == PurchaseOrderStatus.Received);
        }
        catch { }
    }

    private int CountOf(PurchaseOrderStatus s) => s switch
    {
        PurchaseOrderStatus.Draft => _draftCount,
        PurchaseOrderStatus.Approved => _approvedCount,
        PurchaseOrderStatus.PartiallyReceived => _partialCount,
        PurchaseOrderStatus.Received => _receivedCount,
        _ => 0
    };

    private static string GetStatusPill(PurchaseOrderStatus s) => s switch
    {
        PurchaseOrderStatus.Draft => "tm-pill tm-pill-purple",
        PurchaseOrderStatus.Submitted => "tm-pill tm-pill-blue",
        PurchaseOrderStatus.Approved => "tm-pill tm-pill-green",
        PurchaseOrderStatus.PartiallyReceived => "tm-pill tm-pill-amber",
        PurchaseOrderStatus.Received => "tm-pill tm-pill-teal",
        PurchaseOrderStatus.Closed => "tm-pill tm-pill-blue",
        PurchaseOrderStatus.Cancelled => "tm-pill tm-pill-red",
        _ => "tm-pill tm-pill-blue"
    };

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page = 1;
        _debounce?.Stop();
        _debounce?.Dispose();
        _debounce = new System.Timers.Timer(350) { AutoReset = false };
        _debounce.Elapsed += async (_, __) =>
        {
            await LoadOrders();
            await InvokeAsync(StateHasChanged);
        };
        _debounce.Start();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _statusFilter = string.IsNullOrEmpty(v) ? null : Enum.Parse<PurchaseOrderStatus>(v);
        _page = 1;
        await LoadOrders();
    }

    private async Task PickStatus(PurchaseOrderStatus s)
    {
        _statusFilter = _statusFilter == s ? null : s;
        _page = 1;
        await LoadOrders();
    }

    private async Task ResetFilters()
    {
        _search = "";
        _statusFilter = null;
        _page = 1;
        await LoadOrders();
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadOrders();
    }

    private async Task OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
        await LoadOrders();
    }

    private async Task Approve(Guid id)
    {
        try
        {
            await PurchaseService.ApprovePurchaseOrder(id);
            Snackbar.Add("PO approved", Severity.Success);
            await LoadOrders();
            await LoadCountsAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ReceiveGoods(PurchaseOrderDto po)
    {
        var detail = await PurchaseService.GetPurchaseOrderById(po.Id);
        if (detail == null) return;

        var lines = detail.Items
            .Where(i => i.ReceivedQuantity < i.Quantity)
            .Select(i => new GoodsReceivedLineDto(i.Id, i.ProductId, i.Quantity - i.ReceivedQuantity))
            .ToList();

        if (!lines.Any()) { Snackbar.Add("All items already received", Severity.Info); return; }

        var confirm = await DialogService.ShowMessageBoxAsync("Receive Goods",
            $"Receive all outstanding items for {po.OrderNumber}?", "Receive", "Cancel");
        if (confirm == true)
        {
            try
            {
                await PurchaseService.ReceiveGoods(po.Id, lines);
                Snackbar.Add("Goods received successfully", Severity.Success);
                await LoadOrders();
                await LoadCountsAsync();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task OpenCreateEdit(Guid? orderId)
    {
        var suppliers = await DbContext.Suppliers.Where(s => s.IsActive).OrderBy(s => s.SupplierName).ToListAsync();
        var products = await DbContext.Products.OrderBy(p => p.Name).ToListAsync();
        var wareHouse = await DbContext.Warehouses.OrderBy(p => p.Name).ToListAsync();
        var dataModel = new PurchaseOrderDtoModels();
        string dialogTitle = "New Purchase Order";

        if (orderId.HasValue)
        {
            var order = await PurchaseService.GetPurchaseOrderById(orderId.Value);
            if (order == null) { Snackbar.Add("Purchase order not found", Severity.Error); return; }

            dialogTitle = $"Edit PO #{order.OrderNumber}";
            var supplierItem = suppliers.Where(s => s.Id == order.SupplierId)
                .Select(s => new ControlItemsDto() {Id= s.Id, IsSelected = false, Name = s.SupplierName })
                .FirstOrDefault() ?? new ControlItemsDto() { Id = order.SupplierId, Name = order.SupplierName, IsSelected = false };

            dataModel = new PurchaseOrderDtoModels()
            {
                PurchaseDate = order.PurchaseDate,
                SupplierId = order.SupplierId,              
                WarehouseId = order.WarehouseId,
                DiscountAmount = order.DiscountAmount,
                TaxAmount = order.TaxAmount,
                DiscountType = (int)order.DiscountType,
                DueAmount = order.DueAmount,
                TotalAmount = order.TotalAmount,
                //LabourCharge = order.LabourCharge,
                //TruckCharge = order.TruckCharge,
                SubTotal = order.SubTotal,
                PaidAmount = order.PaidAmount,
                Notes = order.Notes,
                SupplierDdlControl = new ControlDto() { 
                    SelectedItem = supplierItem,
                    SelectedText = supplierItem?.Name,
                    LastSelectedItem = supplierItem
                },
                ItemsLine = order.Items.Select(i => new CreatePurchaseOrderItemDto(i.Id, i.ProductId, i.Quantity, i.UnitPrice, i.DiscountAmount,
                    (DiscountType)i.DiscountType, i.TotalDiscountAmount, i.LineTotalPrice, null, null)).ToList()
            };
        }

        var parameters = new DialogParameters<PurchaseOrderDialog>
        {
            { x => x.Suppliers, suppliers.Select(c => new SupplierDto(){ Id = c.Id, SupplierName = c.SupplierName, SupplierEmail = c.SupplierEmail, SupplierPhone = c.SupplierPhone, ContactPersonName = c.ContactPersonName, ContactPersonPhone = c.ContactPersonPhone, ContactPersonEmail = c.ContactPersonEmail, Address = c.Address, City = c.City, Zila = c.Zila, State = c.State, Country = c.Country, PostalCode = c.PostalCode,  IsActive = false }).ToList() },
            { x => x.Products, products.Select(p => (p.Id, p.Name, p.SKU, p.CostPrice)).ToList() },
            { x => x.WareHouses, wareHouse.Select(p => (p.Id, p.Name)).ToList() },
            {x=>x.dataModel, dataModel }
        };

        var dialog = await DialogService.ShowAsync<PurchaseOrderDialog>(dialogTitle, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreatePurchaseOrderDto dto)
        {
            try
            {
                if (orderId.HasValue)
                {
                    await PurchaseService.UpdatePurchaseOrder(orderId.Value, dto);
                    Snackbar.Add("Purchase order updated", Severity.Success);
                }
                else
                {
                    await PurchaseService.CreatePurchaseOrder(dto);
                    Snackbar.Add("Purchase order created", Severity.Success);
                    await LoadCountsAsync();
                }
                await LoadOrders();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task CancelPO(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Cancel Purchase Order",
            "Are you sure you want to cancel this purchase order?", "Yes, Cancel", "No");
        if (confirm == true)
        {
            try
            {
                await PurchaseService.CancelPurchaseOrder(id);
                Snackbar.Add("Purchase order cancelled", Severity.Warning);
                await LoadOrders();
                await LoadCountsAsync();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

    private async Task DeletePO(Guid id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Delete Purchase Order",
            "This will permanently delete the purchase order. Continue?", "Yes, Delete", "No");
        if (confirm == true)
        {
            try
            {
                await PurchaseService.DeletePurchaseOrder(id);
                Snackbar.Add("Purchase order deleted", Severity.Success);
                await LoadOrders();
                await LoadCountsAsync();
            }
            catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        }
    }

}
