@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form"> 
            <MudGrid>
                <MudItem xs="12" sm="6" class="d-flex flex-column">
                    <MudTextField @bind-Value="Supplier.SupplierName" Label="Supplier Name" Required="true" RequiredError="" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" class="mb-5" />
                    <MudTextField @bind-Value="Supplier.SupplierEmail" Label="Supplier Email" ShrinkLabel="true" Required="true" RequiredError="" Variant="Variant.Outlined" Margin="Margin.Dense" class="mb-5" />
                    <MudTextField @bind-Value="Supplier.SupplierPhone" Label="Supplier Phone" ShrinkLabel="true" Required="true" RequiredError="" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" class="d-flex flex-column">
                    <MudTextField @bind-Value="Supplier.ContactPersonName" Label="Contact Person Name" Required="true" RequiredError="" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" class="mb-5" />
                    <MudTextField @bind-Value="Supplier.ContactPersonEmail" Label="Contact Person Email" Required="true" RequiredError="" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" class="mb-5" />
                    <MudTextField @bind-Value="Supplier.ContactPersonPhone" Label="Contact Person Phone" Required="true" RequiredError="" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                @* <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_leadTime" Label="Lead Time (days)" Min="0" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/></MudItem> *@
                <MudItem xs="12"><MudTextField @bind-Value="Supplier.Address" Label="Address" Required="true" RequiredError="" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="Supplier.City" Label="Upozila" Required="true" RequiredError="" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="Supplier.Zila" Label="Zila" ShrinkLabel="true" Required="true" RequiredError="" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField @bind-Value="Supplier.State" Label="State" ShrinkLabel="true" Required="true" RequiredError="" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                @* <MudItem xs="12" sm="4"><MudTextField @bind-Value="Supplier.Country" Label="Country" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="Supplier.PostalCode" Label="Postal Code" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"/></MudItem> *@
                @* <MudItem xs="12" sm="6"><MudTextField @bind-Value="Supplier.PaymentTerms" Label="Payment Terms" ShrinkLabel]="true" Variant]="Variant.Outlined" Margin]="Margin.Dense"/></MudItem> *@
                <MudItem xs="12">
                    <MudCheckBox @bind-Value="Supplier.IsActive" Label="Is Active" CheckedIcon="@Icons.Material.Filled.CheckBox" UncheckedIcon="@Icons.Material.Outlined.CheckBoxOutlineBlank" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public SupplierDto Supplier { get; set; }
    private MudForm _form = default;
    //private string _Suppliername = "", _ContactPersonName = "";
    //private string? _Supplieremail, _Supplierphone, _ContactPersonEmail, _ContactPersonPhone, _address, _city, _zila, _state, _country, _postalCode, _paymentTerms;
    //private int _leadTime;

    protected override void OnInitialized()
    {
    }

    private void Cancel() => MudDialog.Cancel();
    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;
        MudDialog.Close(DialogResult.Ok(Supplier));
    }
}
