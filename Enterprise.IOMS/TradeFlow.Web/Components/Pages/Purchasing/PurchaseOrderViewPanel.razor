@inject IPurchaseService PurchaseService
@inject ISnackbar Snackbar

@if (_open)
{
    <div class="so-backdrop" @onclick="Close"></div>

    <div class="so-side-panel @(_animateIn ? "so-panel-open" : "")">

        <!-- Header -->
        <div class="so-header">
            <div class="d-flex align-items-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Primary" />
                <div>
                    <div class="so-header-title">Purchase Order</div>
                    @if (_order != null)
                    {
                        <div class="so-header-sub">@_order.OrderNumber</div>
                    }
                </div>
                @if (_order != null)
                {
                    <MudChip T="string" Color="@CommonUtility.GetStatusColor(_order.Status)" Size="Size.Small" Class="ms-1">
                        @_order.Status</MudChip>
                }
            </div>
            <div class="d-flex gap-1">
                <MudTooltip Text="Close panel">
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="Close" />
                </MudTooltip>
            </div>
        </div>

        <!-- Body -->
        <div class="so-body">
            @if (_loading)
            {
                <div class="d-flex justify-center align-center" style="height:200px;">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                </div>
            }
            else if (_order != null)
            {
                <!-- Reference block -->
                <div class="so-ref-block mb-3">
                    <div class="d-flex justify-space-between">
                        <div>
                            <div class="so-lbl">Order Number</div>
                            <div class="so-val-lg">@_order.OrderNumber</div>
                        </div>
                        <div class="text-end">
                            <div class="so-lbl">Purchase Date</div>
                            <div class="so-val fw-semibold">@_order.PurchaseDate.ToString("dd MMM yyyy")</div>
                            @if (_order.ExpectedDeliveryDate.HasValue)
                            {
                                <div class="so-sm">Expected: @_order.ExpectedDeliveryDate.Value.ToString("dd MMM yyyy")</div>
                            }
                        </div>
                    </div>
                </div>

                <MudDivider Class="mb-3" />

                <!-- Supplier & Warehouse -->
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="6">
                        <div class="so-info-card">
                            <div class="so-info-icon">
                                <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Small" Style="color:#fff;" />
                            </div>
                            <div class="overflow-hidden">
                                <div class="so-lbl">Supplier</div>
                                <div class="so-val fw-bold text-truncate">@_order.SupplierName</div>
                            </div>
                        </div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="so-info-card">
                            <div class="so-info-icon">
                                <MudIcon Icon="@Icons.Material.Filled.Warehouse" Size="Size.Small" Style="color:#fff;" />
                            </div>
                            <div class="overflow-hidden">
                                <div class="so-lbl">Warehouse</div>
                                <div class="so-val fw-bold text-truncate">@(_order.WarehouseName ?? "—")</div>
                            </div>
                        </div>
                    </MudItem>
                </MudGrid>

                @if (!string.IsNullOrWhiteSpace(_order.Notes))
                {
                    <div class="so-lbl mb-1">Notes</div>
                    <div class="so-val mb-3">@_order.Notes</div>
                    <MudDivider Class="mb-3" />
                }

                <!-- Items table -->
                <div class="so-section-lbl mb-2">Order Items (@_order.Items.Count)</div>
                <div class="so-items-wrapper mb-3">
                    <MudTable Items="@_order.Items" Dense="true" Hover="true" Elevation="0" Class="so-items-table">
                        <HeaderContent>
                            <MudTh>Product</MudTh>
                            <MudTh Style="text-align:right">Qty</MudTh>
                            <MudTh Style="text-align:right">Received</MudTh>
                            <MudTh Style="text-align:right">Price</MudTh>
                            <MudTh Style="text-align:right">Total</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <div class="so-val fw-semibold" style="line-height:1.2;">@context.ProductName</div>
                                <div class="so-sm text-muted">@context.ProductSKU</div>
                            </MudTd>
                            <MudTd Style="text-align:right">@context.Quantity</MudTd>
                            <MudTd Style="text-align:right">@context.ReceivedQuantity</MudTd>
                            <MudTd Style="text-align:right">@context.UnitPrice.ToString("C")</MudTd>
                            <MudTd Style="text-align:right;font-weight:600;">@context.LineTotalPrice.ToString("C")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>

                <MudDivider Class="mb-3" />

                <!-- Totals -->
                <div class="so-totals-box">
                    <div class="so-total-row">
                        <span>Subtotal</span>
                        <span>@_order.SubTotal.ToString("C")</span>
                    </div>
                    @if (_order.DiscountAmount > 0)
                    {
                        <div class="so-total-row">
                            <span>Discount</span>
                            <span class="text-error">-@_order.DiscountAmount.ToString("C")</span>
                        </div>
                    }
                    @if (_order.TaxAmount > 0)
                    {
                        <div class="so-total-row">
                            <span>Tax</span>
                            <span>@_order.TaxAmount.ToString("C")</span>
                        </div>
                    }
                    @if (_order.LabourCharge > 0)
                    {
                        <div class="so-total-row">
                            <span>Labour</span>
                            <span>@_order.LabourCharge.ToString("C")</span>
                        </div>
                    }
                    @if (_order.TruckCharge > 0)
                    {
                        <div class="so-total-row">
                            <span>Transport</span>
                            <span>@_order.TruckCharge.ToString("C")</span>
                        </div>
                    }
                    <div class="so-total-row so-grand-total">
                        <span>TOTAL</span>
                        <span>@_order.TotalAmount.ToString("C")</span>
                    </div>
                    <div class="so-total-row">
                        <span>Paid</span>
                        <span class="text-success">@_order.PaidAmount.ToString("C")</span>
                    </div>
                    <div class="so-total-row @(_order.DueAmount > 0 ? "so-due-row" : "")">
                        <span>Due</span>
                        <span>@_order.DueAmount.ToString("C")</span>
                    </div>
                </div>
            }
        </div>

        <!-- Footer -->
        @if (_order != null)
        {
            <div class="so-footer">
                <MudButton Variant="Variant.Text" OnClick="Close" Size="Size.Small">Close</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Print"
                           Href="@($"/print/purchase-order/{_order.Id}")" Target="_blank">PDF</MudButton>
            </div>
        }
    </div>
}

@code {
    private bool _open;
    private bool _animateIn;
    private bool _loading;
    private PurchaseOrderDto? _order;

    public async Task OpenAsync(Guid id)
    {
        _open = true;
        _loading = true;
        _animateIn = false;
        _order = null;
        StateHasChanged();

        await Task.Delay(20);
        _animateIn = true;
        StateHasChanged();

        try
        {
            _order = await PurchaseService.GetPurchaseOrderById(id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        _loading = false;
        StateHasChanged();
    }

    public void Close()
    {
        _open = false;
        _animateIn = false;
        _order = null;
        StateHasChanged();
    }
}