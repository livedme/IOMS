@page "/purchasing/rfq"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IRfqService RfqService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>RFQ Requests</PageTitle>

<div class="tm-page">
    <TmPageHeader Icon="📨" Title="Request for Quotation (RFQ)" Subtitle="Request supplier quotes, compare responses and award orders">
        <Actions>
            <button class="tm-reset" @onclick="LoadData">⟳ Refresh</button>
            <button class="tm-add-btn" @onclick="OpenCreate">+ New RFQ</button>
        </Actions>
    </TmPageHeader>

    <div class="tm-stats">
        <TmStatTile Icon="📨" Number="@_totalCount" Label="RFQs" Tone="blue" />
        <TmStatTile Icon="📝" Number="@CountOf(RfqStatus.Draft)" Label="Draft" Tone="purple" OnClick="@(() => PickStatus(RfqStatus.Draft))" />
        <TmStatTile Icon="📤" Number="@CountOf(RfqStatus.Sent)" Label="Sent" Tone="yellow" OnClick="@(() => PickStatus(RfqStatus.Sent))" />
        <TmStatTile Icon="📥" Number="@CountOf(RfqStatus.Received)" Label="Responses In" Tone="teal" OnClick="@(() => PickStatus(RfqStatus.Received))" />
        <TmStatTile Icon="🏆" Number="@CountOf(RfqStatus.Awarded)" Label="Awarded" Tone="green" OnClick="@(() => PickStatus(RfqStatus.Awarded))" />
        <TmStatTile Icon="🔄" Number="@_rfqs.Count(r => r.Status != RfqStatus.Closed)" Label="Open" Tone="red" />
    </div>

    <div class="tm-card tm-filters">
        <div class="tm-search">
            <span>🔍</span>
            <input placeholder="Search by RFQ number..." value="@_search" @oninput="OnSearchInput" />
        </div>
        <div class="tm-select">
            <select @onchange="OnStatusChanged">
                <option value="" selected="@(_statusFilter == null)">All Status</option>
                @foreach (RfqStatus s in Enum.GetValues<RfqStatus>())
                {
                    <option value="@s" selected="@(_statusFilter == s)">@s</option>
                }
            </select>
        </div>
        <button class="tm-reset" @onclick="ResetFilters">Reset</button>
    </div>

    <div class="tm-card tm-table-card">
        <div class="tm-table-wrap">
            <table class="tm-table" style="min-width:1000px">
                <thead>
                    <tr>
                        <th>📨 RFQ #</th>
                        <th>Status</th>
                        <th>📅 Required Date</th>
                        <th style="text-align:right">Items</th>
                        <th style="text-align:right">Responses</th>
                        <th style="text-align:right">Best Quote</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_loading)
                    {
                        <tr><td colspan="7"><TmLoading Message="Loading RFQs..." /></td></tr>
                    }
                    else if (_rfqs.Count == 0)
                    {
                        <tr><td colspan="7"><div class="tm-loading">No RFQs found</div></td></tr>
                    }
                    else
                    {
                        @foreach (var r in _rfqs)
                        {
                            <tr>
                                <td><span class="tm-veh"><span class="tm-veh-ico" style="background:#e0e9ff">📨</span>@r.RfqNumber</span></td>
                                <td><span class="@GetStatusPill(r.Status)"><span class="tm-dot"></span>@r.Status</span></td>
                                <td>
                                    @if (r.RequiredDate.HasValue)
                                    {
                                        var isSoon = r.RequiredDate.Value <= DateTime.Today.AddDays(3);
                                        <span class="@(isSoon ? "tm-date-red" : "tm-dim")">@r.RequiredDate.Value.ToString("dd MMM yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="tm-dim">-</span>
                                    }
                                </td>
                                <td style="text-align:right" class="tm-num">@r.Items.Count</td>
                                <td style="text-align:right">
                                    <span class="@(r.SupplierResponses.Count > 0 ? "tm-pill tm-pill-green" : "tm-pill tm-pill-amber")">
                                        <span class="tm-dot"></span>@r.SupplierResponses.Count
                                    </span>
                                </td>
                                <td style="text-align:right" class="tm-money">@BestQuote(r)</td>
                                <td>
                                    <span class="tm-actions" style="justify-content:flex-end">
                                        <button class="tm-act tm-act-view" title="View" @onclick="() => ViewRfq(r.Id)">👁</button>
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <TmPager CurrentPage="@(_page - 1)"
                  PageSize="_pageSize"
                  TotalCount="_totalCount"
                  TotalPages="@PageTotal"
                  ItemLabel="RFQs"
                  OnGoToPage="GoToPage"
                  OnPrev="GoPrevPage"
                  OnNext="GoNextPage"
                  OnPageSizeChanged="OnPageSizeChanged" />
    </div>
</div>

@code {
    private List<RfqRequestDto> _rfqs = new();
    private string? _search;
    private RfqStatus? _statusFilter;
    private int _page = 1;
    private int _pageSize = 25;
    private int _totalCount;
    private int _draftCount, _sentCount, _receivedCount, _awardedCount;
    private bool _loading;
    private System.Timers.Timer? _debounce;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await LoadCountsAsync();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var result = await RfqService.GetRfqRequests(_search, _statusFilter, _page, _pageSize);
            _rfqs = result.Items;
            _totalCount = result.TotalCount;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task LoadCountsAsync()
    {
        try
        {
            var all = await RfqService.GetRfqRequests(null, null, 1, 500);
            var items = all.Items;
            _draftCount = items.Count(r => r.Status == RfqStatus.Draft);
            _sentCount = items.Count(r => r.Status == RfqStatus.Sent);
            _receivedCount = items.Count(r => r.Status == RfqStatus.Received);
            _awardedCount = items.Count(r => r.Status == RfqStatus.Awarded);
        }
        catch { }
    }

    private int CountOf(RfqStatus s) => s switch
    {
        RfqStatus.Draft => _draftCount,
        RfqStatus.Sent => _sentCount,
        RfqStatus.Received => _receivedCount,
        RfqStatus.Awarded => _awardedCount,
        _ => 0
    };

    private static string BestQuote(RfqRequestDto r)
    {
        if (r.SupplierResponses == null || r.SupplierResponses.Count == 0) return "-";
        var best = r.SupplierResponses.Min(x => x.QuotedPrice);
        return best.ToString("N0");
    }

    private void ViewRfq(Guid id) => Navigation.NavigateTo("/quotes/rfq/" + id);

    private async Task OpenCreate()
    {
        var dialog = await DialogService.ShowAsync<RfqCreateDialog>("New RFQ",
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadData();
            await LoadCountsAsync();
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString();
        _page = 1;
        _debounce?.Stop();
        _debounce?.Dispose();
        _debounce = new System.Timers.Timer(350) { AutoReset = false };
        _debounce.Elapsed += async (_, __) =>
        {
            await LoadData();
            await InvokeAsync(StateHasChanged);
        };
        _debounce.Start();
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _statusFilter = string.IsNullOrEmpty(v) ? null : Enum.Parse<RfqStatus>(v);
        _page = 1;
        await LoadData();
    }

    private async Task PickStatus(RfqStatus s)
    {
        _statusFilter = _statusFilter == s ? null : s;
        _page = 1;
        await LoadData();
    }

    private async Task ResetFilters()
    {
        _search = null;
        _statusFilter = null;
        _page = 1;
        await LoadData();
    }

    private int PageTotal => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_pageSize));

    private async Task OnPageChanged(int page)
    {
        _page = Math.Clamp(page, 1, PageTotal);
        await LoadData();
    }

    private async Task OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
        await LoadData();
    }

    private Task GoToPage(int pageIndex) => OnPageChanged(pageIndex + 1);

    private Task GoPrevPage() => OnPageChanged(_page - 1);

    private Task GoNextPage() => OnPageChanged(_page + 1);

    private Task OnPageSizeChanged(ChangeEventArgs e)
        => int.TryParse(e.Value?.ToString(), out var size) && size > 0
            ? OnPageSizeChanged(size)
            : Task.CompletedTask;

    private static string GetStatusPill(RfqStatus s) => s switch
    {
        RfqStatus.Draft => "tm-pill tm-pill-purple",
        RfqStatus.Sent => "tm-pill tm-pill-blue",
        RfqStatus.Received => "tm-pill tm-pill-amber",
        RfqStatus.Awarded => "tm-pill tm-pill-green",
        RfqStatus.Closed => "tm-pill tm-pill-red",
        _ => "tm-pill tm-pill-blue"
    };
}
