@using TradeFlow.Web.Components.Shared.Cards
@inject ISupplierService SupplierService
@inject IPurchaseService PurchaseService
@inject IAccountingService AccountingService
@inject ICreditDebitNoteService CreditDebitNoteService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IPrintDocumentRenderer PrintRenderer

@if (_open)
{
    <div class="so-backdrop" @onclick="Close"></div>

    <div class="so-side-panel @(_animateIn ? "so-panel-open" : "")">

        <!-- Header -->
        <div class="so-header">
            <div class="d-flex align-items-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Store" Color="Color.Primary" />
                <div>
                    <div class="so-header-title">Supplier</div>
                    @if (_supplier != null)
                    {
                        <div class="so-header-sub">@_supplier.SupplierName</div>
                    }
                </div>
                @if (_supplier != null)
                {
                    <MudChip T="string" Color="@CommonUtility.GetStatusColor(_supplier.IsActive)" Size="Size.Small" Class="ms-1">
                        @(_supplier.IsActive ? "Active" : "Inactive")</MudChip>
                }
            </div>
            <div class="d-flex gap-1">
                <MudTooltip Text="Close panel">
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="Close" />
                </MudTooltip>
            </div>
        </div>

        <!-- Body -->
        <div class="so-body">
            @if (_loading)
            {
                <div class="d-flex justify-center align-center" style="height:200px;">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                </div>
            }
            else if (_supplier != null)
            {
                <!-- Reference block -->
                <div class="so-ref-block mb-3">
                    <div class="d-flex justify-space-between">
                        <div>
                            <div class="so-lbl">Supplier</div>
                            <div class="so-val-lg">@_supplier.SupplierName</div>
                            @if (!string.IsNullOrWhiteSpace(_supplier.SupplierPhone))
                            {
                                <div class="so-sm">@_supplier.SupplierPhone</div>
                            }
                        </div>
                        <div class="text-end">
                            <div class="so-lbl">Rating</div>
                            <div class="so-val fw-semibold">@_supplier.Rating.ToString("0.#") / 5</div>
                        </div>
                        @{
                            var initialBalance = _invoices.Where(x => x.IsInitialInvoice == true).FirstOrDefault();

                            if (initialBalance != null)
                            {
                                <div class="text-end">
                                    <div class="so-lbl">Initial Balance</div>
                                    <div class="so-val fw-semibold">@Taka.H(initialBalance.TotalAmount)</div>
                                    <div class="so-lbl">Paid Balance</div>
                                    <div class="so-val fw-semibold">@Taka.H(initialBalance.PaidAmount)</div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <MudDivider Class="mb-3" />

                <!-- Contact -->
                <div class="so-section-lbl mb-2">Contact</div>
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="6">
                        <div class="so-lbl">Email</div>
                        <div class="so-val">@(_supplier.SupplierEmail ?? "—")</div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="so-lbl">Phone</div>
                        <div class="so-val">@(_supplier.SupplierPhone ?? "—")</div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="so-lbl">Contact Person</div>
                        <div class="so-val">@(_supplier.ContactPersonName ?? "—")</div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="so-lbl">Contact Person Phone</div>
                        <div class="so-val">@(_supplier.ContactPersonPhone ?? "—")</div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="so-lbl">Contact Person Email</div>
                        <div class="so-val">@(_supplier.ContactPersonEmail ?? "—")</div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="so-lbl">Payment Terms</div>
                        <div class="so-val">@(_supplier.PaymentTerms ?? "—")</div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="so-lbl">Lead Time (days)</div>
                        <div class="so-val">@_supplier.LeadTimeDays</div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="so-lbl">Address</div>
                        <div class="so-val">@(_supplier.Address ?? "—")</div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="so-lbl">City</div>
                        <div class="so-val">@(_supplier.City ?? "—")</div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="so-lbl">Zila</div>
                        <div class="so-val">@(_supplier.Zila ?? "—")</div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="so-lbl">State</div>
                        <div class="so-val">@(_supplier.State ?? "—")</div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="so-lbl">Country</div>
                        <div class="so-val">@(_supplier.Country ?? "—")</div>
                    </MudItem>
                    <MudItem xs="6">
                        <div class="so-lbl">Postal Code</div>
                        <div class="so-val">@(_supplier.PostalCode ?? "—")</div>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="mb-3" />
                <PartyPurchaseListCard _recentOrders ="_recentOrders"/>
               
                <MudDivider Class="mb-3" />
                <PartyInvoiceListCard invoices="_invoices" />                

                <MudDivider Class="mb-3" />
                <DebiteNoteCard _debitNotes="_debitNotes" IsParty="true" />

                <MudDivider Class="mb-3" />
                <PartyPaymentListCard payments="_payments" />
            }
        </div>

        <!-- Footer -->
        @if (_supplier != null)
        {
            <div class="so-footer">
                <MudButton Variant="Variant.Text" OnClick="Close" Size="Size.Small">Close</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick="PrintDoc">Print</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="DownloadPdf">Download PDF</MudButton>
            </div>
        }
    </div>
}

@code {
    private bool _open;
    private bool _animateIn;
    private bool _loading;
    private SupplierDto? _supplier;
    private List<PurchaseOrderDto> _recentOrders = new();
    private List<StatementInvoiceRowDto> _invoices = new();
    private List<StatementPaymentRowDto> _payments = new();
    private List<DebitNoteDto> _debitNotes = new();
    private decimal _historyTotal;
    private decimal _historyPaid;
    private decimal _historyDue;

    public async Task OpenAsync(Guid id)
    {
        _open = true;
        _loading = true;
        _animateIn = false;
        _supplier = null;
        _recentOrders = new();
        _debitNotes = new();
        _historyTotal = _historyPaid = _historyDue = 0;
        StateHasChanged();

        await Task.Delay(20);
        _animateIn = true;
        StateHasChanged();

        try
        {
            _supplier = await SupplierService.GetSupplierByIdAsync(id);
            if (_supplier != null)
            {
                var history = await PurchaseService.GetPurchaseOrdersAsync(new PurchaseOrderPagedRequest
                {
                    SupplierId = id,
                    CurrentPage = 0,
                    PageSize = 100,
                    SortColumn = "PurchaseDate",
                    SortAscending = false
                });
                _recentOrders = history.Items;
                // _historyTotal = _recentOrders.Sum(o => o.TotalAmount);
                // _historyPaid = _recentOrders.Sum(o => o.PaidAmount);
                // _historyDue = _recentOrders.Sum(o => o.DueAmount);

                var statement = await AccountingService.GetSupplierStatement(id, new DateTime(2000, 1, 1), DateTime.UtcNow.AddDays(1));
                _invoices = statement.Invoices.OrderByDescending(i => i.InvoiceDate).ToList();
                _payments = statement.Payments.OrderByDescending(p => p.PaymentDate).ToList();

                _debitNotes = await CreditDebitNoteService.GetDebitNotesForSupplier(id);
                _debitNotes = _debitNotes.OrderByDescending(d => d.InvoiceNumber).ToList();

            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        _loading = false;
        StateHasChanged();
    }

    public void Close()
    {
        _open = false;
        _animateIn = false;
        _supplier = null;
        _debitNotes = new();
        StateHasChanged();
    }

    private static Color GetNoteStatusColor(string status) => status switch
    {
        "Approved" => Color.Success,
        "Applied" => Color.Info,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };

    private async Task DownloadPdf()
    {
        if (_supplier is null) return;
        try
        {
            var doc = await PrintRenderer.RenderSupplierAsync(_supplier, _recentOrders);
            await JS.InvokeVoidAsync("downloadFile", doc.Html, doc.FileName + ".pdf", doc.Title, doc.Reference);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Could not generate the PDF: " + ex.Message);
        }
    }

    private async Task PrintDoc()
    {
        if (_supplier is null) return;
        try
        {
            var doc = await PrintRenderer.RenderSupplierAsync(_supplier, _recentOrders);
            await JS.InvokeVoidAsync("printHtml", doc.Html, doc.Title, doc.Reference);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Could not print the document: " + ex.Message);
        }
    }
}