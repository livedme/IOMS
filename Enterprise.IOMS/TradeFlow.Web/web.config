<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Blazor Server needs the WebSocket transport. IIS/Plesk only forwards the
           Upgrade/Connection handshake to the app when this is enabled. Without it the
           client falls back to long polling, which is much more sensitive to the
           app-pool worker/affinity configuration. -->
      <webSocket enabled="true" />
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- processPath/arguments/hostingModel are rewritten by the SDK at publish time. -->
      <aspNetCore processPath="dotnet" arguments=".\TradeFlow.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
